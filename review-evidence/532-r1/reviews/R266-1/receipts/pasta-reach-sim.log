== control: no slot firewall table
S -> host-local bridge gateway 172.31.0.1    REACHED host-bridge-gateway-listener
S -> routed container IP 172.31.0.2          REACHED container-listener
== with the runner's rule body (fib daddr type local counter reject)
S -> host-local bridge gateway 172.31.0.1    BLOCKED TimeoutError None
S -> routed container IP 172.31.0.2          REACHED container-listener
== plus a Docker-style published port: nat output DNAT 172.31.0.1:9090 -> 172.31.0.2:8080
S -> host-local 172.31.0.1:9090 (published)  REACHED container-listener
S -> host-local 172.31.0.1:8082 (unpublished) BLOCKED TimeoutError None
table inet sim_slot {
	chain output {
		type filter hook output priority filter; policy accept;
		fib daddr type local counter packets 24 bytes 1776 reject
	}
}
table ip sim_publish {
	chain output {
		type nat hook output priority dstnat; policy accept;
		ip daddr 172.31.0.1 tcp dport 9090 counter packets 1 bytes 60 dnat to 172.31.0.2:8080
	}
}
