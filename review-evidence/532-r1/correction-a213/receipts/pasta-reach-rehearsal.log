  S -> dns 198.51.100.53:53 (via the default route)               RESOLVED registry.example=198.51.100.7
== (c) the corrected rules as the candidate emits them (cgroup selector removed):
create table inet milan_act_slot_1
add chain inet milan_act_slot_1 output { type filter hook output priority filter; policy accept; }
add rule inet milan_act_slot_1 output fib daddr type local counter reject
add rule inet milan_act_slot_1 output oifname != { "up0" } counter reject
  S -> container 172.31.0.2:8080 (routed via br0h, unpublished)   REFUSED TimeoutError
  S -> published 172.31.0.1:9090 (host-local, DNAT to the container) REFUSED TimeoutError
  S -> host-local 172.31.0.1:8082 (bridge gateway listener)       REFUSED TimeoutError
  S -> internet 198.51.100.7:443 (via the default route)          REACHED hello
  S -> dns 198.51.100.53:53 (via the default route)               RESOLVED registry.example=198.51.100.7
== ruleset after (c)
table ip docker_publish_model {
	chain output {
		type nat hook output priority dstnat; policy accept;
		ip daddr 172.31.0.1 tcp dport 9090 counter packets 9 bytes 540 dnat to 172.31.0.2:8080
	}
}
table inet milan_act_slot_1 {
	chain output {
		type filter hook output priority filter; policy accept;
		fib daddr type local counter packets 31 bytes 2504 reject
		oifname != "up0" counter packets 16 bytes 956 reject
	}
}
