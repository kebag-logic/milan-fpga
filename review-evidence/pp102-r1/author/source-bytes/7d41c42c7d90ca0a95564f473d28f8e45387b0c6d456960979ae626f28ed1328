  <line x1="180" y1="196" x2="180" y2="205" stroke="#2f7d46" stroke-width="1.8" marker-end="url(#ah)"/>
  <line x1="180" y1="310" x2="180" y2="319" stroke="#2f7d46" stroke-width="1.8" marker-end="url(#ah)"/>
  <line x1="180" y1="424" x2="180" y2="433" stroke="#2f7d46" stroke-width="1.8" marker-end="url(#ah)"/>
  <line x1="180" y1="538" x2="180" y2="547" stroke="#2f7d46" stroke-width="1.8" marker-end="url(#ah)"/>
  <line x1="180" y1="652" x2="180" y2="661" stroke="#2f7d46" stroke-width="1.8" marker-end="url(#ah)"/>
  <line x1="180" y1="766" x2="180" y2="775" stroke="#2f7d46" stroke-width="1.8" marker-end="url(#ah)"/>

  <!-- horizontal no arrows -->
  <line x1="548" y1="146" x2="607" y2="146" stroke="#a03030" stroke-width="1.8" marker-end="url(#ahn)"/>
  <line x1="548" y1="260" x2="607" y2="260" stroke="#a03030" stroke-width="1.8" marker-end="url(#ahn)"/>
  <line x1="548" y1="374" x2="607" y2="374" stroke="#a03030" stroke-width="1.8" marker-end="url(#ahn)"/>
  <line x1="548" y1="488" x2="607" y2="488" stroke="#a03030" stroke-width="1.8" marker-end="url(#ahn)"/>
  <line x1="548" y1="602" x2="607" y2="602" stroke="#a03030" stroke-width="1.8" marker-end="url(#ahn)"/>
  <line x1="548" y1="716" x2="607" y2="716" stroke="#a03030" stroke-width="1.8" marker-end="url(#ahn)"/>
  <line x1="548" y1="830" x2="607" y2="830" stroke="#a03030" stroke-width="1.8" marker-end="url(#ahn)"/>

  <text x="24" y="920" font-size="11.5" fill="#4a5058">Every drop in this processor is counted; none is silent. Counters saturate rather than wrap, so 0xFFFF means "at least that many", not "none".</text>
  <text x="24" y="942" font-size="11.5" fill="#4a5058">The complete word map, with bit positions, is in the operator guide. The snapshot window is read-only — reading it can never change behaviour.</text>
  <text x="24" y="964" font-size="11.5" fill="#4a5058">Word 15 also exposes the scoreboard and the trace ring; the trace ring itself is a second window, at word address 0x40000.</text>
</svg>
