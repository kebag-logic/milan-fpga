<svg xmlns="http://www.w3.org/2000/svg" width="1360" height="920" viewBox="0 0 1360 920" font-family="DejaVu Sans, Verdana, Helvetica, Arial, sans-serif">
  <defs>
    <marker id="ah" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto">
      <path d="M0,1 L8,4.5 L0,8 z" fill="#2c3038"/>
    </marker>
    <marker id="ahs" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto">
      <path d="M0,1 L8,4.5 L0,8 z" fill="#2b7a78"/>
    </marker>
    <marker id="ahm" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto">
      <path d="M0,1 L8,4.5 L0,8 z" fill="#6b46a5"/>
    </marker>
  </defs>

  <rect x="0" y="0" width="1360" height="920" fill="#fbfcfe" stroke="#ccd2da" stroke-width="1"/>

  <text x="24" y="34" font-size="19" font-weight="bold" fill="#16181d">protocol_processor_top — dataflow of the landed RTL</text>
  <text x="24" y="56" font-size="12" fill="#4a5058">One MAC byte stream in, one MAC byte stream out. Every solid box is a module under hdl/; dashed boxes are glue that lives in the top itself.</text>

  <!-- ============================ ROW 1 ============================ -->
  <rect x="24" y="92" width="130" height="58" rx="6" fill="#eef2f7" stroke="#586376" stroke-width="1.3"/>
  <text x="89" y="115" font-size="12" font-weight="bold" text-anchor="middle" fill="#16181d">MAC trunk RX</text>
  <text x="89" y="133" font-size="10.5" text-anchor="middle" fill="#4a5058">rx_valid/data/last</text>

  <rect x="190" y="92" width="200" height="58" rx="6" fill="#e8f0fb" stroke="#3b6ea5" stroke-width="1.3"/>
  <text x="290" y="113" font-size="12" font-weight="bold" text-anchor="middle" fill="#16181d">KL_pp_rx_validator</text>
  <text x="290" y="130" font-size="10.5" text-anchor="middle" fill="#4a5058">DA gate · 0x22F0 · FA/FB/FC</text>
  <text x="290" y="144" font-size="10.5" text-anchor="middle" fill="#4a5058">V8 h/version · V1 cdl + 12</text>

  <rect x="662" y="92" width="200" height="58" rx="6" fill="#e4f4f3" stroke="#2b7a78" stroke-width="1.3"/>
  <text x="762" y="115" font-size="12" font-weight="bold" text-anchor="middle" fill="#16181d">KL_mrp_strip</text>
  <text x="762" y="133" font-size="10.5" text-anchor="middle" fill="#4a5058">drops 14 header bytes</text>

  <rect x="898" y="92" width="200" height="58" rx="6" fill="#e4f4f3" stroke="#2b7a78" stroke-width="1.3"/>
  <text x="998" y="115" font-size="12" font-weight="bold" text-anchor="middle" fill="#16181d">KL_srp_top</text>
  <text x="998" y="133" font-size="10.5" text-anchor="middle" fill="#4a5058">MSRP + MVRP endpoint</text>

  <line x1="154" y1="121" x2="185" y2="121" stroke="#2c3038" stroke-width="1.6" marker-end="url(#ah)"/>
  <line x1="390" y1="121" x2="657" y2="121" stroke="#2b7a78" stroke-width="1.6" marker-end="url(#ahs)"/>
  <text x="523" y="113" font-size="10.5" text-anchor="middle" fill="#2b7a78">V9 MRP pass-through (whole frame)</text>
  <line x1="862" y1="121" x2="893" y2="121" stroke="#2b7a78" stroke-width="1.6" marker-end="url(#ahs)"/>

  <!-- ============================ ROW 2 ============================ -->
  <rect x="24" y="182" width="200" height="58" rx="6" fill="#e8f0fb" stroke="#3b6ea5" stroke-width="1.3"/>
  <text x="124" y="203" font-size="12" font-weight="bold" text-anchor="middle" fill="#16181d">KL_pp_rx_slots × 5</text>
  <text x="124" y="220" font-size="10.5" text-anchor="middle" fill="#4a5058">payload store, one replica</text>
  <text x="124" y="234" font-size="10.5" text-anchor="middle" fill="#4a5058">per reader (never shared)</text>

  <rect x="260" y="182" width="200" height="58" rx="6" fill="#e8f0fb" stroke="#3b6ea5" stroke-width="1.3"/>
  <text x="360" y="203" font-size="12" font-weight="bold" text-anchor="middle" fill="#16181d">KL_pp_normalizer</text>
  <text x="360" y="220" font-size="10.5" text-anchor="middle" fill="#4a5058">one pp_txn_t record,</text>
  <text x="360" y="234" font-size="10.5" text-anchor="middle" fill="#4a5058">whatever the origin</text>

  <rect x="496" y="182" width="200" height="58" rx="6" fill="#e8f0fb" stroke="#3b6ea5" stroke-width="1.3"/>
  <text x="596" y="203" font-size="12" font-weight="bold" text-anchor="middle" fill="#16181d">KL_pp_dispatch</text>
  <text x="596" y="220" font-size="10.5" text-anchor="middle" fill="#4a5058">three queues: ADP / ACMP /</text>
  <text x="596" y="234" font-size="10.5" text-anchor="middle" fill="#4a5058">AECP — producers stall</text>

  <!-- validator -> slots (frames) -->
  <path d="M230,150 L230,166 L124,166 L124,177" fill="none" stroke="#2c3038" stroke-width="1.6" marker-end="url(#ah)"/>
  <text x="150" y="162" font-size="10.5" text-anchor="middle" fill="#4a5058">frames</text>
  <!-- validator -> normalizer (header beat) -->
  <path d="M330,150 L330,168 L360,168 L360,177" fill="none" stroke="#2c3038" stroke-width="1.6" marker-end="url(#ah)"/>
  <text x="428" y="164" font-size="10.5" text-anchor="middle" fill="#4a5058">parsed header beat</text>
  <line x1="460" y1="211" x2="491" y2="211" stroke="#2c3038" stroke-width="1.6" marker-end="url(#ah)"/>

  <!-- dispatch -> engine bus -->
  <path d="M596,240 L596,258" fill="none" stroke="#2c3038" stroke-width="1.6"/>
  <line x1="124" y1="258" x2="762" y2="258" stroke="#2c3038" stroke-width="1.6"/>
  <line x1="124" y1="258" x2="124" y2="277" stroke="#2c3038" stroke-width="1.6" marker-end="url(#ah)"/>
  <line x1="360" y1="258" x2="360" y2="277" stroke="#2c3038" stroke-width="1.6" marker-end="url(#ah)"/>
  <line x1="596" y1="258" x2="596" y2="277" stroke="#2c3038" stroke-width="1.6" marker-end="url(#ah)"/>
  <line x1="762" y1="258" x2="762" y2="277" stroke="#2c3038" stroke-width="1.6" marker-end="url(#ah)"/>
  <text x="866" y="255" font-size="10.5" fill="#4a5058">routed by protocol field</text>


  <!-- ============================ ROW 3: engines ============================ -->
  <rect x="24" y="282" width="200" height="76" rx="6" fill="#e6f4ea" stroke="#2f7d46" stroke-width="1.3"/>
  <text x="124" y="303" font-size="12" font-weight="bold" text-anchor="middle" fill="#16181d">KL_adp_engine</text>
  <text x="124" y="320" font-size="10.5" text-anchor="middle" fill="#4a5058">advertise SM × interface</text>
  <text x="124" y="334" font-size="10.5" text-anchor="middle" fill="#4a5058">talker discovery SM × sink</text>
  <text x="124" y="348" font-size="10.5" text-anchor="middle" fill="#4a5058">available_index + builder</text>

  <rect x="260" y="282" width="200" height="76" rx="6" fill="#e6f4ea" stroke="#2f7d46" stroke-width="1.3"/>
  <text x="360" y="303" font-size="12" font-weight="bold" text-anchor="middle" fill="#16181d">KL_pp_acmp_listener</text>
  <text x="360" y="320" font-size="10.5" text-anchor="middle" fill="#4a5058">8-state Milan binding SM</text>
  <text x="360" y="334" font-size="10.5" text-anchor="middle" fill="#4a5058">driven by a transition ROM</text>
  <text x="360" y="348" font-size="10.5" text-anchor="middle" fill="#4a5058">records × P-N-STREAM-IN</text>

  <rect x="496" y="282" width="200" height="76" rx="6" fill="#e6f4ea" stroke="#2f7d46" stroke-width="1.3"/>
  <text x="596" y="303" font-size="12" font-weight="bold" text-anchor="middle" fill="#16181d">KL_acmp_talker</text>
  <text x="596" y="320" font-size="10.5" text-anchor="middle" fill="#4a5058">stateless responder</text>
  <text x="596" y="334" font-size="10.5" text-anchor="middle" fill="#4a5058">per-source dest-MAC gate</text>
  <text x="596" y="348" font-size="10.5" text-anchor="middle" fill="#4a5058">drives the maap face</text>

  <rect x="732" y="282" width="200" height="76" rx="6" fill="#e6f4ea" stroke="#2f7d46" stroke-width="1.3"/>
  <text x="832" y="303" font-size="12" font-weight="bold" text-anchor="middle" fill="#16181d">KL_aecp_engine</text>
  <text x="832" y="320" font-size="10.5" text-anchor="middle" fill="#4a5058">opcode decode → µPC</text>
  <text x="832" y="334" font-size="10.5" text-anchor="middle" fill="#4a5058">AECPDU frame builder</text>
  <text x="832" y="348" font-size="10.5" text-anchor="middle" fill="#4a5058">unicast back to src_mac</text>

  <!-- ============================ ROW 4: AECP interior ============================ -->
  <rect x="486" y="378" width="456" height="96" rx="8" fill="#faf6ff" stroke="#6b46a5" stroke-width="1.2" stroke-dasharray="6 4"/>
  <text x="714" y="394" font-size="10.5" text-anchor="middle" fill="#6b46a5">inside KL_aecp_engine</text>

  <rect x="498" y="400" width="136" height="62" rx="6" fill="#f3ecfb" stroke="#6b46a5" stroke-width="1.3"/>
  <text x="566" y="422" font-size="11" font-weight="bold" text-anchor="middle" fill="#16181d">KL_aecp_ucpu</text>
  <text x="566" y="438" font-size="10" text-anchor="middle" fill="#4a5058">4-stage F/D/E/W</text>
  <text x="566" y="452" font-size="10" text-anchor="middle" fill="#4a5058">2048 × 48 b µcode</text>

  <rect x="646" y="400" width="136" height="62" rx="6" fill="#f3ecfb" stroke="#6b46a5" stroke-width="1.3"/>
  <text x="714" y="422" font-size="11" font-weight="bold" text-anchor="middle" fill="#16181d">KL_aecp_desc_store</text>
  <text x="714" y="438" font-size="10" text-anchor="middle" fill="#4a5058">index map + one</text>
  <text x="714" y="452" font-size="10" text-anchor="middle" fill="#4a5058">descriptor line buffer</text>

  <rect x="794" y="400" width="136" height="62" rx="6" fill="#f3ecfb" stroke="#6b46a5" stroke-width="1.3"/>
  <text x="862" y="422" font-size="11" font-weight="bold" text-anchor="middle" fill="#16181d">KL_aecp_resp_buf</text>
  <text x="862" y="438" font-size="10" text-anchor="middle" fill="#4a5058">byte writes gathered</text>
  <text x="862" y="452" font-size="10" text-anchor="middle" fill="#4a5058">into 64-bit lanes</text>

  <line x1="832" y1="358" x2="832" y2="374" stroke="#6b46a5" stroke-width="1.6" marker-end="url(#ahm)"/>

  <!-- AECP interior -> main memory -->
  <path d="M942,431 L988,431" fill="none" stroke="#6b46a5" stroke-width="1.6" marker-end="url(#ahm)"/>

  <rect x="994" y="378" width="342" height="96" rx="8" fill="#f6eeff" stroke="#6b46a5" stroke-width="1.5"/>
  <text x="1165" y="402" font-size="12" font-weight="bold" text-anchor="middle" fill="#16181d">integrator main memory</text>
  <text x="1165" y="422" font-size="10.5" text-anchor="middle" fill="#4a5058">desc_mem_* master — READ ONLY, at DESC_BASE_P</text>
  <text x="1165" y="438" font-size="10.5" text-anchor="middle" fill="#4a5058">resp_mem_* master — READ + WRITE, at RESP_BASE_P</text>
  <text x="1165" y="458" font-size="10.5" text-anchor="middle" fill="#a03030">bases are compile-time parameters, not registers</text>

  <!-- ============================ ROW 5: TX slots ============================ -->
  <rect x="24" y="512" width="908" height="58" rx="6" fill="#fdf0e3" stroke="#b5741f" stroke-width="1.3"/>
  <text x="478" y="533" font-size="12" font-weight="bold" text-anchor="middle" fill="#16181d">KL_pp_tx_slots</text>
  <text x="478" y="551" font-size="10.5" text-anchor="middle" fill="#4a5058">4 standard 576-byte slots + 1 oversize 1600-byte slot · random-access writes, so a header may be back-patched after its payload</text>

  <line x1="124" y1="358" x2="124" y2="507" stroke="#2c3038" stroke-width="1.5" marker-end="url(#ah)"/>
  <line x1="360" y1="358" x2="360" y2="507" stroke="#2c3038" stroke-width="1.5" marker-end="url(#ah)"/>
  <line x1="596" y1="358" x2="596" y2="374" stroke="#2c3038" stroke-width="1.5"/>
  <path d="M596,374 L462,374 L462,507" fill="none" stroke="#2c3038" stroke-width="1.5" marker-end="url(#ah)"/>
  <path d="M714,474 L714,507" fill="none" stroke="#6b46a5" stroke-width="1.6" marker-end="url(#ahm)"/>
  <text x="704" y="498" font-size="10.5" text-anchor="end" fill="#6b46a5">AECPDU on TX lane 0</text>

  <!-- SRP -> tx slots, down the gutter between the AECP group and main memory -->
  <path d="M1060,150 L1060,348 L964,348 L964,492 L816,492 L816,507" fill="none" stroke="#2b7a78" stroke-width="1.6" marker-end="url(#ahs)"/>
  <text x="1080" y="340" font-size="10.5" fill="#2b7a78">MRPDU frames on TX lane 4</text>

  <!-- ============================ ROW 6: arbiter ============================ -->
  <rect x="24" y="602" width="440" height="58" rx="6" fill="#fdf0e3" stroke="#b5741f" stroke-width="1.3"/>
  <text x="244" y="623" font-size="12" font-weight="bold" text-anchor="middle" fill="#16181d">KL_pp_tx_arbiter</text>
  <text x="244" y="641" font-size="10.5" text-anchor="middle" fill="#4a5058">6 lanes, frame-atomic grant, 10 ms aging guard</text>

  <rect x="500" y="602" width="200" height="58" rx="6" fill="#fff8ee" stroke="#b5741f" stroke-width="1.2" stroke-dasharray="6 4"/>
  <text x="600" y="623" font-size="11.5" font-weight="bold" text-anchor="middle" fill="#16181d">ACMP header prepend</text>
  <text x="600" y="641" font-size="10.5" text-anchor="middle" fill="#4a5058">14 bytes on lanes 2 and 5</text>

  <rect x="736" y="602" width="196" height="58" rx="6" fill="#eef2f7" stroke="#586376" stroke-width="1.3"/>
  <text x="834" y="625" font-size="12" font-weight="bold" text-anchor="middle" fill="#16181d">MAC trunk TX</text>
  <text x="834" y="643" font-size="10.5" text-anchor="middle" fill="#4a5058">tx_valid/sof/data/eof/ready</text>

  <line x1="244" y1="570" x2="244" y2="597" stroke="#2c3038" stroke-width="1.6" marker-end="url(#ah)"/>
  <line x1="464" y1="631" x2="495" y2="631" stroke="#2c3038" stroke-width="1.6" marker-end="url(#ah)"/>
  <line x1="700" y1="631" x2="731" y2="631" stroke="#2c3038" stroke-width="1.6" marker-end="url(#ah)"/>

  <text x="480" y="592" font-size="10.5" fill="#4a5058">lane 0 AECP solicited · 1 unsolicited (idle) · 2 ACMP listener · 3 ADP · 4 SRP · 5 talker response</text>

  <!-- ============================ ROW 7: services ============================ -->
  <rect x="24" y="690" width="1312" height="76" rx="8" fill="#f4f4f6" stroke="#6b7280" stroke-width="1.2"/>
  <text x="40" y="710" font-size="11.5" font-weight="bold" fill="#16181d">shared services — every engine is a client</text>
  <text x="40" y="731" font-size="10.5" fill="#4a5058">KL_pp_timer_service (1 ms timebase + deadline slots, arm-port priority mux) · KL_pp_prng (one 64-bit LFSR, owner-routed draw port) · KL_pp_scoreboard (nine hazard classes)</text>
  <text x="40" y="750" font-size="10.5" fill="#4a5058">KL_pp_event_router (sticky events) · KL_pp_originator (self-issued commands + inflight) · KL_pp_trace_ring (256 × 128 b) · KL_pp_side_port · KL_acmp_nvm_shadow → KL_pp_nvm_port</text>

  <!-- ============================ ROW 8: external faces ============================ -->
  <rect x="24" y="790" width="1312" height="104" rx="8" fill="#fff6e5" stroke="#a06400" stroke-width="1.2"/>
  <text x="40" y="810" font-size="11.5" font-weight="bold" fill="#16181d">other faces the top publishes to the integrating fabric — see the integrator guide</text>
  <text x="40" y="831" font-size="10.5" fill="#4a5058">host_* side port (six windows) · nvm_dev_* device face · svc_* SRP service face · maap_* allocation face (the allocator itself lives OUTSIDE this repository)</text>
  <text x="40" y="850" font-size="10.5" fill="#4a5058">class-D status wires read every clock: acmp_declaring_o, acmp_bound_o + bound stream identity, srp_active_o, srp_granted_slope_bps_o, adp_next_avail_index_o</text>
  <text x="40" y="874" font-size="10.5" fill="#a03030">Tying a face off is legal by design: every one of them is watchdog-bounded and degrades to an honest answer instead of wedging the plane.</text>
</svg>
