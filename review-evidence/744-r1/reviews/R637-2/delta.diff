+        'kib="$(awk \'$1 == "MemTotal:" && $3 == "kB" { print $2 }\' /proc/meminfo)"',
+        'cgroup="/sys/fs/cgroup$(sed -n \'s/^0:://p\' /proc/self/cgroup)"',
+        '  if [ "$cgroup" = /sys/fs/cgroup ]; then break; fi',
+    ),
+    ".github/workflows/rtl-fast.yml": (
