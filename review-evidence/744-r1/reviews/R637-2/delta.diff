+        '        ("low 0\\nmax 0\\noom 0\\noom_kill 0\\n", "proc /proc proc rw 0 0\\n",',
+        '         "no cgroup2 hierarchy at the cgroup root", "0 cgroup2 mount(s) at /sys/fs/cgroup"),',
+    ),
