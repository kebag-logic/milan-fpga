+def rom_digest(directory: Path) -> str:
+    """Bind exact names and generated bytes in fixed lexical order.
+
+    Each name ends in NUL, followed by an eight-byte big-endian content
+    length and those bytes. Paths, directory order and timestamps are absent.
+    """
+    digest = hashlib.sha256()
+    for name in ROM_IMAGES:
+        content = (directory / name).read_bytes()
+        if not content:
+            raise ValueError(f"generated ROM is empty: {name}")
+        digest.update(name.encode("ascii") + b"\0")
+        digest.update(len(content).to_bytes(8, "big"))
+        digest.update(content)
+    return digest.hexdigest()
+
