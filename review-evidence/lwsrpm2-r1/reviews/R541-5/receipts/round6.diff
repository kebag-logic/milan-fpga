+            assert_that(seen.retained, is_equal_to(1));
+            allocation_fail_after(fault);
+            tick(1);
+            assert_that(allocation_failures(), is_equal_to(1));
+            assert_that(seen.retained, is_equal_to(1));
+            allocation_fail_after(0);
+            if (receive) {
+                assert_that(mrp_rx(a, 0, pdu, len), is_equal_to(0));
