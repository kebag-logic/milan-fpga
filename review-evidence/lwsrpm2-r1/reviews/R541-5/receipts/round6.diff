+static struct mrp_app *ordered_bridge(void)
+{
+    struct mrp_app *base = stream_bridge();
+    struct mrp_app_ops ops = *base->ops;
+    ops.join_ind = ordered_join; ops.leave_ind = ordered_leave;
+    mrp_app_destroy(base);
