{
  "configure": [
    "cmake",
    "-S",
    "$SOURCE",
    "-B",
    "$PACKET/scratch/sanitized",
    "-DCMAKE_PREFIX_PATH=$PACKET/scratch/deps",
    "-DLWSRP_MILAN=ON",
    "-DCMAKE_C_FLAGS=-fsanitize=address,undefined -fno-omit-frame-pointer -g"
  ],
  "build": [
    "make",
    "-C",
    "$PACKET/scratch/sanitized",
    "-j16"
  ],
  "run": [
    "$PACKET/scratch/sanitized/unit_tests"
  ],
  "environment": {
    "ASAN_OPTIONS": "detect_leaks=1",
    "LD_LIBRARY_PATH": "$PACKET/scratch/deps/lib"
  },
  "return_codes": [
    0,
    0,
    0
  ]
}
