+        }
+    }
+    if (la) {
+        ps->la = MRP_LA_STATE_PASSIVE;
+        // 10.7.6.6: the committed sLA also signals rLA locally.
+        broadcast_event(app, ps, MRP_EVENT_RLA, port_id);
