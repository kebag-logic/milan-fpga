 planted mutant.\n3. Run this repository's gates. Run the milan-fpga consumer gates on a scratch parent at dev e9cbb676, with the gptp-processor gitlink set to your head.\n4. STOP on any interface or parameter change seen by the parent.\n\nPost REVIEW READY or STOP here.\n","author_association":"OWNER","pin":null,"reactions":{"url":"https://api.github.com/repos/Mister-M-alt/FPGA-gPTP/issues/comments/6249575055/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Mister-M-alt/FPGA-gPTP/issues/comments/6249586531","html_url":"https://github.com/Mister-M-alt/FPGA-gPTP/issues/82#issuecomment-6249586531","issue_url":"https://api.github.com/repos/Mister-M-alt/FPGA-gPTP/issues/82","id":6249586531,"node_id":"IC_kwDOT4nUSs8AAAABdIEfYw","user":{"login":"Mister-M-alt","id":161579364,"node_id":"U_kgDOCaGBZA","avatar_url":"https://avatars.githubusercontent.com/u/161579364?v=4","gravatar_id":"","url":"https://api.github.com/users/Mister-M-alt","html_url":"https://github.com/Mister-M-alt","followers_url":"https://api.github.com/users/Mister-M-alt/followers","following_url":"https://api.github.com/users/Mister-M-alt/following{/other_user}","gists_url":"https://api.github.com/users/Mister-M-alt/gists{/gist_id}","starred_url":"https://api.github.com/users/Mister-M-alt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mister-M-alt/subscriptions","organizations_url":"https://api.github.com/users/Mister-M-alt/orgs","repos_url":"https://api.github.com/users/Mister-M-alt/repos","events_url":"https://api.github.com/users/Mister-M-alt/events{/privacy}","received_events_url":"https://api.github.com/users/Mister-M-alt/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-18T11:52:32Z","updated_at":"2026-10-18T11:52:32Z","body":"[A649] TAKEN","author_association":"OWNER","pin":null,"react