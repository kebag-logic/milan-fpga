+    const uint64_t HOPD = 0x0082D0FFFE000002ull;
+    const uint64_t SRCD = 0x0082D0FFFE000003ull;
+    const uint64_t GME = 0x0082E0FFFE000001ull;
+    const uint64_t SRCE = 0x0082E0FFFE000002ull;
