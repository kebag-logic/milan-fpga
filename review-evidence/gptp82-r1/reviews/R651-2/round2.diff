+      if (!fell && !(commit_snaps[i].flags & FL_ASCAP)) fell = &commit_snaps[i];
+      if (fell && !self && commit_snaps[i].gm == OUR_CID) self = &commit_snaps[i];
+    }
+    if (fell && self)
