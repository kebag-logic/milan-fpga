+  void probe_warm_reset_with_a_retained_record() {
+    const uint64_t GMA = 0x0065A0FFFE0000A1ull, SRCA = 0x0065A0FFFE0000A3ull;
+    const uint64_t GMB = 0x0065A0FFFE0000B1ull, SRCB = 0x0065A0FFFE0000B3ull;
+    pd_mode = PD_NORMAL;
+    wait_flags(FL_ASCAP, FL_ASCAP, 9000000);
+    size_t m = commit_snaps.size();
+    send_announce(0x6501, 0, GMA, 1, SRCA, {GMA, SRCA}, phc() + 100);
+    printf("PROBE-WARM A announce: %zu commits, last gm %016llx count %u\n", commit_snaps.size() - m, commit_snaps.size() > m ? (unsigned long long)commit_snaps.back().gm : 0ull, commit_snaps.size() > m ? commit_snaps.back().count : 0);
+    expect("PROBE-WARM peer A elected", commit_snaps.size() > m ? commit_snaps.back().gm : 0, GMA);
+    m = commit_snaps.size();
+    warm_reset();
+    printf("PROBE-WARM after warm reset: %zu commits, first gm %016llx count %u\n", commit_snaps.size() - m, commit_snaps.size() > m ? (unsigned long long)commit_snaps[m].gm : 0ull, commit_snaps.size() > m ? commit_snaps[m].count : 0);
+    expect("PROBE-WARM warm reset publishes thisClock", commit_snaps.size() > m ? commit_snaps[m].gm : 0, OUR_CID);
+    wait_flags(FL_ASCAP, FL_ASCAP, 9000000);
+    m = commit_snaps.size();
+    send_announce(0x6502, 1, GMB, 1, SRCB, {GMB, SRCB}, phc() + 100);
+    const uint64_t got = commit_snaps.size() > m ? commit_snaps.back().gm : 0;
+    printf("PROBE-WARM B announce after reset: %zu commits, last gm %016llx (A=%016llx B=%016llx self=%016llx) parent %016llx count %u flags %x\n", commit_snaps.size() - m, (unsigned long long)got, (unsigned long long)GMA, (unsigned long long)GMB, (unsigned long long)OUR_CID, commit_snaps.size() > m ? (unsigned long long)commit_snaps.back().parent : 0ull, commit_snaps.size() > m ? commit_snaps.back().count : 0, commit_snaps.size() > m ? commit_snaps.back().flags : 0);
+    for (int beat = 0; beat < 3; beat++) {
