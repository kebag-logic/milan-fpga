+  d->ev_cmd_type_i = 0x0005;
+  d->ev_cmd_index_i = 1;
+  d->ev_cmd_arg0_i = 2;
+  d->ev_cmd_arg1_i = 3;
+  d->ev_cmd_excl_eid_i = EID_R;
+  d->ev_cmd_i = 1;
+  tick();
+  d->ev_cmd_i = 0;
+  ++now;
+  const UnsJob c1 = job_presented(now + WALK_MS);
+  d->ca_fail_owner_i = 0;                   // C's retry fails now
+  d->ca_fail_valid_i = 1;
