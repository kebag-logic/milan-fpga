read_verilog -sv <scratch>/r5fifo/gold.sv
read_verilog -sv <scratch>/r5fifo/gate.sv
chparam -set WIDTH 52 -set LOG2D 3 gold_fifo
chparam -set WIDTH 52 -set LOG2D 3 gate_fifo
proc; opt_clean; memory -nomap; memory_map; opt -full; flatten
rename gold_fifo gold
rename gate_fifo gate
equiv_make gold gate equiv
hierarchy -top equiv
equiv_simple -seq 5
equiv_induct -seq 5
equiv_status -assert
