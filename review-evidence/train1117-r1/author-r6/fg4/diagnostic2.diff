+// DIAGNOSTIC (F-G4): one read frame at any address, on the armed poll's bus at its bit period. The console runs
+// between the poll's calls, and a call takes whole frames, so the bus is idle here.
+int32_t ctrl_plat_phy_diag_read(uint32_t address, uint32_t reg)
+{
+	const struct ctrl_plat_phy *p = diag.phy;
+	if (p == NULL || p->clock == NULL) {
+		return -2;
+	}
+	const uint32_t lo = (CTRL_PLAT_PHY_READ_OP << 10 | (address & 31u) << 5 | (reg & 31u))
+			    << (32u - CTRL_PLAT_PHY_COMMAND_BITS);
+	return frame(p, lo, CTRL_PLAT_PHY_PREAMBLE_BITS + CTRL_PLAT_PHY_COMMAND_BITS);
+}
