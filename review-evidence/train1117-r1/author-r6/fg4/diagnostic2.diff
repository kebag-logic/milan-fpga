+// DIAGNOSTIC (F-G4): the PHY poll's state, one line (ctrl_plat_phy.c, ctrl_plat_phy_diag_words). The accessor is
+// weak, so a build without the PHY poll prints PHY=none. Registers read as fffffffe were never read; ffffffff is an
+// unacknowledged read.
+extern unsigned ctrl_plat_phy_diag_words(uint32_t *w) __attribute__((weak));
+
+static void phy_report(struct ctrl_plat_console *c)
+{
+	static const char *const label[] = {"PHY_ARMED=", " FOUND=", " ADDR=", " STAGE=", " ADV=", " RENEG=", " POLLS=",
+					    " WRITES=", " RESTARTS=", " LINK=", " R4_BEFORE=", " R9_BEFORE=", " R4=",
+					    " R9=", " R9_NOW=", " R4_NOW=", " R0=", " SPIN=", " R10_NOW="};
+	uint32_t w[sizeof label / sizeof label[0]];
+	const unsigned n = ctrl_plat_phy_diag_words != NULL ? ctrl_plat_phy_diag_words(w) : 0u;
+	if (n != sizeof label / sizeof label[0]) {
+		ctrl_plat_console_puts(c, "PHY=none\r\n");
+		return;
+	}
+	for (unsigned k = 0; k < n; ++k) {
+		if ((k >= 9u && k <= 16u) || k == 18u) {
+			field(c, label[k], w[k]);
+		} else {
+			count(c, label[k], w[k]);
+		}
+	}
+	ctrl_plat_console_puts(c, "\r\n");
+}
+
+// DIAGNOSTIC (F-G4): which addresses on the poll's MDIO bus answer, and their registers. MDIO_ACK has bit n set where
+// address n acknowledged a PHYID1 read. Then one line each for addresses 0 and 1 and the first two others that
+// answered: registers 0 to 6, 9, 10, 15, 17 and 31, ffffffff unacknowledged. The reads block for about 12 ms; register
+// 1's read clears its latched link-down bit, and register 10's its fault bit.
+extern int32_t ctrl_plat_phy_diag_read(uint32_t address, uint32_t reg) __attribute__((weak));
+
+static void mdio_report(struct ctrl_plat_console *c)
+{
+	static const uint8_t reg[] = {0u, 1u, 2u, 3u, 4u, 5u, 6u, 9u, 10u, 15u, 17u, 31u};
+	if (ctrl_plat_phy_diag_read == NULL || ctrl_plat_phy_diag_read(0u, 2u) == -2) {
+		ctrl_plat_console_puts(c, "MDIO=none\r\n");
+		return;
+	}
+	uint32_t ack = 0u;
+	for (uint32_t a = 0; a < 32u; ++a) {
+		ack |= ctrl_plat_phy_diag_read(a, 2u) >= 0 ? 1u << a : 0u;
+	}
+	field(c, "MDIO_ACK=", ack);
+	ctrl_plat_console_puts(c, "\r\n");
+	unsigned lines = 0u;
+	for (uint32_t a = 0; a < 32u && lines < 4u; ++a) {
+		if (a > 1u && (ack & 1u << a) == 0u) {
+			continue;
+		}
+		++lines;
+		count(c, "A=", a);
+		for (unsigned k = 0; k < sizeof reg; ++k) {
+			count(c, " R", reg[k]);
+			field(c, "=", (uint32_t)ctrl_plat_phy_diag_read(a, reg[k]));
+		}
+		ctrl_plat_console_puts(c, "\r\n");
+	}
+}
