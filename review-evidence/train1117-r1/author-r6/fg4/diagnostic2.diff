+// DIAGNOSTIC (F-G4): milan_phy's words, in its order (ctrl_plat_console.c), or 0 words before a poll was armed
+unsigned ctrl_plat_phy_diag_words(uint32_t *w)
+{
+	const struct ctrl_plat_phy *p = diag.phy;
+	if (p == NULL) {
+		return 0u;
+	}
+	const uint32_t words[] = {p->clock != NULL ? 1u : 0u, p->found ? 1u : 0u, p->address, p->stage, p->adv,
+				  p->renegotiations, diag.polls, diag.writes, diag.restarts, p->published,
+				  (uint32_t)diag.before_local, (uint32_t)diag.before_gig, (uint32_t)diag.check_local,
+				  (uint32_t)diag.check_gig, (uint32_t)diag.now_gig, (uint32_t)diag.now_local,
+				  (uint32_t)diag.control, p->spin, (uint32_t)diag.peer_gig};
+	memcpy(w, words, sizeof words);
+	return (unsigned)(sizeof words / sizeof words[0]);
+}
