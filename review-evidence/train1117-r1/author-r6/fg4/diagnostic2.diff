+// DIAGNOSTIC (F-G4): the poll's counters for milan_phy (ctrl_plat_phy.h)
+static struct ctrl_plat_phy_diag diag = {NULL, 0u, 0u, 0u, -2, -2, -2, -2, -2, -2, -2, -2};
