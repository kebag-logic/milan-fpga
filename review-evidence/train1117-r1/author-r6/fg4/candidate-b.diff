 }
 
+TEST_F(Phy, B13APollAPeriodLateTakesItsFrameThroughASave) {
+    // F-G4 liveness: under input that leaves no pass empty, THE STEP runs only aged, so every call owes the store a
+    // centisecond's step, and a save's steps leave the PHY no room in such a call. Through a save behind a 600 ms
+    // erase, a link loss must still be published within two poll periods, as the release's bound allows.
+    nvm_fmodel_times(600000u, 2000u);
+    ASSERT_EQ(ctrl_plat_boot(&env), CTRL_PLAT_READY);
+    run(kFirstPollMs);
+    ASSERT_EQ(peer.word, kGigFull);
+    ASSERT_EQ(nvm_store_commit_now(), 1) << "a save in flight";
+    peer.link(false);
+    peer.latched_down = true;
+    const std::uint64_t lost = nvm_fmodel_now_us();
+    std::uint64_t down_at = 0;
+    bool saving = true;
+    for (unsigned k = 0; k < 300u && down_at == 0u; ++k) {   // 3 s of calls, one each 10 ms, each owing a step
+        nvm_fmodel_advance_us(10000u);
+        nvm_store_tick();
+        (void)ctrl_plat_phy_store_step(&ctrl_plat.phy, nvm_store_clock(nullptr) + CTRL_LOOP_SHARE_US);
+        if (peer.word == 0u) {
+            down_at = nvm_fmodel_now_us();
+            saving = nvm_store_status()->phase != NVM_P_IDLE;
+        }
+    }
+    ASSERT_NE(down_at, 0u) << "B13 the loss is published";
+    EXPECT_LE(down_at - lost, 2u * CTRL_PLAT_PHY_POLL_US + 20000u)
+        << "B13 a loss published within two poll periods through a save";
+    EXPECT_TRUE(saving) << "B13 the save still in flight when the loss was published (the case this holds)";
+    EXPECT_TRUE(peer.fault.empty()) << peer.fault;
+}
