diff --git a/sw/firmware/ctrl/plat/ctrl_plat_phy.c b/sw/firmware/ctrl/plat/ctrl_plat_phy.c
index e9524b89f4..4288d6f97f 100644
--- a/sw/firmware/ctrl/plat/ctrl_plat_phy.c
+++ b/sw/firmware/ctrl/plat/ctrl_plat_phy.c
@@ -323,6 +323,17 @@ bool ctrl_plat_phy_step(struct ctrl_plat_phy *phy, int32_t room)
 _Static_assert(NVM_P_OFF < NVM_P_CAPTURE && NVM_P_IDLE < NVM_P_CAPTURE && NVM_P_HELD > NVM_P_VERIFY &&
 	       NVM_P_VERIFY - NVM_P_CAPTURE == 7, "a save's phases are CAPTURE to VERIFY, and only they");
 
+// LIVENESS (F-G4): a frame owed by a poll a whole period late: one in progress since a period ago, or one idle and
+// due since a period ago (its last start two periods back)
+static bool overdue(const struct ctrl_plat_phy *phy)
+{
+	if (!owes(phy)) {
+		return false;
+	}
+	const uint32_t late = (uint32_t)phy->clock(phy->ctx) - phy->started;
+	return phy->polled && late >= (phy->stage != CTRL_PLAT_PHY_IDLE ? 1u : 2u) * CTRL_PLAT_PHY_POLL_US;
+}
+
 bool ctrl_plat_phy_store_step(void *ctx, uint32_t deadline)
 {
 	// a call that owes no centisecond's step and a frame owed: the frame, and the store's extra step (#920) waits
@@ -330,6 +341,14 @@ bool ctrl_plat_phy_store_step(void *ctx, uint32_t deadline)
 	if (!nvm_store_owed() && owes(ctx)) {
 		return ctrl_plat_phy_step(ctx, (int32_t)(deadline - nvm_store_clock(NULL)));
 	}
+	// LIVENESS (F-G4): under input that leaves no pass empty THE STEP runs only aged, so every call owes the store a
+	// centisecond's step, and a save's steps would hold the poll for the save's length (an erase alone is up to
+	// seconds). A poll a whole period late takes this call's frame instead; the store's owed step waits for the
+	// next call, so still no call carries a save's step and a frame
+	if (overdue(ctx)) {
+		(void)ctrl_plat_phy_step(ctx, (int32_t)(deadline - nvm_store_clock(NULL)));
+		return true;
+	}
 	const struct nvm_status *s = nvm_store_status();
 	const uint32_t steps = s->steps;
 	const bool saving = (uint32_t)s->phase - NVM_P_CAPTURE <= (uint32_t)(NVM_P_VERIFY - NVM_P_CAPTURE);
