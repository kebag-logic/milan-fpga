 	} else if (is(c, "milan_gettime")) {
 		tod(c);
 		++c->commands;
+	} else if (is(c, "milan_phy")) {
+		phy_report(c);
+		++c->commands;
 	} else {
 		ctrl_plat_console_puts(c, "?\r\n");
 		++c->refused;
