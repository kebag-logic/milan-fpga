+// DIAGNOSTIC (F-G4, a bench image, not the train's): the poll last armed and its counters since then, which the
+// console's milan_phy prints. Registers read as -2 were never read; -1 is an unacknowledged read.
+struct ctrl_plat_phy_diag {
+	const struct ctrl_plat_phy *phy;   // the poll armed last, NULL before
+	uint32_t polls;                    // polls started
+	uint32_t writes;                   // the advertisement's write frames taken (9, 4, 0)
+	uint32_t restarts;                 // of them, register 0's (the restart)
+	int32_t before_local, before_gig;  // registers 4 and 9 as read before the writes
+	int32_t check_local, check_gig;    // registers 4 and 9 as read back after them
+	int32_t now_gig, now_local;        // registers 9 and 4 as the latest poll's resolution read them
+	int32_t control;                   // register 0 as read before the restart
+};
+const struct ctrl_plat_phy_diag *ctrl_plat_phy_diag(void);
+// milan_phy's 18 words into `w`, in the console's order; 0 before a poll was armed.
+unsigned ctrl_plat_phy_diag_words(uint32_t *w);
+
 #ifdef __cplusplus
 }
 #endif
