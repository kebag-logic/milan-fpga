+	} else if (stage == CTRL_PLAT_PHY_ADV_CHECK_GIG) {
+		diag.check_gig = v;
+	} else if (stage == CTRL_PLAT_PHY_GIG_LOCAL) {
+		diag.now_gig = v;
+	} else if (stage == CTRL_PLAT_PHY_LOCAL) {
+		diag.now_local = v;
+	} else if (stage == CTRL_PLAT_PHY_ADV_CONTROL) {
+		diag.control = v;
