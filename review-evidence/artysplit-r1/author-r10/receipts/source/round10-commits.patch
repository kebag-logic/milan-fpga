diff --git a/tb/verilator/ctrl_service_budget/egress_fixed.py b/tb/verilator/ctrl_service_budget/egress_fixed.py
new file mode 100644
index 000000000..88a75eb95
--- /dev/null
+++ b/tb/verilator/ctrl_service_budget/egress_fixed.py
@@ -0,0 +1,64 @@
+# SPDX-FileCopyrightText: 2026 Kebag Logic
+# SPDX-License-Identifier: CERN-OHL-W-2.0
+"""Measure the 100 Mb/s egress row's fixed path on the converted MII chain, and hold egress_mii.MII_FIXED_NS to it.
+
+egress_fixed_main.cpp sends one frame at a time through tb/verilator/gptp_txts/generated/mac_tx_chain_mii.v, the
+shipping MAC transmit chain on the board's MII stages as sw/litex/gen_mac_tx_model.py converts it, and prints for
+each length and each of 8 x 8 clock phases the chain's latency from its boundary's last beat to the last nibble at
+its pads, less the frame's wire time. The stated figure is the largest, rounded up to 10 ns; the run exits 1 unless
+MII_FIXED_NS is exactly that.
+
+usage: python3 -I egress_fixed.py BUILD_DIR
+"""
+
+from __future__ import annotations
+
+import subprocess
+import sys
+from pathlib import Path
+
+import egress_mii
+
+HERE = Path(__file__).resolve().parent
+CHAIN = HERE.parents[1] / 'verilator/gptp_txts/generated/mac_tx_chain_mii.v'
+#: The least frame, one under it the padding covers, the SR stream's, gPTP's longest, an odd length, the largest.
+LENGTHS = (14, 60, 64, 90, 127, 512, 1514)
+
+
+def build(build_dir: Path) -> Path:
+    """Verilate the converted chain with the bench; the executable."""
+    build_dir.mkdir(parents=True, exist_ok=True)
+    subprocess.run(['verilator', '--cc', '--exe', '--build', '-O3', '-Wno-fatal', '--top-module', 'mac_tx_chain_mii',
+                    '--Mdir', str(build_dir), '-CFLAGS', '-O2 -std=c++17', str(CHAIN),
+                    str(HERE / 'egress_fixed_main.cpp'), '-o', 'Vmac_tx_chain_mii'],
+                   check=True, stdout=subprocess.DEVNULL)
+    return build_dir / 'Vmac_tx_chain_mii'
+
+
+def measured(binary: Path) -> dict[int, int]:
+    """The largest fixed path at each length, ps."""
+    out: dict[int, int] = {}
+    text = subprocess.run([str(binary), *map(str, LENGTHS)], check=True, capture_output=True, text=True).stdout
+    for line in text.splitlines():
+        _, length, _, _, ps = line.split()
+        out[int(length)] = max(out.get(int(length), 0), int(ps))
+    return out
+
+
+def main(argv: list[str]) -> int:
+    """Build, measure and compare with the stated figure."""
+    if len(argv) != 1:
+        print(__doc__)
+        return 2
+    worst = measured(build(Path(argv[0])))
+    for length, ps in sorted(worst.items()):
+        print(f'length {length}: fixed path at most {ps / 1000:.1f} ns over 64 clock phases')
+    stated = -(-max(worst.values()) // 10_000) * 10
+    ok = stated == egress_mii.MII_FIXED_NS
+    print(f'{"PASS" if ok else "FAIL"}: the most is {max(worst.values()) / 1000:.1f} ns, stated {stated} ns; '
+          f'egress_mii.MII_FIXED_NS is {egress_mii.MII_FIXED_NS} ns')
+    return int(not ok)
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv[1:]))
diff --git a/tb/verilator/ctrl_service_budget/egress_fixed_main.cpp b/tb/verilator/ctrl_service_budget/egress_fixed_main.cpp
new file mode 100644
index 000000000..e890d0032
--- /dev/null
+++ b/tb/verilator/ctrl_service_budget/egress_fixed_main.cpp
@@ -0,0 +1,139 @@
+// SPDX-FileCopyrightText: 2026 Kebag Logic
+// SPDX-License-Identifier: CERN-OHL-W-2.0
+//
+// The fixed path of the 100 Mb/s egress row (egress_mii.py, MII_FIXED_NS): one frame at a time through the CONVERTED
+// MII transmit chain (tb/verilator/gptp_txts/generated/mac_tx_chain_mii.v, sw/litex/gen_mac_tx_model.py), from the
+// last beat its datapath boundary accepts to the last nibble at its pads, less that frame's wire time. The chain is
+// otherwise idle, so nothing queues: what is left is its crossing, the store-and-forward FIFO's release, the MAC
+// core's pipeline and crossing, and the PHY stage. The clocks are the Arty point's, 80 MHz sys, 50 MHz datapath and
+// the 25 MHz MII transmit clock, each phase of the datapath and wire clocks against sys swept.
+//
+// Usage: Vmac_tx_chain_mii <length>...   One line per length and phase: `FIXED <length> <dp> <eth> <ps>`.
+#include "Vmac_tx_chain_mii.h"
+#include "verilated.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <vector>
+
+namespace {
+
+constexpr std::uint64_t kSysPs = 12500;
+constexpr std::uint64_t kDpPs = 20000;
+constexpr std::uint64_t kEthPs = 40000;
+constexpr std::uint64_t kOctetPs = 80000;
+constexpr unsigned kPhases = 8;
+
+// One run: reset, settle, one frame of `len` bytes at the boundary, and the chain's own latency.
+class Run {
+ public:
+    Run(std::uint64_t dp_offset, std::uint64_t eth_offset)
+        : dut_(std::make_unique<Vmac_tx_chain_mii>()), dp_next_(dp_offset + kDpPs / 2),
+          eth_next_(eth_offset + kEthPs / 2) {}
+
+    std::uint64_t fixed(std::size_t len);
+
+ private:
+    std::unique_ptr<Vmac_tx_chain_mii> dut_;
+    std::uint64_t now_ = 0;
+    std::uint64_t sys_next_ = kSysPs / 2;
+    std::uint64_t dp_next_;
+    std::uint64_t eth_next_;
+    std::size_t pos_ = 0;
+    std::size_t len_ = 0;
+    bool armed_ = false;
+    std::uint64_t last_beat_ = 0;
+    std::uint64_t last_nibble_ = 0;
+
+    void step();
+    void drive();
+};
+
+void Run::step() {
+    now_ = std::min({sys_next_, dp_next_, eth_next_});
+    const bool dp_rise = dp_next_ == now_ && dut_->dp_clk == 0;
+    const bool dp_fall = dp_next_ == now_ && dut_->dp_clk != 0;
+    const bool eth_rise = eth_next_ == now_ && dut_->eth_tx_clk == 0;
+    const bool accepted = dp_rise && dut_->dp_tvalid != 0 && dut_->dp_tready != 0;
+    const bool last = accepted && dut_->dp_tlast != 0;
+    if (sys_next_ == now_) {
+        dut_->sys_clk = !dut_->sys_clk;
+        sys_next_ += kSysPs / 2;
+    }
+    if (dp_next_ == now_) {
+        dut_->dp_clk = !dut_->dp_clk;
+        dp_next_ += kDpPs / 2;
+    }
+    if (eth_next_ == now_) {
+        dut_->eth_tx_clk = !dut_->eth_tx_clk;
+        dut_->eth_rx_clk = dut_->eth_tx_clk;
+        eth_next_ += kEthPs / 2;
+    }
+    dut_->eval();
+    if (accepted) pos_ += 8;
+    if (last) last_beat_ = now_;
+    if (dp_fall) drive();
+    dut_->eval();
+    if (eth_rise && dut_->gmii_tx_en != 0) last_nibble_ = now_;
+}
+
+void Run::drive() {
+    const bool on = armed_ && pos_ < len_;
+    dut_->dp_tvalid = on;
+    dut_->dp_tlast = on && pos_ + 8 >= len_;
+    dut_->dp_tkeep = 0;
+    dut_->dp_tdata = 0;
+    if (!on) return;
+    for (std::size_t i = 0; i < 8 && pos_ + i < len_; ++i) dut_->dp_tkeep |= 1u << i;
+    dut_->dp_tdata = pos_ == 0 ? 0x0000554433221102ULL : 0xa5a5a5a5a5a5a5a5ULL;
+}
+
+std::uint64_t Run::fixed(std::size_t len) {
+    dut_->sys_rst = 1;
+    dut_->dp_rst = 1;
+    dut_->eth_phy_rst = 1;
+    dut_->reinit = 0;
+    dut_->eth_rst = 0;
+    dut_->loopback = 0;
+    while (now_ < 400000) step();
+    dut_->sys_rst = 0;
+    dut_->dp_rst = 0;
+    dut_->eth_phy_rst = 0;
+    while (now_ < 800000) step();
+    len_ = len;
+    armed_ = true;
+    const std::uint64_t wire = (8 + std::max<std::size_t>(len, 60) + 4) * kOctetPs;
+    while (now_ < 800000 + 4 * wire + 20000000) step();
+    if (last_beat_ == 0 || last_nibble_ <= last_beat_) {
+        std::fprintf(stderr, "length %zu: no frame on the pads\n", len);
+        std::exit(1);
+    }
+    return last_nibble_ + kEthPs - last_beat_ - wire;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    Verilated::commandArgs(argc, argv);
+    std::vector<std::size_t> lengths;
+    for (int i = 1; i < argc; ++i) {
+        if (argv[i][0] != '+') lengths.push_back(std::strtoul(argv[i], nullptr, 10));
+    }
+    if (lengths.empty()) {
+        std::fprintf(stderr, "usage: %s <length>...\n", argv[0]);
+        return 2;
+    }
+    for (const std::size_t len : lengths) {
+        for (unsigned d = 0; d < kPhases; ++d) {
+            for (unsigned e = 0; e < kPhases; ++e) {
+                Run run(d * kDpPs / kPhases, e * kEthPs / kPhases);
+                std::printf("FIXED %zu %u %u %llu\n", len, d, e,
+                            static_cast<unsigned long long>(run.fixed(len)));
+            }
+        }
+    }
+    return 0;
+}
