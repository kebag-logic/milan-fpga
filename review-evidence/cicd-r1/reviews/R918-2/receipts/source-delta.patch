@@ -35,13 +35,15 @@ SRCS = $(RTL_DIR)/ieee1722/avtp/avtp_subtype_pkg.sv $(METER_RTL) \
 # The servo with the meter in front of it (sim_servo.cpp): the servo at its
 # silicon loop parameters, TICK_CYC the one value for the RTL's 1 ms tick at
 # the harness's 24.576 MHz / 32 audio clock and for the harness itself.
-# --public-flat-rw: the harness reads the servo's tick divider (to run clk_i
+# probes.vlt: the harness reads the servo's tick divider (to run clk_i
 # fine around each tick) and its window error; it writes nothing through it.
+# probes.vlt keeps exactly those signals public, in place of --public-flat-rw,
+# which kept every signal unoptimised.
 TICK_CYC   ?= 768
 SERVO_RTL  ?= $(RTL_DIR)/ieee1722/crf/KL_mmcm_drp_servo.sv
 SERVO_MDIR ?= obj_servo
 SERVO_FLAGS = --cc --exe --build -j $(VERILATOR_JOBS) --top-module meter_servo_wrap \
-         --public-flat-rw -GTICK_CYC_P=$(TICK_CYC) \
+         probes.vlt -GTICK_CYC_P=$(TICK_CYC) \
          -Wall -Wno-fatal -Werror-UNDRIVEN -Wno-DECLFILENAME -Wno-UNUSEDSIGNAL \
          -Wno-WIDTHEXPAND -Wno-WIDTHTRUNC -Wno-UNUSEDPARAM -Wno-PINCONNECTEMPTY \
          -Wno-EOFNEWLINE \
diff --git a/tb/verilator/aaf_clock_meter/probes.vlt b/tb/verilator/aaf_clock_meter/probes.vlt
new file mode 100644
index 0000000000..f3931d8091
--- /dev/null
+++ b/tb/verilator/aaf_clock_meter/probes.vlt
@@ -0,0 +1,13 @@
+// SPDX-FileCopyrightText: 2026 Kebag Logic
+// SPDX-License-Identifier: CERN-OHL-W-2.0
+// The internal signals the harnesses touch, and only those (in place of
+// --public-flat-rw, see the Makefile). sim_main.cpp and sim_servo.cpp read them; nothing is driven.
+// A signal missing here still compiles (Verilator keeps it in the root
+// structure, unoptimised or not), so every internal name the harnesses use
+// must be listed.
+`verilator_config
+public_flat_rd -module "KL_aaf_clock_meter" -var "g5_v_r"
+public_flat_rd -module "KL_mmcm_drp_servo" -var "tick_div_r"
+public_flat_rd -module "KL_mmcm_drp_servo" -var "pp_seq_r"
+public_flat_rd -module "KL_mmcm_drp_servo" -var "pp_run_r"
+public_flat_rd -module "KL_mmcm_drp_servo" -var "ew_r"
diff --git a/tb/verilator/crf_rx/Makefile b/tb/verilator/crf_rx/Makefile
index ffeb2497c4..e233f3afe3 100644
--- a/tb/verilator/crf_rx/Makefile
+++ b/tb/verilator/crf_rx/Makefile
@@ -31,12 +31,15 @@ VERILATOR ?= verilator
 RTL_DIR    = ../../../hdl
 TOP        = KL_crf_rx
 
-# --public-flat-rw: the [G1] wrap cases preload the counter flops at their
-# old wrap/peg points (65534, 254) instead of simulating 18 h of soak; the
-# flag keeps every signal writable (and un-localized) from the harness.
+# probes.vlt: the [G1] wrap cases preload the counter flops at their
+# old wrap/peg points (65534, 254) instead of simulating 18 h of soak, and
+# the harnesses read a few internal registers; probes.vlt keeps exactly those
+# signals public and writable. --public-flat-rw did that for every signal and
+# so kept Verilator from optimising any of them (talker_step: twice the
+# instructions for a byte-identical log).
 VFLAGS = --cc --exe --build -j 0 \
          --top-module $(TOP) \
-         --public-flat-rw \
+         probes.vlt \
          -GCLK_FREQ_HZ_P=200000 \
          -GIVAL_CYC_P=$(IVAL_CYC) \
          -GMAXTT_NS_P=$(MAXTT_NS) -GEARLY_MARGIN_NS_P=$(EARLY_M_NS) \
@@ -73,7 +76,7 @@ discontinuity-build:
 	$(VERILATOR) $(VFLAGS) -Mdir $(DISC_MDIR) $(SRCS) sim_discontinuity.cpp -o Vdiscontinuity
 
 talker_step:
-	$(VERILATOR) --cc --exe --build -j 4 --public-flat-rw \
+	$(VERILATOR) --cc --exe --build -j 4 probes.vlt \
 	  --top-module crf_talker_wrap -Mdir obj_talker \
 	  -Wall -Wno-fatal -Wno-UNUSEDSIGNAL -Wno-UNUSEDPARAM -Wno-PINCONNECTEMPTY \
 	  -CFLAGS "-std=c++17 -O2 -Wall -Wextra" \
