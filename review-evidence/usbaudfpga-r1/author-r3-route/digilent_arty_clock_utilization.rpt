# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y4 [get_cells BUFG_8]
set_property LOC BUFGCTRL_X0Y2 [get_cells BUFG_9]
set_property LOC BUFGCTRL_X0Y1 [get_cells BUFG_7]
set_property LOC BUFGCTRL_X0Y0 [get_cells BUFG]
set_property LOC BUFGCTRL_X0Y9 [get_cells BUFG_6]
set_property LOC BUFGCTRL_X0Y8 [get_cells BUFG_3]
set_property LOC BUFGCTRL_X0Y5 [get_cells BUFG_2]
set_property LOC BUFGCTRL_X0Y7 [get_cells BUFG_5]
set_property LOC BUFGCTRL_X0Y3 [get_cells BUFG_1]
set_property LOC BUFGCTRL_X0Y16 [get_cells eth_clocks0_tx_IBUF_BUFG_inst]
set_property LOC BUFGCTRL_X0Y17 [get_cells clk100_IBUF_BUFG_inst]
set_property LOC BUFGCTRL_X0Y6 [get_cells BUFG_4]

# Location of IO Primitives which is load of clock spine
set_property LOC IOB_X0Y106 [get_cells eth_ref_clk_OBUF_inst]

# Location of clock ports
set_property LOC IOB_X1Y126 [get_ports clk100]
set_property LOC IOB_X0Y124 [get_ports eth_clocks0_tx]

# Clock net "usb_forward_clk" driven by instance "BUFG_8" located at site "BUFGCTRL_X0Y4"
#startgroup
create_pblock {CLKAG_usb_forward_clk}
add_cells_to_pblock [get_pblocks  {CLKAG_usb_forward_clk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="usb_forward_clk"}]]]
resize_pblock [get_pblocks {CLKAG_usb_forward_clk}] -add {CLOCKREGION_X1Y2:CLOCKREGION_X1Y2}
#endgroup

# Clock net "usb_capture_clk" driven by instance "BUFG_9" located at site "BUFGCTRL_X0Y2"
#startgroup
create_pblock {CLKAG_usb_capture_clk}
add_cells_to_pblock [get_pblocks  {CLKAG_usb_capture_clk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="usb_capture_clk"}]]]
resize_pblock [get_pblocks {CLKAG_usb_capture_clk}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X0Y2:CLOCKREGION_X0Y2}
#endgroup

# Clock net "usb_bus_clk" driven by instance "BUFG_7" located at site "BUFGCTRL_X0Y1"
#startgroup
create_pblock {CLKAG_usb_bus_clk}
add_cells_to_pblock [get_pblocks  {CLKAG_usb_bus_clk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="usb_bus_clk"}]]]
resize_pblock [get_pblocks {CLKAG_usb_bus_clk}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X0Y2:CLOCKREGION_X0Y2 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y2:CLOCKREGION_X1Y2}
#endgroup

# Clock net "sys_clk" driven by instance "BUFG" located at site "BUFGCTRL_X0Y0"
