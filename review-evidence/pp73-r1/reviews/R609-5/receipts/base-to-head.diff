+                   cwd=root / "hdl/aecp/ucode", stdout=subprocess.DEVNULL, check=True)
+    subprocess.run([sys.executable, "gen_ltn_rom.py", "-o", str(into / "ltn_rom.hex")],
+                   cwd=root / "hdl/acmp/rom", stdout=subprocess.DEVNULL, check=True)
