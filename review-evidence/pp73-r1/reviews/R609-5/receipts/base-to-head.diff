index 0000000..8a4a5e2
--- /dev/null
+++ b/scripts/aecp_gate/fields.py
@@ -0,0 +1,107 @@
+# SPDX-License-Identifier: CERN-OHL-W-2.0
+"""The command table's field registry: exhaustive paths and executable claims.
+
+[] identifies command/documented rows; * identifies named map members. Container
+entries describe shape only; their children each have their own classification.
+The registry is data beside the exported table, never inferred from this code.
+"""
+from .inputs import FIELDS, Inputs, read_json
+
+MAPS = {"status_codes", "hazard_classes", "shared_entries"}
+
+
+def field_paths(value: object, path: str = "") -> set:
+    """Every field present, folding row indices and named maps into patterns."""
+    found = set()
+    if isinstance(value, dict):
+        for key, child in value.items():
+            part = "*" if path in MAPS else key
+            nested = f"{path}.{part}" if path else part
+            found.add(nested)
+            found.update(field_paths(child, nested))
+    elif isinstance(value, list):
+        for child in value:
+            if isinstance(child, dict):
+                found.update(field_paths(child, path + "[]"))
+    return found
+
+
+def registry(inp: Inputs) -> list:
+    """Read the registry once, allowing the self-test to plant a registry copy."""
+    if inp.registry is None:
+        inp.registry = read_json(inp.root, FIELDS)
+    return inp.registry
+
+
+def check_fields(inp: Inputs) -> list:
+    """Every table field is registered exactly once, with an actionable status."""
+    entries = registry(inp)
+    if not isinstance(entries, list) or not all(isinstance(e, dict) for e in entries):
+        return ["  fields: registry must be a list of field objects"]
+    p, seen = [], set()
+    for entry in entries:
+        path = entry.get("path")
+        if not isinstance(path, str) or not path:
+            p.append("  fields: registry entry needs a path")
+            continue
+        if path in seen:
+            p.append(f"  fields: {path}: duplicate registry entry")
+        seen.add(path)
+        status = entry.get("status")
+        if status not in ("held", "held to nothing"):
+            p.append(f"  fields: {path}: status must be held or held to nothing")
+        if not isinstance(entry.get("reason"), str) or not entry["reason"]:
+            p.append(f"  fields: {path}: needs a reason describing its scope")
+        if status == "held" and not _claim(entry):
+            p.append(f"  fields: {path}: held needs consumer, check and a named drift probe")
+        elif status == "held" and not _targets_field(inp.table, entry):
+            p.append(f"  fields: {path}: probe must change this table field")
+    actual = field_paths(inp.table)
+    for path in sorted(actual - seen):
+        p.append(f"  fields: {path}: table field missing from registry")
+    for path in sorted(seen - actual):
+        p.append(f"  fields: {path}: registry entry has no such table field")
+    if inp.table.get("fields") != "aecp_fields.json":
+        p.append("  fields: fields: export must name aecp_fields.json")
+    return p
+
+
+def _claim(entry: dict) -> bool:
+    """A held field names its reader, finding words and concrete table edits."""
+    probe = entry.get("probe")
+    return (isinstance(entry.get("consumer"), str) and bool(entry["consumer"])
+            and isinstance(entry.get("check"), str) and bool(entry["check"])
+            and isinstance(probe, dict) and bool(probe.get("edits"))
+            and isinstance(probe.get("words"), list) and bool(probe["words"])
+            and all(isinstance(w, str) and w for w in probe["words"])
+            and isinstance(probe["edits"], list)
+            and all(isinstance(e, dict) and isinstance(e.get("path"), list)
+                    and e["path"] and "value" in e for e in probe["edits"]))
+
+
+def plant_field(inp: Inputs, probe: dict) -> None:
+    """Apply a registry probe to the copy's table; no executable data is read."""
+    for edit in probe["edits"]:
+        owner = inp.table
+        for key in edit["path"][:-1]:
+            owner = owner[key]
+        owner[edit["path"][-1]] = edit["value"]
+
+
+def _targets_field(table: dict, entry: dict) -> bool:
+    """A held claim must target its own existing field; the sweep rejects no-ops."""
+    targeted = False
+    for edit in entry["probe"]["edits"]:
+        value, path = table, ""
+        try:
+            for key in edit["path"]:
+                value = value[key]
+                if isinstance(key, int):
+                    path += "[]"
+                else:
+                    part = "*" if path in MAPS else key
+                    path = f"{path}.{part}" if path else part
+        except (KeyError, IndexError, TypeError):
+            return False
+        targeted |= path == entry["path"]
+    return targeted
diff --git a/scripts/aecp_gate/gate.py b/scripts/aecp_gate/gate.py
new file mode 100644
index 0000000..22f820d
--- /dev/null
+++ b/scripts/aecp_gate/gate.py
@@ -0,0 +1,94 @@
+# SPDX-FileCopyrightText: 2026 Kebag Logic
+# SPDX-License-Identifier: CERN-OHL-W-2.0
+"""The AECP command gate's three verdicts: every consumer against the table
+(`check`), F06.14 regenerated (`write`), and tb/aecp_cmds' fresh sweep against
+the table and the recorded decode.json (`observed`)."""
+import json
+from pathlib import Path
+
+from .doc import check_doc, check_inventory, regenerated
+from .fields import check_fields
+from .field_docs import check_references, write_references
+from .inputs import (DOC, ENGINE, NOTIFY, PP_PKG, RECORD, ROM_KEY, SCOREBOARD, TOP,
+                     UCPU_PKG, GateError, Inputs, digests, load, read_json, ucode_of)
+from .record import canonical, check_record, check_swept, dump_record, record_diff
+from .rom import check_rom
+from .rtl import (check_classifier, check_engine, check_notify, check_scoreboard,
+                  check_status_codes, classifier, engine_consts, hazard_codes, lockprot,
+                  notify_classes, status_codes, uns_kinds)
+from .table import check_schema
+
+
+def check(inp: Inputs) -> list:
+    """Every disagreement, one line each; empty means the gate passes. The
+    generator runs only on a table the schema accepts and whose entries the
+    engine was observed to dispatch: those are the fields it reads."""
+    t = inp.table
+    p = check_schema(t)
+    if p:
+        return p
+    p += check_fields(inp)
+    if inp.record is None:
+        inp.record = read_json(inp.root, RECORD)
+    found, _, _, entries_ok = check_record(t, inp.record)
+    found += check_swept(inp, rom=False)
+    p += found
+    p += check_engine(t, engine_consts(inp.texts[ENGINE]))
+    default, cls = classifier(inp.texts[TOP])
+    p += check_classifier(t, default, cls, hazard_codes(inp.texts[PP_PKG]))
+    p += check_scoreboard(t, lockprot(inp.texts[SCOREBOARD]))
+    p += check_notify(t, *notify_classes(inp.texts[NOTIFY]))
+    p += check_status_codes(t, status_codes(inp.texts[UCPU_PKG]))
+    p += check_doc(t, inp.texts[DOC])
+    p += check_inventory(t, inp.texts[DOC])
+    if not check_fields(inp):
+        p += check_references(inp)
+    if entries_ok:
+        p += check_rom(t, ucode_of(inp))
+        p += [x for x in check_swept(inp, rom=True) if ROM_KEY in x]
+    return p
+
+
+def write(root: Path) -> int:
+    """Regenerate F06.14 from the table."""
+    inp = load(root)
+    p = check_schema(inp.table) + check_fields(inp)
+    if p:
+        print("\n".join(p))
+        return 1
+    doc = inp.texts[DOC]
+    new = regenerated(inp.table, doc)
+    if new != doc:
+        (root / DOC).write_text(new, encoding="utf-8")
+        print(f"aecp commands: rewrote F06.14 in {DOC}")
+    else:
+        print(f"aecp commands: F06.14 in {DOC} is current")
+    write_references(inp)
+    return 0
+
+
+def observed(root: Path, path: Path, rewrite: bool) -> int:
+    """tb/aecp_cmds's verdict: a fresh sweep held to the table and to the
+    recorded decode.json (or, with `rewrite`, written as decode.json)."""
+    inp = load(root, record=not rewrite)
+    try:
+        raw = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError) as exc:
+        raise GateError(f"the sweep's output {path} cannot be read: {exc}") from exc
+    uc = ucode_of(inp)
+    rec = canonical(raw, uc, uns_kinds(inp.texts[PP_PKG]), digests(inp.swept, uc))
+    if rewrite:
+        (root / RECORD).write_text(dump_record(rec), encoding="utf-8")
+        print(f"aecp commands: wrote {RECORD} from {raw['trials']} trials")
+        inp.record = rec
+    p = check_schema(inp.table)
+    n, f = 1, bool(p)
+    if not p:
+        found, n2, f2, _ = check_record(inp.table, rec, "the fresh sweep")
+        p, n, f = found, n + n2, f + f2
+    stale = record_diff(rec, inp.record)
+    p, n, f = p + stale, n + 1, f + bool(stale)
+    for line in p:
+        print(f"FAIL:{line}")
+    print(f"aecp_cmds: {raw['trials']} trials swept; {n} checks: {n - f} PASS, {f} FAIL")
+    return 1 if f else 0
