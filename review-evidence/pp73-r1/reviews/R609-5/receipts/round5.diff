+    @property
+    def name(self) -> str:
+        """The module-qualified guard label used in every verdict."""
+        return f"{self.module}.{self.block}"
+
+    @property
+    def elaborated(self) -> str:
+        """The top passed to each front end."""
+        return self.top or self.module
