#!/usr/bin/env python3
"""Limit each build to two compile workers; override binary with REVIEW_VERILATOR."""
import os,sys
args=sys.argv[1:]
for i in range(len(args)-1):
    if args[i] == '-j': args[i+1]='2'
os.execv(os.environ.get('REVIEW_VERILATOR','$VALIDATION_TOOLS/pinned-verilator-5.050/verilator'), ['verilator',*args])
