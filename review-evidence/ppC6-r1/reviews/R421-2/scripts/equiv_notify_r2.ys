# R421-2: gold = main 3f3ea56b's KL_aecp_notify; gate = head 88e0bf82's at EN_IDENTIFY_NOTIF_P = 0
# (the round-1 author script with round 2's third unread input, uns_tx_busy_i, also deleted)
read_verilog base/all.v
hierarchy -top KL_aecp_notify
rename KL_aecp_notify gold
design -stash gold
read_verilog head/all.v
hierarchy -top KL_aecp_notify
chparam -set EN_IDENTIFY_NOTIF_P 0 KL_aecp_notify
rename KL_aecp_notify gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
proc
memory
opt_clean
delete -port gate/identify_button_i gate/identify_index_i gate/uns_tx_busy_i
equiv_make gold gate equiv
hierarchy -top equiv
equiv_struct
equiv_simple -seq 3
equiv_induct -seq 3
equiv_status -assert
