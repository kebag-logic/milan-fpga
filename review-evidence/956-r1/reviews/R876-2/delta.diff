--- a/sw/firmware/ctrl/test/test_aecp.cpp
+++ b/sw/firmware/ctrl/test/test_aecp.cpp
@@ -1058,6 +1058,122 @@ TEST_F(AppOutputs, ListenerRegistrationChangeIsItsStreamOutputsNotice)
