+        rc, printed = dry_run_transcript(resolved, "rtl-full", slot, shipping_root)
+        moved_to = " ".join(f"--cpuset-cpus={each}" for each in ranges[:concurrency])
+        check(
+            f"a slot-{slot.number} dry run of the shipping rtl-full prints its "
