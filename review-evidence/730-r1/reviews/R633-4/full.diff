+def cpu_range_overlaps(named: Sequence[tuple[str, str]]) -> list[str]:
+    """Each CPU two `(owner, "first-last")` ranges share, as `<owner> and <owner> share CPU <n>`; [] if disjoint."""
+    holders: dict[int, str] = {}
