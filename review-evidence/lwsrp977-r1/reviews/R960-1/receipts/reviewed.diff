+static struct mmrp_ctx mmrp_context = {on_mac, on_mac_gone, on_svc, on_svc_gone};
+
+/* ---- observation ------------------------------------------------------ */
+
+static void observed(void *ctx, const struct mrp_transition *t)
+{
+    (void)ctx;
+    printf("  T port %u type %u ev %s %s>%s %s>%s", t->port_id, t->attr_type, mrp_event_name(t->event),
+           mrp_appl_state_name(t->appl_from), mrp_appl_state_name(t->appl_to),
+           mrp_reg_state_name(t->reg_from), mrp_reg_state_name(t->reg_to));
+    hex(" ", t->attr_val, app->ops->attr_len(t->attr_type));
+    printf("\n");
+}
+
+static bool filtered(void *ctx, uint8_t port, uint8_t type, const void *value)
+{
+    (void)ctx;
+    const uint8_t *v = value;
+    bool take = ((v[0] + v[app->ops->attr_len(type) - 1u] + type + port) % 7u) != 0u;
+    printf("  filter port %u type %u %u\n", port, type, take);
+    return take;
+}
+
+static void visited(void *ctx, const struct mrp_attr_status *st)
+{
+    (void)ctx;
+    const uint8_t head[4] = {st->port_id, st->attr_type, (uint8_t)st->appl, (uint8_t)st->reg};
+    mix(head, sizeof(head));
+    mix(st->attr_val, value_len(st->attr_type));
+}
+
+static int sent(void *ctx, uint8_t port, const uint8_t *pdu, size_t len)
+{
+    (void)ctx;
+    ++sends;
+    const bool refuse = refuse_every && sends % refuse_every == 0u;
+    printf("  send port %u len %zu%s", port, len, refuse ? " refused" : "");
+    hex(" ", pdu, len);
+    printf("\n");
+    return refuse ? -1 : 0;
+}
+
+/* ---- received PDUs ---------------------------------------------------- */
+
+static size_t events(uint8_t *out, unsigned n, bool subtype)
+{
+    size_t at = 0;
+    for (unsigned k = 0; k < n; k += 3u) {
+        out[at++] = (uint8_t)(draw(6) * 36u + (k + 1u < n ? draw(6) * 6u : 0u) + (k + 2u < n ? draw(6) : 0u));
+    }
+    if (subtype) {
+        for (unsigned k = 0; k < n; k += 4u) {
+            out[at++] = (uint8_t)draw(256);
+        }
+    }
+    return at;
+}
+
+/* One MSRP Message of one vector (IEEE 802.1Q-2018 35.2.2). */
+static size_t msrp_message(uint8_t *out)
+{
+    static const uint8_t types[] = {MSRP_ATTR_TYPE_TALKER_ADV, MSRP_ATTR_TYPE_TALKER_FAILED,
+                                    MSRP_ATTR_TYPE_LISTENER, MSRP_ATTR_TYPE_DOMAIN};
+    const uint8_t type = types[draw(4)];
+    const uint8_t alen = app->ops->attr_len(type);
+    const unsigned n = type == MSRP_ATTR_TYPE_DOMAIN ? 1u : 1u + draw(5);
+    uint8_t *v = out + 6;
+    memset(v, 0, alen);
+    if (type == MSRP_ATTR_TYPE_DOMAIN) {
+        v[0] = 6u; v[1] = 3u; v[2] = (uint8_t)draw(2); v[3] = (uint8_t)(2u + draw(2));
+    } else {
+        stream_id(v);
+    }
+    if (type == MSRP_ATTR_TYPE_TALKER_ADV || type == MSRP_ATTR_TYPE_TALKER_FAILED) {
+        v[8] = 0x91u; v[9] = 0xe0u; v[10] = 0xf0u; v[13] = (uint8_t)draw(2);
+        v[15] = 2u; v[16] = 0u; v[17] = 64u; v[19] = 1u; v[20] = 0x70u;
+        v[24] = (uint8_t)(1u + draw(2));
+        if (type == MSRP_ATTR_TYPE_TALKER_FAILED) {
+            v[32] = (uint8_t)draw(2); v[33] = (uint8_t)(1u + draw(2));
+        }
+    }
+    size_t at = 6u + alen;
+    at += events(out + at, n, type == MSRP_ATTR_TYPE_LISTENER);
+    out[at++] = 0u; out[at++] = 0u;
+    const bool leaveall = draw(12) == 0u;
+    out[0] = type; out[1] = alen;
+    out[2] = (uint8_t)((at - 4u) >> 8); out[3] = (uint8_t)(at - 4u);
+    out[4] = (uint8_t)(((leaveall ? 0x2000u : 0u) | n) >> 8); out[5] = (uint8_t)n;
+    return at;
+}
+
+/* One Message of one vector for an application without AttributeListLength. */
+static size_t plain_message(uint8_t *out)
+{
+    uint8_t type, value[6] = {0};
+    unsigned n = 1u + draw(5);
+    if (kind == KIND_MVRP) {
+        type = MVRP_ATTR_TYPE_VID;
+        const unsigned vid = draw(3) * 256u + 1u + draw(10);
+        value[0] = (uint8_t)(vid >> 8); value[1] = (uint8_t)vid;
+    } else if (kind == KIND_MMRP) {
+        type = draw(3) == 0u ? MMRP_ATTR_TYPE_SVC : MMRP_ATTR_TYPE_MAC;
+        if (type == MMRP_ATTR_TYPE_SVC) {
+            value[0] = (uint8_t)draw(2);
+            n = 1u + draw(2);
+        } else {
+            value[0] = 0x01u; value[1] = 0x00u; value[2] = 0x5eu; value[5] = (uint8_t)draw(12);
+        }
+    } else {
+        type = (uint8_t)(1u + draw(2));
+        value[0] = (uint8_t)draw(24);
+    }
+    const uint8_t alen = app->ops->attr_len(type);
+    size_t at = 0;
+    out[at++] = type; out[at++] = alen;
+    const bool leaveall = draw(12) == 0u;
+    out[at++] = (uint8_t)(((leaveall ? 0x2000u : 0u) | n) >> 8); out[at++] = (uint8_t)n;
+    memcpy(out + at, value, alen);
+    at += alen;
+    at += events(out + at, n, app->ops->attr_has_subtype && app->ops->attr_has_subtype(type));
+    out[at++] = 0u; out[at++] = 0u;
+    return at;
+}
+
+static size_t random_pdu(uint8_t *pdu)
+{
+    size_t len = 1u;
+    pdu[0] = draw(20) == 0u ? 1u : 0u;
+    for (unsigned m = 1u + draw(3); m != 0u; --m) {
+        len += kind == KIND_MSRP ? msrp_message(pdu + len) : plain_message(pdu + len);
+    }
+    pdu[len++] = 0u; pdu[len++] = 0u;
+    if (draw(40) == 0u) {
+        len -= 1u + draw((unsigned)len - 3u); /* truncated */
+    }
+    return len;
+}
+
+/* ---- local declarations ---------------------------------------------- */
+
+static void local_value(uint8_t *type, uint8_t *value)
+{
+    memset(value, 0, 48);
+    switch (kind) {
+    case KIND_MSRP: {
+        const uint32_t which = draw(5);
+        if (which < 2u) {
+            struct msrp_talker_adv t = {0};
+            stream_id(t.stream_id.bytes);
+            t.dest_mac[0] = 0x91u; t.dest_mac[5] = (uint8_t)draw(3);
+            t.vlan_id = 2u; t.max_frame_size = (uint16_t)(64u + 8u * draw(3)); t.max_interval_frames = 1u;
+            t.priority_and_rank = 0x70u;
+            if (which == 0u) {
+                *type = MSRP_ATTR_TYPE_TALKER_ADV;
+                memcpy(value, &t, sizeof(t));
+            } else {
+                struct msrp_talker_failed f = {0};
+                f.talker = t;
+                f.failure_info[8] = (uint8_t)(1u + draw(3));
+                *type = MSRP_ATTR_TYPE_TALKER_FAILED;
+                memcpy(value, &f, sizeof(f));
+            }
+        } else if (which < 4u) {
+            *type = MSRP_ATTR_TYPE_LISTENER;
+            stream_id(value);
+            value[8] = (uint8_t)(1u + draw(3));
+        } else {
+            struct msrp_domain d = {(uint8_t)(6u + draw(2)), 3u, (uint16_t)(2u + draw(2))};
+            *type = MSRP_ATTR_TYPE_DOMAIN;
+            memcpy(value, &d, sizeof(d));
+        }
+        break;
+    }
+    case KIND_MVRP: {
+        const unsigned vid = draw(3) * 256u + 1u + draw(10);
+        *type = MVRP_ATTR_TYPE_VID;
+        value[0] = (uint8_t)(vid >> 8); value[1] = (uint8_t)vid;
+        break;
+    }
+    case KIND_MMRP:
+        if (draw(3) == 0u) {
+            *type = MMRP_ATTR_TYPE_SVC;
+            value[0] = (uint8_t)draw(2);
+        } else {
+            *type = MMRP_ATTR_TYPE_MAC;
+            value[0] = 0x01u; value[1] = 0x00u; value[2] = 0x5eu; value[5] = (uint8_t)draw(12);
+        }
+        break;
+    default:
+        *type = (uint8_t)(1u + draw(2));
+        value[0] = (uint8_t)draw(24);
+        value[1] = (uint8_t)draw(3);
+        break;
+    }
+}
+
+static int declare(uint8_t port, bool join)
+{
+    uint8_t type, value[48];
+    local_value(&type, value);
+    printf("%s port %u type %u", join ? "join" : "leave", port, type);
+    hex(" ", value, value_len(type));
+    printf("\n");
+    if (kind == KIND_MSRP && draw(2)) {
+        if (type == MSRP_ATTR_TYPE_TALKER_ADV) {
+            struct msrp_talker_adv t;
+            memcpy(&t, value, sizeof(t));
+            return join ? msrp_declare_talker(app, port, &t, draw(2) != 0u) :
+                          msrp_withdraw_talker(app, port, &t.stream_id);
+        }
+        if (type == MSRP_ATTR_TYPE_LISTENER) {
+            struct msrp_stream_id id;
+            memcpy(id.bytes, value, 8);
+            return join ? msrp_declare_listener(app, port, &id, (enum msrp_listener_decl)value[8]) :
+                          msrp_withdraw_listener(app, port, &id);
+        }
+    }
+    if (kind == KIND_MVRP && draw(2)) {
+        const uint16_t vid = (uint16_t)(value[0] << 8 | value[1]);
+        return join ? mvrp_declare(app, port, vid) : mvrp_withdraw(app, port, vid);
+    }
+    if (kind == KIND_MMRP && draw(2)) {
+        if (type == MMRP_ATTR_TYPE_SVC) {
+            return join ? mmrp_declare_svc(app, port, value[0]) : mmrp_withdraw_svc(app, port, value[0]);
+        }
+        struct mmrp_mac mac;
+        memcpy(mac.addr, value, 6);
+        return join ? mmrp_declare_mac(app, port, &mac) : mmrp_withdraw_mac(app, port, &mac);
+    }
+    return join ? mrp_mad_join(app, port, type, value, draw(2) != 0u) : mrp_mad_leave(app, port, type, value);
+}
+
+/* ---- the run ---------------------------------------------------------- */
+
+static void state_digest(unsigned long step)
+{
+    digest = UINT64_C(0xcbf29ce484222325);
+    for (uint8_t p = 0; p < n_ports; ++p) {
+        int count = mrp_attr_visit(app, p, visited, NULL);
+        enum mrp_la_state la;
+        enum mrp_pt_state pt;
+        (void)mrp_port_status(app, p, &la, &pt);
+        const int head[3] = {count, (int)la, (int)pt};
+        mix(head, sizeof(head));
+    }
+    printf("S %lu %016llx live %lu\n", step, (unsigned long long)digest, live);
+}
+
+int main(int argc, char **argv)
+{
+    if (argc != 3) {
+        fprintf(stderr, "usage: mad_trace <seed> <steps>\n");
+        return 2;
+    }
+    const unsigned long seed = strtoul(argv[1], NULL, 0);
+    rng = (uint32_t)seed * 2654435761u + 7u;
+    const unsigned long steps = strtoul(argv[2], NULL, 0);
+    kind = (enum kind)(seed % KINDS);
+    n_ports = (uint8_t)(1u + draw(kind == KIND_MSRP || kind == KIND_TIE ? 3u : 2u));
+    fail_every = draw(3) == 0u ? 40u + draw(200) : 0u;
+    refuse_every = draw(2) == 0u ? 2u + draw(6) : 0u;
+    const bool filter = draw(2) != 0u;
+    printf("seed %lu %s ports %u fail %u refuse %u filter %u\n", seed, kind_names[kind], n_ports, fail_every,
+           refuse_every, filter);
+    const uint32_t saved_fail = fail_every;
+    fail_every = 0u;
+    switch (kind) {
+    case KIND_MSRP: app = msrp_app_create(n_ports, &msrp_context); break;
+    case KIND_MVRP: mvrp_context.on_vlan_registered = on_vlan_registered;
+                    mvrp_context.on_vlan_deregistered = on_vlan_deregistered;
+                    app = mvrp_app_create(n_ports, &mvrp_context); break;
+    case KIND_MMRP: app = mmrp_app_create(n_ports, &mmrp_context); break;
+    default:        app = tie_create(n_ports); break;
+    }
+    if (!app) {
+        printf("create failed\n");
+        return 1;
+    }
+    for (uint8_t p = 0; p < n_ports; ++p) {
+        const uint32_t join = 2u + draw(20);
+        const int r = mrp_port_configure(app, p, join, join * 2u + 6u + draw(80), 40u + draw(1200), draw(1000),
+                                         draw(2) != 0u);
+        printf("configure %u rc %d\n", p, r);
+    }
+    mrp_set_observer(app, observed, NULL);
+    if (filter) {
+        mrp_set_rx_filter(app, filtered, NULL);
+    }
+    fail_every = saved_fail;
+    uint8_t pdu[1600], buffer[2048];
+    memset(buffer, 0xa5, sizeof(buffer));
+    for (unsigned long step = 0; step < steps; ++step) {
+        const uint32_t what = draw(64);
+        const uint8_t port = (uint8_t)draw(n_ports);
+        int r = 0;
+        if (what < 22u) {
+            const size_t len = random_pdu(pdu);
+            printf("rx port %u", port);
+            hex(" ", pdu, len);
+            printf("\n");
+            r = mrp_rx(app, port, pdu, len);
+        } else if (what < 32u) {
+            r = declare(port, true);
+        } else if (what < 37u) {
+            r = declare(port, false);
+        } else if (what < 49u) {
+            static const size_t capacities[] = {3u, 24u, 60u, 120u, 300u, 1500u, 2048u};
+            const size_t capacity = capacities[draw(7)];
+            printf("transmit port %u capacity %zu\n", port, capacity);
+            r = mrp_transmit(app, port, buffer, capacity, sent, NULL);
+            /* The whole buffer, as a failed build leaves it too. */
+            digest = UINT64_C(0xcbf29ce484222325);
+            mix(buffer, sizeof(buffer));
+            printf("buffer %016llx\n", (unsigned long long)digest);
+        } else if (what < 58u) {
+            const uint32_t n = what < 56u ? 1u + draw(30) : 50u + draw(300);
+            printf("tick %u\n", n);
+            for (uint32_t k = 0; k < n; ++k) {
+                shlan_timer_tick();
+            }
+        } else if (what < 61u) {
+            printf("reclaim port %u\n", port);
+            r = (int)mrp_reclaim(app, port);
+        } else if (what < 62u) {
+            const bool flush = draw(2) != 0u;
+            printf("role port %u flush %u\n", port, flush);
+            mrp_port_role_change(app, port, flush);
+        } else if (what < 63u) {
+            const bool enable = draw(2) != 0u;
+            printf("periodic port %u %u\n", port, enable);
+            mrp_set_periodic(app, port, enable);
+        } else {
+            uint8_t type, value[48];
+            local_value(&type, value);
+            printf("registered type %u", type);
+            hex(" ", value, value_len(type));
+            r = (int)mrp_attr_registered_ports(app, type, value);
+            printf("\n");
+        }
+        printf("rc %d\n", r);
+        state_digest(step);
+    }
+    fail_every = 0u;
+    printf("destroy\n");
+    switch (kind) {
+    case KIND_MSRP: msrp_app_destroy(app); break;
+    case KIND_MVRP: mvrp_app_destroy(app); break;
+    case KIND_MMRP: mmrp_app_destroy(app); break;
+    default:        mrp_app_destroy(app); break;
+    }
+    for (unsigned k = 0; k < 2000u; ++k) {
+        shlan_timer_tick();
+    }
+    printf("END allocations %lu releases %lu live %lu sends %lu\n", allocations, releases, live, sends);
+    return 0;
+}
diff --git a/tests/differential/timer_trace.c b/tests/differential/timer_trace.c
new file mode 100644
index 0000000..6aa6aaf
--- /dev/null
+++ b/tests/differential/timer_trace.c
@@ -0,0 +1,146 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/*
+ * One random life of the timer module, printed as a trace: registrations,
+ * arms, disarms, removals and ticks, and every expiry with the tick it fired
+ * in. Callbacks arm, disarm and register other timers, and themselves, as
+ * lwSRP's own callbacks do, so a tick's order and its arm-during-tick rule
+ * show in the trace. tests/check_differential.py builds this file against a
+ * base revision's src/ports/timer.c and against the checkout's, and requires
+ * the two traces to be byte-identical for every seed.
+ *
+ * usage: timer_trace <seed> <steps>
+ */
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "ports/timer.h"
+
+#define TIMERS 48u
+
+static struct shlan_timer timers[TIMERS];
+static bool registered[TIMERS];
+static uint32_t rng;
+static uint32_t now;
+static unsigned long fired;
+static bool in_tick;
+
+static uint32_t draw(uint32_t n)
+{
+    rng ^= rng << 13;
+    rng ^= rng >> 17;
+    rng ^= rng << 5;
+    return rng % n;
+}
+
+/* Arm lengths: often one or a few centiseconds, some near the wheel's
+ * turns, some far. */
+static uint32_t length(void)
+{
+    const uint32_t kind = draw(20);
+    if (kind == 0u) {
+        return 0u;
+    }
+    if (kind < 5u) {
+        return 1u;
+    }
+    if (kind < 10u) {
+        return 2u + draw(4);
+    }
+    if (kind < 14u) {
+        return 6u + draw(66);
+    }
+    if (kind < 16u) {
+        return 60u + draw(12);
+    }
+    if (kind < 18u) {
+        return 120u + draw(16);
+    }
+    if (kind < 19u) {
+        return 250u + draw(20);
+    }
+    return 1000u + draw(4000);
+}
+
+static void expired(void *arg);
+
+static void register_timer(unsigned n)
+{
+    shlan_timer_init(&timers[n], expired, &timers[n]);
+    registered[n] = true;
+}
+
+/* One action on another timer, or on t itself, as a callback takes it. */
+static void act(unsigned self)
+{
+    const unsigned n = draw(4) == 0u ? self : draw(TIMERS);
+    const uint32_t what = draw(10);
+    if (what < 6u) {
+        const uint32_t cs = length();
+        printf("  arm %u %u\n", n, cs);
+        shlan_timer_arm(&timers[n], cs);
+    } else if (what < 8u) {
+        printf("  disarm %u\n", n);
+        shlan_timer_disarm(&timers[n]);
+    } else if (!registered[n]) {
+        printf("  init %u\n", n);
+        register_timer(n);
+    }
+}
+
+static void expired(void *arg)
+{
+    const unsigned n = (unsigned)((struct shlan_timer *)arg - timers);
+    ++fired;
+    printf("F %u %u%s\n", now, n, in_tick ? "" : " outside a tick");
+    for (uint32_t k = draw(4); k != 0u; --k) {
+        act(n);
+    }
+}
+
+int main(int argc, char **argv)
+{
+    if (argc != 3) {
+        fprintf(stderr, "usage: timer_trace <seed> <steps>\n");
+        return 2;
+    }
+    rng = (uint32_t)strtoul(argv[1], NULL, 0) * 2654435761u + 1u;
+    const unsigned long steps = strtoul(argv[2], NULL, 0);
+    for (unsigned n = 0; n < TIMERS; ++n) {
+        if (draw(2)) {
+            register_timer(n);
+        }
+    }
+    for (unsigned long step = 0; step < steps; ++step) {
+        const uint32_t what = draw(32);
+        const unsigned n = draw(TIMERS);
+        if (what < 12u) {
+            const uint32_t cs = length();
+            printf("arm %u %u\n", n, cs);
+            shlan_timer_arm(&timers[n], cs);
+        } else if (what < 15u) {
+            printf("disarm %u\n", n);
+            shlan_timer_disarm(&timers[n]);
+        } else if (what < 17u) {
+            printf("remove %u\n", n);
+            shlan_timer_remove(&timers[n]);
+            registered[n] = false;
+        } else if (what < 19u) {
+            if (!registered[n]) {
+                printf("init %u\n", n);
+                register_timer(n);
+            }
+        } else {
+            for (uint32_t k = what < 30u ? 1u : 1u + draw(300); k != 0u; --k) {
+                ++now;
+                in_tick = true;
+                shlan_timer_tick();
+                in_tick = false;
+            }
+            printf("ticked to %u\n", now);
+        }
+    }
+    printf("END fired %lu at %u\n", fired, now);
+    return 0;
+}
diff --git a/tests/unit/key_test.c b/tests/unit/key_test.c
new file mode 100644
index 0000000..76c4253
--- /dev/null
+++ b/tests/unit/key_test.c
@@ -0,0 +1,304 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/*
+ * The attribute key (mrp.h attr_key) is a lookup prefilter only. Each pair of
+ * applications here differs in attr_key alone: one keyed as created, one with
+ * NULL. Both take the same random sequence of received PDUs, local
+ * declarations, withdrawals, timer ticks and transmissions. Their indications,
+ * attribute states and transmitted PDUs must match after every step.
+ * StreamIDs and VIDs are drawn so different values often share a key octet.
+ */
+#include <cgreen/cgreen.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#include "shish_lan/msrp.h"
+#include "shish_lan/mvrp.h"
+#include "shish_lan/mrp_pdu.h"
+#include "ports/timer.h"
+#if LWSRP_ATTR_KEY
+
+Describe(Key);
+BeforeEach(Key) {}
+AfterEach(Key) {}
+
+struct key_run {
+    struct mrp_app *app;
+    uint64_t hash;
+    unsigned joins;
+    unsigned leaves;
+    unsigned sent;
+};
+
+static struct key_run runs[2];
+static uint32_t seed;
+
+static uint32_t draw(uint32_t n)
+{
+    seed = seed * 1664525u + 1013904223u;
+    return (seed >> 8) % n;
+}
+
+static void mix(struct key_run *r, const void *bytes, size_t len)
+{
+    const uint8_t *b = bytes;
+    for (size_t k = 0; k < len; ++k) {
+        r->hash = (r->hash ^ b[k]) * UINT64_C(0x100000001b3);
+    }
+}
+
+static struct key_run *run_of(const struct mrp_app *app)
+{
+    return app == runs[0].app ? &runs[0] : &runs[1];
+}
+
+static size_t value_len(const struct mrp_app *app, uint8_t type)
+{
+    return app->ops->attr_mem_len ? app->ops->attr_mem_len(type) : app->ops->attr_len(type);
+}
+
+static void joined(struct mrp_app *app, uint8_t port, uint8_t type, const void *value, bool is_new)
+{
+    struct key_run *r = run_of(app);
+    const uint8_t head[3] = {1u, type, (uint8_t)(port + (is_new ? 2u : 0u))};
+    mix(r, head, sizeof(head));
+    mix(r, value, value_len(app, type));
+    ++r->joins;
+}
+
+static void left(struct mrp_app *app, uint8_t port, uint8_t type, const void *value)
+{
+    struct key_run *r = run_of(app);
+    const uint8_t head[3] = {2u, type, port};
+    mix(r, head, sizeof(head));
+    mix(r, value, value_len(app, type));
+    ++r->leaves;
+}
+
+static int sent(void *ctx, uint8_t port, const uint8_t *pdu, size_t len)
+{
+    struct key_run *r = ctx;
+    const uint8_t head[2] = {3u, port};
+    mix(r, head, sizeof(head));
+    mix(r, pdu, len);
+    ++r->sent;
+    return 0;
+}
+
+static void visited(void *ctx, const struct mrp_attr_status *st)
+{
+    struct key_run *r = ctx;
+    const uint8_t head[4] = {4u, st->attr_type, (uint8_t)st->appl, (uint8_t)st->reg};
+    mix(r, head, sizeof(head));
+    mix(r, st->attr_val, r->app->ops->attr_len(st->attr_type));
+}
+
+/* A StreamID from one talker: UniqueIDs whose last octet repeats across
+ * three high octets, so keys collide between different streams. */
+static void stream_id(uint8_t *id)
+{
+    const uint8_t mac[6] = {0x02u, 0x00u, 0x00u, 0x00u, 0x00u, 0x10u};
+    memcpy(id, mac, sizeof(mac));
+    id[6] = (uint8_t)draw(3);
+    id[7] = (uint8_t)draw(12);
+}
+
+/* One MSRP message with one vector of up to five values (IEEE 802.1Q-2018
+ * 35.2.2), its FirstValue drawn from a small set of each field. */
+static size_t msrp_message(uint8_t *out)
+{
+    static const uint8_t types[] = {MSRP_ATTR_TYPE_TALKER_ADV, MSRP_ATTR_TYPE_TALKER_FAILED,
+                                    MSRP_ATTR_TYPE_LISTENER, MSRP_ATTR_TYPE_DOMAIN};
+    const uint8_t type = types[draw(4)];
+    const uint8_t alen = runs[0].app->ops->attr_len(type);
+    const unsigned n = type == MSRP_ATTR_TYPE_DOMAIN ? 1u : 1u + draw(5);
+    uint8_t *v = out + 6;
+    memset(v, 0, alen);
+    if (type == MSRP_ATTR_TYPE_DOMAIN) {
+        v[0] = 6u; v[1] = 3u; v[2] = (uint8_t)draw(2); v[3] = (uint8_t)(2u + draw(2));
+    } else {
+        stream_id(v);
+    }
+    if (type == MSRP_ATTR_TYPE_TALKER_ADV || type == MSRP_ATTR_TYPE_TALKER_FAILED) {
+        v[8] = 0x91u; v[9] = 0xe0u; v[10] = 0xf0u; v[13] = (uint8_t)draw(2);
+        v[15] = 2u; v[16] = 0u; v[17] = 64u; v[19] = 1u; v[20] = 0x70u;
+        v[24] = (uint8_t)(1u + draw(2));
+        if (type == MSRP_ATTR_TYPE_TALKER_FAILED) {
+            v[32] = (uint8_t)draw(2); v[33] = (uint8_t)(1u + draw(2));
+        }
+    }
+    size_t at = 6u + alen;
+    for (unsigned k = 0; k < n; k += 3u) {
+        out[at++] = (uint8_t)(draw(6) * 36u + (k + 1u < n ? draw(6) * 6u : 0u) + (k + 2u < n ? draw(6) : 0u));
+    }
+    if (type == MSRP_ATTR_TYPE_LISTENER) {
+        for (unsigned k = 0; k < n; k += 4u) {
+            out[at++] = (uint8_t)draw(256);
+        }
+    }
+    out[at++] = 0u; out[at++] = 0u;
+    const bool leaveall = draw(16) == 0u;
+    out[0] = type; out[1] = alen;
+    out[2] = (uint8_t)((at - 4u) >> 8); out[3] = (uint8_t)(at - 4u);
+    out[4] = (uint8_t)(((leaveall ? 0x2000u : 0u) | n) >> 8); out[5] = (uint8_t)n;
+    return at;
+}
+
+static size_t msrp_pdu(uint8_t *pdu)
+{
+    size_t len = 1u;
+    pdu[0] = 0u;
+    for (unsigned m = 1u + draw(3); m != 0u; --m) {
+        len += msrp_message(pdu + len);
+    }
+    pdu[len++] = 0u; pdu[len++] = 0u;
+    return len;
+}
+
+/* One MVRP message (IEEE 802.1Q-2018 11.2.3.1): VIDs whose low octet repeats. */
+static size_t mvrp_pdu(uint8_t *pdu)
+{
+    const unsigned n = 1u + draw(5);
+    const unsigned vid = draw(3) * 256u + 1u + draw(10);
+    size_t at = 0u;
+    pdu[at++] = 0u; pdu[at++] = MVRP_ATTR_TYPE_VID; pdu[at++] = MVRP_ATTR_LEN_VID;
+    pdu[at++] = (uint8_t)(((draw(16) == 0u ? 0x2000u : 0u) | n) >> 8); pdu[at++] = (uint8_t)n;
+    pdu[at++] = (uint8_t)(vid >> 8); pdu[at++] = (uint8_t)vid;
+    for (unsigned k = 0; k < n; k += 3u) {
+        pdu[at++] = (uint8_t)(draw(6) * 36u + (k + 1u < n ? draw(6) * 6u : 0u) + (k + 2u < n ? draw(6) : 0u));
+    }
+    pdu[at++] = 0u; pdu[at++] = 0u; pdu[at++] = 0u; pdu[at++] = 0u;
+    return at;
+}
+
+/* A local declaration's in-memory value, from the same small sets. */
+static uint8_t local_value(bool msrp, uint8_t *type, uint8_t *value)
+{
+    memset(value, 0, 48);
+    if (!msrp) {
+        *type = MVRP_ATTR_TYPE_VID;
+        const unsigned vid = draw(3) * 256u + 1u + draw(10);
+        value[0] = (uint8_t)(vid >> 8); value[1] = (uint8_t)vid;
+        return 1u;
+    }
+    *type = draw(2) == 0u ? MSRP_ATTR_TYPE_TALKER_ADV : MSRP_ATTR_TYPE_LISTENER;
+    if (*type == MSRP_ATTR_TYPE_TALKER_ADV) {
+        struct msrp_talker_adv t = {0};
+        stream_id(t.stream_id.bytes);
+        t.vlan_id = 2u; t.max_frame_size = 64u; t.max_interval_frames = 1u;
+        t.priority_and_rank = 0x70u;
+        memcpy(value, &t, sizeof(t));
+    } else {
+        stream_id(value);
+        value[8] = (uint8_t)(1u + draw(3));
+    }
+    return 1u;
+}
+
+/* The two runs, step by step; each step's effects on both must hash alike. */
+static void differential(struct mrp_app *(*create)(void), bool msrp, unsigned steps)
+{
+    for (unsigned k = 0; k < 2u; ++k) {
+        struct mrp_app *prototype = create();
+        assert_that(prototype, is_non_null);
+        struct mrp_app_ops ops = *prototype->ops;
+        ops.join_ind = joined; ops.leave_ind = left; ops.ctx = NULL;
+        ops.map_join = NULL; ops.map_leave = NULL;
+        if (k == 1u) {
+            assert_that(ops.attr_key, is_non_null);
+            ops.attr_key = NULL;
+        }
+        mrp_app_destroy(prototype);
+        runs[k] = (struct key_run){mrp_app_create(&ops, 1), UINT64_C(0xcbf29ce484222325), 0, 0, 0};
+        assert_that(runs[k].app, is_non_null);
+        assert_that(mrp_port_configure(runs[k].app, 0, 20, 60, 1000, 0x872u, true), is_equal_to(0));
+    }
+    uint8_t pdu[512], buffer[1500], type, value[48];
+    for (unsigned step = 0; step < steps; ++step) {
+        const uint32_t what = draw(16);
+        const uint32_t ticks = what >= 13u ? 1u + draw(40) : 0u;
+        size_t len = what < 8u ? (msrp ? msrp_pdu(pdu) : mvrp_pdu(pdu)) : 0u;
+        if (what >= 8u && what < 12u) {
+            (void)local_value(msrp, &type, value);
+        }
+        int result[2] = {0, 0};
+        for (unsigned k = 0; k < 2u; ++k) {
+            struct key_run *r = &runs[k];
+            if (what < 8u) {
+                result[k] = mrp_rx(r->app, 0, pdu, len);
+            } else if (what < 10u) {
+                result[k] = mrp_mad_join(r->app, 0, type, value, true);
+            } else if (what < 12u) {
+                result[k] = mrp_mad_leave(r->app, 0, type, value);
+            } else if (what == 12u) {
+                result[k] = mrp_transmit(r->app, 0, buffer, sizeof(buffer), sent, r);
+            }
+            mix(r, &result[k], sizeof(result[k]));
+        }
+        for (uint32_t t = 0; t < ticks; ++t) {
+            shlan_timer_tick();
+        }
+        if (what >= 13u) {
+            for (unsigned k = 0; k < 2u; ++k) {
+                result[k] = mrp_transmit(runs[k].app, 0, buffer, sizeof(buffer), sent, &runs[k]);
+                mix(&runs[k], &result[k], sizeof(result[k]));
+            }
+        }
+        for (unsigned k = 0; k < 2u; ++k) {
+            mix(&runs[k], &step, sizeof(step));
+            (void)mrp_attr_visit(runs[k].app, 0, visited, &runs[k]);
+        }
+        if (runs[0].hash != runs[1].hash) {
+            /* The first step whose effects differ, as the failure's actual value. */
+            assert_that(step, is_equal_to(steps));
+            break;
+        }
+    }
+    assert_that(runs[0].hash == runs[1].hash, is_true);
+    assert_that(runs[0].joins, is_equal_to(runs[1].joins));
+    assert_that(runs[0].leaves, is_equal_to(runs[1].leaves));
+    assert_that(runs[0].sent, is_equal_to(runs[1].sent));
+    assert_that(runs[0].joins, is_greater_than(steps / 20u));
+    assert_that(runs[0].leaves, is_greater_than(steps / 40u));
+    assert_that(runs[0].sent, is_greater_than(steps / 40u));
+    for (unsigned k = 0; k < 2u; ++k) {
+        mrp_app_destroy(runs[k].app);
+        runs[k].app = NULL;
+    }
+}
+
+static struct msrp_ctx msrp_context;
+static struct mvrp_ctx mvrp_context;
+
+static struct mrp_app *msrp_prototype(void)
+{
+    return msrp_app_create(1, &msrp_context);
+}
+
+static struct mrp_app *mvrp_prototype(void)
+{
+    return mvrp_app_create(1, &mvrp_context);
+}
+
+Ensure(Key, msrp_keyed_lookups_match_unkeyed_lookups)
+{
+    seed = 0x872u;
+    differential(msrp_prototype, true, 4000u);
+}
+
+Ensure(Key, mvrp_keyed_lookups_match_unkeyed_lookups)
+{
+    seed = 0x873u;
+    differential(mvrp_prototype, false, 4000u);
+}
+
+TestSuite *key_suite(void)
+{
+    TestSuite *suite = create_test_suite();
+    add_test_with_context(suite, Key, msrp_keyed_lookups_match_unkeyed_lookups);
+    add_test_with_context(suite, Key, mvrp_keyed_lookups_match_unkeyed_lookups);
+    return suite;
+}
+#else
+/* Built without LWSRP_ATTR_KEY the MAD keeps no key, so there is nothing to compare (tests/unit/main.c). */
+typedef int key_test_unbuilt;
+#endif
