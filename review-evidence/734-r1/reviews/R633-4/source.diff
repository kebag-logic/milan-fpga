+                       env=env, check=True, capture_output=True, text=True)
+        changed = next(work.glob("changed*"))
+        verdicts = dict(line.split("=", 1) for line in output.read_text().splitlines())
+        return changed.read_text().splitlines(), verdicts["rtl"]
