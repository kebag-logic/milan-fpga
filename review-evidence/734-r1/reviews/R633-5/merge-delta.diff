-// One ACMPDU, decoded.
-struct pdu {
-	uint8_t msg;
-	uint8_t status;
-	uint64_t stream_id;
-	uint64_t controller;
-	uint64_t talker;
-	uint64_t listener;
-	uint16_t talker_uid;
-	uint16_t listener_uid;
-	uint64_t dest_mac;
