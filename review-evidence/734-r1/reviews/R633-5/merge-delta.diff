-static bool due(uint32_t deadline, uint32_t at)
-{
-	return (int32_t)(deadline - at) <= 0;
-}
-
-static void sm_timer(struct acmp *a, struct acmp_sink *s, enum acmp_timer kind, uint32_t delay_ms)
