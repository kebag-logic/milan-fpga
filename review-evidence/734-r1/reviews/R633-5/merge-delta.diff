-	x ^= x << 13;
-	x ^= x >> 17;
-	x ^= x << 5;
-	a->rng = x;
-	uint32_t ms = ((x >> 16) * (ACMP_TMR_DELAY_MAX_MS + 1u)) >> 16;
-	a->draws++;
-	a->last_draw_ms = ms;
-	return ms;
-}
