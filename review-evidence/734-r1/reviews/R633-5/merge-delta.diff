-        x ^= x << 13;
-        x ^= x >> 17;
-        x ^= x << 5;
-        if ((((x >> 16) * (spec::TMR_DELAY_MAX_MS + 1u)) >> 16) == ms) {
-            return s;
-        }
-    }
-}
