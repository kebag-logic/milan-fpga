+# Round 2 (A516 adaptation, the only change to this script): the two checks above asserted the
+# round-1 sentences. They now assert the round-2 sentences against the one partition both pages
+# name, recomputed here from the records: every scope's own logic outside u_nvm_port.
+def kids(key, sc):
+    if key == "wrapper":
+        return [k for k in sc if k != "wrapper" and "/" not in k]
+    return [k for k in sc if k.startswith(key + "/") and k.count("/") == key.count("/") + 1]
+
+
+def own(key, sc, f):
+    return sc[key][f] - sum(sc[k][f] for k in kids(key, sc))
+
+
+terms = [k for k in s["A"] if k != "u_pp/u_nvm_port"]
+d = {f: [own(k, s["B"], f) - own(k, s["A"], f) for k in terms] for f in ("LUT", "FF")}
+n_lut, n_ff, a_lut, a_ff = sum(d["LUT"]), sum(d["FF"]), sum(map(abs, d["LUT"])), sum(map(abs, d["FF"]))
+top = (own("u_pp", s["B"], "LUT") - own("u_pp", s["A"], "LUT"), own("u_pp", s["B"], "FF") - own("u_pp", s["A"], "FF"))
+for page, text in (("findings", FIND), ("AREA_BUDGET", BUDGET)):
