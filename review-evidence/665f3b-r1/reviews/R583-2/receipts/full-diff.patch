+    if (fd < 0 || write(fd, r.data, r.len) != (ssize_t)r.len || close(fd) != 0)
+        fail("cannot append to", path);
+    if (WIFSIGNALED(status)) {
+        signal(WTERMSIG(status), SIG_DFL);
+        raise(WTERMSIG(status));
+    }
+    return rc;
