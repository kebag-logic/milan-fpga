-template <std::size_t N>
-std::array<std::uint8_t, N> versioned(std::array<std::uint8_t, N> f, unsigned v) {
-    f[15] = static_cast<std::uint8_t>((f[15] & 0x8Fu) | (v << 4));
-    return f;
-}
