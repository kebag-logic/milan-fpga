-}
-
-static uint32_t p_seed(struct acmp *a)
-{
-	a->in_port = true;
-	uint32_t seed = a->ports->seed(a->ports->ctx);
-	a->in_port = false;
-	return seed;
-}
-
-static bool p_locked(struct acmp *a, uint64_t *controller)
