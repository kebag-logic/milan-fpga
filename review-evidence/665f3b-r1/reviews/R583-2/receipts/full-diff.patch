-// The earlier of a deadline and the earliest found so far.
-static void earliest(bool *any, uint32_t *at, bool armed, uint32_t deadline)
-{
-	if (armed && (!*any || (int32_t)(deadline - *at) < 0)) {
-		*at = deadline;
-		*any = true;
-	}
-}
-
