+    "milan_dp": {
+        "aclk": 1558, "render-mutants": 1375, "gptp": 862, "gptp-lat": 838, "dynmap": 617, "notify": 366,
+        "counters-8": 300, "counters-8-frames": 296, "crflic": 247, "nxn8": 242, "counters-1": 144,
