 from pathlib import Path
 import os
@@ -25,6 +37,35 @@
 SESSION_POOL = f'{NCPU - 32}-{NCPU - 1}'  # the top 32 CPUs: 64-95 on the 96-CPU VM (2026-11-17), 96-127 before
 
 
+def _siblings():
+    """cpu -> the set of logical CPUs on its physical core, from sysfs; a CPU it cannot read is its own core."""
+    out = {}
+    for cpu in range(NCPU):
+        try:
+            text = Path(f'/sys/devices/system/cpu/cpu{cpu}/topology/thread_siblings_list').read_text().strip()
+            out[cpu] = frozenset(expand(text))
+        except (OSError, ValueError):
+            out[cpu] = frozenset({cpu})
+    return out
+
+
+def whole_cores(cpus):
+    """`cpus` with every SMT sibling of each of them: what a unit pinned to `cpus` keeps from other bookings."""
+    siblings = _siblings()
+    return set().union(*(siblings.get(c, {c}) for c in cpus)) if cpus else set()
+
+
+def threads(spec):
+    """One logical CPU per physical core of a booked range, the lowest of each core, as a taskset list. A range that
+    splits a core is refused: half a core is not a booking a simulation can run on alone."""
+    cpus = expand(spec)
+    siblings = _siblings()
+    split = sorted(c for c in cpus if not siblings.get(c, {c}) <= cpus)
+    if split:
+        raise ValueError(f'{spec} splits the physical core(s) of CPU(s) {split}: book whole cores')
+    return ','.join(str(c) for c in sorted(cpus) if c == min(siblings.get(c, {c})))
+
+
 def expand(spec):
     out = set()
     for part in filter(None, spec.replace(' ', '').split(',')):
