-    return cpus | expand(SESSION_POOL)
+    return whole_cores(cpus | expand(SESSION_POOL))
+
+
+def unpinned():
+    """Active milan-* units whose main process may run on every CPU, besides the queue daemons: their work floats
+    onto booked cores, whose idle siblings are then not idle."""
+    listing = subprocess.run(['systemctl', '--user', 'list-units', 'milan-*', '--no-legend', '--state=active', '--plain'],
+                             capture_output=True, text=True).stdout.split('\n')
+    out = []
+    for name in (line.split(' ')[0] for line in listing):
+        if not name.endswith('.service') or name in ('milan-lane-queue.service', 'milan-review-queue.service'):
+            continue
+        pid = subprocess.run(['systemctl', '--user', 'show', '-p', 'MainPID', '--value', name],
+                             capture_output=True, text=True).stdout.strip()
+        aff = subprocess.run(['taskset', '-cp', pid], capture_output=True, text=True).stdout.rpartition(': ')[2].strip()
+        if pid and pid != '0' and aff and expand(aff) == set(range(NCPU)):
+            out.append(name.removesuffix('.service'))
+    return out
 
 
