+        for (auto peer : {kPeerAbove,kPeerBelow,kStationMac}) {
+            dut->enable_i=0; cyc(20); seen=frames.size();
+            dut->seed_valid_i=1; dut->seed_offset_i=0x100;
+            dut->enable_i=1;
