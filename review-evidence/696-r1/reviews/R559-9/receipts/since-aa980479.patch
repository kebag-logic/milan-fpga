+    check_.dec("621: restore CRF selection succeeds", restored.size() > 16 ? restored[16] >> 3 : 255, 0);
+    run_cycles(kClkHz / 10);
+    check_.dec("621: CRF source restored", dut_->rootp->milan_datapath__DOT__crf_clk_selected_r, 1);
+}
