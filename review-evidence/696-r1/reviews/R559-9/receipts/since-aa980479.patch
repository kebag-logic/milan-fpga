diff --git a/tb/verilator/csr/gen_lockstep.py b/tb/verilator/csr/gen_lockstep.py
new file mode 100644
index 000000000..6442c3262
--- /dev/null
+++ b/tb/verilator/csr/gen_lockstep.py
@@ -0,0 +1,181 @@
+#!/usr/bin/env python3
+# SPDX-FileCopyrightText: 2026 Kebag Logic
+# SPDX-License-Identifier: CERN-OHL-W-2.0
+"""Emit the read-path lockstep top for one CSR shape (lane M5 of #640).
+
+The lockstep leg runs the current hdl/common/csr/milan_csr.sv beside
+milan_csr_ref.sv, a frozen copy of the block as dev e8454e27 shipped it, with
+the read path that lane M5 restructured. Both instances see the SAME inputs
+every cycle and every output of the two is compared every cycle, so the
+reference is an oracle for the whole module, not only for the read path.
+
+The top is generated at build time, into the build directory, from the
+module's own port list, so it can never omit a port the block grows:
+  * every input except aclk/aresetn is a slice of one stimulus vector `stim`
+    the harness writes as a whole (randomised) or by field name;
+  * every DUT output is a slice of `dout`, which the harness reads by name;
+  * `mism[k]` is 1 while output k differs between the two instances.
+lockstep_ports.h carries the field tables the harness addresses them by, and
+the map's register addresses so random traffic can aim at mapped words.
+
+The reference is refused unless it is the e8454e27 block byte for byte
+(module name aside): its SHA-256 with `milan_csr_ref` read back as
+`milan_csr` must be REF_SHA256_C. The two port lists must be identical too;
+identical function behind a different interface is not this lane's claim.
+
+usage: gen_lockstep.py <dut.sv> <ref.sv> <outdir> NAME=VALUE...
+       (the NAME=VALUE pairs are the milan_csr parameters of the shape)
+"""
+
+import ast
+import hashlib
+import operator
+import re
+import sys
+from pathlib import Path
+
+#: SHA-256 of hdl/common/csr/milan_csr.sv at dev e8454e27 (git blob 3392e01a)
+REF_SHA256_C = "c3106a1410035f33eef9e634750ffc534be4d04293263bdbfd4ea144dfd523d8"
+REF_MODULE_C = "module milan_csr_ref #("
+DUT_MODULE_C = "module milan_csr #("
+#: inputs the harness drives as ports of their own, never through `stim`
+OWN_PORTS_C = ("aclk", "aresetn")
+PORT_RE = re.compile(r"^\s*(input|output)\s+(?:wire|logic)?\s*(\[[^\]]+\])?\s*(\w+)\s*,?",
+                     re.M)
+ADDR_RE = re.compile(r"\b(A_[A-Z0-9_]+)\s*=\s*'h([0-9A-Fa-f]+)")
+ARITH = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul,
+         ast.FloorDiv: operator.floordiv}
+
+
+def arith(expr: str, params: dict[str, int]) -> int:
+    """Evaluate a port-width bound: integers, parameters, + - * and /."""
+    def walk(node: ast.AST) -> int:
+        """One node of the bound's expression tree."""
+        if isinstance(node, ast.Constant) and isinstance(node.value, int):
+            return node.value
+        if isinstance(node, ast.Name) and node.id in params:
+            return params[node.id]
+        if isinstance(node, ast.BinOp) and type(node.op) in ARITH:
+            return ARITH[type(node.op)](walk(node.left), walk(node.right))
+        raise ValueError(f"port width bound not understood: {expr!r}")
+    return walk(ast.parse(expr.replace("/", "//"), mode="eval").body)
+
+
+def ports(text: str, params: dict[str, int]) -> list[tuple[str, str, int]]:
+    """[(direction, name, width)] of the module header in `text`.
+
+    The header runs from its `)(` line to its own `);` line; a `);` inside a
+    port comment does not end it.
+    """
+    start = re.search(r"^\)\(\s*$", text, re.M)
+    end = re.search(r"^\);\s*$", text[start.end():], re.M) if start else None
+    if not start or not end:
+        raise SystemExit("gen_lockstep: no `)(` ... `);` port header found")
+    head = text[start.end():start.end() + end.start()]
+    found = []
+    for m in PORT_RE.finditer(head):
+        width = 1
+        if m.group(2):
+            hi, lo = m.group(2)[1:-1].split(":")
+            width = arith(hi.strip(), params) - arith(lo.strip(), params) + 1
+        found.append((m.group(1), m.group(3), width))
+    declared = len(re.findall(r"^\s*(?:input|output)\b", head, re.M))
+    if len(found) != declared:
+        raise SystemExit(f"gen_lockstep: parsed {len(found)} ports of {declared} declared; "
+                         f"a port the top omits is an output nobody compares")
+    return found
+
+
+def checked_reference(ref_text: str) -> None:
+    """Refuse a reference that is not the frozen e8454e27 block."""
+    if ref_text.count(REF_MODULE_C) != 1:
+        raise SystemExit(f"gen_lockstep: the reference must declare {REF_MODULE_C!r} once")
+    digest = hashlib.sha256(ref_text.replace(REF_MODULE_C, DUT_MODULE_C).encode()).hexdigest()
+    if digest != REF_SHA256_C:
+        raise SystemExit(f"gen_lockstep: milan_csr_ref.sv is not the e8454e27 block "
+                         f"(sha256 {digest}, expected {REF_SHA256_C}); the oracle "
+                         f"must be the implementation the lane replaced, unedited")
+
+
+def emit_top(plist: list[tuple[str, str, int]], params: dict[str, int]) -> str:
+    """The SystemVerilog lockstep top for one shape."""
+    ins = [(n, w) for d, n, w in plist if d == "input" and n not in OWN_PORTS_C]
+    outs = [(n, w) for d, n, w in plist if d == "output"]
+    in_w = sum(w for _, w in ins)
+    out_w = sum(w for _, w in outs)
+    pmap = ", ".join(f".{k}({v})" for k, v in params.items())
+    lines = ["// GENERATED by tb/verilator/csr/gen_lockstep.py - do not edit",
+             "`default_nettype none", "module csr_lockstep_top (",
+             "  input  wire aclk,", "  input  wire aresetn,",
+             f"  input  wire [{in_w - 1}:0] stim,",
+             f"  output wire [{out_w - 1}:0] dout,",
+             f"  output wire [{len(outs) - 1}:0] mism", ");"]
+    for n, w in outs:
+        lines.append(f"  wire [{w - 1}:0] d_{n}, r_{n};")
+    for inst, mod, pre in (("dut", "milan_csr", "d_"), ("ref_i", "milan_csr_ref", "r_")):
+        conns = ["    .aclk(aclk)", "    .aresetn(aresetn)"]
+        off = 0
+        for n, w in ins:
+            conns.append(f"    .{n}(stim[{off} +: {w}])")
+            off += w
+        conns += [f"    .{n}({pre}{n})" for n, _ in outs]
+        lines.append(f"  {mod} #({pmap}) {inst} (")
+        lines.append(",\n".join(conns))
+        lines.append("  );")
+    off = 0
+    for k, (n, w) in enumerate(outs):
+        lines.append(f"  assign dout[{off} +: {w}] = d_{n};")
+        lines.append(f"  assign mism[{k}] = (d_{n} != r_{n});")
+        off += w
+    lines += ["endmodule", "`default_nettype wire", ""]
+    return "\n".join(lines)
+
+
+def emit_header(plist: list[tuple[str, str, int]], addrs: list[int]) -> str:
+    """The C++ field tables the harness addresses the vectors by."""
+    ins = [(n, w) for d, n, w in plist if d == "input" and n not in OWN_PORTS_C]
+    outs = [(n, w) for d, n, w in plist if d == "output"]
+    lines = ["// GENERATED by tb/verilator/csr/gen_lockstep.py - do not edit",
+             "#pragma once",
+             "struct LockField { const char* name; int off; int width; };"]
+    for tag, fields in (("IN", ins), ("OUT", outs)):
+        lines.append(f"static const LockField LOCK_{tag}[] = {{")
+        off = 0
+        for n, w in fields:
+            lines.append(f"  {{\"{n}\", {off}, {w}}},")
+            off += w
+        lines.append("};")
+        lines.append(f"static const int LOCK_{tag}_N = {len(fields)};")
+        lines.append(f"static const int LOCK_{tag}_W = {off};")
+    lines.append("static const unsigned LOCK_ADDRS[] = {")
+    lines += [f"  0x{a:03X}u," for a in addrs]
+    lines.append("};")
+    lines.append(f"static const int LOCK_ADDRS_N = {len(addrs)};")
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    """Check the reference, then write the top and the header for one shape."""
+    if len(argv) < 4:
+        print(__doc__)
+        return 2
+    dut_text = Path(argv[1]).read_text()
+    ref_text = Path(argv[2]).read_text()
+    outdir = Path(argv[3])
+    params = {}
+    for pair in argv[4:]:
+        name, value = pair.split("=", 1)
+        params[name] = int(value, 0)
+    checked_reference(ref_text)
+    plist = ports(dut_text, params)
+    if plist != ports(ref_text, params):
+        raise SystemExit("gen_lockstep: the block's port list differs from the reference's")
+    addrs = sorted({int(v, 16) for _, v in ADDR_RE.findall(dut_text)})
+    outdir.mkdir(parents=True, exist_ok=True)
+    (outdir / "csr_lockstep_top.sv").write_text(emit_top(plist, params))
+    (outdir / "lockstep_ports.h").write_text(emit_header(plist, addrs))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
diff --git a/tb/verilator/csr/lock_mutants.py b/tb/verilator/csr/lock_mutants.py
new file mode 100644
index 000000000..e1e515be3
--- /dev/null
+++ b/tb/verilator/csr/lock_mutants.py
@@ -0,0 +1,199 @@
+#!/usr/bin/env python3
+# SPDX-FileCopyrightText: 2026 Kebag Logic
+# SPDX-License-Identifier: CERN-OHL-W-2.0
+"""Planted defects for the CSR read-path lockstep: prove each named check can fail.
+
+sim_lock.cpp runs the current milan_csr beside the frozen e8454e27 block and
+grades five named checks (its banner). This driver plants ONE defect at a time
+into a copy of hdl/common/csr/milan_csr.sv, rebuilds the 1x1 lockstep leg
+through the Makefile's own recipe (`make lock1`, or `make lock8` for a defect
+only an extra context can reach, with LOCK_SRC and the leg's build directory
+overridden) and runs it. A mutant is caught only when the harness fails by its
+own verdict AND the check named for that defect class is among the failures;
+a crash, an abort or a failure of some other check is not a catch. The
+positive control is the clean leg `make` just built (obj_lock1), re-run here,
+or rebuilt when it is older than any input of its recipe.
+
+The classes are the lane's (issue #640, lane M5): a wrong address decode, a
+torn multi-word snapshot, a stale snapshot after an update and a reset-value
+drift. Two more defects land in the lane's own stage-1/stage-2 change.
+
+What bounds a run. The harness is cycle-bounded by construction (every AXI
+wait has a cycle guard) and this driver sets no host-time deadline; the
+sweep's per-suite guard in scripts/run_all_suites.sh is the host-time bound,
+and the SIGTERM handler turns that kill into an exit that removes the
+temporary directory.
+
+Usage: make -C tb/verilator/csr   (or python3 lock_mutants.py from there)
+Exit 0 = every mutant was caught and the clean leg still passes.
+"""
+
+import signal
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+CSR_RTL = HERE / "../../../hdl/common/csr/milan_csr.sv"
+CLEAN_MDIR = HERE / "obj_lock1"
+EXE_NAME = "Vcsr_lock"
+#: every input of the clean recipe: a clean binary older than any is stale
+CLEAN_INPUTS = [CSR_RTL, HERE / "milan_csr_ref.sv", HERE / "gen_lockstep.py",
+                HERE / "sim_lock.cpp", HERE / "Makefile",
+                HERE / "../../common/verilator_harness.hpp"]
+sys.path.insert(0, str(HERE / "../../../scripts"))
+from suite_tally import log_reports_failure  # noqa: E402
+
+# (name, the ONE text it replaces, its replacement, the check it must fail,
+#  the leg that can reach it)
+MUTATIONS = [
+    ("wrong address decode: IRQ_RAW's live word answers at IRQ_MASK",
+     "      A_IRQ_RAW:    live_mux = irq_status;",
+     "      A_IRQ_MASK:   live_mux = irq_status;",
+     "decode", "lock1"),
+    ("torn snapshot: window CNT3 reads its live counter, not the SNAP word",
+     "              SK_RAW_C:    strm_mux = snap_shadow_r[1 + 32'(coff[5:2])];",
+     "              SK_RAW_C:    strm_mux = (coff[5:2] == 4'd3) ? i_avtprx_cnt10[3*32 +: 32]\n"
+     "                                      : snap_shadow_r[1 + 32'(coff[5:2])];",
+     "snapshot-coherence", "lock1"),
+    ("stale snapshot: a listener SNAP after a talker SNAP keeps the POISON kind",
+     "              for (int w = 1; w < 11; w++) snap_kind_r[w] <= SK_RAW_C;\n",
+     "",
+     "snapshot-freshness", "lock1"),
+    ("stale snapshot: an extra listener's burst word keeps its previous kind",
+     "                snap_kind_r[snap_wi_r]   <= SK_RAW_C;\n",
+     "",
+     "snapshot-freshness", "lock8"),
+    ("reset-value drift: the CNT kinds reset to POISON instead of zero",
+     "      for (int w = 0; w < 12; w++) snap_kind_r[w] <= SK_ZERO_C;\n    end else begin",
+     "      for (int w = 0; w < 12; w++) snap_kind_r[w] <= SK_POISON_C;\n    end else begin",
+     "reset-values", "lock1"),
+    ("stage 1: the shadow word is not zeroed under a live or window claim",
+     "    if (!aresetn || (rd_pend && !shadow_rd_w))",
+     "    if (!aresetn)",
+     "decode", "lock1"),
+    ("stage 1: the window's range leaf answers 0 instead of the window's word",
+     "          live_mux = strm_mux;",
+     "          live_mux = 32'h0;",
+     "decode", "lock1"),
+]
+
+
+def build(rtl_path: Path, mdir: Path, leg: str = "lock1") -> Path | None:
+    """Build a lockstep leg against `rtl_path` through the suite's own recipe;
+    the executable, or None when the recipe failed or left none."""
+    out = subprocess.run(
+        ["make", "-s", "-C", str(HERE), leg, f"LOCK_SRC={rtl_path}",
+         f"{leg.upper()}_MDIR={mdir}"],
+        capture_output=True, text=True, check=False)
+    exe = mdir / EXE_NAME
+    if out.returncode != 0 or not exe.is_file():
+        sys.stdout.write(out.stdout[-2000:])
+        sys.stdout.write(out.stderr[-2000:])
+        return None
+    return exe
+
+
+def is_fresh(exe: Path) -> bool:
+    """True when `exe` exists and is no older than any input of its recipe."""
+    return exe.is_file() and all(exe.stat().st_mtime >= src.stat().st_mtime
+                                 for src in CLEAN_INPUTS)
+
+
+def run_harness(exe: Path) -> tuple[int, str]:
+    """(rc, stdout) of one run of the harness, with no host deadline: it is
+    cycle-bounded (module docstring)."""
+    out = subprocess.run([str(exe)], cwd=str(HERE), capture_output=True,
+                         text=True, check=False)
+    return out.returncode, out.stdout + out.stderr
+
+
+def failed_checks(out: str) -> list[str]:
+    """The names of the checks the harness printed as failed, in order."""
+    return [line.strip()[len("[FAIL]"):].split(":")[0].strip()
+            for line in out.splitlines() if line.strip().startswith("[FAIL]")]
+
+
+def verdict(rc: int, out: str, must_fail: str | None) -> str:
+    """'pass', 'caught', or why the run is not evidence."""
+    reason, failed = log_reports_failure(out)
+    if rc == 0 and not failed:
+        return "pass"
+    if rc == 0 and failed:
+        return f"exited 0 but {reason} - a masked verdict is not evidence"
+    if failed:
+        if must_fail and must_fail not in failed_checks(out):
+            return f"failed, but not the named check ({must_fail!r})"
+        return "caught"
+    if rc < 0:
+        return f"died by signal {-rc} with no harness verdict - a crash is not a catch"
+    return f"exited {rc} with no harness verdict - a DUT abort is not a catch"
+
+
+def run_mutant(src: str, mutation: tuple[str, str, str, str, str], work: Path,
+               n: int) -> bool:
+    """Plant one mutation, build and run its leg; True when it was caught."""
+    name, pattern, replacement, breaks, leg = mutation
+    if src.count(pattern) != 1:
+        print(f"[FAIL] mutation {name!r}: its pattern appears {src.count(pattern)} "
+              f"time(s) in {CSR_RTL.name}, expected exactly 1. The RTL moved and this "
+              f"mutant is no longer mutating anything - fix the pattern, do not delete the arm.")
+        return False
+    mpath = work / f"m{n}" / "milan_csr.sv"
+    mpath.parent.mkdir()
+    mpath.write_text(src.replace(pattern, replacement))
+    exe = build(mpath, work / f"m{n}" / "obj", leg)
+    if exe is None:
+        print(f"[FAIL] mutation {name!r} did not compile; a mutant that cannot build "
+              f"proves nothing about the harness")
+        return False
+    rc, out = run_harness(exe)
+    answer = verdict(rc, out, breaks)
+    if answer == "caught":
+        print(f"[PASS] mutant caught ({leg}): {name} - fails \"{breaks}\"")
+        print(f"    it failed {', '.join(failed_checks(out))}")
+        return True
+    if answer == "pass":
+        print(f"[FAIL] mutant SURVIVED: {name}. The harness does not prove \"{breaks}\".")
+    else:
+        print(f"[FAIL] mutant {name!r} {answer}")
+    return False
+
+
+def main() -> int:
+    """Run the positive control and every mutant; 1 if any mutant survived."""
+    def on_sigterm(*_: object) -> None:
+        """Exit on a kill so the temporary directory is removed."""
+        sys.exit(143)
+
+    signal.signal(signal.SIGTERM, on_sigterm)
+    src = CSR_RTL.read_text()
+    passes = 0
+    fails = 0
+    with tempfile.TemporaryDirectory(prefix="csr-lock-mutants-") as td:
+        work = Path(td)
+        exe = CLEAN_MDIR / EXE_NAME
+        if not is_fresh(exe):
+            print(f"[INFO] {exe.relative_to(HERE)} is missing or older than its "
+                  f"sources: the positive control is rebuilt")
+            exe = build(CSR_RTL.resolve(), work / "clean")
+        answer = verdict(*run_harness(exe), None) if exe else "did not compile"
+        if answer == "pass":
+            passes += 1
+            print("[PASS] the unmutated block still passes the lockstep leg")
+        else:
+            fails += 1
+            print(f"[FAIL] the unmutated block does NOT pass ({answer}) - every "
+                  f"mutant result is meaningless")
+        for n, mutation in enumerate(MUTATIONS):
+            if run_mutant(src, mutation, work, n):
+                passes += 1
+            else:
+                fails += 1
+    print(f"\n{passes + fails} checks: {passes} PASS, {fails} FAIL")
+    return 1 if fails else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tb/verilator/csr/milan_csr_ref.sv b/tb/verilator/csr/milan_csr_ref.sv
new file mode 100644
index 000000000..a7c6972a5
--- /dev/null
+++ b/tb/verilator/csr/milan_csr_ref.sv
@@ -0,0 +1,3174 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Kebag Logic
+ * SPDX-License-Identifier: CERN-OHL-W-2.0
+ */
+
+/*
+------------------------------------------------------------------------------
+  File        : milan_csr.sv
+  Author      : Kebag Logic
+
+  Date        : 2026-07-01
+  Description : AXI4-Lite control/status-register (CSR) block for the Milan TSN
+                network interface. This is the memory-mapped control plane
+                (REQUIREMENTS.md REQ-CSR-*) that bare-metal firmware uses; it
+                turns the previously compile-time-only TSN knobs (MAC config,
+                PTP clock control, the fabric media and protocol faces) into
+                runtime-writable registers, and exposes MAC statistics, link
+                status and interrupts back to software.
+
+                THE 802.1Q CLASSIFIER / 802.1Qav CBS FACES ARE WRITE-ONLY
+                SCRATCH SINCE VERSION 0x0002_0056. traffic_controller_802_1q
+                and the ptp_ts_top record stampers are no longer instantiated
+                by milan_datapath (their only input was the retired host
+                plane's TX), so CLS_* (0x300) and the CBS window (0x400)
+                still store and read back what software writes but reach
+                no logic. PTP_INGRESS/EGRESS_LAT (0x540/0x544) are readable,
+                inert scratch: plain RW with no timestamp-correction consumer
+                at VERSION 0x0002_0057. CAP.CBS and
+                IRQ_STATUS[0] tx_ts_ready are structural zero. The output
+                ports that carried them are deleted, not tied.
+
+                THE LEGACY 1722.1 / SRP GROUPS ARE INERT SINCE 2026-08-13.
+                The RTL that consumed them - this repository's own ADP
+                advertiser, AECP/AEM engine, ACMP talker and listener, and
+                lwSRP applicant - is DELETED; the protocol-processor submodule
+                is the control plane, reached through the 0x920 window. THE
+                REGISTERS STAY, because the register map is an ABI and every
+                board script writes it, but what they do changed and the
+                change is not uniform. Three kinds, all recorded per word in
+                docs/reference/REGISTER_MAP.md:
+
+                  * STRUCTURAL ZERO - the status word's source is gone, so it
+                    reads 0 and a reader must not mistake that for "idle":
+                    the A_ADP_DIAG counters and advertiser state, every AECP
+                    status word (lock, config, cmd/resp counts, BDBG 0x768,
+                    AEMP 0x7C8 status), the ACMP listener's state-machine
+                    fields and ACMPL_DBG, the ACMP cmd/resp counts, the lwSRP
+                    MRPDU counters, the journal status/sequence (0x7B8), and
+                    both 0x800-window context-table ports.
+                  * ACCEPTED AND DISCARDED - the write lands nowhere and
+                    nothing observable changes: the AEM patch port, AS_PATH
+                    staging, the 0x7A0 bind-restore master, the journal
+                    ingest, the lwSRP row-provisioning words, and the five
+                    ADPDU fields the processor holds as internal constants
+                    (entity_capabilities, valid_time, association_id,
+                    controller_capabilities, interface_index).
+                  * STILL LIVE, REPOINTED - available_index, ACMP talker
+                    active and the listener BOUND record, the SRP Domain
+                    pair, granted slope and over-limit bit: all republished
+                    from the processor's class-D face.
+
+                The full register map / ABI is documented in
+                docs/reference/REGISTER_MAP.md and mirrored by the self-checking harness
+                in tb/verilator/csr. Register groups:
+
+                  0x000  ID / VERSION / CAPABILITIES / IRQ
+                  0x100  MAC control + status
+                  0x200  Statistics (RMON) snapshot window
+                  0x300  802.1Q classifier (PCP->TC map; write-only scratch)
+                  0x400  802.1Qav CBS, per queue (stride 0x20; write-only scratch)
+                  0x500  PTP hardware clock (adjfine/adjtime/settime/gettime)
+
+                Design notes:
+                  * AXI4-Lite slave uses the combinational-ready, single-
+                    outstanding pattern: a transfer commits on the same rising
+                    edge that *READY is asserted, so a master that drops *VALID
+                    right after the handshake still commits (no lost writes).
+                  * Configuration values leave on flat o_* output ports for the
+                    rest of milan_datapath to consume. Status (link, RMON counters,
+                    PTP TOD) and event pulses arrive on i_* input ports.
+                  * Command strobes (PTP settime/adjtime/snapshot, stats
+                    snapshot/reset) are emitted as single-cycle o_*_cmd_* /
+                    o_stats_* pulses. Fields consumed in the gtx_clk (PTP/TX)
+                    domain must be CDC-synchronised at the consumer using these
+                    apply strobes (REQ-CSR-03); this block is purely in the
+                    aclk (AXI) domain.
+                  * s_axi_wstrb is intentionally ignored: the ABI mandates full
+                    32-bit register writes.
+
+  Company     : Kebag Logic
+  Project     : Milan FPGA Platform
+------------------------------------------------------------------------------
+*/
+
+`default_nettype none
+
+module milan_csr_ref #(
+  parameter int NUM_QUEUES  = 5,             //! Number of HW traffic-class queues (reported in CAP.num_queues); q4 = highest priority
+  parameter int ADDR_WIDTH  = 16,            //! Byte-address width of the AXI-Lite window (16 => 64 KB)
+  parameter int N_LISTENERS_P = 1,           //! listener stream contexts addressable by the 0x800 window (A_STRM_SEL dir=0); idx >= N reads 0 / writes ignored
+  parameter int N_TALKERS_P   = 1,           //! talker stream contexts (A_STRM_SEL dir=1)
+  parameter int unsigned SRP_LSN0_ROW_P = 0, //! dedicated listener-0 lwSRP ctx row (0 = feature absent: the legacy row-0 alias is all sink 0 has)
+  //! chmap map-RAM READBACK capability, declared by the INSTANTIATOR because
+  //! only the integration knows whether the RAM's read port is actually
+  //! wired: [0] = render (RMAP, KL_chan_map_render) readback connected,
+  //! [1] = capture (CMAP, KL_chan_map_capture) readback connected AND
+  //! carrying the {loop_fed, loop_mapped} loopback mask. DEFAULT 0 = ABSENT,
+  //! which is the honest default: an instantiation that does not connect
+  //! o_chmap_rd_*/i_chmap_rd_* must not be able to report a map word. The
+  //! value is published in CHMAP_SNAP[9:8] so software reads UNSUPPORTED
+  //! instead of a structural zero (methodology R5; the STATS_CAP 0x204 rule).
+  parameter int unsigned CHMAP_RDBK_P = 0,
+  //! PHC clock frequency of the domain ptp_ts_top's counter ticks in.
+  //! Sets the PTP_INCR RESET value = the true clock period in Q8.24 ns
+  //! (derive, never mirror: the historic hardcoded 8.0 ns was the
+  //! RGMII-era 125 MHz assumption and made every other domain's free-run
+  //! PHC scale-wrong until software wrote PTP_INCR - the t532 wire-scale
+  //! audit's in-tree find). The default keeps the standalone contract
+  //! (125 MHz -> 0x08000000); milan_datapath overrides with its own
+  //! MILAN_CLK_FREQ_HZ so the two can never disagree.
+  parameter int unsigned MILAN_CLK_FREQ_HZ_P = 125_000_000,
+  //! When set, the gPTP publication bank owns the legacy GM/parent/pdelay
+  //! read addresses. Each 64-bit identity is snapshotted across a two-half
+  //! read in either order. Default 0 retains the addresses as an ownerless,
+  //! write-inert ABI; milan_datapath passes its product option.
+  parameter bit GPTP_PLANE_EN_P = 1'b0,
+  //! Declared by the INSTANTIATOR, like CHMAP_RDBK_P: 1 only when the PHC
+  //! really elaborated the PPS comparator. It is published RO in
+  //! PTP_PPS_CTRL[16] so software reads UNSUPPORTED instead of a structural
+  //! zero, and so "not built" can never be mistaken for "built and idle".
+  parameter bit PPS_P = 1'b0,
+  //! PPS pulse width in PHC clock CYCLES (not seconds), published RO in
+  //! PTP_PPS_WIDTH. The reader converts with the PHC frequency it already
+  //! knows from PTP_INCR; nothing here mirrors a per-board constant.
+  parameter int unsigned PPS_WIDTH_CYC_P = 125_000,
+  //! Value returned by the read-only 32-bit VERSION register. [31:16] is the major
+  //! redesign number; [15:0] is the flat, continuously increasing compliance
+  //! revision. The ENTITY firmware_version renders this as major.minor.rev.
+  //! 0x005C corrects what three RO status fields MEAN (#471, #472).
+  //! LWSRP_STATUS 0x694 [3:0] describes ONE subject again - the Listener
+  //! attribute registered on talker source 0 - so [1:0] is its four-packed
+  //! value, [2] "registered" counts Asking Failed IN, and [3] "ready" is the
+  //! Ready/Ready Failed pair; the substituted plane had [2] reading bit 1 of
+  //! that value and [1:0]/[3] describing sink 0's own declaration instead.
+  //! ACMPL_STATE 0x6A4 [6] "TalkerAdvertise registered" compares sink 0's
+  //! registered Talker code against ADVERTISE, where it had taken bit 1, the
+  //! FAILED bit. No CSR address, width or access moves: 0x005B's
+  //! SET_SAMPLING_RATE list check is unchanged and this is a value change in
+  //! four bits of two existing read-only words. The register occupies four
+  //! bytes and no CSR addresses move.
+  //!
+  //! 0x005E (issue #358) ADDS ONE ADDRESS: `A_GPTP_LAT` at 0x7F0, RO live,
+  //! writes inert, option OFF zero - the timestamp latency corrections the
+  //! fabric gPTP plane is applying, {ingress_ns[31:16], egress_ns[15:0]}.
+  //! Nothing else moves, and the ONLY live consumer of a latency correction
+  //! remains the plane: 0x540 and 0x544 stay inert scratch. 0x005D was never
+  //! released: a parallel lane held it and landed as 0x005F.
+  //!
+  //! 0x005F lands the saved-state SNAPSHOT OWNERSHIP contract (#484,
+  //! docs/design/SAVED_STATE_SNAPSHOT_OWNERSHIP.md). PP_STAT 0x924 gains
+  //! [11] nvm_pend: accepted work that no verified slot holds and nvm_dirty
+  //! does not report - a change the producer still holds, or a record whose
+  //! logical write has not completed - so the durable reading of the
+  //! saved-state page's 9.3 becomes (backed 1, dirty 0, stale 0) AND pend 0.
+  //! PP_STAT[11] read 0 before and was reserved. The backend's own status
+  //! word behind PP_NVM_STAT 0x93C gains a constant contract tag 0xC3 in
+  //! [31:24] and the capture face the contract defines - [23] unres, [22]
+  //! nvm_pend, [21] arm refused, [20] ack refused, [19] attested, [18] valid,
+  //! [17] hold, [16] open, [11] reload refused, [3] load pending, [2] load
+  //! accepted - and PP_NVM_SEL 0x934 gains word 5, the capture identity, and
+  //! words 8 to 15, the per-record ownership vector; [8] nvm_dirty there now
+  //! means the COMMITTABLE image work that drives a commit. The strobe word
+  //! gains [3] ARM, [4] ATTEST, [5] RELEASE and [6] RELOAD, and [1]'s
+  //! acknowledgement must quote the capture identity in [31:16]. 0x005C's
+  //! SRP status words are unchanged. No CSR ADDRESS, width or access moves:
+  //! this is one new PP_STAT bit and new meaning inside the backend's
+  //! existing indexed window. The register occupies four bytes.
+  //!
+  //! Historical 0x0060 behavior before #502's live-write correction:
+  //! 0x0060 WIDENS what PP_STAT 0x924 [11] nvm_pend REPORTS (#496, and
+  //! protocol-processor issue 90, merged). 0x005F defined the bit but could
+  //! only raise it for a dynamic-state field held by the AECP store, because
+  //! the pinned processor exported nothing else; two of its terms read a
+  //! constant zero. The pinned processor now exports the binding manager's
+  //! unflushed sinks and the AECP commit marks, so [11] also reads 1 while a
+  //! binding accepted INSIDE the manager's debounce has not yet committed,
+  //! and after a committed channel-map (ADD/REMOVE_AUDIO_MAPPINGS) or user
+  //! name (SET_NAME) change, which no record writer materializes and which
+  //! therefore clears only at reset. For a controller host this makes the
+  //! saved-state page's 9.3 durable reading - (backed 1, dirty 0, stale 0)
+  //! AND pend 0 - honest for those three cases: a host that polled it over
+  //! one of them was told durable while the change was not. Nothing here
+  //! loosens the bit: 0 still means no accepted work is outstanding.
+  //! #502 closes the original marks' program-tail window: accepted name
+  //! writes and actual parent phase-5 map writes now raise pending.
+  //! Unchanged maps raise nothing; marks still delimit command completion.
+  //! No CSR address, width, access or OTHER field moves. PP_NVM_STAT
+  //! 0x93C, PP_NVM_SEL 0x934 and 0x005C's SRP status words are unchanged.
+  //! The register occupies four bytes.
