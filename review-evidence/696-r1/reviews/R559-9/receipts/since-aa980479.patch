+      lwsrp_dmlo <= LWSRP_DMAC_LO_RST_C;
+      lwsrp_dmhi <= LWSRP_DMAC_HI_RST_C;
+      lwsrp_tspec<= LWSRP_TSPEC_RST_C;
+      lwsrp_lat  <= LWSRP_LATENCY_RST_C;
