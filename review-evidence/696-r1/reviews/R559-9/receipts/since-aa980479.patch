+      crf_sidlo   <= 32'h0;
+      crf_sidhi   <= 32'h0;
+      crft_ctrl   <= 32'h0;
+      crft_sidlo  <= 32'h0;
+      crft_sidhi  <= 32'h0;
+      crft_dmlo   <= 32'h0;
+      crft_dmhi   <= 32'h0;
+      tone_ctrl  <= 32'h0;
+      mcsrv_ctrl <= 32'h0;
+      ltap_en_r  <= 1'b1;   //! latency taps measure by default
+      ltap_clr_p <= 1'b0;
+      chmap_ctrl <= 32'h0; chmap_sel <= 32'h0; chmap_word <= 32'h0;
+      chmap_commits <= 16'h0; chmap_refused <= 8'h0; chmap_wr_p <= 1'b0;
