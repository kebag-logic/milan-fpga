diff --git a/sw/firmware/ctrl/plat/ctrl_split.ld b/sw/firmware/ctrl/plat/ctrl_split.ld
new file mode 100644
index 000000000..f05021cdd
--- /dev/null
+++ b/sw/firmware/ctrl/plat/ctrl_split.ld
@@ -0,0 +1,38 @@
+/* SPDX-FileCopyrightText: 2026 Kebag Logic */
+/* SPDX-License-Identifier: CERN-OHL-W-2.0 */
+/* ctrl_split.ld - the control firmware in the split placement's block RAM
+ * (#640 M8a). The firmware owns the reset entry: _start is the first word of
+ * rom, the CPU's reset address. rom holds the load image (.text, .rodata and
+ * the initial values of .data); sram holds .data, .bss and the stack.
+ * regions.ld is sw/litex/ctrl_memory.py's, the one statement of the map, and
+ * the SoC sizes both regions' block RAM from the image this script links. */
+OUTPUT_ARCH(riscv)
+ENTRY(_start)
+INCLUDE regions.ld
+
+SECTIONS
+{
+	.text : { KEEP(*(.text.start)) *(.text .text.*) } > rom
+	.rodata : ALIGN(4) { *(.rodata .rodata.* .srodata .srodata.*) } > rom
+	.data : ALIGN(4)
+	{
+		_fdata = .;
+		*(.data .data.* .sdata .sdata.*) *(.got .got.plt)
+		. = ALIGN(4);
+		_edata = .;
+	} > sram AT > rom
+	_fdata_rom = LOADADDR(.data);
+	.bss (NOLOAD) : ALIGN(4)
+	{
+		_fbss = .;
+		*(.bss .bss.* .sbss .sbss.* COMMON)
+		. = ALIGN(4);
+		_ebss = .;
+	} > sram
+	.stack (NOLOAD) : ALIGN(16)
+	{
+		. += 8192;
+		_stack_top = .;
+	} > sram
+	/DISCARD/ : { *(.comment) *(.note .note.*) *(.eh_frame .eh_frame.*) }
+}
diff --git a/sw/firmware/ctrl/plat/ctrl_split_start.S b/sw/firmware/ctrl/plat/ctrl_split_start.S
new file mode 100644
index 000000000..97ebe7cd1
--- /dev/null
+++ b/sw/firmware/ctrl/plat/ctrl_split_start.S
@@ -0,0 +1,28 @@
+/* SPDX-FileCopyrightText: 2026 Kebag Logic */
+/* SPDX-License-Identifier: CERN-OHL-W-2.0 */
+/* ctrl_split_start.S - the control firmware's reset entry in the split
+ * placement (#640 M8a, ctrl_split.ld). No BIOS runs first: the stack goes at
+ * the top of its reservation, .data is copied from its initial values in rom
+ * and .bss is cleared, so a CPU reset re-enters with the state of power-on.
+ * Then main; a return from it parks the hart. */
+	.section .text.start, "ax"
+	.global _start
+_start:
+	lla	sp, _stack_top
+	lla	t0, _fdata_rom
+	lla	t1, _fdata
+	lla	t2, _edata
+1:	bgeu	t1, t2, 2f
+	lw	t3, 0(t0)
+	sw	t3, 0(t1)
+	addi	t0, t0, 4
+	addi	t1, t1, 4
+	j	1b
+2:	lla	t0, _fbss
+	lla	t1, _ebss
+3:	bgeu	t0, t1, 4f
+	sw	zero, 0(t0)
+	addi	t0, t0, 4
+	j	3b
+4:	call	main
+5:	j	5b
