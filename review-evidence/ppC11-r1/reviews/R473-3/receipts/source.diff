+    localparam int unsigned SNK_W_C = (N_SINKS_P > 1) ? $clog2(N_SINKS_P) : 1
+) (
+    input  wire         clk_i,
+    input  wire         rst_n,
+    input  wire         p2p_i,
+    input  wire  [47:0] own_mac_i,
+
+    // shared decoder event bus (fans to both modules)
+    input  wire         evt_valid_i,
