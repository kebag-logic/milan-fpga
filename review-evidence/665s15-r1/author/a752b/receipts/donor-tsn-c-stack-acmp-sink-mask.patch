diff --git a/include/acmp.h b/include/acmp.h
index 6ff13dd..19d41f8 100644
--- a/include/acmp.h
+++ b/include/acmp.h
@@ -160,6 +160,15 @@ extern "C" {
 #ifndef ACMP_MAX_SOURCES
 #define ACMP_MAX_SOURCES 16u
 #endif
+// One bit a sink: the sinks an owed frame holds a change notice back for. It
+// follows ACMP_MAX_SINKS, so a build past 32 sinks keeps every sink's bit.
+#if ACMP_MAX_SINKS > 64u
+#error "ACMP_MAX_SINKS: an owed frame's release mask holds at most 64 sinks"
+#elif ACMP_MAX_SINKS > 32u
+typedef uint64_t acmp_sink_mask;
+#else
+typedef uint32_t acmp_sink_mask;
+#endif
 #define ACMP_MAX_INTERFACES 4u
 #define ACMP_OWED_MAX 8u
 #define ACMP_AVTP_VERSION 0u            // IEEE 1722.1-2021 8.2.1.3; IEEE 1722.1-2021 6.2.2.3
@@ -397,7 +406,7 @@ struct acmp_sink {
 struct acmp_owed {
 	uint8_t interface;
 	uint8_t probe_of;
-	uint32_t release;
+	acmp_sink_mask release;
 	uint8_t frame[ACMP_FRAME_BYTES];
 };
 
