`default_nettype none
module probe_top (
  input  wire        axis_clk,
  input  wire        axis_resetn,
  input  wire        eng_we_i,       // engine phc_addend_we_o (registered)
  input  wire [31:0] eng_addend_i,   // engine phc_addend_o
  input  wire        eng_level_i,    // engine phc_slew_active_o (registered)
  output wire [63:0] ptp_now_o,
  output wire        eff_o
);
  // KL_gptp_shadow.sv:748-749 equivalent
  logic signed [31:0] gptp_adj_w;
  always_ff @(posedge axis_clk)
    if (!axis_resetn) gptp_adj_w <= '0; else if (eng_we_i) gptp_adj_w <= $signed(eng_addend_i);
  wire gptp_slew_active_w = eng_level_i;
// BLOCK
  assign eff_o = gptp_slew_eff_w;
  wire        t_en; wire [31:0] t_incr, t_adj; wire [63:0] t_tod, t_off, t_ppst;
  wire        t_ld, t_adjc, t_snap, t_ppse, t_ppsa;
  wire [63:0] snap; wire snap_v;
  ptp_csr_sync #(.TS_WIDTH(64), .INCR_WIDTH(32), .PPS_P(1'b0)) ptp_sync (
    .aclk(axis_clk), .aresetn(axis_resetn), .a_enable(1'b1), .a_incr(32'h0800_0000),
    .a_adj(unsigned'(gptp_adj_w)), .a_tod_wr('0), .a_offset('0), .a_cmd_load(1'b0),
    .a_cmd_adjust(1'b0), .a_cmd_snapshot(1'b0), .a_tod_rd(), .a_tod_rd_valid(),
    .a_pps_enable(1'b0), .a_pps_target_ns('0), .a_pps_arm(1'b0), .a_pps_target_rd_ns(),
    .ts_clk(axis_clk), .ts_resetn(axis_resetn), .t_enable(t_en), .t_incr(t_incr),
    .t_adj(t_adj), .t_tod_wr(t_tod), .t_cmd_load(t_ld), .t_offset(t_off),
    .t_cmd_adjust(t_adjc), .t_cmd_snapshot(t_snap), .t_tod_snapshot(snap),
    .t_tod_snapshot_valid(snap_v), .t_pps_enable(t_ppse), .t_pps_target_ns(t_ppst),
    .t_pps_arm(t_ppsa), .t_pps_target_live_ns('0));
  timestamp_counter #(.COUNTER_WIDTH(64), .INCR_WIDTH(32), .FRAC_WIDTH(24), .PPS_P(1'b0)) ts_counter (
    .clk(axis_clk), .resetn(axis_resetn), .enable_i(t_en), .incr_i(t_incr), .adj_i(t_adj),
    .tod_wr_i(t_tod), .cmd_load_i(t_ld), .offset_i(t_off), .cmd_adjust_i(t_adjc),
    .cmd_snapshot_i(t_snap), .pps_enable_i(1'b0), .pps_target_ns_i('0), .pps_arm_i(1'b0),
    .timestamp_out(ptp_now_o), .tod_snapshot_o(snap), .tod_snapshot_valid_o(snap_v),
    .pps_o(), .pps_target_ns_o());
endmodule
`default_nettype wire
