+// DIAG (#643 item 1, scratch): the law over absolute PDU numbers, the ids
+// wrapping at 4096, every window shorter than that and cleared before it
+void TdmRenderHarness::diag_law(long first_pdu, long last_pdu, const char* tag) {
+    const double lo = kRenderSetpointEvt * kTickCycles;
+    const double hi = (kRenderSetpointEvt + 1) * kTickCycles
+                    + static_cast<double>(kBandSlackCycles);
+    long n = 0, in_band = 0, fill_ok = 0, dmin = 0, dmax = 0;
+    int fmin = 99, fmax = -1;
+    for (long p = first_pdu; p < last_pdu; p++) {
+        const size_t i = static_cast<size_t>(p & 0xFFF);
+        if (accept_at[i] < 0 || pop_at[i] < 0) continue;
+        const long d = pop_at[i] - accept_at[i];
+        if (n == 0 || d < dmin) dmin = d;
+        if (n == 0 || d > dmax) dmax = d;
+        if (static_cast<double>(d) > lo && static_cast<double>(d) <= hi) ++in_band;
+        if (fill_at[i] == kRenderSetpointEvt) ++fill_ok;
+        if (fill_at[i] < fmin) fmin = fill_at[i];
+        if (fill_at[i] > fmax) fmax = fill_at[i];
+        ++n;
+    }
+    std::printf("  [diag] %s off=%ld: n %ld fill_ok %ld in_band %ld fill %d..%d "
+                "delay %.3f..%.3f ticks err_now %d\n", tag, diag_off, n, fill_ok,
+                in_band, fmin, fmax, static_cast<double>(dmin) / kTickCycles,
+                static_cast<double>(dmax) / kTickCycles,
+                static_cast<int>(static_cast<int16_t>(
+                    dut->rootp->milan_datapath__DOT__mga_err_w)));
+    long pn = 0, pfill_ok = 0, pband = 0, pdmin = 0, pdmax = 0, apmin = 0, apmax = 0;
+    int pfmin = 99, pfmax = -1, tmax = 0;
+    const double plo = kRenderSetpointEvt * kTickCycles;
+    const double phi = (kRenderSetpointEvt + 1) * kTickCycles;
+    for (long p = first_pdu; p < last_pdu; p++) {
+        const size_t i = static_cast<size_t>(p & 0xFFF);
+        if (accept_at[i] < 0 || pop_at[i] < 0 || push_at[i] < 0) continue;
+        const long d = pop_at[i] - push_at[i];
+        const long ap = push_at[i] - accept_at[i];
+        if (pn == 0 || d < pdmin) pdmin = d;
+        if (pn == 0 || d > pdmax) pdmax = d;
+        if (pn == 0 || ap < apmin) apmin = ap;
+        if (pn == 0 || ap > apmax) apmax = ap;
+        if (static_cast<double>(d) > plo && static_cast<double>(d) <= phi) ++pband;
+        if (fill_push[i] == kRenderSetpointEvt) ++pfill_ok;
+        if (fill_push[i] < pfmin) pfmin = fill_push[i];
+        if (fill_push[i] > pfmax) pfmax = fill_push[i];
+        if (ticks_ap[i] > tmax) tmax = ticks_ap[i];
+        ++pn;
+    }
+    std::printf("  [diag] %s-PUSH off=%ld: n %ld fill_ok %ld in_band(no slack) %ld "
+                "fill %d..%d delay %ld..%ld cyc = %.4f..%.4f ticks; accept->push "
+                "%ld..%ld cyc; ticks between %d\n", tag, diag_off, pn, pfill_ok,
+                pband, pfmin, pfmax, pdmin, pdmax,
+                static_cast<double>(pdmin) / kTickCycles,
+                static_cast<double>(pdmax) / kTickCycles, apmin, apmax, tmax);
+}
+
+void TdmRenderHarness::diag_restart_feed(bool phys) {
+    feed_on = false;
+    for (int k = 0; k < 4; k++) {
+        while (axis_cycle < next_pdu_at) step();
+        advance_pdu_slot();
+    }
+    pdu_frac_num = phys ? kPduPhysFracNum : 0;
+    feed_on = true;
+}
+
+void TdmRenderHarness::diag_t30(long off) {
+    diag_off = off;
+    std::printf("\n[DIAG] T30 INTERNAL, feed start +%ld cycles\n", off);
+    build_injection_record(20000);
+    feed_on = true;
+    pdu_frac_num = diag_phys ? kPduPhysFracNum : 0;
+    pdu_frac_acc = 0;
+    std::printf("  [diag] feed cadence from the T30 start: %s\n",
+                diag_phys ? "physical" : "nominal");
+    const long feed_start = axis_cycle;
+    next_pdu_at = axis_cycle + 64 + off;
+    run_fed(40 * kPduPeriodCycles);
+    const long int_first = injected_events / kEvents;
+    const Window intr = decode_and_grade_a_window(300 * kPduPeriodCycles,
+                                                  "D30 INTERNAL");
+    report_a_window(intr, "D30 INTERNAL");
+    diag_law(int_first + 4, injected_events / kEvents - 4, "IN");
+    const long cap = axis_cycle + 400'000'000;
+    while (trk_settled_at < 0 && axis_cycle < cap) run_fed(kPduPeriodCycles);
+    std::printf("  [diag] SETTLE off=%ld: settled_at %ld = t14+%ld cyc = "
+                "feed+%ld cyc (t14 at %ld, feed start %ld)\n", off,
+                trk_settled_at, trk_settled_at - t14_release,
+                trk_settled_at - feed_start, t14_release, feed_start);
+    for (size_t i = 0; i < kIdSpace; i++) { accept_at[i] = -1; fill_at[i] = -1; pop_at[i] = -1; push_at[i] = -1; }
+    long s_first = injected_events / kEvents;
+    run_fed(300 * kPduPeriodCycles);
+    diag_law(s_first + 4, injected_events / kEvents - 4, "SAME");
+    diag_restart_feed(false);
+    run_fed(40 * kPduPeriodCycles);
+    for (size_t i = 0; i < kIdSpace; i++) { accept_at[i] = -1; fill_at[i] = -1; pop_at[i] = -1; push_at[i] = -1; }
+    s_first = injected_events / kEvents;
+    run_fed(300 * kPduPeriodCycles);
+    diag_law(s_first + 4, injected_events / kEvents - 4, "FRESH-NOM");
+    diag_restart_feed(true);
+    run_fed(40 * kPduPeriodCycles);
+    trace_pdus = 3;
+    for (size_t i = 0; i < kIdSpace; i++) { accept_at[i] = -1; fill_at[i] = -1; pop_at[i] = -1; push_at[i] = -1; }
+    s_first = injected_events / kEvents;
+    run_fed(300 * kPduPeriodCycles);
+    diag_law(s_first + 4, injected_events / kEvents - 4, "FRESH-PHYS");
+    feed_on = false;
+}
