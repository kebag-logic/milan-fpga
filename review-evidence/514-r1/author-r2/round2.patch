+def _arm_measurement_cases(fx, history):
+    """Reach the arm-level handler with an empty delta and a failed H read."""
+    original_tree = _tree({"work": _blob(ORIGINAL)})
+    source_tree = _tree({"work": _blob(SOURCE)})
+    initial = _commit(history, original_tree, [], "net-zero initial")
+    source = _commit(history, source_tree, [initial], "source change")
+    source_revert = _commit(history, original_tree, [source], "source revert")
+    replay = _commit(history, source_tree, [initial], "replayed change")
+    replay_revert = _commit(history, original_tree, [replay], "replayed revert")
+    history._git("update-ref", "refs/heads/pr", source_revert)
+    history._git("update-ref", "refs/heads/main", replay_revert)
+    args = ["--no-fetch", "--base", "main", "pr"]
+    rc, output = fx.run(args)
+    fx.case("linear-empty-delta-historical", (rc, "contained" in output), (0, True),
+            "an empty source delta keeps its existing landing verdict")
+    result = fx.run([*args, "--current-retention"])
+    fx.case("linear-empty-delta", _observed(result), (1, ["UNKNOWN"]),
+            "exact replays of a change and its revert cannot certify an empty delta")
+    fx.case("linear-empty-delta-diagnostic",
+            "linear retention unmeasurable: retention has no measurable changed-path set" in result[1],
+            True, "the example reaches the arm-level unmeasurable result after H")
+
+    # Exact current paths establish landing without H. Only the optional arm
+    # reads this history, so a failed read cannot mask its UNKNOWN result.
+    _history(history, (_blob(ORIGINAL), _blob(SOURCE), _blob(SOURCE)))
+    saved = fx.mc._git
+    failed_reads = []
+
+    def fail(*args: str) -> tuple[int, str]:
+        """Fail H's source enumeration without replacing its verdict helper."""
+        if args[:2] == ("rev-list", "--no-merges"):
+            failed_reads.append(args)
+            return 128, ""
+        return saved(*args)
+
+    with patch.object(fx.mc, "_git", fail):
+        rc, output = fx.run(args)
+        fx.case("linear-H-failure-historical",
+                (rc, "every path this branch touched is identical" in output, len(failed_reads)),
+                (0, True, 0), "the path landing proof does not require the failed H measurement")
+        result = fx.run([*args, "--current-retention"])
+    fx.case("linear-H-measurement-failure", _observed(result), (1, ["UNKNOWN"]),
+            "an unavailable H measurement is never a retention certificate")
+    fx.case("linear-H-failure-reached", len(failed_reads), 1,
+            "the optional arm actually attempted the failing Git read")
+    fx.case("linear-H-failure-diagnostic",
+            "linear retention unmeasurable: rev-list could not enumerate refs/heads/pr" in result[1],
+            True, "the arm reports its H measurement failure explicitly")
+
+
