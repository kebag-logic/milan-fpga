+def _failed_landing_cases(fx, history):
+    """A failed landing must never acquire an optional retention certificate."""
+    initial, _, _ = _history(history, (_blob(ORIGINAL), _blob(SOURCE), _blob(SOURCE)))
+    history._git("update-ref", "refs/heads/main", initial)
+    for target, word in (("pr", "STRANDED"), ("no-such-branch", "UNKNOWN")):
+        result = fx.run(["--no-fetch", "--base", "main", target, "--current-retention"])
+        lines = [line.split() for line in result[1].splitlines() if line.strip()]
+        fx.case("linear-failed-landing-" + word,
+                (result[0], lines[0][0] if lines else "no verdict"), (1, word),
+                "the option preserves the failed landing verdict and exit")
+        fx.case("linear-no-retained-on-" + word,
+                any(line[0] == "retained" for line in lines), False,
+                "a failed landing emits no retained line")
+        fx.case("linear-no-retention-on-" + word, _observed(result), (1, []),
+                "current retention is evaluated only for a contained landing")
+
