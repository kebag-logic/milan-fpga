      "command": "git submodule update --init third_party/verilog-axis protocol-processor gptp-processor third_party/lwSRP third_party/tsn-c-stack",
      "job_if": "${{ needs.changes.outputs.rtl == 'true' }}",
      "step_if": "success()"
    },
    {
      "job": "firmware-unit",
      "step": "Install GoogleTest and GoogleMock and print the versions",
      "command": "set -euo pipefail",
      "job_if": "${{ needs.changes.outputs.rtl == 'true' }}",
      "step_if": "success()"
    },
    {
      "job": "firmware-unit",
      "step": "Install GoogleTest and GoogleMock and print the versions",
      "command": "sudo apt-get update -qq",
      "job_if": "${{ needs.changes.outputs.rtl == 'true' }}",
      "step_if": "success()"
    },
    {
      "job": "firmware-unit",
      "step": "Install GoogleTest and GoogleMock and print the versions",
      "command": "sudo apt-get install -y --no-install-recommends libgtest-dev libgmock-dev",
      "job_if": "${{ needs.changes.outputs.rtl == 'true' }}",
      "step_if": "success()"
    },
    {
      "job": "firmware-unit",
      "step": "Install GoogleTest and GoogleMock and print the versions",
      "command": "python3 -m pip install --quiet pyyaml",
      "job_if": "${{ needs.changes.outputs.rtl == 'true' }}",
      "step_if": "success()"
    },
    {
      "job": "firmware-unit",
      "step": "Install GoogleTest and GoogleMock and print the versions",
      "command": "dpkg-query -W libgtest-dev libgmock-dev",
      "job_if": "${{ needs.changes.outputs.rtl == 'true' }}",
      "step_if": "success()"
    },
    {
      "job": "firmware-unit",
      "step": "Install GoogleTest and GoogleMock and print the versions",
      "command": "g++ --version | head -n 1",
      "job_if": "${{ needs.changes.outputs.rtl == 'true' }}",
      "step_if": "success()"
    },
    {
      "job": "firmware-unit",
      "step": "Install GoogleTest and GoogleMock and print the versions",
      "command": "gcov --version | head -n 1",
      "job_if": "${{ needs.changes.outputs.rtl == 'true' }}",
      "step_if": "success()"
    },
    {
      "job": "firmware-unit",
      "step": "Prove the tally reads a failing and a crashing test as failures",
      "command": "python3 sw/firmware/gtest/tally_selftest.py",
      "job_if": "${{ needs.changes.outputs.rtl == 'true' }}",
      "step_if": "success()"
    },
    {
      "job": "firmware-unit",
      "step": "Install and verify the pinned RV32 SDK",
      "command": "set -euo pipefail",
      "job_if": "${{ needs.changes.outputs.rtl == 'true' }}",
      "step_if": "success()"
    },
    {
      "job": "firmware-unit",
      "step": "Install and verify the pinned RV32 SDK",
      "command": "python3 scripts/ci_rv32_sdk_selftest.py",
      "job_if": "${{ needs.changes.outputs.rtl == 'true' }}",
      "step_if": "success()"
    },
    {
      "job": "firmware-unit",
      "step": "Install and verify the pinned RV32 SDK",
      "command": "python3 scripts/ci_rv32_sdk.py --destination \"$HOME/br-milan-rv32/host\"",
      "job_if": "${{ needs.changes.outputs.rtl == 'true' }}",
      "step_if": "success()"
    },
    {
      "job": "firmware-unit",
      "step": "Run the control-plane firmware suites and RV32 builds",
      "command": "set -euo pipefail",
      "job_if": "${{ needs.changes.outputs.rtl == 'true' }}",
      "step_if": "success()"
    },
    {
      "job": "firmware-unit",
      "step": "Run the control-plane firmware suites and RV32 builds",
