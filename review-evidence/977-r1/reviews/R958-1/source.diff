+        EXPECT_FALSE(adapter.declared_alone);
+        EXPECT_TRUE(loop.rx[MBX_CH_SRP].ready(&adapter)) << "and records are taken again";
+    } else {
+        EXPECT_GT(adapter.transmitted,sent) << "the call that declares builds the MRPDU";
+        EXPECT_FALSE(adapter.declared_alone);
+    }
+    settle();
