+    // Local validation accelerator: fork only after a proven common stimulus prefix.
+    // The parent remains at that exact state; each child gets an independent process image.
+    using CheckpointJobs = std::vector<std::pair<std::string, std::string>>;
+    bool checkpoint_initialized_ = false;
+    std::size_t checkpoint_step_ = ~std::size_t(0);
+    CheckpointJobs checkpoint_jobs_;
+    std::string checkpoint_log_;
+    void checkpoint_target() {
+        checkpoint_step_ = steps_.size();
+        for (const auto& job : checkpoint_jobs_) {
+            const auto next = checkpoint_steps(job.first.c_str());
+            size_t n = 0;
+            while (n < std::min(next.size(), checkpoint_step_) &&
+                   next[n].op == steps_[n].op && next[n].args == steps_[n].args) ++n;
+            checkpoint_step_ = n;
+        }
+        if (checkpoint_step_ < step_) throw std::runtime_error("checkpoint stimulus prefix differs");
+        if (checkpoint_jobs_.size() < 2) checkpoint_step_ = ~std::size_t(0);
+    }
+    void checkpoint() {
+        if (!checkpoint_initialized_) {
+            checkpoint_initialized_ = true;
+            const char* manifest = std::getenv("CHECKPOINT_MANIFEST");
+            if (!manifest) return;
+            const char* log = std::getenv("CHECKPOINT_LOG");
+            if (!log) throw std::runtime_error("checkpoint log path missing");
+            checkpoint_log_ = log;
+            std::ifstream list(manifest);
+            if (!list) throw std::runtime_error("cannot open checkpoint manifest");
+            std::string script, output;
+            while (list >> script >> output) checkpoint_jobs_.emplace_back(script, output);
+            if (checkpoint_jobs_.empty()) throw std::runtime_error("empty checkpoint manifest");
+            checkpoint_target();
+        }
+        if (step_ != checkpoint_step_) return;
+        if (armed_) throw std::runtime_error("checkpoint at an armed wait");
+        DIR* tasks = opendir("/proc/self/task");
+        if (!tasks) throw std::runtime_error("cannot count checkpoint threads");
+        unsigned threads = 0;
+        while (auto* e = readdir(tasks)) if (e->d_name[0] != '.') ++threads;
+        closedir(tasks);
+        if (threads != 1) throw std::runtime_error("checkpoint requires a single-threaded process");
+        std::map<std::vector<std::string>, CheckpointJobs> branches;
+        for (const auto& job : checkpoint_jobs_) {
+            const auto next = checkpoint_steps(job.first.c_str());
+            if (next.size() <= step_) throw std::runtime_error("short checkpoint script");
+            for (size_t n = 0; n < step_; ++n)
+                if (next[n].op != steps_[n].op || next[n].args != steps_[n].args)
+                    throw std::runtime_error("checkpoint stimulus prefix differs");
+            std::vector<std::string> key{next[step_].op};
+            key.insert(key.end(), next[step_].args.begin(), next[step_].args.end());
+            branches[key].push_back(job);
+        }
+        if (branches.size() < 2) throw std::runtime_error("checkpoint did not branch");
+        std::fflush(nullptr);
+        checkpoint_model->prepareClone();
+        std::vector<pid_t> children;
+        for (const auto& branch : branches) {
+            const pid_t pid = fork();
+            if (pid < 0) throw std::runtime_error("checkpoint fork failed");
+            if (pid == 0) {
+                checkpoint_model->atClone();
+                checkpoint_jobs_ = branch.second;
+                const auto previous_log = checkpoint_log_;
+                checkpoint_log_ = checkpoint_jobs_[0].second;
+                if (checkpoint_jobs_.size() > 1) checkpoint_log_ += ".prefix-" + std::to_string(step_);
+                if (!std::freopen(checkpoint_log_.c_str(), "w", stdout))
+                    throw std::runtime_error("cannot open checkpoint log");
+                std::ifstream prefix(previous_log, std::ios::binary);
+                if (!prefix) throw std::runtime_error("cannot read checkpoint prefix log");
+                std::array<char, 65536> bytes;
+                while (prefix) {
+                    prefix.read(bytes.data(), bytes.size());
+                    if (std::fwrite(bytes.data(), 1, prefix.gcount(), stdout) != size_t(prefix.gcount()))
+                        throw std::runtime_error("cannot write checkpoint prefix log");
+                }
+                steps_ = checkpoint_steps(checkpoint_jobs_[0].first.c_str());
+                checkpoint_target();
+                return;
+            }
+            children.push_back(pid);
+        }
+        int failures = 0;
+        for (pid_t child : children) {
+            int status = 0; pid_t pid;
+            do { pid = waitpid(child, &status, 0); } while (pid < 0 && errno == EINTR);
+            if (pid < 0) throw std::runtime_error("checkpoint waitpid failed");
+            if (!WIFEXITED(status) || WEXITSTATUS(status) != 0) ++failures;
+        }
+        std::_Exit(failures ? 1 : 0);
+    }
