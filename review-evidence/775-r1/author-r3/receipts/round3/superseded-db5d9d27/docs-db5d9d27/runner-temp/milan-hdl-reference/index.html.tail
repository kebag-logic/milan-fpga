<tr><td>amr_st_e</td><td>enum logic [4:0] { AS_BOOT, AS_RNEXT, AS_RREQ, AS_RRD, AS_RJDG, AS_ECNT, AS_EP0, AS_EP0W, AS_ESCAN, AS_EBW, AS_EP1, AS_EP1W, AS_EP2, AS_EP3, AS_EEND, AS_RB, AS_RB2, AS_SVC, AS_WLAT, AS_WCRC, AS_WREQ, AS_WSTR, AS_WWAIT, AS_WBACK, AS_WBWAIT }</td><td></td></tr>
