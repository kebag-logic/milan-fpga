tb/nvm_port/Makefile
41: BUILDS = $(words 1 2 3 $(FUZZ_TMOS))
42: 
43: # Each build prints its own tally and adds it to obj_dir/build_tally.txt; the
44: # last line printed is the sum, which is the line run_suites.sh reads.
45: run: elab
46: 	@mkdir -p obj_dir && rm -f obj_dir/build_tally.txt
47: 	$(call suite,$(TMO),obj_dir)
48: 	$(call suite,$(TMO_ALT),obj_alt)
49: 	$(call suite,$(TMO_MIN),obj_min)
50: 	$(foreach t,$(FUZZ_TMOS),$(call fuzz_at,$(t)) && ) true
51: 	@awk '{c += $$1; f += $$2} END {if (NR != $(BUILDS)) {print "FAIL: " NR " build tallies, expected $(BUILDS)"; exit 1} printf "%d checks: %d PASS, %d FAIL\n", c, c - f, f; exit (f != 0)}' \
52: 	    obj_dir/build_tally.txt
