-constexpr std::uint16_t ETHERTYPE = 0x22F0u;                 // IEEE 1722-2016 Table 5
-constexpr std::uint8_t SUBTYPE = 0xFCu;                      // IEEE 1722-2016 Table 6: ACMP
-constexpr std::uint8_t ADPDU_SUBTYPE = 0xFAu;                  // and ADP
