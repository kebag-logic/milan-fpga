+                                 cmrd_side_r, cmrd_addr_r,      // [22:16]
+                                 6'd0,                          // [15:10]
+                                 CHMAP_RDBK_C,                  // [9:8]
+                                 3'd0,                          // [7:5]
+                                 cmrd_armed_r, cmrd_unsup_r,    // [4:3]
+                                 cmrd_to_r, cmrd_valid_r,       // [2:1]
+                                 cmrd_busy_r};                  // [0]
