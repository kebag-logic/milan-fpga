+                                 f"({why})")
+            elif isinstance(n, ast.Name) and isinstance(n.ctx, ast.Load) and n.id not in local | BUILTINS:
+                found.append(f"{rel}:{n.lineno} {owner} names {n.id}, neither ctrl_build.py's nor in the pin "
+                             f"proof's vocabulary")
+            elif isinstance(n, ast.Attribute):
+                modules = [t for k, _, t in bound.get(n.value.id, []) if k == "import"] \
+                    if isinstance(n.value, ast.Name) else []
+                if modules and n.attr not in VOCABULARY.get(modules[0], frozenset()):
+                    found.append(f"{rel}:{n.lineno} {owner} names {ast.unparse(n)}, outside the pin proof's "
+                                 f"vocabulary")
+                elif not modules and n.attr not in ATTRIBUTES:
+                    found.append(f"{rel}:{n.lineno} {owner} names .{n.attr}, outside the pin proof's vocabulary")
+        return found
+
+    found = []
+    for root in ROOTS:
+        if not any(kind == "def" for kind, _, _ in bound.get(root, [])):
+            found.append(f"{rel} holds no {root}, which decides the pin")
+        for kind, node, _ in bound.get(root, []):
+            found += uses(root, node) if kind == "def" else [f"{rel}:{node.lineno} binds {root} again"]
+    return found
+
+
+def proof_run(texts: dict[str, str], stack: Path = STACK, inherited: dict[str, str] | None = None) -> tuple[int, str]:
+    """The pin proof run from `texts` (each module's path and text) under its audit hook, in a fresh interpreter
+    and before any build (PROOF_RUN), on `stack`, with `inherited` added to the environment it inherits: its exit
+    status, and its output then its errors. That environment holds neither of the helper's two settings, so only
+    the helper's own environment can give them."""
+    env = {k: v for k, v in os.environ.items() if k not in ("GIT_NO_REPLACE_OBJECTS", "GIT_GRAFT_FILE")}
+    with tempfile.TemporaryDirectory(prefix="ctrl-pin-") as scratch:
+        given = Path(scratch) / "texts.json"
+        given.write_text(json.dumps(texts), encoding="utf-8")
+        res = fw_gtest.run([sys.executable, "-I", "-B", "-c", PROOF_RUN, str(ROOT), str(given), str(stack)],
+                           timeout=PROOF_RUN_TIMEOUT_S, env={**env, "LC_ALL": "C", **(inherited or {})})
+    return res.returncode, res.stdout + res.stderr
+
+
+def exercised(texts: dict[str, str]) -> list[str]:
+    """The pin proof run from `texts` under its audit hook (proof_run): each refusal of the hook, at the line of the
+    proof that asked; or, if the run did not reach the pin check's verdict, how it ended."""
+    rc, out = proof_run(texts)
+    refused = [ln.removeprefix(HOOK_REFUSED) for ln in out.splitlines() if ln.startswith(HOOK_REFUSED)]
+    if refused or (rc == 0 and "tsn-c-stack at " in out):
+        return list(dict.fromkeys(refused))
+    return [f"the pin proof did not reach its verdict under its audit hook: exit {rc}: "
+            f"{out.strip().splitlines()[-1] if out.strip() else 'no output'}"]
+
+
+def census(texts: dict[str, str], env: dict[str, str]) -> list[str]:
+    """Each way the pin proof's modules (`texts`: each one's path and text) could start a process other than
+    through the helper, or run dynamic code (THE CENSUS), and each setting of the helper's environment (`env`) that
+    would let git read a replacement object or a graft; then each refusal of the audit hook when the proof runs from
+    the texts (exercised)."""
+    findings = []
+    builds = [rel for rel in texts if Path(rel).name == "ctrl_build.py"]
+    if len(builds) != 1:
+        findings.append(f"the census was given {len(builds)} ctrl_build.py, which holds the helper, where it needs one")
+    for rel, text in texts.items():
+        tree = ast.parse(text, rel)
+        helper_nodes: set[int] = set()
+        hook_nodes: set[int] = set()
+        if rel in builds:
+            bound = scope(tree)
+            helper = bound.get(HELPER, [])
+            defs = [node for kind, node, _ in helper if kind == "def"]
+            if not defs:
+                findings.append(f"{rel} holds no helper ({HELPER})")
+            findings += [f"{rel}:{node.lineno} binds the helper's name {HELPER} again" for _, node, _ in helper
+                         if node is not defs[0]]
+            helper_nodes = {id(n) for helper_def in defs[:1] for n in ast.walk(helper_def)}
+            hooks = [node for kind, node, _ in bound.get(HOOK, []) if kind == "def"]
+            hook_nodes = {id(n) for hook_def in hooks[:1] for n in ast.walk(hook_def)}
+            findings += reach(rel, tree)
+        findings += launches(rel, tree, helper_nodes, hook_nodes)
+    if len(builds) == 1:
+        findings += exercised(texts)
+    if env.get("GIT_NO_REPLACE_OBJECTS") != "1":
+        findings.append("the pin proof's Git environment does not set GIT_NO_REPLACE_OBJECTS=1, so Git would read "
+                        "a replacement object")
+    graft = env.get("GIT_GRAFT_FILE")
+    if not graft or Path(graft).exists(follow_symlinks=False):
+        findings.append(f"the pin proof's Git environment gives GIT_GRAFT_FILE {graft or 'no value'}, so Git would "
+                        f"read a graft file")
+    return list(dict.fromkeys(findings))
+
+
+def proof_census() -> list[str]:
+    """The census of the pin proof as the checkout holds it, with the helper's own environment."""
+    return census({p.relative_to(ROOT).as_posix(): p.read_text(encoding="utf-8") for p in PROOF}, git_env())
+
+
+def make(makefile: Path, *args: str, timeout: int | None = None, env: dict[str, str] | None = None) -> tuple[int, str]:
+    """make on one Makefile, in its directory."""
+    return run(["make", "--no-print-directory", "-C", str(makefile.parent), "-f", makefile.name, *args],
+               env=env, timeout=timeout)
+
+
+def targets(makefile: Path, overrides: list[str], env: dict[str, str] | None = None) -> dict[str, frozenset[str]]:
+    """Every target the Makefile defines, special and pattern ones aside, with all its prerequisites (normal
+    and order-only), from make's own database."""
+    _, out = make(makefile, "-p", "-n", "-q", "-R", *overrides, NO_GOAL, env=env)
+    files = out.partition("\n# Files\n")[2].partition("\n# files hash-table stats")[0]
+    if not files:
+        raise Refusal(f"make printed no database for {makefile.relative_to(ROOT)}")
+    found = {}
+    for entry in files.split("\n\n"):
+        lines = [ln for ln in entry.splitlines() if ln]
+        rule = next((ln for ln in lines if not ln.startswith(("#", "\t"))), None)
+        if rule is None or any(ln.startswith("# Not a target") for ln in lines):
+            continue
+        name, sep, rest = rule.partition(":")
+        if sep and not name.startswith(".") and "%" not in name:
+            found[name.strip()] = frozenset(rest.lstrip(":").replace("|", " ").split())
+    return found
+
+
+def recipes(makefile: Path, target: str, overrides: list[str],
+            env: dict[str, str] | None = None) -> dict[str, list[str]]:
+    """Each target make's dry run of `target` would build (it and its prerequisites, every one remade), with the
+    command lines of its own recipe."""
+    _, out = make(makefile, "-n", "-B", "--trace", *overrides, target, env=env)
+    own: dict[str, list[str]] = {}
+    current = None
+    for line in out.splitlines():
+        if m := TRACE.match(line):
+            current = m[1]
+            own.setdefault(current, [])
+        elif current is not None:
+            own[current].append(line)
+    return own
+
+
+def stack_targets(makefile: Path, stack: Path) -> tuple[list[str], list[str], list[str]]:
+    """The Makefile's targets whose build reaches `stack` (STACK_DIR), those that run the pin check, and the
+    findings: each target whose own recipe names the stack without one that runs the pin check among its
+    prerequisites, and each that names the checkout's stack instead."""
+    overrides = [f"STACK_DIR={stack}"]
+    defined = targets(makefile, overrides)
+    built = {name: recipes(makefile, name, overrides) for name in defined}
+    pins = {t for own in built.values() for t, lines in own.items() if any(PIN_RUN in ln for ln in lines)}
+    where = makefile.relative_to(ROOT).as_posix() if makefile.is_relative_to(ROOT) else makefile.name
+    reaching, findings = [], {}
+    for name, own in built.items():
+        if any(str(stack) in ln for lines in own.values() for ln in lines):
+            reaching.append(name)
+        for target, lines in own.items():
+            if target in pins:
+                continue
+            if any(CHECKOUT_STACK in ln for ln in lines):
+                findings[f"{where}: {target} builds the checkout's tsn-c-stack, not the STACK_DIR it is given"] = None
+            elif any(str(stack) in ln for ln in lines) and not defined.get(target, frozenset()) & pins:
+                findings[f"{where}: {target} builds against tsn-c-stack without the pin check "
+                         f"({', '.join(sorted(pins)) or 'none'}) as a prerequisite"] = None
+    return reaching, sorted(pins), list(findings)
+
+
+def named_compilers(makefile: Path, env: dict[str, str]) -> list[dict]:
+    """Each compiler a Makefile's recipes run by a path no capture wrapper stands on (`env`'s CTRL_CAPTURE_BIN),
+    read from make's own dry run of every target under the capture's environment: a bypass record of each, as
+    the capture's audit hook writes one for a Python builder."""
+    wrappers = Path(env["CTRL_CAPTURE_BIN"]).resolve()
+    where = makefile.relative_to(ROOT).as_posix() if makefile.is_relative_to(ROOT) else makefile.name
+    found = {}
+    for target in targets(makefile, [], env):
+        for own, lines in recipes(makefile, target, [], env).items():
+            for line in lines:
+                for word in re.split(r"[\s;&|()`]+", line):
+                    word = word.strip("'\"")
+                    if "/" in word and COMPILER.match(word.rpartition("/")[2]) and \
+                            (makefile.parent / word).resolve().parent != wrappers:
+                        found[(word, line)] = {"bypass": word, "args": [line], "cwd": str(makefile.parent),
+                                               "from": [f"{where} (target {own})"]}
+    return list(found.values())
+
+
+def makefile_findings(makefiles: list[Path], work: Path) -> list[str]:
+    """Every Makefile builder's targets that build the stack take the pin check first: judged with STACK_DIR a
+    link to the submodule, so a recipe naming the submodule itself is told apart."""
+    link = work / "tsn-c-stack-link"
+    work.mkdir(parents=True, exist_ok=True)
+    if not link.is_symlink():
+        link.symlink_to(STACK, target_is_directory=True)
+    findings = [f for makefile in makefiles for f in stack_targets(makefile, link)[2]]
+    for makefile in makefiles:
+        if makefile.parent.name == "milan_dp":
+            defined = targets(makefile, [])
+            findings += [f"{target} lacks its required stack-pin prerequisite"
+                         for target in COUNTER_TARGETS if "stack-pin" not in defined.get(target, frozenset())]
+    return findings
+
+
+def mirror(directory: Path, into: Path) -> Path:
+    """A scratch checkout for one directory of it: the directory's files copied (tracked, or new and not
+    ignored), every other entry of the checkout linked, so its relative paths reach what they reach in the
+    checkout and what it writes stays in the copy."""
+    if into.exists():
+        shutil.rmtree(into)
+    here, there = ROOT, into
+    for part in directory.relative_to(ROOT).parts:
+        there.mkdir(parents=True, exist_ok=True)
+        for entry in here.iterdir():
+            if entry.name != part:
+                (there / entry.name).symlink_to(entry)
+        here, there = here / part, there / part
+    listed = git(directory, "ls-files", "-z", "--cached", "--others", "--exclude-standard", ".")
+    if listed.returncode:
+        raise Refusal(f"cannot list {directory.relative_to(ROOT)}: {listed.stderr.strip()}")
+    for name in filter(None, listed.stdout.split("\0")):
+        if (directory / name).is_file():
+            (there / name).parent.mkdir(parents=True, exist_ok=True)
+            shutil.copy2(directory / name, there / name)
+    return there
+
+
+def vanished(_function: object, _path: str, error: tuple) -> None:
+    """Only a file vanishing during scratch removal is harmless; every other error propagates."""
+    if not isinstance(error[1], FileNotFoundError):
+        raise error[1]
+
+
+@dataclass(frozen=True)
+class Clone:
+    """The scratch clone of the stack each pin control spoils (`path`, under `work`), at the gitlink `pin`."""
+
+    work: Path
+    pin: str
+
+    @property
+    def path(self) -> Path:
+        """The clone's checkout."""
+        return self.work / "pin-clone"
+
+    def fresh(self) -> None:
+        """A new clone of the stack at its gitlink, for the next control."""
+        if self.path.exists():
+            shutil.rmtree(self.path, onerror=vanished)
+        create(self.path, STACK)
+        self.answer("-c", "advice.detachedHead=false", "checkout", "--quiet", self.pin)
+
+    def answer(self, *args: str, stdin: str | None = None) -> str:
+        """What a command of the clone's repository prints; a failure refuses the control's setup."""
+        res = git(self.path, *args, stdin=stdin)
+        if res.returncode:
+            raise Refusal(f"a pin control's setup failed ({' '.join(args[:2])}): {res.stderr.strip()}")
+        return res.stdout
+
+    def append(self, rel: str) -> None:
+        """One line added to a file of the clone."""
+        (self.path / rel).write_text((self.path / rel).read_text(encoding="utf-8") + "\n", encoding="utf-8")
+
+    def hidden(self) -> None:
+        """A source edited and hidden from the index's comparison by its assume-unchanged flag."""
+        self.append("src/adp.c")
+        self.answer("update-index", "--assume-unchanged", "src/adp.c")
+
+    def linked(self) -> None:
+        """A source replaced by a symbolic link to a copy of its own bytes outside the clone."""
+        copy = self.work / "adp.c"
+        shutil.copyfile(self.path / "src/adp.c", copy)
+        (self.path / "src/adp.c").unlink()
+        (self.path / "src/adp.c").symlink_to(copy)
+
+    def executable(self) -> None:
+        """A script made executable, its bytes unchanged."""
+        script = self.path / "scripts/check_boundary.py"
+        script.chmod(script.stat().st_mode | stat.S_IXUSR)
+
+    def remade(self, tree: str, name: str, oid: str) -> str:
+        """A tree written into the clone's objects: `tree` with its entry `name` holding `oid` instead."""
+        entries = []
+        for entry in filter(None, self.answer("ls-tree", "-z", tree).split("\0")):
+            meta, entry_name = entry.split("\t", 1)
+            mode, kind, _ = meta.split()
+            entries.append(f"{mode} {kind} {oid}\t{name}" if entry_name == name else entry)
+        return self.answer("mktree", "-z", stdin="\0".join(entries) + "\0").strip()
+
+    def substitutes(self) -> tuple[str, str, str]:
+        """src/adp.c edited on disk, and the trees that would make the pinned commit hold the edit written into the
+        clone's objects: the pinned src/ tree, its substitute, and the substitute of the pinned commit's tree."""
+        self.append("src/adp.c")
+        blob = self.answer("hash-object", "-w", "--no-filters", "src/adp.c").strip()
+        src = self.answer("rev-parse", f"{self.pin}:src").strip()
+        new_src = self.remade(src, "adp.c", blob)
+        return src, new_src, self.remade(self.answer("rev-parse", f"{self.pin}^{{tree}}").strip(), "src", new_src)
+
+    def replaced_tree(self) -> None:
+        """The edit on disk, and the pinned src/ tree replaced by the one holding it (refs/replace)."""
+        src, new_src, _ = self.substitutes()
+        self.answer("replace", src, new_src)
+
+    def replaced_commit(self) -> None:
+        """The edit on disk, and the pinned commit replaced by a copy of it whose tree holds the edit; HEAD still
+        names the pin."""
+        _, _, new_root = self.substitutes()
+        commit = self.answer("cat-file", "commit", self.pin)
+        old_root = self.answer("rev-parse", f"{self.pin}^{{tree}}").strip()
+        if not commit.startswith(f"tree {old_root}\n"):
+            raise Refusal(f"the pinned commit {self.pin[:8]} does not begin with its tree")
+        copy = self.answer("hash-object", "-t", "commit", "-w", "--stdin",
+                           stdin=commit.replace(old_root, new_root, 1)).strip()
+        self.answer("replace", self.pin, copy)
+
+    def grafted(self) -> None:
+        """A source edited, and a graft file in the clone's repository that makes the pinned commit a root."""
+        self.append("src/adp.c")
+        (self.path / ".git/info/grafts").write_text(f"{self.pin}\n", encoding="utf-8")
+
+    def filtered(self) -> None:
+        """A source edited, and a clean filter given it through the clone's attributes that cuts the edit off, so
+        a hash through the filter is the pinned blob (checked here, or the control would prove nothing)."""
+        size = (self.path / "src/adp.c").stat().st_size
+        self.append("src/adp.c")
+        self.answer("config", "filter.pin-control.clean", f"head -c {size}")
+        (self.path / ".git/info/attributes").write_text("src/adp.c filter=pin-control\n", encoding="utf-8")
+        if self.answer("hash-object", "src/adp.c").strip() != self.answer("rev-parse", f"{self.pin}:src/adp.c").strip():
+            raise Refusal("the pin control's clean filter does not turn its edit back into the pinned blob")
+
+    def direct(self) -> tuple[bool, str]:
+        """The pin check itself on the clone: accepted, and what it said."""
+        try:
+            return True, f"accepted {stack_pin(self.path, self.pin)}"
+        except Refusal as exc:
+            return False, str(exc)
+
+
+def unplanted() -> tuple[bool, str]:
+    """The pin proof as the checkout holds it, run under its audit hook (exercised): accepted when it reaches its
+    verdict with no refusal, and what it ended with."""
+    found = exercised({p.relative_to(ROOT).as_posix(): p.read_text(encoding="utf-8") for p in PROOF})
+    return not found, "; ".join(found) or "the pin check's verdict, no refusal"
+
+
+def planted(rel: str, old: str | None, new: str, word: str, at_plant: bool) -> tuple[bool, str]:
+    """The pin proof run under its audit hook (exercised) with `new` in place of `old` in one of its modules (`rel`,
+    its name; `old` None: `new` added at its end): accepted unless a refusal of the hook holds `word` and, if
+    `at_plant`, names a line of `new`; and that refusal."""
+    texts = {p.relative_to(ROOT).as_posix(): p.read_text(encoding="utf-8") for p in PROOF}
+    key = (HERE / rel).relative_to(ROOT).as_posix()
+    text = texts[key]
+    if old is not None and text.count(old) != 1:
+        return True, f"the hook control's anchor occurs {text.count(old)} times in {rel}"
+    at = len(text) if old is None else text.index(old)
+    first = text[:at].count("\n") + 1
+    last = first + new.count("\n")
+    lines = [f"{key}:{n} " for n in range(first, last + 1)] if at_plant else [""]
+    texts[key] = text[:at] + new + text[at + len(old or ""):]
+    found = exercised(texts)
+    named = [f for f in found if word in f and any(f.startswith(line) for line in lines)]
+    where = f" at {key}:{first} to {last}" if at_plant else ""
+    return not named, named[0] if named else f"no refusal{where} that holds {word}: {found}"
+
+
+def census_arms() -> list[tuple]:
+    """The pin proof's standing controls under its audit hook, each run before any build: each plant of HOOK_PLANTS
+    ends in the hook's refusal, by its words, at a line of the plant (or, for the helper's own, anywhere)."""
+    return [(f"the audit hook, {what}", lambda: None,
+             lambda r=rel, o=old, n=new, w=word, a=at_plant: planted(r, o, n, w, a), word)
+            for what, rel, old, new, word, at_plant in HOOK_PLANTS]
+
+
+def pin_controls(work: Path, makefiles: list[Path]) -> tuple[int, int]:
+    """The shared pin check passes a clone of the stack at its gitlink and refuses, by name, the clone with a
+    source, a test, a script, a CMake file or a file no gate builds edited, with an edit the index hides, with a
+    header the gitlink's tree does not hold, with a symbolic link standing in for a file, with a file made
+    executable, and at another revision; and, by the edited source's name, the clone whose src/ tree or whose
+    pinned commit is replaced by one holding the edit, and the clone with a graft file beside the edit; and, by the
+    filter's key, the clone whose attributes give the edited source a clean filter that turns it back into the
+    pinned bytes. The pin proof runs to its verdict under its audit hook, and ends in the hook's refusal with each
+    plant of HOOK_PLANTS. The controls of the inherited environment (ctrl_pin_env.py), and of the object store and
+    the repositories' own configuration (ctrl_pin_store.py), hold.
+    The MAAP differential (both modes) and the AECP lane's arms, campaign and wire comparison refuse an edited
+    clone before building it; every Makefile builder's target that reaches the stack refuses a poisoned one on
+    the pin check.
+    Returns the misbehaving count and the number of controls."""
+    pin = stack_gitlink()
+    clone = Clone(work, pin)
+    edited = f"differs from the pinned {pin[:8]}: "
+
+    def tool(argv: list[str], env: dict[str, str] | None = None) -> tuple[bool, str]:
+        """A gate run on the clone: accepted (exit 0), and its last line about the stack."""
+        rc, out = run(argv, env=env)
+        said = [ln for ln in out.splitlines() if "tsn-c-stack" in ln]
+        return rc == 0, f"exit {rc}: {said[-1].strip() if said else 'no pin verdict'}"
+
+    def differential(*extra: str) -> tuple[bool, str]:
+        """The MAAP differential on the clone, with a simulator that always fails."""
+        return tool([sys.executable, "-B", str(HERE / "maap_differential.py"), "--stack", str(clone.path), *extra],
+                    {"VERILATOR": "false"})
+
+    def aecp(script: str, *extra: str) -> tuple[bool, str]:
+        """One of the AECP lane's tools on the clone, with a simulator that always fails."""
+        return tool([sys.executable, "-B", str(HERE / script), "--stack", str(clone.path), "--output",
+                     str(work / "aecp-out"), *extra], {"VERILATOR": "false"})
+
+    arms = [("the pinned clone, unmodified", lambda: None, clone.direct, ""),
+            ("a core source edited", lambda: clone.append("src/adp.c"), clone.direct, edited + "src/adp.c"),
+            ("a core test edited", lambda: clone.append("tests/test_adp.cpp"), clone.direct,
+             edited + "tests/test_adp.cpp"),
+            ("a stack script edited", lambda: clone.append("scripts/check_boundary.py"), clone.direct,
+             edited + "scripts/check_boundary.py"),
+            ("a CMake file edited", lambda: clone.append("CMakeLists.txt"), clone.direct, edited + "CMakeLists.txt"),
+            ("a file no gate builds edited", lambda: clone.append("LICENSE"), clone.direct, edited + "LICENSE"),
+            ("an edit the index hides (assume-unchanged)", clone.hidden, clone.direct, edited + "src/adp.c"),
+            ("a header the pinned tree does not hold", lambda: (clone.path / "include/stdint.h").write_text(""),
+             clone.direct, edited + "include/stdint.h"),
+            ("a symbolic link standing in for a source, to its own bytes", clone.linked, clone.direct,
+             edited + "src/adp.c"),
+            ("a script made executable (a mode change)", clone.executable, clone.direct,
+             edited + "scripts/check_boundary.py"),
+            ("another revision checked out", lambda: clone.answer("checkout", "--quiet", "HEAD~1"), clone.direct,
+             "is not the pinned"),
+            ("a source edited, the pinned src/ tree replaced by one holding the edit", clone.replaced_tree,
+             clone.direct, edited + "src/adp.c"),
+            ("a source edited, the pinned commit replaced by one holding the edit", clone.replaced_commit,
+             clone.direct, edited + "src/adp.c"),
+            ("a source edited beside a graft file", clone.grafted, clone.direct, edited + "src/adp.c"),
+            ("a source edited, a clean filter given through attributes turning it back into the pinned blob",
+             clone.filtered, clone.direct, UNLISTED + "filter.pin-control.clean (local)"),
+            ("the pin proof as the checkout holds it, under its audit hook", lambda: None, unplanted, ""),
+            *census_arms(),
+            ("the MAAP differential, a core source edited", lambda: clone.append("src/maap.c"), differential,
+             edited + "src/maap.c"),
+            ("the MAAP differential's self-test, a core source edited", lambda: clone.append("src/maap.c"),
+             lambda: differential("--self-test"), edited + "src/maap.c"),
+            ("the AECP arms, a core source edited", lambda: clone.append("src/acmp.c"),
+             lambda: aecp("aecp_arms.py", "--app"), edited + "src/acmp.c"),
+            ("the AECP campaign, a core source edited", lambda: clone.append("src/acmp.c"),
+             lambda: aecp("aecp_mutants.py", "--shard", "0", "1000"), edited + "src/acmp.c"),
+            ("the AECP wire comparison, the stack's wire layer edited", lambda: clone.append("include/wire.h"),
+             lambda: aecp("aecp_wire.py", "--reference", str(PP), "--verilator", "false"), edited + "include/wire.h")]
+    texts = {p.relative_to(ROOT).as_posix(): p.read_text(encoding="utf-8") for p in PROOF}
+    arms += inherited_arms(clone.path, pin, work, lambda stack, env: proof_run(texts, stack, env))
+    arms += store_arms(clone.path, pin, work, edited)
+    for shape, extra in (("1", ()), ("8", ()), ("1", ("--build-only",))):
+        arms.append((f"the F5 gap check shape {shape} {extra}, the stack's wire layer edited",
+                     lambda: clone.append("include/wire.h"),
+                     lambda s=shape, e=extra: tool([sys.executable, "-B",
+                         str(ROOT / "tb/verilator/milan_dp/stream_counter_f5.py"),
+                         "--stack", str(clone.path), "--shape", s, *e]), edited + "include/wire.h"))
+    arms.append(("the F5 gap check, another revision checked out",
+                 lambda: clone.answer("checkout", "--quiet", "HEAD~1"),
+                 lambda: tool([sys.executable, "-B", str(ROOT / "tb/verilator/milan_dp/stream_counter_f5.py"),
+                               "--stack", str(clone.path)]), "is not the pinned"))
+    clone.fresh()
+    arms += bench_arms(makefiles, clone.path, work, edited)
+    bad = 0
+    for what, spoil, check, needle in arms:
+        clone.fresh()
+        spoil()
+        accepted, detail = check()
+        ok = accepted if not needle else (not accepted and needle in detail)
+        print(f"[{'ok' if ok else 'ESCAPED'}] tsn-c-stack pin control, {what}: {detail}", flush=True)
+        bad += not ok
+    lifecycle_bad, lifecycle_count = lifecycle_controls(clone)
+    bad += lifecycle_bad
+    for scratch in (clone.path, *(work / d for d in ("aecp-out", "bench", "unpinned", "inherited", "store"))):
+        shutil.rmtree(scratch, ignore_errors=True)
+    (work / "adp.c").unlink(missing_ok=True)
+    return bad, len(arms) + lifecycle_count
diff --git a/sw/firmware/ctrl/test/ctrl_pin_bench.py b/sw/firmware/ctrl/test/ctrl_pin_bench.py
new file mode 100644
index 000000000..c99573d36
--- /dev/null
+++ b/sw/firmware/ctrl/test/ctrl_pin_bench.py
@@ -0,0 +1,65 @@
+# SPDX-FileCopyrightText: 2026 Kebag Logic
+# SPDX-License-Identifier: CERN-OHL-W-2.0
+"""Execute stack-pin controls at the mailbox and counter Makefile entry points."""
+
+import sys
+from pathlib import Path
+
+from ctrl_build import ROOT, Refusal
+
+
+def bench_arms(makefiles: list[Path], clone: Path, work: Path, edited: str) -> list[tuple]:
+    """For every target of every Makefile builder that reaches the stack in its dry run: run it in a scratch
+    copy of its directory against the clone with wire.h poisoned, with no simulator; it must refuse on the pin
+    check and never reach the poisoned header; each target that runs the pin check passes the clone
+    unpoisoned. And the planted Makefile without the pin prerequisite."""
+    from ctrl_pin import (BENCH_TIMEOUT_S, COUNTER_TARGETS, NO_SIMULATOR, POISON, UNPINNED,
+                          make, makefile_findings, mirror, stack_targets)
+
+    simulator = work / "no_simulator.py"
+    simulator.write_text(NO_SIMULATOR, encoding="utf-8")
+
+    def poison() -> None:
+        """The clone's wire.h, which every firmware build reads, ends in an #error."""
+        wire = clone / "include/wire.h"
+        wire.write_text(wire.read_text(encoding="utf-8") + f"\n{POISON}\n", encoding="utf-8")
+
+    def bench(makefile: Path, target: str) -> tuple[bool, str]:
+        """The target run for real in a fresh scratch copy: accepted, and its verdict on the stack."""
+        copy = mirror(makefile.parent, work / "bench") / makefile.name
+        rc, out = make(copy, f"STACK_DIR={clone}", f"VERILATOR={sys.executable} -I {simulator}", target,
+                       timeout=BENCH_TIMEOUT_S)
+        said = [ln for ln in out.splitlines() if "tsn-c-stack" in ln or "PIN-POISON" in ln]
+        if "PIN-POISON" in out:
+            return True, f"exit {rc}: compiled the poisoned header: {said[-1].strip()}"
+        return rc == 0, f"exit {rc}: {said[-1].strip() if said else 'no pin verdict'}"
+
+    def unpinned(plant: tuple = UNPINNED) -> tuple[bool, str]:
+        """The planted Makefile, judged as the gate judges every Makefile builder."""
+        makefile, old, new, _ = plant
+        copy = mirror(makefile.parent, work / "bench") / makefile.name
+        text = copy.read_text(encoding="utf-8")
+        if text.count(old) != 1:
+            raise Refusal(f"the planted Makefile control's anchor occurs {text.count(old)} times")
+        copy.write_text(text.replace(old, new), encoding="utf-8")
+        found = makefile_findings([copy], work / "unpinned")
+        return not found, found[0] if found else "no finding"
+
+    arms = []
+    for makefile in makefiles:
+        where = makefile.relative_to(ROOT).as_posix()
+        reaching, pins, _ = stack_targets(makefile, clone)
+        arms += [(f"{where} make {pin}, the pinned clone", lambda: None, lambda m=makefile, t=pin: bench(m, t), "")
+                 for pin in pins]
+        for target in reaching:
+            arms.append((f"{where} make {target}, the stack's wire.h poisoned", poison,
+                         lambda m=makefile, t=target: bench(m, t), edited + "include/wire.h"))
+    arms.append((f"{UNPINNED[0].relative_to(ROOT).as_posix()} planted with {UNPINNED[3]} unpinned", lambda: None,
+                 unpinned, f"{UNPINNED[3]} builds against tsn-c-stack without the pin check"))
+    for target in COUNTER_TARGETS:
+        plant = (ROOT / "tb/verilator/milan_dp/Makefile", f"{target}: | stack-pin\n", f"{target}:\n", target)
+        needle = f"{target} lacks its required stack-pin prerequisite" if target == "counters" else \
+            f"{target} builds against tsn-c-stack without the pin check"
+        arms.append((f"milan_dp planted with {target} unpinned", lambda: None,
+                     lambda p=plant: unpinned(p), needle))
+    return arms
diff --git a/sw/firmware/ctrl/test/ctrl_pin_env.py b/sw/firmware/ctrl/test/ctrl_pin_env.py
new file mode 100644
index 000000000..db675710f
--- /dev/null
+++ b/sw/firmware/ctrl/test/ctrl_pin_env.py
@@ -0,0 +1,306 @@
+# SPDX-FileCopyrightText: 2026 Kebag Logic
+# SPDX-License-Identifier: CERN-OHL-W-2.0
+"""ctrl_pin_env.py - the pin proof's controls of the environment it inherits (#697).
+
+The pin proof's helper (ctrl_build.git) starts Git with the proof's own
+environment, the whole of it (ctrl_build.GIT_ENVIRONMENT), and its audit hook
+refuses any other (THE HOOK, ctrl_pin.py). These controls set, in the
+environment of the process that runs the proof, each variable that would
+redirect what Git reads if it reached Git:
+- the repository: GIT_DIR, GIT_WORK_TREE, GIT_COMMON_DIR and GIT_INDEX_FILE;
+- the object store: GIT_OBJECT_DIRECTORY and GIT_ALTERNATE_OBJECT_DIRECTORIES;
+- the replacement refs: GIT_REPLACE_REF_BASE;
+- the configuration: GIT_CONFIG_COUNT with its keys and values,
+  GIT_CONFIG_PARAMETERS, GIT_CONFIG_GLOBAL, GIT_CONFIG_SYSTEM, HOME and
+  XDG_CONFIG_HOME;
+- the attributes: GIT_ATTR_SOURCE.
+Each runs the pin proof as the checkout holds it, under its audit hook, in a
+fresh interpreter (ctrl_pin.proof_run), on a clone of the stack prepared so
+that the variable, if it reached Git, would change the verdict:
+- an edited clone accepted, its edit committed in another repository;
+- the gitlink read from another index, the clone at that revision;
+- the pinned tree read from another store, or from none;
+- a program the configuration names started by Git: core.fsmonitor, which Git
+  runs when it reads an index, here a recorder.
+Each must end in the verdict the clone itself earns, and no program the
+configuration names may run. Two set what Git applies only when it hashes a
+file through its filters, which the proof never does: a clean filter given
+through GIT_CONFIG_COUNT, and one whose attribute is given through
+GIT_ATTR_SOURCE, the filter through GIT_CONFIG_COUNT. Each would turn the
+edit back into the pinned blob, as the control checks. With every variable at once, the pinned clone is accepted.
+GIT_REPLACE_REF_BASE is also held by GIT_NO_REPLACE_OBJECTS=1, so its control
+fails only if both settings are lost. A last control gives the hook's judge of
+the environment the list CPython 3.14's fork_exec gives, with a key twice.
+"""
+
+from __future__ import annotations
+
+import shutil
+from collections.abc import Callable
+from dataclasses import dataclass
+from pathlib import Path
+
+from ctrl_build import GIT_ENVIRONMENT, NO_MAINTENANCE, ROOT, STACK, Refusal, environment_judge, git
+
+#: The gitlink's path in the checkout, which another index records.
+GITLINK = STACK.relative_to(ROOT).as_posix()
+#: The program the configuration controls name: Git runs it and it records that it ran (in `ran`, beside it), then
+#: fails, which Git reads as "read every file".
+RECORDER = '#!/bin/sh\necho "$0 $*" >> "$(dirname "$0")/ran"\nexit 1\n'
+#: The source each control edits, and the filter that would turn its edit back into the pinned blob.
+EDITED, FILTER = "src/adp.c", "pin-control"
+
+
+def answer(directory: Path, *args: str, stdin: str | None = None) -> str:
+    """What a git command in `directory` prints; a failure refuses the control's setup."""
+    res = git(directory, *args, stdin=stdin)
+    if res.returncode:
+        raise Refusal(f"an inherited-environment control's setup failed ({' '.join(args[:2])}): {res.stderr.strip()}")
+    return res.stdout
+
+
+def create(directory: Path, source: Path | None = None) -> None:
+    """Create one scratch repository with maintenance disabled, including its initial clone command."""
+    if source is None:
+        answer(directory.parent, "init", "--quiet", str(directory))
+        for setting in NO_MAINTENANCE:
+            key, value = setting.split("=", 1)
+            answer(directory, "config", key, value)
+    else:
+        config = [arg for setting in NO_MAINTENANCE for arg in ("--config", setting)]
+        answer(directory.parent, "clone", "--quiet", "--no-hardlinks", *config, str(source), str(directory))
+
+
+@dataclass(frozen=True)
+class Scene:
+    """Where one control works: the stack clone, its pinned revision, and a directory of its own beside it."""
+
+    stack: Path
+    pin: str
+    own: Path
+
+    def edit(self) -> None:
+        """The clone's EDITED with a line added."""
+        source = self.stack / EDITED
+        source.write_bytes(source.read_bytes() + b"\n")
+
+    def edited(self) -> str:
+        """EDITED with a line added, as text, from the pinned blob: the clone itself is left as it is."""
+        return answer(self.stack, "cat-file", "blob", f"{self.pin}:{EDITED}") + "\n"
+
+    def remade(self, tree: str, name: str, oid: str) -> str:
+        """A tree written into the clone's objects: `tree` with its entry `name` holding `oid` instead."""
+        entries = [f"{meta.rsplit(' ', 1)[0]} {oid}\t{entry}" if entry == name else f"{meta}\t{entry}"
+                   for meta, entry in (e.split("\t", 1) for e in filter(None, answer(self.stack, "ls-tree", "-z", tree)
+                                                                        .split("\0")))]
+        return answer(self.stack, "mktree", "-z", stdin="\0".join(entries) + "\0").strip()
+
+    def edited_src(self) -> tuple[str, str]:
+        """The pinned src/ tree, and a tree written into the clone's objects that is it but for EDITED's blob,
+        which holds the edit (edited)."""
+        blob = answer(self.stack, "hash-object", "-w", "--stdin", stdin=self.edited()).strip()
+        src = answer(self.stack, "rev-parse", f"{self.pin}:src").strip()
+        return src, self.remade(src, Path(EDITED).name, blob)
+
+    def recorder(self) -> str:
+        """The recorder program, in this control's own directory."""
+        program = self.own / "recorder"
+        program.write_text(RECORDER, encoding="utf-8")
+        program.chmod(0o755)
+        return str(program)
+
+    def filtered(self, *config: str) -> None:
+        """Check that the clean filter (FILTER, `config` naming its attribute or the filter) turns the edit back
+        into the pinned blob, or the control would prove nothing."""
+        size = len(answer(self.stack, "cat-file", "blob", f"{self.pin}:{EDITED}").encode())
+        through = answer(self.stack, *config, "-c", f"filter.{FILTER}.clean=head -c {size}", "hash-object",
+                         "--stdin", f"--path={EDITED}", stdin=self.edited()).strip()
+        if through != answer(self.stack, "rev-parse", f"{self.pin}:{EDITED}").strip():
+            raise Refusal("an inherited-environment control's clean filter does not give the pinned blob")
+
+
+def repository(scene: Scene) -> dict[str, str]:
+    """Another repository, whose HEAD and whose index's gitlink are a commit holding the edit."""
+    other = scene.own / "repository"
+    create(other, scene.stack)
+    (other / EDITED).write_text(scene.edited(), encoding="utf-8")
+    answer(other, "-c", "user.name=pin control", "-c", "user.email=pin-control@invalid", "commit", "--quiet",
+           "--all", "--message=edited")
+    commit = answer(other, "rev-parse", "HEAD").strip()
+    answer(other, "update-index", "--add", "--cacheinfo", f"160000,{commit},{GITLINK}")
+    return {"GIT_DIR": str(other / ".git")}
+
+
+def index(scene: Scene) -> dict[str, str]:
+    """An index whose gitlink is the stack's previous revision."""
+    create(scene.own / "index")
+    previous = answer(scene.stack, "rev-parse", f"{scene.pin}~1").strip()
+    answer(scene.own / "index", "update-index", "--add", "--cacheinfo", f"160000,{previous},{GITLINK}")
+    return {"GIT_INDEX_FILE": str(scene.own / "index/.git/index")}
+
+
+def empty(scene: Scene) -> Path:
+    """An empty repository's own directory."""
+    create(scene.own / "empty")
+    return scene.own / "empty/.git"
+
+
+def alternate(scene: Scene) -> dict[str, str]:
+    """A copy of the clone's objects."""
+    store = scene.stack / ".git/objects"
+    for entry in store.iterdir():
+        if entry.name != "info":
+            (shutil.copytree if entry.is_dir() else shutil.copy2)(entry, scene.own / "alternate" / entry.name)
+    return {"GIT_ALTERNATE_OBJECT_DIRECTORIES": str(scene.own / "alternate")}
+
+
+def unstored(scene: Scene) -> None:
+    """The clone's own objects removed, and the stores its objects/info/alternates names (which a clone of a
+    submodule initialised with --reference inherits), so that it reads none: its checkout and its HEAD stay."""
+    for entry in (scene.stack / ".git/objects").iterdir():
+        if entry.name != "info":
+            (shutil.rmtree if entry.is_dir() else Path.unlink)(entry)
+    (scene.stack / ".git/objects/info/alternates").unlink(missing_ok=True)
+
+
+def swapped(scene: Scene) -> dict[str, str]:
+    """Under another replacement base, the pinned src/ tree replaced by one holding the edit."""
+    src, new = scene.edited_src()
+    answer(scene.stack, "update-ref", f"refs/swap/{src}", new)
+    return {"GIT_REPLACE_REF_BASE": "refs/swap/"}
+
+
+def configured(scene: Scene, how: str) -> dict[str, str]:
+    """core.fsmonitor naming the recorder, through one way the environment gives Git configuration (`how`)."""
+    program = scene.recorder()
+    text = f"[core]\n\tfsmonitor = {program}\n"
+    if how in ("GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM"):
+        (scene.own / "config").write_text(text, encoding="utf-8")
+        return {how: str(scene.own / "config")}
+    if how == "HOME":
+        (scene.own / ".gitconfig").write_text(text, encoding="utf-8")
+        return {"HOME": str(scene.own)}
+    if how == "XDG_CONFIG_HOME":
+        (scene.own / "git").mkdir()
+        (scene.own / "git/config").write_text(text, encoding="utf-8")
+        return {"XDG_CONFIG_HOME": str(scene.own)}
+    if how == "GIT_CONFIG_PARAMETERS":
+        return {how: f"'core.fsmonitor'='{program}'"}
+    return {"GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "core.fsmonitor", "GIT_CONFIG_VALUE_0": program}
+
+
+def filter_given(scene: Scene) -> dict[str, str]:
+    """A clean filter given through GIT_CONFIG_COUNT, its attribute in the clone's own attributes."""
+    (scene.stack / ".git/info/attributes").write_text(f"{EDITED} filter={FILTER}\n", encoding="utf-8")
+    scene.filtered()
+    size = len(answer(scene.stack, "cat-file", "blob", f"{scene.pin}:{EDITED}").encode())
+    return {"GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": f"filter.{FILTER}.clean",
+            "GIT_CONFIG_VALUE_0": f"head -c {size}"}
+
+
+def attributes_given(scene: Scene) -> dict[str, str]:
+    """A tree whose .gitattributes gives the edited source the clean filter, the filter given through
+    GIT_CONFIG_COUNT (the clone's own configuration holds only what the pin check allows)."""
+    blob = answer(scene.stack, "hash-object", "-w", "--stdin", stdin=f"{EDITED} filter={FILTER}\n").strip()
+    tree = answer(scene.stack, "mktree", stdin=f"100644 blob {blob}\t.gitattributes\n").strip()
+    size = len(answer(scene.stack, "cat-file", "blob", f"{scene.pin}:{EDITED}").encode())
+    scene.filtered(f"--attr-source={tree}")
+    return {"GIT_ATTR_SOURCE": tree, "GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": f"filter.{FILTER}.clean",
+            "GIT_CONFIG_VALUE_0": f"head -c {size}"}
+
+
+#: Each control: what it sets; the variables, from its own state (the clone's checkout and HEAD left as they
+#: are); what is done to the clone; and the words its verdict must hold.
+INHERITED: tuple[tuple[str, Callable[[Scene], dict[str, str]], Callable[[Scene], None], str], ...] = (
+    ("GIT_DIR, a repository whose HEAD and gitlink are a commit holding the clone's edit", repository, Scene.edit,
+     "differs from the pinned"),
+    ("GIT_INDEX_FILE, an index whose gitlink is the revision the clone is checked out at", index,
+     lambda s: answer(s.stack, "checkout", "--quiet", f"{s.pin}~1"), "is not the pinned"),
+    ("GIT_WORK_TREE, another directory", lambda s: {"GIT_WORK_TREE": str(s.own)}, Scene.edit,
+     "differs from the pinned"),
+    ("GIT_COMMON_DIR, an empty repository's", lambda s: {"GIT_COMMON_DIR": str(empty(s))}, Scene.edit,
+     "differs from the pinned"),
+    ("GIT_OBJECT_DIRECTORY, an empty store", lambda s: {"GIT_OBJECT_DIRECTORY": str(empty(s) / "objects")},
+     Scene.edit, "differs from the pinned"),
+    ("GIT_ALTERNATE_OBJECT_DIRECTORIES, the clone's objects, which its own store no longer holds", alternate,
+     unstored, "cannot read the pinned tree"),
+    ("GIT_REPLACE_REF_BASE, a base under which the pinned src/ tree is replaced by one holding the edit", swapped,
+     Scene.edit, "differs from the pinned"),
+    ("GIT_CONFIG_COUNT, its key and value, core.fsmonitor naming a program", lambda s: configured(s, ""),
+     Scene.edit, "differs from the pinned"),
+    ("GIT_CONFIG_PARAMETERS, core.fsmonitor naming a program", lambda s: configured(s, "GIT_CONFIG_PARAMETERS"),
+     Scene.edit, "differs from the pinned"),
+    ("GIT_CONFIG_GLOBAL, a file whose core.fsmonitor names a program", lambda s: configured(s, "GIT_CONFIG_GLOBAL"),
+     Scene.edit, "differs from the pinned"),
+    ("GIT_CONFIG_SYSTEM, a file whose core.fsmonitor names a program", lambda s: configured(s, "GIT_CONFIG_SYSTEM"),
+     Scene.edit, "differs from the pinned"),
+    ("HOME, a directory whose .gitconfig names a program", lambda s: configured(s, "HOME"), Scene.edit,
+     "differs from the pinned"),
+    ("XDG_CONFIG_HOME, a directory whose git/config names a program", lambda s: configured(s, "XDG_CONFIG_HOME"),
+     Scene.edit, "differs from the pinned"),
+    ("GIT_CONFIG_COUNT, its key and value, a clean filter turning the edit back into the pinned blob",
+     filter_given, Scene.edit, "differs from the pinned"),
+    ("GIT_ATTR_SOURCE, a tree giving the edited source a clean filter that turns it back into the pinned blob",
+     attributes_given, Scene.edit, "differs from the pinned"),
+)
+
+
+def judged_twice() -> tuple[bool, str]:
+    """The audit hook's judge of the helper's environment given, as CPython 3.14's fork_exec gives it, a list of
+    entries with GIT_NO_REPLACE_OBJECTS twice, the first 0, which is the one Git reads."""
+    entries = [b"GIT_NO_REPLACE_OBJECTS=0", *(f"{key}={value}".encode() for key, value in GIT_ENVIRONMENT.items())]
+    why = environment_judge(GIT_ENVIRONMENT)("_posixsubprocess.fork_exec", entries)
+    return why is None, why or "no refusal"
+
+
+def merged(into: dict[str, str], more: dict[str, str]) -> None:
+    """`more`'s variables added to `into`, GIT_CONFIG_COUNT's entries after those `into` already holds."""
+    first, count = int(into.get("GIT_CONFIG_COUNT", "0")), int(more.get("GIT_CONFIG_COUNT", "0"))
+    for n in range(count):
+        into[f"GIT_CONFIG_KEY_{first + n}"] = more[f"GIT_CONFIG_KEY_{n}"]
+        into[f"GIT_CONFIG_VALUE_{first + n}"] = more[f"GIT_CONFIG_VALUE_{n}"]
+    into.update({k: v for k, v in more.items() if not k.startswith(("GIT_CONFIG_COUNT", "GIT_CONFIG_KEY_",
+                                                                    "GIT_CONFIG_VALUE_"))})
+    if count:
+        into["GIT_CONFIG_COUNT"] = str(first + count)
+
+
+def inherited_arms(stack: Path, pin: str, work: Path,
+                   run: Callable[[Path, dict[str, str]], tuple[int, str]]) -> list[tuple]:
+    """The pin controls of the inherited environment, as ctrl_pin.pin_controls runs them (each after a fresh clone
+    of the stack at `stack`, pinned at `pin`): each control of INHERITED, the pinned clone with every variable at
+    once, and the judge given entries with a key twice. `run` runs the proof on a stack checkout with variables
+    added to the environment it inherits: its exit status and output."""
+    own = work / "inherited"
+    given: dict[str, str] = {}
+
+    def prepare(controls: tuple, spoiled: bool) -> None:
+        """Each control's own directory afresh and its variables; then (`spoiled`) what it does to the clone."""
+        if own.exists():
+            shutil.rmtree(own)
+        given.clear()
+        for n, (_, variables, _, _) in enumerate(controls):
+            (own / str(n)).mkdir(parents=True)
+            merged(given, variables(Scene(stack, pin, own / str(n))))
+        for _, _, spoil, _ in controls if spoiled else ():
+            spoil(Scene(stack, pin, own / "0"))
+
+    def verdict(needle: str) -> tuple[bool, str]:
+        """The proof's verdict on the clone with the variables inherited: accepted at the pin, and its last word.
+        A program the configuration names that Git ran fails the control, whatever the verdict."""
+        rc, out = run(stack, dict(given))
+        ran = sorted(own.rglob("ran"))
+        if ran:
+            return bool(needle), f"Git ran a program the inherited configuration names: " \
+                                 f"{ran[0].read_text(encoding='utf-8').splitlines()[0]}"
+        said = [ln.removeprefix("REFUSED: ") for ln in out.splitlines()
+                if ln.startswith(("REFUSED: ", "tsn-c-stack at "))]
+        detail = said[-1] if said else f"exit {rc}, no pin verdict: {out.strip()[-200:]}"
+        return rc == 0 and detail == f"tsn-c-stack at {pin}", detail
+
+    arms = [(f"the inherited environment, {control[0]}", lambda c=control: prepare((c,), True),
+             lambda n=control[3]: verdict(n), control[3]) for control in INHERITED]
+    return [*arms, ("the inherited environment, every variable above at once, the pinned clone",
+                    lambda: prepare(INHERITED, False), lambda: verdict(""), ""),
+            ("the audit hook's environment judge, fork_exec's entries with GIT_NO_REPLACE_OBJECTS twice",
+             lambda: None, judged_twice, "not each a key given once")]
diff --git a/sw/firmware/ctrl/test/ctrl_pin_lifecycle.py b/sw/firmware/ctrl/test/ctrl_pin_lifecycle.py
new file mode 100644
index 000000000..9501ce3cf
--- /dev/null
+++ b/sw/firmware/ctrl/test/ctrl_pin_lifecycle.py
@@ -0,0 +1,110 @@
+# SPDX-FileCopyrightText: 2026 Kebag Logic
+# SPDX-License-Identifier: CERN-OHL-W-2.0
+"""Scratch repositories cannot leave automatic maintenance racing their removal."""
+
+from __future__ import annotations
+
+import errno
+import os
+import shutil
+from pathlib import Path
+from typing import TYPE_CHECKING
+from unittest.mock import patch
+
+from ctrl_build import Refusal
+from ctrl_pin_env import Scene, answer, create
+from ctrl_pin_store import loose
+
+if TYPE_CHECKING:
+    from ctrl_pin import Clone
+
+
+def settings(directory: Path, scope: str) -> bool:
+    """Both independent maintenance switches are present in the requested configuration scope."""
+    lines = answer(directory, "config", "--show-scope", "--list").splitlines()
+    return all(f"{scope}\t{setting}" in lines for setting in ("gc.auto=0", "maintenance.auto=false"))
+
+
+def configured_clones(clone: Clone) -> bool:
+    """The ordinary clone and both other construction paths persist the disabled settings."""
+    clone.fresh()
+    own = clone.work / "lifecycle-config"
+    own.mkdir()
+    try:
+        create(own / "empty")
+        create(own / "second", clone.path)
+        return all(settings(path, "local") for path in (clone.path, own / "empty", own / "second"))
+    finally:
+        shutil.rmtree(own)
+
+
+def command_settings(clone: Clone) -> bool:
+    """Every helper command overrides enabled settings in the repository it reads."""
+    clone.fresh()
+    clone.answer("config", "gc.auto", "1")
+    clone.answer("config", "maintenance.auto", "true")
+    accepted, detail = clone.direct()
+    return not accepted and "gc.auto (local)" in detail and "maintenance.auto (local)" in detail and \
+        settings(clone.path, "command") and all(
+        clone.answer("config", "--get", key).strip() == value
+        for key, value in (("gc.auto", "0"), ("maintenance.auto", "false")))
+
+
+def loose_fetch(clone: Clone) -> bool:
+    """The hosted failure's loose-object fetch stays unpacked and permits the next fresh clone."""
+    clone.fresh()
+    own = clone.work / "lifecycle-fetch"
+    own.mkdir()
+    try:
+        loose(Scene(clone.path, clone.pin, own))
+        safe = settings(clone.path, "local") and settings(clone.path, "command")
+        clone.fresh()
+        return safe and clone.direct()[0]
+    finally:
+        shutil.rmtree(own)
+
+
+def deletion(clone: Clone, error: int) -> bool:
+    """Race an unlink after directory enumeration, or inject another error at that same operation."""
+    clone.fresh()
+    victim = clone.path / ".git/maintenance.lock"
+    victim.write_text("transient\n", encoding="utf-8")
+    unlink = os.unlink
+    seen = False
+
+    def raced(path: str, *, dir_fd: int | None = None) -> None:
+        """Inject the selected race or error on the actual removal call."""
+        nonlocal seen
+        if Path(path).name == victim.name:
+            seen = True
+            if error == errno.ENOENT:
+                unlink(path, dir_fd=dir_fd)
+            else:
+                raise OSError(error, "planted scratch removal failure", path)
+        unlink(path, dir_fd=dir_fd)
+
+    try:
+        with patch("os.unlink", raced):
+            clone.fresh()
+    except OSError as exc:
+        return seen and error != errno.ENOENT and exc.errno == error
+    return seen and error == errno.ENOENT and clone.direct()[0]
+
+
+def controls(clone: Clone) -> tuple[int, int]:
+    """Exercise real scratch construction, fetch and removal; never turn another deletion error green."""
+    cases = (("clone, init and secondary clone disable maintenance", lambda: configured_clones(clone)),
+             ("every Git call overrides enabled local maintenance", lambda: command_settings(clone)),
+             ("loose fetch then fresh clone", lambda: loose_fetch(clone)),
+             ("file vanishing after enumeration", lambda: deletion(clone, errno.ENOENT)),
+             ("permission error is propagated", lambda: deletion(clone, errno.EACCES)),
+             ("I/O error is propagated", lambda: deletion(clone, errno.EIO)))
+    bad = 0
+    for name, check in cases:
+        try:
+            ok, detail = check(), ""
+        except (OSError, Refusal) as exc:
+            ok, detail = False, str(exc)
+        print(f"[{'ok' if ok else 'ESCAPED'}] scratch lifecycle, {name}: {detail or str(ok)}", flush=True)
+        bad += not ok
+    return bad, len(cases)
diff --git a/sw/firmware/ctrl/test/ctrl_pin_store.py b/sw/firmware/ctrl/test/ctrl_pin_store.py
new file mode 100644
index 000000000..6e4315872
--- /dev/null
+++ b/sw/firmware/ctrl/test/ctrl_pin_store.py
@@ -0,0 +1,453 @@
+# SPDX-FileCopyrightText: 2026 Kebag Logic
+# SPDX-License-Identifier: CERN-OHL-W-2.0
+"""ctrl_pin_store.py - the pin proof's controls of Git's object store and of the repositories' own configuration (#697).
+
+The pin proof reads the pinned commit and each tree under it raw from the
+stack's object store, and hashes each here against its id
+(ctrl_build.stored); it reads no blob, hashing each file of the checkout from
+its own bytes instead. Git checks the hash of no object cat-file prints, nor
+of a tree below the one ls-tree is given, so without that check an object
+forged in the store would be read as the pinned one. Each of these controls
+takes a clone of the stack whose objects are all loose in its own store (none
+packed, none in another store), edits a source, and replaces the loose file of
+one object of the pin with one holding the bytes of another that would hide the
+edit (a new file, so no file a hard link shares is written):
+- the pinned src/ tree, with a tree holding the edit (R585-12's F1): refused
+  as a forged object, by the tree's place;
+- the pinned commit, with a commit whose tree holds the edit: refused as a
+  forged object, the pinned commit;
+- the pinned blob of the edited source, with the edit's: refused by the edited
+  source's name, since the proof reads no blob.
+Nor is a file hashed through Git: a source whose line endings the clone's
+attributes have Git convert back into the pinned blob (text) is refused by
+its name.
+Both repositories' keys are parsed by one parser (ctrl_build.parsed_key)
+into a section, a subsection (none, empty or named) and a variable.
+The stack's own configuration may hold only Git's own bookkeeping of a
+clone and a submodule (ctrl_build.STACK_CONFIG, its allowlist, `*` standing
+for a named subsection), and the pin check refuses every other key by its
+name before it reads an object (ctrl_build.configured). One control holds
+each family of keys it refuses, each key naming a recorder
+(ctrl_pin_env.RECORDER) where it names a program:
+- a promisor remote whose transport is a program, beside a missing object of
+  the pin, as R584-12 and R585-13 probed it: its upload-pack
+  (remote.<name>.uploadpack), and ssh through core.sshCommand;
+- each of those four keys alone: extensions.partialClone and
+  remote.<name>.promisor beside the missing object, remote.<name>.uploadpack
+  and core.sshCommand on the pinned clone;
+- core.fsmonitor beside an edit, core.hooksPath, credential.helper, and the
+  other programs Git may start (an askpass, a pager, an editor, a textconv, a
+  signing program, an alternate refs command, a pack-objects hook);
+- an include of a file that names a program, and a work tree's own
+  configuration that does;
+- a key no Git defines, as a later Git might add.
+Each ends in the refusal naming exactly the keys it planted, and the recorder
+never runs. A clone holding a key of every family of the allowlist is
+accepted, and one holding submodule "".active, an allowlisted section and
+variable with an empty subsection, is refused by that key. A clean filter in
+the clone's own configuration is held by ctrl_pin.py's control.
+The superproject's own configuration may not hold a key of the sections and
+variables ctrl_build.SUPERPROJECT_REFUSED names, whatever its subsection: a
+promisor remote and its transport (extensions.partialClone,
+remote.promisor, remote.partialCloneFilter, remote.uploadpack,
+core.sshCommand) and core.fsmonitor. The pin check refuses each by its name
+before it reads the gitlink from the superproject's index
+(ctrl_build.superproject_configured), so the superproject declares no
+promisor remote in any key spelling Git reads, judged by section and
+variable; its other keys are not judged. Eight controls read the gitlink of a
+superproject whose index records the pin, as the proof reads the checkout's
+(ctrl_build.stack_gitlink):
+- its own configuration naming the recorder as core.fsmonitor;
+- a partial clone whose sparse index lacks the tree that holds the gitlink, as
+  R585-14 probed it: its promisor remote's upload-pack the recorder, which
+  then serves the tree (SERVER), and its remote reached over ssh through
+  core.sshCommand;
+- that sparse index beside a promisor remote declared without a subsection
+  (remote.promisor, remote.partialCloneFilter) or with an empty one
+  (remote "".promisor), as R584-14 probed it, which Git names "" and reaches
+  through the recorder by an ext:: URL rewrite (unnamed_promisor);
+- an included file and its work tree's own configuration, each naming the
+  recorder as core.fsmonitor.
+Each ends in the refusal naming exactly the refused keys it planted, and the
+recorder never runs. An eighth, the superproject configured as
+actions/checkout and git submodule update --init leave it (its token as
+http.<url>.extraheader, the stack's submodule entries), is read as the pin.
+The helper also gives Git core.fsmonitor=false and GIT_NO_LAZY_FETCH=1,
+defence in depth behind both repositories' checks.
+"""
+
+from __future__ import annotations
+
+import shutil
+from collections.abc import Callable
+from pathlib import Path
+
+from ctrl_build import (STACK_CONFIG, SUPERPROJECT_KEYS, UNLISTED, Refusal, family, parsed_key, stack_gitlink,
+                        stack_pin)
+from ctrl_pin_env import EDITED, GITLINK, RECORDER, Scene, answer, create
+
+#: More objects than a fetch of the pin's history brings, so that the fetch unpacks each into a loose object
+#: rather than keep the pack it is sent.
+UNPACK_LIMIT = 1_000_000
+#: The pin check's words for an object of the store that does not hash to its id.
+FORGED = "holds a forged or corrupt object: "
+#: The program a superproject's promisor remote's upload-pack control names: it records that it ran, as the
+#: recorder does (ctrl_pin_env.RECORDER), then serves what it is asked for, so that a Git that fetched through it
+#: would be given the tree the superproject lacks, read the gitlink, and accept.
+SERVER = '#!/bin/sh\necho "$0 $*" >> "$(dirname "$0")/ran"\nexec git-upload-pack "$@"\n'
+
+
+def loose(scene: Scene) -> None:
+    """The clone made again with every object of the pin's history loose in its own store, none packed and none
+    in another store: fetched from the clone into a new repository, then checked out at the pin."""
+    packed = scene.own / "packed"
+    scene.stack.rename(packed)
+    create(scene.stack)
+    answer(scene.stack, "-c", f"fetch.unpackLimit={UNPACK_LIMIT}", "fetch", "--quiet", "--no-tags", str(packed),
+           "HEAD")
+    answer(scene.stack, "-c", "advice.detachedHead=false", "checkout", "--quiet", scene.pin)
+    shutil.rmtree(packed)
+    store = scene.stack / ".git/objects"
+    if any((store / "pack").iterdir()) or (store / "info/alternates").exists():
+        raise Refusal("an object-store control's clone keeps a pack or another store, so it cannot forge an object")
+
+
+def forge(scene: Scene, victim: str, source: str) -> None:
+    """Reading the object `victim` gives the object `source`'s bytes: its loose file replaced by a new one holding
+    theirs, so that no file another store may share through a hard link is written."""
+    if victim == source:
+        raise Refusal(f"an object-store control would forge {victim[:8]} with itself")
+    taken, given = (scene.stack / ".git/objects" / oid[:2] / oid[2:] for oid in (victim, source))
+    forged = taken.with_name(taken.name + ".forged")
+    forged.write_bytes(given.read_bytes())
+    forged.replace(taken)
+
+
+def forged_tree(scene: Scene) -> None:
+    """The edit on disk, and the pinned src/ tree's object overwritten by a tree holding it (R585-12's F1)."""
+    loose(scene)
+    scene.edit()
+    forge(scene, *scene.edited_src())
+
+
+def forged_commit(scene: Scene) -> None:
+    """The edit on disk, and the pinned commit's object overwritten by a copy of it whose tree holds the edit."""
+    loose(scene)
+    scene.edit()
+    _, src = scene.edited_src()
+    root = answer(scene.stack, "rev-parse", f"{scene.pin}^{{tree}}").strip()
+    commit = answer(scene.stack, "cat-file", "commit", scene.pin)
+    copy = commit.replace(f"tree {root}\n", f"tree {scene.remade(root, 'src', src)}\n", 1)
+    forge(scene, scene.pin, answer(scene.stack, "hash-object", "-t", "commit", "-w", "--stdin", stdin=copy).strip())
+
+
+def forged_blob(scene: Scene) -> None:
+    """The edit on disk, and the object of the edited source's pinned blob overwritten by the edit's."""
+    loose(scene)
+    scene.edit()
+    blob = answer(scene.stack, "hash-object", "-w", "--stdin", stdin=scene.edited()).strip()
+    forge(scene, answer(scene.stack, "rev-parse", f"{scene.pin}:{EDITED}").strip(), blob)
+
+
+def converted(scene: Scene) -> None:
+    """A source's line endings made CRLF, and the clone's attributes giving it the text attribute, which has Git
+    convert them back when it hashes the file, so that a hash through Git is the pinned blob (checked here, or the
+    control would prove nothing): a conversion no configuration names."""
+    source = scene.stack / EDITED
+    data = source.read_bytes()
+    if b"\r" in data:
+        raise Refusal("the line-ending control needs a source that holds no carriage return")
+    source.write_bytes(data.replace(b"\n", b"\r\n"))
+    (scene.stack / ".git/info/attributes").write_text(f"{EDITED} text\n", encoding="utf-8")
+    if answer(scene.stack, "hash-object", EDITED) != answer(scene.stack, "rev-parse", f"{scene.pin}:{EDITED}"):
+        raise Refusal("the line-ending control's conversion does not turn its edit back into the pinned blob")
+
+
+def superproject(scene: Scene, keys: tuple[tuple[str, str], ...]) -> None:
+    """A superproject whose index's gitlink is the pin, `keys` set in its own configuration."""
+    top = scene.own / "superproject"
+    create(top)
+    answer(top, "update-index", "--add", "--cacheinfo", f"160000,{scene.pin},{GITLINK}")
+    for key, value in keys:
+        answer(top, "config", key, value)
+
+
+def checked_out(scene: Scene) -> None:
+    """A superproject whose gitlink is the pin, its own configuration holding what actions/checkout writes there
+    (the remote, gc.auto, the token as http.<url>.extraheader) and what git submodule update --init writes for
+    the stack (its url, and active)."""
+    superproject(scene, (("remote.origin.url", "https://github.com/kebag-logic/milan-fpga"),
+                         ("remote.origin.fetch", "+refs/heads/*:refs/remotes/origin/*"), ("gc.auto", "0"),
+                         ("http.https://github.com/.extraheader", "AUTHORIZATION: basic pin-control"),
+                         (f"submodule.{GITLINK}.url", "https://github.com/kebag-logic/tsn-c-stack.git"),
+                         (f"submodule.{GITLINK}.active", "true")))
+
+
+def superproject_included(scene: Scene) -> None:
+    """A superproject whose gitlink is the pin, its own configuration including (include.path) a file that names
+    the recorder as core.fsmonitor, and its work tree's own configuration (extensions.worktreeConfig) naming it."""
+    (scene.own / "included").write_text(f"[core]\n\tfsmonitor = {scene.recorder()}\n", encoding="utf-8")
+    superproject(scene, (("include.path", str(scene.own / "included")), ("extensions.worktreeConfig", "true")))
+    answer(scene.own / "superproject", "config", "--worktree", "core.fsmonitor", scene.recorder())
+
+
+def sparse_superproject(scene: Scene, keys: Callable[[Path], tuple[tuple[str, str | None], ...]]) -> None:
+    """A superproject whose sparse index holds the gitlink (the pin) under a sparse directory whose tree its own
+    store lacks, as R585-14 probed it: fetched, every object loose, from an origin beside it that holds the tree,
+    made sparse outside another directory, then checked out, then that tree's object removed; then `keys`
+    (given the origin's path) set in its own configuration, a value None naming the recorder. A Git reading the
+    gitlink must fetch the tree first."""
+    origin, top, parent = scene.own / "origin", scene.own / "superproject", GITLINK.rpartition("/")[0]
+    create(origin)
+    (origin / "kept").mkdir()
+    (origin / "kept/file").write_text("kept\n", encoding="utf-8")
+    answer(origin, "add", "kept/file")
+    answer(origin, "update-index", "--add", "--cacheinfo", f"160000,{scene.pin},{GITLINK}")
+    answer(origin, "-c", "user.name=pin-control", "-c", "user.email=pin-control@invalid", "commit", "--quiet", "-m",
+           "pin-control")
+    create(top)
+    answer(top, "-c", f"fetch.unpackLimit={UNPACK_LIMIT}", "fetch", "--quiet", "--no-tags", str(origin), "HEAD")
+    answer(top, "update-ref", "HEAD", "FETCH_HEAD")
+    answer(top, "sparse-checkout", "set", "--cone", "--sparse-index", "kept")
+    answer(top, "checkout", "--quiet")
+    tree = answer(top, "rev-parse", f"HEAD:{parent}").strip()
+    if f"040000 {tree} 0\t{parent}/" not in answer(top, "ls-files", "--sparse", "--stage").splitlines():
+        raise Refusal("the sparse superproject control's index holds no sparse directory around the gitlink")
+    (top / ".git/objects" / tree[:2] / tree[2:]).unlink()
+    if any((top / ".git/objects/pack").iterdir()):
+        raise Refusal("the sparse superproject control's superproject keeps a pack, so it may still hold the tree")
+    for key, value in keys(origin):
+        answer(top, "config", key, scene.recorder() if value is None else value)
+
+
+def served(scene: Scene) -> str:
+    """The recorder that serves (SERVER), in the control's own directory, its record beside it."""
+    program = scene.own / "server"
+    program.write_text(SERVER, encoding="utf-8")
+    program.chmod(0o755)
+    return str(program)
+
+
+def unnamed_promisor(scene: Scene, key: str, value: str) -> None:
+    """A sparse superproject (sparse_superproject) whose own configuration declares a promisor remote by `key` alone,
+    in a spelling without a subsection or with an empty one, as R584-14 probed it: Git names that remote "" and
+    fetches from "" as a URL, which an empty url.<base>.insteadOf rewrites to an ext:: transport whose program is
+    the recorder (protocol.ext.allow=always). The superproject's check refuses neither of those two keys, so its
+    refusal names `key` alone."""
+    sparse_superproject(scene, lambda _: ((key, value), (f"url.ext::{scene.recorder()}.insteadOf", ""),
+                                          ("protocol.ext.allow", "always")))
+
+
+def monitored_stack(scene: Scene) -> None:
+    """The clone's own configuration naming the recorder as core.fsmonitor, and the edit on disk."""
+    answer(scene.stack, "config", "core.fsmonitor", scene.recorder())
+    scene.edit()
+
+
+def keyed(scene: Scene, keys: tuple[tuple[str, str | None], ...], missing: bool = False) -> None:
+    """`keys` set in the clone's own configuration, a value None naming the recorder; first (`missing`) the clone
+    made again with every object loose (loose) and the pinned src/ tree's object removed, so that Git reading the
+    pin would fetch it from a promisor remote the keys name."""
+    if missing:
+        loose(scene)
+        src = answer(scene.stack, "rev-parse", f"{scene.pin}:src").strip()
+        (scene.stack / ".git/objects" / src[:2] / src[2:]).unlink()
+    for key, value in keys:
+        answer(scene.stack, "config", key, scene.recorder() if value is None else value)
+
+
+def hooked(scene: Scene) -> None:
+    """The clone's own configuration naming as core.hooksPath a directory whose hooks are the recorder."""
+    hooks = scene.own / "hooks"
+    hooks.mkdir()
+    for hook in ("post-checkout", "post-index-change", "reference-transaction"):
+        (hooks / hook).write_text(RECORDER, encoding="utf-8")
+        (hooks / hook).chmod(0o755)
+    answer(scene.stack, "config", "core.hooksPath", str(hooks))
+
+
+def included(scene: Scene) -> None:
+    """The clone's own configuration including (include.path) a file that names the recorder as core.fsmonitor."""
+    (scene.own / "included").write_text(f"[core]\n\tfsmonitor = {scene.recorder()}\n", encoding="utf-8")
+    answer(scene.stack, "config", "include.path", str(scene.own / "included"))
+
+
+def worktree_configured(scene: Scene) -> None:
+    """The clone's work tree given its own configuration (extensions.worktreeConfig), which names the recorder as
+    core.fsmonitor."""
+    answer(scene.stack, "config", "extensions.worktreeConfig", "true")
+    answer(scene.stack, "config", "--worktree", "core.fsmonitor", scene.recorder())
+
+
+def allowlisted(scene: Scene) -> None:
+    """A key of each family of the allowlist (ctrl_build.STACK_CONFIG) in the clone's own configuration, beside the
+    keys its clone holds, each naming what Git itself would: the clone's own work tree, a branch's remote, its
+    submodules' bookkeeping. A family the clone then holds no key of refuses the control's setup."""
+    keyed(scene, (("core.worktree", str(scene.stack)), ("branch.main.remote", "origin"),
+                  ("branch.main.merge", "refs/heads/main"), ("submodule.active", "."),
+                  ("submodule.pin-control.url", "../pin-control.git"), ("submodule.pin-control.active", "true"),
+                  ("submodule.alternateLocation", "superproject"), ("submodule.alternateErrorStrategy", "die")))
+    held = {family(*parsed_key(entry.partition("\n")[0]))
+            for entry in filter(None, answer(scene.stack, "config", "--list", "--local", "-z").split("\0"))}
+    lacking = sorted(set(STACK_CONFIG) - held)
+    if lacking:
+        raise Refusal(f"the allowlisted configuration control's clone holds no {', '.join(lacking)}")
+
+
+def partial(name: str, url: str) -> tuple[tuple[str, str | None], ...]:
+    """The keys that make the clone a partial clone whose promisor remote is `name`, at `url`."""
+    return (("core.repositoryformatversion", "1"), ("extensions.partialClone", name), (f"remote.{name}.url", url),
+            (f"remote.{name}.promisor", "true"))
+
+
+#: The programs Git may start that no other control names, each key naming the recorder.
+HELPERS = ("core.askPass", "core.pager", "core.editor", "diff.pin-control.textconv", "gpg.program",
+           "core.alternateRefsCommand", "uploadpack.packObjectsHook")
+
+
+#: The spellings of a promisor remote without a subsection or with an empty one (unnamed_promisor), as R584-14
+#: probed them: what each is, the key set and its value, and the key as Git lists it.
+UNNAMED = (("remote.promisor, no subsection", "remote.promisor", "true", "remote.promisor"),
+           ("remote.partialCloneFilter, no subsection", "remote.partialCloneFilter", "tree:0",
+            "remote.partialclonefilter"),
+           ('remote "".promisor, an empty subsection', "remote..promisor", "true", "remote..promisor"))
+
+
+def refused(*keys: str) -> str:
+    """The pin check's refusal of exactly `keys` of the superproject's own configuration, each with its scope."""
+    return SUPERPROJECT_KEYS + ", ".join(keys)
+
+
+def unlisted(*keys: str) -> str:
+    """The pin check's refusal of exactly `keys` of the stack's own configuration, each with its scope."""
+    return UNLISTED + ", ".join(keys)
+
+
+def superproject_controls(gitlink: Callable[[], str]) -> tuple[tuple, ...]:
+    """The controls of the superproject's own configuration (store_arms), each read by `gitlink`: what it is, how
+    the superproject is made, how it is read, and the words its verdict must hold (none: the pin is read)."""
+    return (
+        ("the superproject's own configuration, a program named as core.fsmonitor, its gitlink read",
+         lambda s: superproject(s, (("core.fsmonitor", s.recorder()),)), gitlink, refused("core.fsmonitor (local)")),
+        ("the superproject's own configuration, a sparse index whose sparse directory holding the gitlink lacks its "
+         "tree, a partial clone whose promisor remote's upload-pack is a program that serves it, its gitlink read",
+         lambda s: sparse_superproject(s, lambda origin: (*partial("origin", str(origin)),
+                                                          ("remote.origin.partialCloneFilter", "tree:0"),
+                                                          ("remote.origin.uploadpack", served(s)))), gitlink,
+         refused("extensions.partialclone (local)", "remote.origin.partialclonefilter (local)",
+                 "remote.origin.promisor (local)", "remote.origin.uploadpack (local)")),
+        ("the superproject's own configuration, a sparse index whose sparse directory holding the gitlink lacks its "
+         "tree, a partial clone whose promisor remote is reached over ssh by a program (core.sshCommand), its gitlink "
+         "read",
+         lambda s: sparse_superproject(s, lambda _: (*partial("probe", "ssh://pin-control.invalid/superproject"),
+                                                     ("core.sshCommand", None))), gitlink,
+         refused("core.sshcommand (local)", "extensions.partialclone (local)", "remote.probe.promisor (local)")),
+        *(("the superproject's own configuration, a sparse index whose sparse directory holding the gitlink lacks its "
+           f"tree, a promisor remote declared by {what}, reached through a program by an ext:: URL rewrite, its "
+           "gitlink read", lambda s, k=key, v=value: unnamed_promisor(s, k, v), gitlink, refused(f"{listed} (local)"))
+          for what, key, value, listed in UNNAMED),
+        ("the superproject's own configuration, an included file (include.path) and its work tree's own "
+         "configuration each naming a program as core.fsmonitor, its gitlink read", superproject_included, gitlink,
+         refused("core.fsmonitor (local)", "core.fsmonitor (worktree)")),
+        ("the superproject's own configuration as actions/checkout and git submodule update --init write it, its "
+         "gitlink read", checked_out, gitlink, ""))
+
+
+def store_arms(stack: Path, pin: str, work: Path, edited: str) -> list[tuple]:
+    """The pin controls of the object store and of the repositories' own configuration, as ctrl_pin.pin_controls
+    runs them (each after a fresh clone of the stack at `stack`, pinned at `pin`): each must end in its verdict,
+    and no program a configuration names may run. `edited` begins the refusal of a checkout that differs."""
+    own = work / "store"
+    scene = Scene(stack, pin, own)
+
+    def spoiled(spoil: Callable[[Scene], None]) -> Callable[[], None]:
+        """`spoil`, in a control directory of its own made afresh."""
+        def prepared() -> None:
+            """The control's directory afresh, then `spoil`."""
+            if own.exists():
+                shutil.rmtree(own)
+            own.mkdir(parents=True)
+            spoil(scene)
+        return prepared
+
+    def gitlink() -> str:
+        """The superproject's gitlink, read as the pin proof reads the checkout's: the pin, or a Refusal."""
+        said = stack_gitlink(own / "superproject")
+        if said != pin:
+            raise Refusal(f"the superproject's gitlink was read as {said}, not as the pin {pin}")
+        return said
+
+    def judged(read: Callable[[], str], needle: str) -> tuple[bool, str]:
+        """`read`'s verdict: accepted, and what it said. A program a configuration names that Git ran fails the
+        control, whatever the verdict."""
+        try:
+            accepted, said = True, f"accepted {read()}"
+        except Refusal as exc:
+            accepted, said = False, str(exc)
+        ran = sorted(own.rglob("ran"))
+        if ran:
+            return bool(needle), f"Git ran a program a repository's own configuration names: " \
+                                 f"{ran[0].read_text(encoding='utf-8').splitlines()[0]}"
+        return accepted, said
+
+    def checked() -> str:
+        """The pin check on the clone."""
+        return stack_pin(stack, pin)
+
+    controls = (
+        ("the object store, a source edited, the pinned src/ tree's object overwritten by a tree holding the edit",
+         forged_tree, checked, FORGED + "the pinned src/ tree"),
+        ("the object store, a source edited, the pinned commit's object overwritten by a commit whose tree holds "
+         "the edit", forged_commit, checked, FORGED + "the pinned commit"),
+        ("the object store, a source edited, its pinned blob's object overwritten by the edit's", forged_blob,
+         checked, edited + EDITED),
+        ("the stack's attributes, a source's line endings changed, a conversion they give turning it back into the "
+         "pinned blob", converted, checked, edited + EDITED),
+        *superproject_controls(gitlink),
+        ("the stack's own configuration, a program named as core.fsmonitor, a source edited", monitored_stack,
+         checked, unlisted("core.fsmonitor (local)")),
+        ("the stack's own configuration, a key of each family of its allowlist, the pinned clone", allowlisted,
+         checked, ""),
+        ("the stack's own configuration, a key of an allowlisted family's section and variable with an empty "
+         'subsection (submodule "".active), the pinned clone', lambda s: keyed(s, (("submodule..active", "true"),)),
+         checked, unlisted("submodule..active (local)")),
+        ("the stack's own configuration, a partial clone whose promisor remote's upload-pack is a program, the "
+         "pinned src/ tree's object missing",
+         lambda s: keyed(s, (*partial("origin", str(s.stack)), ("remote.origin.uploadpack", None)), True), checked,
+         unlisted("extensions.partialclone (local)", "remote.origin.promisor (local)",
+                  "remote.origin.uploadpack (local)")),
+        ("the stack's own configuration, a partial clone whose promisor remote is reached over ssh by a program "
+         "(core.sshCommand), the pinned src/ tree's object missing",
+         lambda s: keyed(s, (*partial("probe", "ssh://pin-control.invalid/stack"), ("core.sshCommand", None)), True),
+         checked, unlisted("core.sshcommand (local)", "extensions.partialclone (local)",
+                           "remote.probe.promisor (local)")),
+        ("the stack's own configuration, extensions.partialClone alone, the pinned src/ tree's object missing",
+         lambda s: keyed(s, (("core.repositoryformatversion", "1"), ("extensions.partialClone", "origin"),
+                             ("remote.origin.url", str(s.stack))), True), checked,
+         unlisted("extensions.partialclone (local)")),
+        ("the stack's own configuration, remote.<name>.promisor alone, the pinned src/ tree's object missing",
+         lambda s: keyed(s, (("remote.origin.url", str(s.stack)), ("remote.origin.promisor", "true")), True),
+         checked, unlisted("remote.origin.promisor (local)")),
+        ("the stack's own configuration, a program named as remote.<name>.uploadpack",
+         lambda s: keyed(s, (("remote.origin.uploadpack", None),)), checked,
+         unlisted("remote.origin.uploadpack (local)")),
+        ("the stack's own configuration, a program named as core.sshCommand",
+         lambda s: keyed(s, (("core.sshCommand", None),)), checked, unlisted("core.sshcommand (local)")),
+        ("the stack's own configuration, a directory of programs named as core.hooksPath", hooked, checked,
+         unlisted("core.hookspath (local)")),
+        ("the stack's own configuration, a program named as credential.helper",
+         lambda s: keyed(s, (("credential.helper", None),)), checked, unlisted("credential.helper (local)")),
+        ("the stack's own configuration, a program named by each other key Git starts one for",
+         lambda s: keyed(s, tuple((key, None) for key in HELPERS)), checked,
+         unlisted("core.alternaterefscommand (local)", "core.askpass (local)", "core.editor (local)",
+                  "core.pager (local)", "diff.pin-control.textconv (local)", "gpg.program (local)",
+                  "uploadpack.packobjectshook (local)")),
+        ("the stack's own configuration, an included file (include.path) naming a program as core.fsmonitor",
+         included, checked, unlisted("core.fsmonitor (local)", "include.path (local)")),
+        ("the stack's work tree's own configuration (extensions.worktreeConfig), a program named as core.fsmonitor",
+         worktree_configured, checked, unlisted("core.fsmonitor (worktree)", "extensions.worktreeconfig (local)")),
+        ("the stack's own configuration, a key no Git defines, as a later Git might add, naming a program",
+         lambda s: keyed(s, (("pin-control.program", None),)), checked, unlisted("pin-control.program (local)")),
+    )
+    return [(what, spoiled(spoil), lambda r=read, n=needle: judged(r, n), needle)
+            for what, spoil, read, needle in controls]
