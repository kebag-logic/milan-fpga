+    .map_flat_o (ref_map_flat_o),
+    .i2s_pair_valid_i, .i2s_l_i, .i2s_r_i,
+    .tdm_pair_valid_i, .tdm_pair_slot_i, .tdm_l_i, .tdm_r_i, .tone_smp_i,
