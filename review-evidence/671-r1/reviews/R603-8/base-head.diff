+class Mutant(NamedTuple):
+    """One edit of one function or class, and the rule or property it removes or weakens."""
+
+    name: str
+    target: str
+    owner: str
+    attribute: str
+    old: str
+    new: str
+    arm: str
+
+
+#: What the mutants target besides ctrl_memory.RULES: the documented behaviour that is not a refusal.
