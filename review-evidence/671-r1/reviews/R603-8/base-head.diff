+def parsed_key(key: str) -> tuple[str, str | None, str]:
+    """A configuration key as Git lists it, parsed as Git's own parser (parse_config_key) parses it: its section, all
+    before the first dot; its variable, all after the last; and its subsection, which may hold dots, all between.
+    Git lists the section and the variable in lower case. The subsection is None where the key has none
+    (remote.promisor), "" where it is empty (remote "".promisor, which Git lists as remote..promisor), and its name
+    otherwise."""
+    section, _, rest = key.partition(".")
+    subsection, dot, variable = rest.rpartition(".")
+    return section, subsection if dot else None, variable
+
+
+def configuration(directory: Path) -> list[tuple[str, str, str | None, str, str, str]]:
+    """All the configuration Git reads for the proof's commands in the repository at `directory`, as Git lists it
+    through the helper (config --list --show-scope), an included file's keys in the including file's scope: each
+    key's scope, its section, subsection and variable (parsed_key, the one parser of both repositories' keys), the
+    key as Git names it, and its value. Listing it reads no index and no object."""
+    res = git(directory, "config", "--list", "--show-scope", "-z")
+    if res.returncode:
+        raise Refusal(f"cannot read the configuration of {directory}: {res.stderr.strip()}")
+    listed, entries = res.stdout, []
+    while listed:
+        scope, _, listed = listed.partition("\0")
+        entry, _, listed = listed.partition("\0")
+        key, _, value = entry.partition("\n")
+        entries.append((scope, *parsed_key(key), key, value))
+    return entries
+
+
+def family(section: str, subsection: str | None, variable: str) -> str:
+    """A parsed key (parsed_key) as STACK_CONFIG names its family: `section.variable` without a subsection,
+    `section.*.variable` with a named one, and `section."".variable` with an empty one, a family STACK_CONFIG does
+    not list."""
+    if subsection is None:
+        return f"{section}.{variable}"
+    named = "*" if subsection else '""'
+    return f"{section}.{named}.{variable}"
+
+
+def configured(stack: Path) -> None:
+    """Refuse the stack's repository whose configuration holds a key outside STACK_CONFIG's families (family), by
+    the key's name and scope, before the proof reads any object of it. What is judged is all the configuration Git
+    reads for the proof's commands there (configuration): the repository's own and its work tree's, which may hold
+    keys of STACK_CONFIG's families or the exact NO_MAINTENANCE settings, and the helper's command settings
+    (HELPER_CONFIG). No system or global file is read (GIT_ENVIRONMENT), so a key of either scope is refused too. The
+    stack's configuration holds Git's own bookkeeping of a clone and a submodule only, and no key of it names a
+    program, a promisor remote or its transport."""
+    refused = [f"{key} ({scope})" for scope, section, subsection, variable, key, value in configuration(stack)
+               if not (scope in ("local", "worktree") and
+                       (family(section, subsection, variable) in STACK_CONFIG or f"{key}={value}" in NO_MAINTENANCE) or
+                       scope == "command" and f"{key}={value}" in HELPER_CONFIG)]
+    if refused:
+        raise Refusal(UNLISTED + ", ".join(sorted(refused)))
+
+
+def superproject_configured(root: Path) -> None:
+    """Refuse the superproject at `root` whose own configuration holds a key of a section and variable
+    SUPERPROJECT_REFUSED names, whatever its subsection (parsed_key), by the key's name and scope, before
+    stack_gitlink reads its index. What is judged is all the configuration Git reads for the proof's commands there
+    (configuration), but the helper's own setting (HELPER_CONFIG): the repository's own and its work tree's, an
+    included file's keys among them. So the superproject declares no promisor remote in any key spelling Git reads,
+    judged by section and variable, through whose transport Git would fetch a tree a sparse index lacks while the
+    gitlink is read, and names no fsmonitor; its other keys are not judged."""
+    refused = [f"{key} ({scope})" for scope, section, _, variable, key, value in configuration(root)
+               if f"{section}.{variable}" in SUPERPROJECT_REFUSED and
+               not (scope == "command" and f"{key}={value}" in HELPER_CONFIG)]
+    if refused:
+        raise Refusal(SUPERPROJECT_KEYS + ", ".join(sorted(refused)))
+
+
+def stack_pin(stack: Path = STACK, pin: str | None = None) -> str:
+    """Refuse a stack checkout that is not at the recorded gitlink, or that is not the gitlink's whole tree:
+    the same paths, each of the same type and mode, every file and symbolic link hashed as git hashes a blob
+    and equal to the tree's. Its repository's configuration holds only Git's own bookkeeping (configured), so no
+    key of it names a program Git starts or a remote it fetches from; git reads the real objects only (git_env),
+    so a replacement or a graft changes nothing it reads; every object the proof reads, the pinned commit and each
+    of its trees, is hashed here and equal to its id (pinned_tree), so a forged or corrupt one is refused; and the
+    index is never consulted, so an edit hidden from `git status` (assume-unchanged, skip-worktree) is refused like
+    any other: every gate builds the pinned stack or none."""
+    pin = pin or stack_gitlink()
+    top = git(stack, "rev-parse", "--show-toplevel")
+    if top.returncode or Path(top.stdout.strip()).resolve() != stack.resolve():
+        raise Refusal(f"{stack} is not its own checkout: initialise the tsn-c-stack submodule")
+    configured(stack)
+    head = git(stack, "rev-parse", "HEAD").stdout.strip()
+    if head != pin:
+        raise Refusal(f"tsn-c-stack at {head or 'no HEAD'} is not the pinned {pin}")
+    algorithm = git(stack, "rev-parse", "--show-object-format").stdout.strip()
+    if algorithm not in hashlib.algorithms_available:
+        raise Refusal(f"cannot hash the objects of {stack}: no hash {algorithm or 'named'}")
+    want = pinned_tree(stack, pin, algorithm)
+    found = on_disk(stack, algorithm)
+    differ = sorted(name for name in want.keys() | found.keys() if want.get(name) != found.get(name))
+    if differ:
+        raise Refusal(f"tsn-c-stack differs from the pinned {pin[:8]}: {', '.join(differ)}")
+    return head
+
+
+#: Where each stack file lived in sw/firmware/ctrl before #697 moved the cores
+#: into the submodule (the file map of the stack's import record). A tree of an
+#: older revision (ctrl_image.py --base, ctrl_srp_image.py --ctrl-source) still
+#: holds them there.
+LEGACY = {"src/adp.c": "adp/adp.c", "src/acmp.c": "acmp/acmp.c", "src/maap.c": "maap/maap.c",
+          "include/adp.h": "adp/adp.h", "include/acmp.h": "acmp/acmp.h", "include/maap.h": "maap/maap.h",
+          "include/wire.h": "wire/wire.h"}
+
+
+def legacy_stack(ctrl: Path, into: Path) -> Path | None:
+    """For a ctrl tree from before #697, which holds its own cores, a copy of them in the stack's layout
+    under `into`; None for a tree that holds none. An older tree holds fewer (no ACMP before lane F3), and
+    a source the copy lacks is one its tree lacks."""
+    held = {new: old for new, old in LEGACY.items() if (ctrl / old).is_file()}
+    if not held:
+        return None
+    for new, old in held.items():
+        (into / new).parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(ctrl / old, into / new)
+    return into
+
+
+def main(argv: list[str] | None = None) -> int:
+    """The pin check from a command line, for the gates that are not Python (the mailbox bench's Makefile):
+    exit 0 with the pinned revision, or 2 with the refusal."""
+    ap = argparse.ArgumentParser(description="Refuse a tsn-c-stack checkout off its gitlink or differing from it.")
+    ap.add_argument("--stack-pin", type=Path, nargs="?", const=STACK, required=True, metavar="DIR",
+                    help="the stack checkout a gate builds (default: the submodule)")
+    args = ap.parse_args(argv)
+    try:
+        print(f"tsn-c-stack at {stack_pin(args.stack_pin.resolve())}")
+    except Refusal as exc:
+        print(f"REFUSED: {exc}")
+        return 2
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
