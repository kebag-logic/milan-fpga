+  localparam [ADDR_WIDTH-1:0] A_ETH_GUARD  = 'h7D8;  //! [0] guarded (RW via magic)
+  // ---- 0x7DC inert AS_PATH compatibility ABI ---------------------------
+  localparam [ADDR_WIDTH-1:0] A_ASP_LO  = 'h7DC;
+  localparam [ADDR_WIDTH-1:0] A_ASP_HI  = 'h7E0;
