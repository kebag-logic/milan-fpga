+    static std::uint32_t pub_domain(std::uint32_t t) {
+        return ((0x120u + t) << MBX_SR_DOMAIN_VID_LSB) | (((t + 5u) & 7u) << MBX_SR_DOMAIN_PRIORITY_LSB) |
+               ((t & 1u) << MBX_SR_DOMAIN_ADOPTED_LSB);
+    }
 
