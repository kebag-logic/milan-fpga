read_verilog base.launch.v
hierarchy -top KL_gptp_gmii_launch; proc; flatten; opt_clean; rename KL_gptp_gmii_launch gold; design -stash g
read_verilog head.launch.tied.v
hierarchy -top KL_gptp_gmii_launch; proc; flatten; opt_clean; rename KL_gptp_gmii_launch gate; design -stash h
design -copy-from g -as gold gold
design -copy-from h -as gate gate
equiv_make gold gate equiv
hierarchy -top equiv
opt_clean
equiv_simple -seq 2 -undef
equiv_induct -seq 3 -undef
tee -o equiv_launch2.status equiv_status
equiv_status -assert
