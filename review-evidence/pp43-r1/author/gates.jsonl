{"name": "parent-integrity", "cwd": "$LANES/pp43-49-gsi-internal", "command": ["python3", "-c", "from pathlib import Path\nimport subprocess\nparent = Path(\"$LANES/pp94-parent-consumer\")\ncopy = Path(\"$VALIDATION_STORAGE/pp43-a253-parent-validation\")\nhead = \"5771578784c77e945980c78faa52f3e54bcf5e2d\"\nparent_head = \"3eaee03f0c50522c4e4da8e12c771ec130a8c2f9\"\noriginal_pin = \"2e1675d2d20bbc0bb549b36b9d485b2f9b747d5f\"\ndef git(root, *args):\n    return subprocess.check_output([\"git\", \"-C\", str(root), *args], text=True).strip()\nassert git(parent, \"rev-parse\", \"HEAD\") == parent_head\nassert git(copy, \"rev-parse\", \"HEAD\") == parent_head\nassert git(parent, \"diff\", \"--cached\", \"--name-only\") == \"\"\nassert git(parent, \"diff\", \"--name-only\") == \"protocol-processor\"\nassert original_pin in git(parent, \"ls-files\", \"--stage\", \"protocol-processor\")\nassert head in git(copy, \"ls-files\", \"--stage\", \"protocol-processor\")\nassert git(copy, \"diff\", \"HEAD\", \"--name-only\") == \"protocol-processor\"\nfor root in (parent, copy):\n    assert git(root / \"protocol-processor\", \"rev-parse\", \"HEAD\") == head\n    assert git(root / \"protocol-processor\", \"status\", \"--porcelain\") == \"\"\nassert git(\".\", \"status\", \"--porcelain\") == \"\"\nassert git(\".\", \"diff\", \"--name-only\", \"0452c49201e2a124a8345a6f9678a3e064145f2b\", head) == \"tb/pp_top/gsi_mutants.py\"\nprint(\"PASS: designated parent HEAD and index unchanged; only its processor checkout moved\")\nprint(\"PASS: isolated copy has identical parent HEAD/content, with only candidate gitlink staged\")\nprint(\"PASS: both processor checkouts and author lane clean at \" + head)\nprint(\"PASS: final follow-up changes only mutant-runner annotations; RTL/docs/C++ tests unchanged\")\n"], "rc": 0, "seconds": 0.11}
