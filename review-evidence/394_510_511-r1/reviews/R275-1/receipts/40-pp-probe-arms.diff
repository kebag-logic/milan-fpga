+  // ---- R275 disposable probe: 0x0001 / 0x0003 / 0x0004 -------------------
+  void r275_probe_the_other_three_mvu_command_types() {
+    struct Case { uint16_t ct; size_t bytes; const char* what; };
+    const Case cases[] = {
+      {0x0001,  8, "SET_SYSTEM_UNIQUE_ID minimal"},
+      {0x0001, 16, "SET_SYSTEM_UNIQUE_ID with a u64 id"},
+      {0x0003,  8, "SET_MEDIA_CLOCK_REFERENCE_INFO minimal"},
+      {0x0003, 80, "SET_MEDIA_CLOCK_REFERENCE_INFO with a 64-byte name"},
+      {0x0004,  8, "GET_MEDIA_CLOCK_REFERENCE_INFO minimal"},
+      {0x0004, 12, "GET_MEDIA_CLOCK_REFERENCE_INFO with an index"},
+    };
+    uint16_t seq = 0xC0A0;
+    for (const auto& c : cases) {
+      auto cmd = mvu_cmd_pl(MVU_PID_LO, c.ct, c.bytes);
+      auto got = mvu(MVU_PID_LO, c.ct, seq, c.bytes);
+      auto want = mvu_expect(AECP_NOT_IMPLEMENTED, seq, cmd);
+      CHECK(!got.empty(), "R275: %s got silence", c.what);
+      CHECK(got == want, "R275: %s is not the byte-exact NOT_IMPLEMENTED echo", c.what);
+      if (!got.empty() && got != want) { dump("got ", got); dump("want", want); }
+      ++seq;
+    }
+  }
+
