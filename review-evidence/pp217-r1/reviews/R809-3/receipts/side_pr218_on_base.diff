+          SRP_AP_AA_C, SRP_AP_QA_C, SRP_AP_AP_C, SRP_AP_QP_C: nx = SRP_AP_VP_C;   // note 9
+          default:     nx = st;                // VP, VN, LA (note 10), LO
+        endcase
