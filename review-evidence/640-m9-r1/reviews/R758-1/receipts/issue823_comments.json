[{"url":"https://api.github.com/repos/kebag-logic/milan-fpga/issues/comments/6545894131","html_url":"https://github.com/kebag-logic/milan-fpga/issues/823#issuecomment-6545894131","issue_url":"https://api.github.com/repos/kebag-logic/milan-fpga/issues/823","id":6545894131,"node_id":"IC_kwDOP42Xbc8AAAABhipq8w","user":{"login":"Mister-M-alt","id":161579364,"node_id":"U_kgDOCaGBZA","avatar_url":"https://avatars.githubusercontent.com/u/161579364?v=4","gravatar_id":"","url":"https://api.github.com/users/Mister-M-alt","html_url":"https://github.com/Mister-M-alt","followers_url":"https://api.github.com/users/Mister-M-alt/followers","following_url":"https://api.github.com/users/Mister-M-alt/following{/other_user}","gists_url":"https://api.github.com/users/Mister-M-alt/gists{/gist_id}","starred_url":"https://api.github.com/users/Mister-M-alt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mister-M-alt/subscriptions","organizations_url":"https://api.github.com/users/Mister-M-alt/orgs","repos_url":"https://api.github.com/users/Mister-M-alt/repos","events_url":"https://api.github.com/users/Mister-M-alt/events{/privacy}","received_events_url":"https://api.github.com/users/Mister-M-alt/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-31T16:11:58Z","updated_at":"2026-10-31T16:11:58Z","body":"[A10] Owner, 2026-10-31 17:11: **a save may take up to 0.5 s.** The manager reads this as: from the change to durable in flash, worst case, at 32x32; the owner may correct the reading.\n\nAgainst today's design (`docs/design/SAVED_STATE_FASTCONNECT.md`, datasheet maxima):\n- A whole-image commit is 3.07 s at 1x1 and 3.27 s at 8x8. The 64 KiB erase is 3,000 ms of that, and programming is 5 ms per page.\n- At 32x32 the image is about 60 KB, about 240 pages, so programming alone would be about 1.2 s.\n\n**So this issue's format must make a save an append, not a rewrite:**\n- The standby slot is erased in the background after each commit, so no erase sits on the save path.\n- A save appends only the changed records, about one page per change.\n- Compaction, the full rewrite into the other slot, runs off the save path, and a power cut during it loses nothing.\n\n`T-NVM-COMMIT-TIMEOUT` (8,000 ms) is restated against the new worst case. The same bound applies to the firmware writer (#665 F1).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/kebag-logic/milan-fpga/issues/comments/6545894131/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/kebag-logic/milan-fpga/issues/comments/6545924397","html_url":"https://github.com/kebag-logic/milan-fpga/issues/823#issuecomment-6545924397","issue_url":"https://api.github.com/repos/kebag-logic/milan-fpga/issues/823","id":6545924397,"node_id":"IC_kwDOP42Xbc8AAAABhirhLQ","user":{"login":"Mister-M-alt","id":161579364,"node_id":"U_kgDOCaGBZA","avatar_url":"https://avatars.githubusercontent.com/u/161579364?v=4","gravatar_id":"","url":"https://api.github.com/users/Mister-M-alt","html_url":"https://github.com/Mister-M-alt","followers_url":"https://api.github.com/users/Mister-M-alt/followers","following_url":"https://api.github.com/users/Mister-M-alt/following{/other_user}","gists_url":"https://api.github.com/users/Mister-M-alt/gists{/gist_id}","starred_url":"https://api.github.com/users/Mister-M-alt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mister-M-alt/subscriptions","organizations_url":"https://api.github.com/users/Mister-M-alt/orgs","repos_url":"https://api.github.com/users/Mister-M-alt/repos","events_url":"https://api.github.com/users/Mister-M-alt/events{/privacy}","received_events_url":"https://api.github.com/users/Mister-M-alt/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-31T16:14:39Z","updated_at":"2026-10-31T16:14:39Z","body":"[A10] Owner, 17:14: confirmed. A save is bounded by **0.5 s worst case**, from the change to durable in flash, at 32x32. The append-only save path with background pre-erase above is the design direction.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/kebag-logic/milan-fpga/issues/comments/6545924397/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]