+                                           bool stopped, uint8_t code,
+                                           uint64_t bridge) {
+    auto body = StreamInfoPhase::gsi_body(0x0005, sink, true, 3 << 5);
+    putbe(&body[44], 2, 2);
+    body[34] = code;
+    putbe(&body[36], bridge, 8);
