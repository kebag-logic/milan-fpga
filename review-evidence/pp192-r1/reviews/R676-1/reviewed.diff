+  // controller. Each controller's sequence_id is modelled from the wire: the
+  // count of unsolicited frames it was sent before.
+  static constexpr uint64_t B_MAC = 0x0202C2C2C2C2ull;
+  uint16_t b_unsolicited = 0;
