+              "%u Failed clocks, grants at %d/%d)", phase, gap, failed, first7, first0);
+        printf("WINDOW phase=%u gap=%d held=%d source7=%d source0=%d from_accept0\n",
+               phase, gap, int(held), first7 - accepted0, first0 - accepted0);
+      }
+    }
+  }
