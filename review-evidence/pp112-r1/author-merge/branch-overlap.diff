+          auto ready = mrpdu_body(true, {Msg{3, 8, true,
+            {Vec{false, 1, fv_sid(sid), {EV_NEW}, {DECL_READY}}}}});
+          // Stop before the packed events, with the FirstValue received.
+          for (size_t i = 0; i < 15;) {
