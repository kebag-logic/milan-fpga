+# SPDX-License-Identifier: CERN-OHL-W-2.0
+# Default SRP shape, same part/mode/clock/reports as ucpu_ooc.tcl.
+set SPEC [file normalize [file dirname [info script]]/../..]
+read_verilog -sv $SPEC/hdl/common/pp_pkg.sv $SPEC/hdl/srp/srp_pkg.sv
+foreach src [lsort [glob $SPEC/hdl/srp/KL_*.sv]] { read_verilog -sv $src }
+synth_design -mode out_of_context -top KL_srp_top -part xc7a100tfgg484-2
+create_clock -period 10.000 -name clk [get_ports clk_i]
+report_utilization -hierarchical -file util_hier.rpt
+report_utilization -file util.rpt
+report_timing_summary -delay_type max -max_paths 3 -file timing.rpt
