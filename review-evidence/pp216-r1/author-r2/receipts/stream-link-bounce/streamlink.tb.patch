+  // disposable probe (report only): the stream declarations across a link bounce
+  void probe_streams_across_a_link_bounce() {
+    for (int refeed = 0; refeed < 2; refeed++) {
+      h.reset(); d->link_up_i = 1; h.run_ms(300);
+      const size_t f0 = h.archive.size();
+      h.op(OP_DECL_TK, 0, own_sid(0), 0x91e0f0010100ULL, 2, 29, 1);
+      h.op(OP_DECL_LS, 0, SIDX, DAX, 2, 0, 0, DECL_READY);
+      const auto tav = mrpdu_body(true, {Msg{1, 25, false, {Vec{false, 1,
+             fv_talker(SIDX, DAX, 2, 0x0100, 1, 3, 1, 0x00012345), {EV_JOININ}, {}}}}});
+      h.feed(tav, true);
+      h.run_ms(3000);
+      printf("STREAMLINK case %s\n", refeed ? "the peer declares its Talker Advertise again 100 ms after LINK_UP"
+                                            : "the peer sends nothing after the bounce");
+      printf("STREAMLINK before: talker %s\n", shown216(messages_of(true, 1, own_sid(0), f0), 12).c_str());
+      printf("STREAMLINK before: listener %s\n", shown216(messages_of(true, 3, SIDX, f0), 12).c_str());
+      printf("STREAMLINK before: tk_decl(0)=%d ls_decl(0)=%d tk_reg(0)=%d active(0)=%d\n",
+             h.tk_decl(0), h.ls_decl(0), h.tk_reg(0), h.active(0) ? 1 : 0);
+      const uint32_t down = d->now_ms_o;
+      const size_t fd = h.archive.size();
+      d->link_up_i = 0; h.run_ms(30);
+      const size_t fd_end = h.archive.size();
+      printf("STREAMLINK frames that left during the 30 ms link down: %zu\n", fd_end - fd);
+      printf("STREAMLINK during link down: tk_decl(0)=%d ls_decl(0)=%d tk_reg(0)=%d\n",
+             h.tk_decl(0), h.ls_decl(0), h.tk_reg(0));
+      d->link_up_i = 1;
+      const uint32_t up = d->now_ms_o;
+      const size_t f1 = h.archive.size();
+      if (refeed) { h.run_ms(100); h.feed(tav, true); }
+      h.run_ms(3000);
+      printf("STREAMLINK link down at %u ms, up at %u ms\n", down, up);
+      printf("STREAMLINK after LINK_UP: talker %s\n", shown216(messages_of(true, 1, own_sid(0), f1), 12).c_str());
+      printf("STREAMLINK after LINK_UP: listener %s\n", shown216(messages_of(true, 3, SIDX, f1), 12).c_str());
+      printf("STREAMLINK after LINK_UP: VID 2 %s\n", shown216(messages_of(false, 1, 2, f1), 12).c_str());
+      printf("STREAMLINK after LINK_UP: Domain %s\n", shown216(messages_of(true, 4, DOM_VALUE, f1), 12).c_str());
+      printf("STREAMLINK after: tk_decl(0)=%d ls_decl(0)=%d tk_reg(0)=%d active(0)=%d\n",
+             h.tk_decl(0), h.ls_decl(0), h.tk_reg(0), h.active(0) ? 1 : 0);
+    }
+    CHECK(true, "STREAMLINK probe ran");
+  }
