+uint64_t RebootBench::grade_egress(const std::string& tag) {
+    dut->reboot_req_i = 1;
+    uint64_t n = 0;
+    bool waited = true;
+    while (n < kEgressMs * kMsCycles) {
+        step();
+        ++n;
+        waited = waited && dut->phy_hold_o == 0 && dut->icap_csib_o == 1;
+    }
+    ck.that(label(tag, "no PHY hold for 10 ms after the request").c_str(), waited);
+    n += run_until([&] { return dut->phy_hold_o == 1; }, (kEgressMs + 4) * kMsCycles);
+    std::printf("  [i] %s request to PHY hold %llu clocks, bound (%llu, %llu]\n", tag.c_str(),
+                static_cast<unsigned long long>(n),
+                static_cast<unsigned long long>(kEgressMs * kMsCycles),
+                static_cast<unsigned long long>((kEgressMs + 1) * kMsCycles + 2));
+    ck.that(label(tag, "the PHY hold rises more than 10 ms after the request").c_str(),
+            dut->phy_hold_o == 1 && n > kEgressMs * kMsCycles);
+    ck.that(label(tag, "...and at most one tick and two clocks more").c_str(),
+            dut->phy_hold_o == 1 && n <= (kEgressMs + 1) * kMsCycles + 2);
+    return n;
+}
+
+void RebootBench::grade_bound(const std::string& tag, uint64_t to_burst, uint64_t ms,
+                              const char* what) {
+    const uint64_t to_iprog = to_burst + 6;
+    std::printf("  [i] %s request to the IPROG word %llu clocks, bound %llu\n", tag.c_str(),
+                static_cast<unsigned long long>(to_iprog),
+                static_cast<unsigned long long>(ms * kMsCycles + kBoundClocks));
+    ck.that(label(tag, what).c_str(), to_iprog <= ms * kMsCycles + kBoundClocks);
+}
