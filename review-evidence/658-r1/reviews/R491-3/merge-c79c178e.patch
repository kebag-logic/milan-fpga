+  localparam int unsigned MBX_TICK_MS_C = 32'd10;
+  //! channels
+  localparam int unsigned MBX_N_CH_C = 32'd5;
+  //! ring counter width
+  localparam int unsigned MBX_INDEX_BITS_C = 32'd16;
+  //! accept terms per channel
+  localparam int unsigned MBX_MAX_TERMS_C = 32'd2;
+  //! bytes a filter term reads
+  localparam int unsigned MBX_TERM_FIELD_BYTES_C = 32'd8;
+  //! wire byte of the EtherType
+  localparam int unsigned MBX_ETHERTYPE_BYTE_C = 32'd12;
+  //! wire byte of the AVTP subtype
+  localparam int unsigned MBX_SUBTYPE_BYTE_C = 32'd14;
+  //! wire byte whose low nibble is message_type
+  localparam int unsigned MBX_MSG_TYPE_BYTE_C = 32'd15;
+  //! never (an unused term)
+  localparam int unsigned MBX_TEST_NONE_C = 32'd0;
+  //! always
+  localparam int unsigned MBX_TEST_ANY_C = 32'd1;
+  //! the 8-byte big-endian field equals OWN_EID
+  localparam int unsigned MBX_TEST_EQ_OWN_C = 32'd2;
+  //! the 8-byte field is 0
+  localparam int unsigned MBX_TEST_EQ_ZERO_C = 32'd3;
+  //! the 6-byte start and 2-byte count overlap [MAAP_BASE, MAAP_BASE + MAAP_COUNT - 1]
+  localparam int unsigned MBX_TEST_RANGE_OVERLAP_C = 32'd4;
+  //! TMR_CMD.OP arm
+  localparam int unsigned MBX_TMR_OP_ARM_C = 32'd1;
+  //! TMR_CMD.OP cancel
+  localparam int unsigned MBX_TMR_OP_CANCEL_C = 32'd2;
+  //! Contract identity. Firmware checks MAGIC and MAJOR before it opens a channel.
+  localparam int unsigned MBX_REG_ID_C = 32'h00000000;
+  //! ID: contract minor version
+  localparam int unsigned MBX_ID_MINOR_LSB_C = 32'd0;
+  //! ID: contract minor version
+  localparam int unsigned MBX_ID_MINOR_WIDTH_C = 32'd8;
+  //! ID: contract major version
+  localparam int unsigned MBX_ID_MAJOR_LSB_C = 32'd8;
+  //! ID: contract major version
+  localparam int unsigned MBX_ID_MAJOR_WIDTH_C = 32'd8;
+  //! ID: 0x4D42
+  localparam int unsigned MBX_ID_MAGIC_LSB_C = 32'd16;
+  //! ID: 0x4D42
+  localparam int unsigned MBX_ID_MAGIC_WIDTH_C = 32'd16;
+  //! What this build elaborated.
+  localparam int unsigned MBX_REG_CAPS_C = 32'h00000004;
+  //! CAPS: channel count
+  localparam int unsigned MBX_CAPS_N_CH_LSB_C = 32'd0;
+  //! CAPS: channel count
+  localparam int unsigned MBX_CAPS_N_CH_WIDTH_C = 32'd4;
+  //! CAPS: interface count
+  localparam int unsigned MBX_CAPS_N_IF_LSB_C = 32'd4;
+  //! CAPS: interface count
+  localparam int unsigned MBX_CAPS_N_IF_WIDTH_C = 32'd4;
