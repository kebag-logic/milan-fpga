+      if (wr_w && off_w == AW2_C'(MBX_REG_OWN_EID_LO_C)) own_eid_lo_r <= host_wdata_i & (mbx_place_f(32'hFFFF_FFFF, MBX_OWN_EID_LO_EID_LSB_C, MBX_OWN_EID_LO_EID_WIDTH_C));
+      if (wr_w && off_w == AW2_C'(MBX_REG_OWN_EID_HI_C)) own_eid_hi_r <= host_wdata_i & (mbx_place_f(32'hFFFF_FFFF, MBX_OWN_EID_HI_EID_LSB_C, MBX_OWN_EID_HI_EID_WIDTH_C));
+      if (wr_w && off_w == AW2_C'(MBX_REG_FILTER_EN_C)) filter_en_r <= host_wdata_i & (mbx_place_f(32'hFFFF_FFFF, MBX_FILTER_EN_OPEN_LSB_C, MBX_FILTER_EN_OPEN_WIDTH_C));
+      if (wr_w && off_w == AW2_C'(MBX_REG_MAAP_BASE_LO_C)) maap_base_lo_r <= host_wdata_i & (mbx_place_f(32'hFFFF_FFFF, MBX_MAAP_BASE_LO_ADDR_LSB_C, MBX_MAAP_BASE_LO_ADDR_WIDTH_C));
+      if (wr_w && off_w == AW2_C'(MBX_REG_MAAP_BASE_HI_C)) maap_base_hi_r <= host_wdata_i & (mbx_place_f(32'hFFFF_FFFF, MBX_MAAP_BASE_HI_ADDR_LSB_C, MBX_MAAP_BASE_HI_ADDR_WIDTH_C));
+      if (wr_w && off_w == AW2_C'(MBX_REG_MAAP_COUNT_C)) maap_count_r <= host_wdata_i & (mbx_place_f(32'hFFFF_FFFF, MBX_MAAP_COUNT_COUNT_LSB_C, MBX_MAAP_COUNT_COUNT_WIDTH_C));
+      if (wr_w && off_w == AW2_C'(MBX_REG_TMR_DEADLINE_C)) tmr_deadline_r <= host_wdata_i & (mbx_place_f(32'hFFFF_FFFF, MBX_TMR_DEADLINE_MS_LSB_C, MBX_TMR_DEADLINE_MS_WIDTH_C));
