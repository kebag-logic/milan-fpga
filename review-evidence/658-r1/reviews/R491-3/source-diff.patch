+    if (off_w == AW2_C'(MBX_REG_MAAP_BASE_LO_C)) reg_rdata_w = maap_base_lo_r;
+    if (off_w == AW2_C'(MBX_REG_MAAP_BASE_HI_C)) reg_rdata_w = maap_base_hi_r;
