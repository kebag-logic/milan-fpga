+  logic [15:0] bus_err_r;                      //! BUS_ERR
+  logic [31:0] gm_hi_snap_r  [MBX_N_IF_C];     //! GM_HI, snapshot taken by a GM_LO read
+  logic [7:0]  domain_snap_r [MBX_N_IF_C];     //! DOMAIN, snapshot taken by a GM_LO read
+
+  assign tmr_cmd_p_w = wr_w && (off_w == AW2_C'(MBX_REG_TMR_CMD_C));
+
+  always_ff @(posedge clk_i) begin : host_write
+    if (!rst_n) begin
+      irq_enable_r <= '0;
+      tick_ctl_r <= '0;
+      own_eid_lo_r <= '0;
+      own_eid_hi_r <= '0;
+      filter_en_r <= '0;
+      maap_base_lo_r <= '0;
+      maap_base_hi_r <= '0;
+      maap_count_r <= '0;
+      tmr_deadline_r <= '0;
+      evt_tail_r <= '0;
+      err_r     <= 1'b0;
+      bus_err_r <= '0;
