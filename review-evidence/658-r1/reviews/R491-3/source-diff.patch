+#define MBX_REG_MAAP_COUNT 0x34u
+/* MAAP_COUNT: address count */
+#define MBX_MAAP_COUNT_COUNT_LSB 0u
+/* MAAP_COUNT: address count */
+#define MBX_MAAP_COUNT_COUNT_WIDTH 16u
