+  logic [31:0] irq_enable_r;   //! IRQ_ENABLE
+  logic [31:0] tick_ctl_r;   //! TICK_CTL
+  logic [31:0] own_eid_lo_r;   //! OWN_EID_LO
+  logic [31:0] own_eid_hi_r;   //! OWN_EID_HI
+  logic [31:0] filter_en_r;   //! FILTER_EN
+  logic [31:0] maap_base_lo_r;   //! MAAP_BASE_LO
+  logic [31:0] maap_base_hi_r;   //! MAAP_BASE_HI
+  logic [31:0] maap_count_r;   //! MAAP_COUNT
+  logic [31:0] tmr_deadline_r;   //! TMR_DEADLINE
+  logic        tmr_cmd_p_w;   //! TMR_CMD written this cycle
+  logic [31:0] evt_tail_r;   //! EVT_TAIL
+  logic [15:0] rx_tail_r [MBX_N_CH_C];   //! RX_TAIL per channel
+  logic [15:0] tx_head_r [MBX_N_CH_C];   //! TX_HEAD per channel
