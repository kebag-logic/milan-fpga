+    //! from @50 as {stream_index, stream_channel, cluster_offset,
+    //! cluster_channel}
+    struct AmapPage {
+        long status = -1;
+        long cdl = -1;
+        long nmaps = -1;
+        long nmappings = -1;
+        std::vector<std::array<uint16_t, 4> > rec;
