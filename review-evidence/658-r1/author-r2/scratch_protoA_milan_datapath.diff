+  localparam logic [N_STREAMS*8*16-1:0] AMAP_OUT_INIT_OWNER_C =
+      amap_out_identity_owner();
+  localparam logic [N_STREAMS*8*16-1:0] AMAP_OUT_INIT_CLUSTER_C =
+      amap_out_identity_cluster();
