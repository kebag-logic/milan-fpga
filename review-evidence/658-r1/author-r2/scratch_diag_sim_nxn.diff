+    //! SCRATCH (#658 stage 1, item 3): which command sequence yields the
+    //! bench readback {SPI 0: one mapping s0.c0->o0.c0, SPO 0: none}
+    long amap_edit(uint16_t cmd, uint16_t ty,
+                   const std::vector<std::array<uint16_t, 4> >& recs) {
+        std::vector<uint8_t> pl(8 + 8 * recs.size(), 0);
+        pl[0] = static_cast<uint8_t>(ty >> 8); pl[1] = static_cast<uint8_t>(ty);
+        pl[4] = static_cast<uint8_t>(recs.size() >> 8);
+        pl[5] = static_cast<uint8_t>(recs.size());
+        for (size_t i = 0; i < recs.size(); i++)
+            for (size_t f = 0; f < 4; f++) {
+                pl[8 + 8*i + 2*f] = static_cast<uint8_t>(recs[i][f] >> 8);
+                pl[9 + 8*i + 2*f] = static_cast<uint8_t>(recs[i][f]);
+            }
+        return aecp_status(aecp_xact(cmd, dynmap_sq++, pl));
+    }
+    void diag_show(const char* tag) {
+        uint64_t f = 0;
+        const long ch = current_channels(0x0005, 0, &f);
+        for (uint16_t ty : {static_cast<uint16_t>(0x000E), static_cast<uint16_t>(0x000F)}) {
+            const AmapPage p = get_audio_map_page0(ty, 0);
+            printf("  [diag] %-34s %s 0 (in fmt %016llx, %ld ch): status %ld, maps %ld, %ld mapping(s)",
+                   tag, ty == 0x000E ? "SPI" : "SPO",
+                   static_cast<unsigned long long>(f), ch, p.status, p.nmaps, p.nmappings);
+            for (const std::array<uint16_t, 4>& m : p.rec)
+                printf(" s%u.c%u->o%u.c%u", static_cast<unsigned>(m[0]), static_cast<unsigned>(m[1]),
+                       static_cast<unsigned>(m[2]), static_cast<unsigned>(m[3]));
+            printf("\n");
+        }
+    }
