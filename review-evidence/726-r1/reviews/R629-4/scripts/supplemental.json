  },
  {
    "name": "sdk-offline-selftest",
    "cmd": [
      "python3",
      "scripts/ci_rv32_sdk_selftest.py"
    ]
  },
  {
    "name": "no-git-docs",
    "cmd": [
      "python3",
      "{packet}/scripts/check_no_git.py",
      "{root}",
      "{packet}"
    ]
  }
