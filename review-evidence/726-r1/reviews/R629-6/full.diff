diff --git a/tb/verilator/milan_dp/stream_counter_f5.cpp b/tb/verilator/milan_dp/stream_counter_f5.cpp
new file mode 100644
index 000000000..845af671e
--- /dev/null
+++ b/tb/verilator/milan_dp/stream_counter_f5.cpp
@@ -0,0 +1,97 @@
+// SPDX-FileCopyrightText: 2026 Kebag Logic
+// SPDX-License-Identifier: CERN-OHL-W-2.0
+// Reuse the firmware's real mailbox fixture and generated descriptor image.
+// Appended to test_aecp.cpp by stream_counter_f5.py.
+#include <map>
+#include <tuple>
+
+namespace {
+struct F5CounterGaps {
+    size_t count=0;
+    uint32_t min_ms=5000;
+    uint32_t max_ms=0;
+    uint32_t tail_ms=0;
+    bool refresh=false;
+    bool spacing=true;
+};
+
+F5CounterGaps f5_counter_gaps(const std::vector<uint32_t>& times,uint32_t start_ms)
+{
+    F5CounterGaps result;
+    uint32_t last=0;
+    for(const uint32_t at:times) {
+        if(at<start_ms || at>=5000) continue;
+        if(result.count) {
+            result.min_ms=std::min(result.min_ms,at-last);
+            result.max_ms=std::max(result.max_ms,at-last);
+        }
+        ++result.count;
+        last=at;
+    }
+    result.tail_ms=5000-(result.count ? last : start_ms);
+    result.spacing=result.min_ms>=1000;
+    result.refresh=result.count>=2 && result.max_ms<=1003 && result.tail_ms<=1003;
+    return result;
+}
+
+void f5_check_counter_gaps(const std::vector<uint32_t>& times,unsigned type,unsigned index,unsigned recipient)
+{
+    const char* omitted=std::getenv("COUNTERS_OMIT_CHECK");
+    const auto gaps=f5_counter_gaps(times,0);
+    if(!omitted || std::strcmp(omitted,"RATE")!=0) {
+        EXPECT_TRUE(gaps.spacing)<<"[F5 RATE] Milan 5.4.5.2 Table 5.22 spacing";
+    }
+    if(!omitted || std::strcmp(omitted,"CADENCE")!=0) {
+        EXPECT_TRUE(gaps.refresh)<<"[F5 CADENCE] every gap and final wait <= 1000 ms plus 2 ms stall and one service pass";
+    }
+    bool stable=true;
+    for(uint32_t start_ms=0;start_ms<=1000;++start_ms) {
+        const auto shifted=f5_counter_gaps(times,start_ms);
+        stable &= shifted.refresh==gaps.refresh && shifted.spacing==gaps.spacing;
+    }
+    if(!omitted || std::strcmp(omitted,"PHASE")!=0) {
+        EXPECT_TRUE(stable)<<"[F5 PHASE] measurement starts through one second preserve verdict";
+    }
+    printf("F5_GAPS,%u,%u,%u,%zu,%u,%u,%u\n",type,index,recipient,gaps.count,gaps.min_ms,gaps.max_ms,gaps.tail_ms);
+    unsigned bins[5]{};
+    for(const auto at:times) {
+        ASSERT_LT(at,5000u);
+        ++bins[at/1000];
+        printf("F5_NOTE,%u,%u,%u,%u\n",type,index,recipient,at);
+    }
+    // Fixed bins describe the capture; they never decide its verdict.
+    for(unsigned window=0;window<5;++window)
+        printf("F5,%u,%u,%u,%u,%u,%u,%u\n",type,index,recipient,window,bins[window],gaps.min_ms,gaps.max_ms);
+}
+} // namespace
+
+TEST_F(Mailbox, StreamCounterGaps)
+{
+    receive(36,{},CTLR);receive(36,{},CTLR+1);
+    std::vector<std::pair<unsigned,unsigned>> streams;
+    for(auto&d:descriptors)if(d.type==5 || d.type==6)streams.emplace_back(d.type,d.index);
+    ASSERT_FALSE(streams.empty());
+    using Key=std::tuple<unsigned,unsigned,uint64_t>;
+    std::map<Key,std::vector<uint32_t>> departures;
+    uint32_t seen=fabric.tx_sent;
+    const uint32_t origin=fabric.now_ms;
+    ON_CALL(mock,Counters).WillByDefault([&](unsigned,uint16_t,uint16_t,aecp_counters*v){
+        v->valid=0xf3f;for(unsigned n=0;n<32;++n)v->value[n]=fabric.now_ms;return true;
+    });
+    for(unsigned t=0;t<5000;++t){
+        if(t%10==0)for(auto [type,index]:streams)aecp_changed(&adapter.core,type,index,8);
+        if(t==2000)mbx_model_tx_pause(&fabric,true);
+        if(t==2002)mbx_model_tx_pause(&fabric,false);
+        service(100);
+        while(seen<fabric.tx_sent){
+            auto*f=mbx_model_tx_frame(&fabric,seen++);ASSERT_NE(f,nullptr);
+            if(get(f->bytes+36,2)!=0x8029)continue;
+            Key key{get(f->bytes+38,2),get(f->bytes+40,2),get(f->bytes+26,8)};
+            departures[key].push_back(f->now_ms-origin);
+        }
+        mbx_model_advance_ms(&fabric,1);
+    }
+    for(auto [type,index]:streams)for(uint64_t recipient:{CTLR,CTLR+1}){
+        f5_check_counter_gaps(departures[{type,index,recipient}],type,index,unsigned(recipient-CTLR));
+    }
+}
diff --git a/tb/verilator/milan_dp/stream_counter_f5.py b/tb/verilator/milan_dp/stream_counter_f5.py
new file mode 100644
index 000000000..7d93e5aa6
--- /dev/null
+++ b/tb/verilator/milan_dp/stream_counter_f5.py
@@ -0,0 +1,87 @@
+#!/usr/bin/env python3
+# SPDX-FileCopyrightText: 2026 Kebag Logic
+# SPDX-License-Identifier: CERN-OHL-W-2.0
+"""Apply #726's notification gaps to the unchanged firmware mailbox path."""
+
+import argparse
+import os
+import shutil
+import tempfile
+from pathlib import Path
+import sys
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+sys.path.insert(0, str(ROOT / "sw/firmware/ctrl/test"))
+import aecp_arms  # noqa: E402
+from ctrl_build import CTRL, Tree  # noqa: E402
+import fw_gtest  # noqa: E402
+
+
+def mailbox_fixture(variant: str) -> str:
+    """Stage the gap fixture, optionally restoring phase-sensitive bin grading."""
+    fixture = (HERE / "stream_counter_f5.cpp").read_text()
+    if variant == "fixed-grid":
+        anchor = "result.refresh=result.count>=2 && result.max_ms<=1003 && result.tail_ms<=1003;"
+        if fixture.count(anchor) != 1:
+            raise RuntimeError("mailbox grid plant anchor moved")
+        fixture = fixture.replace(anchor, """
+    unsigned bins[5]{};
+    for(const auto at:times) {
+        if(at>=start_ms && at-start_ms<5000) ++bins[(at-start_ms)/1000];
+    }
+    result.refresh=std::all_of(std::begin(bins),std::end(bins),[](unsigned n){return n>=1;});""")
+    return (ROOT / "sw/firmware/ctrl/test/test_aecp.cpp").read_text() + "\n" + fixture
+
+
+def main() -> int:
+    """Run mailbox gaps and, for a plant, require detection then omission escape."""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--work", type=Path)
+    parser.add_argument("--variant", choices=("clean", "late", "rate", "fixed-grid"), default="clean")
+    parser.add_argument("--shape", type=int, choices=(1, 8), default=1)
+    args = parser.parse_args()
+    temporary = tempfile.TemporaryDirectory(prefix="stream-counter-f5-") if args.work is None else None
+    work = args.work.resolve() if args.work else Path(temporary.name)
+    work.mkdir(parents=True, exist_ok=True)
+    # core_arm's test source seam selects this fixture extension; all firmware
+    # inputs still come from CTRL and the existing arm builds the mailbox.
+    (work / "test_aecp.cpp").write_text(mailbox_fixture(args.variant))
+    aecp_arms.HERE = work
+    source = CTRL
+    if args.variant in ("late", "rate"):
+        source = work / "firmware"
+        shutil.copytree(CTRL, source, dirs_exist_ok=True,
+                        ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))
+        path = source / "aecp/aecp.c"
+        text = path.read_text()
+        anchor = "e->counter_at = departure_ms + 1000u;"
+        if text.count(anchor) != 1:
+            raise RuntimeError("counter deadline plant anchor moved")
+        delay = 2000 if args.variant == "late" else 500
+        path.write_text(text.replace(anchor, f"e->counter_at = departure_ms + {delay}u;"))
+    tree = Tree(source, work / "build", work / "reuse", fw_gtest.Build(jobs=2))
+    shape = "endstation_ax7101_1x1_tdm8" if args.shape == 1 else "endstation_ax7101_8x8"
+    group = {"late": "CADENCE", "rate": "RATE", "fixed-grid": "PHASE"}.get(args.variant)
+    for omitted in (None, group) if group else (None,):
+        os.environ.pop("COUNTERS_OMIT_CHECK", None)
+        if omitted:
+            os.environ["COUNTERS_OMIT_CHECK"] = omitted
+        result = aecp_arms.core_arm(tree, ROOT / "configs" / (shape + ".yaml"),
+                                    mode="mailbox", selected="Mailbox.StreamCounterGaps")
+        name = "escape.log" if omitted else "run.log"
+        (work / name).write_text(result.log)
+        if group and not omitted:
+            failures = [line for line in result.log.splitlines() if "[FAIL] Mailbox." in line]
+            if result.rc != 1 or not failures or any(f"[F5 {group}]" not in f for f in failures):
+                raise RuntimeError(f"unattributable {args.variant}: {result.log}")
+        elif result.rc:
+            raise RuntimeError(result.log)
+        print(f"F5 {args.shape}x{args.shape} {args.variant} {name}: rc={result.rc}")
+    if temporary:
+        temporary.cleanup()
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tb/verilator/milan_dp/stream_counters.hpp b/tb/verilator/milan_dp/stream_counters.hpp
new file mode 100644
index 000000000..53be275eb
--- /dev/null
+++ b/tb/verilator/milan_dp/stream_counters.hpp
@@ -0,0 +1,324 @@
+// SPDX-FileCopyrightText: 2026 Kebag Logic
+// SPDX-License-Identifier: CERN-OHL-W-2.0
+// Included inside NxnDatapathHarness. #726: MAC packet census, counter resets,
+// 32-bit wrap, and per-descriptor/recipient notification gaps. The descriptor
+// image, parser, counters, arbiter, processor and response-memory path are real.
+// Protocol time uses 1000 cycles/ms; the clock parameter remains 50 MHz.
+// Grade every consecutive gap from the first captured notification onward.
+// Issue #726 ruling 6134121887 fixes refresh at 1000 ms + 25 ms service.
+// Measured dirty-and-eligible to final-recipient service is descriptive only.
+    void counter_feed(int s,uint8_t seq) {
+        const uint64_t ts=phc_now_ns()+2000000;
+        std::vector<uint8_t> f(s<kNstreamsTb ? 86 : 64,0);
+        gsi_put(f,0,0x91E0F0002A02ull,6);
+        gsi_put(f,6,0x021122334455ull,6);
+        gsi_put(f,12,0x22F0,2);
+        f[16]=seq;
+        gsi_put(f,18,0x0211223300000100ull+s,8);
+        if(s<kNstreamsTb) {
+            f[14]=2;f[15]=0x81;
+            gsi_put(f,26,ts & 0xffffffffu,4);
+            f[30]=2;f[31]=0x50;f[32]=2;f[33]=32;
+            gsi_put(f,34,48,2);
+        } else {
+            f[14]=4;f[15]=0x80;f[17]=1;
+            gsi_put(f,26,48000,4);gsi_put(f,30,8,2);
+            gsi_put(f,32,96,2);gsi_put(f,34,ts,8);
+        }
+        gsi_rx_q.push_back(f);
+    }
+
+    static constexpr int ncounter = 2 * (kNstreamsTb + 1) + 2;
+    struct CounterProbeState {
+        std::array<uint32_t,kNstreamsTb+1> wire_tx{};
+        std::array<uint32_t,kNstreamsTb+1> wire_tu{};
+        std::array<uint32_t,kNstreamsTb+1> wire_mr{};
+        const char* omitted_check = std::getenv("COUNTERS_OMIT_CHECK");
+        std::array<long,ncounter> service_begin{};
+        std::array<long,ncounter> service_max{};
+        long measurement_end_cyc=0;
+        bool counter_watch_on=false;
+    } counter_state;
+    void counter_check(const char* group,const char* what,unsigned long got,unsigned long expected) {
+        if(counter_state.omitted_check && std::strcmp(counter_state.omitted_check,group)==0) return;
+        std::string name=std::string("[726 ")+group+"] "+what;
+        ck(name.c_str(),got,expected);
+    }
+    void counter_departed(const std::vector<uint8_t>& f) {
+        const int o=gsi_be(f,12,2)==0x8100 ? 4 : 0;
+        if(f.size()>size_t(26+o) && gsi_be(f,12+o,2)==0x22f0 && (f[14+o]==2 || f[14+o]==4)) {
+            const unsigned ix=f[14+o]==4 ? kNstreamsTb : gsi_be(f,24+o,2);
+            if(ix<=kNstreamsTb) {
+                ++counter_state.wire_tx[ix];
+                counter_state.wire_tu[ix] += f[(f[14+o]==4 ? 15 : 17)+o] & 1;
+                counter_state.wire_mr[ix] += (f[15+o] >> 3) & 1;
+            }
+        }
+        if(!counter_state.counter_watch_on || f.size()<46 || !aecp_is_unsolicited(f) || notify_cmd(f)!=0x29) return;
+        const auto ty=gsi_be(f,38,2);
+        const auto s=gsi_be(f,40,2);
+        const int ix=ty==5 ? s : ty==6 ? kNstreamsTb+1+s : ty==9 ? ncounter-2 : ncounter-1;
+        if(ix>=ncounter || counter_state.service_begin[ix]<0)return;
+        counter_state.service_max[ix]=std::max(counter_state.service_max[ix],uns_log_cycle-counter_state.service_begin[ix]);
+        if(memcmp(f.data()+26,CTL_B.eid,8)==0)counter_state.service_begin[ix]=-1;
+    }
+    void counter_watch() {
+        if(!counter_state.counter_watch_on) return;
+        const auto* r=dut->rootp;
+        const auto now=r->milan_datapath__DOT__pp_shadow__DOT__u_pp__DOT__u_timer__DOT__now_ms_r;
+        const auto dirty=r->milan_datapath__DOT__pp_shadow__DOT__u_pp__DOT__u_notify__DOT__ctr_dirty_r;
+        const auto sent=r->milan_datapath__DOT__pp_shadow__DOT__u_pp__DOT__u_notify__DOT__ctr_sent_r;
+        for(int i=0;i<ncounter;++i) {
+            const auto stamp=r->milan_datapath__DOT__pp_shadow__DOT__u_pp__DOT__u_notify__DOT__ctr_last_r[i];
+            if(counter_state.service_begin[i]<0 && (dirty>>i&1) && (!(sent>>i&1) || uint32_t(now-stamp)>=1000))
+                counter_state.service_begin[i]=uns_log_cycle;
+        }
+    }
+
+    int stream_counter_probe() {
+        const milan::tb::Model<Vmilan_datapath> model;
+        dut = model.get();
+        bring_the_datapath_out_of_reset();
+        prove_the_identity_and_provision_the_entity_id();
+        std::string why;
+        if (!aemi_load(AEMI_CFG_C, &why)) {
+            printf("image failure: %s\n", why.c_str()); return 2;
+        }
+        counter_setup();
+        counter_measure();
+        counter_state.measurement_end_cyc=uns_log_cycle;
+        counter_state.counter_watch_on=false;
+        axi_write(A_AAF_CTRL,0x00020002);axi_write(A_CRFT_CTRL,0);
+        for(int t=0;t<5000;++t)gsi_tick();
+        for(int s=0;s<=kNstreamsTb;++s) {
+            const auto got=dut->rootp->milan_datapath__DOT__talker_diag__DOT__ftx_r[s];
+            printf("TX_COUNT,%d,%u,%u\n",s,got,counter_state.wire_tx[s]);
+            counter_check("TX","per-AVTPDU total equals wire",got,counter_state.wire_tx[s]);
+            counter_check("TX","every output emitted",counter_state.wire_tx[s]>10,1);
+        }
+        counter_notifications();
+        const auto batch_base=counter_receive_resets();
+        for(int i=0;i<ncounter;++i)printf("SERVICE,%d,%ld\n",i,counter_state.service_max[i]);
+        counter_restart_wrap();
+        counter_batch_boundary(batch_base);
+        return report();
+    }
+
+    void counter_setup() {
+        dm_answering = true;
+        start_the_boot_restore_walk();
+        axi_write(0x644, 1); // receive-filter bypass
+        axi_write(0x680, 0); // no reservation traffic in this cadence fixture
+        for (int s = 0; s < kNstreamsTb; ++s) {
+            axi_write(A_STRM_SEL, s);
+            axi_write(A_SW_SID_LO, 0x100u + s);
+            axi_write(A_SW_SID_HI, 0x02112233);
+            axi_write(A_SW_FMT_LO, FMT_LO);
+            axi_write(A_SW_FMT_HI, FMT_HI);
+            axi_write(A_SW_CTRL, 1);
+        }
+        axi_write(A_CRF_SIDLO_L, 0x100u + kNstreamsTb);
+        axi_write(A_CRF_SIDHI_L, 0x02112233);
+        axi_write(A_CRF_CTRL_L, 1);
+        for (const Ctlr* ctl : {&CTL_A, &CTL_B}) {
+            const auto r = aecp_xact_from(*ctl, 0x24, 0x5000, {0,0,0,0});
+            ck("[726] registered recipient", aecp_status(r), 0);
+        }
+    }
+
+    void counter_measure() {
+        constexpr long counter_second = 1000L * kMsCycTb;
+        axi_write(A_AAF_CTRL, 0x00020003);
+        axi_write(A_CRFT_CTRL, 1);
+        uns_log.clear(); uns_log_when.clear(); uns_log_cycle=0;
+        counter_state.service_begin.fill(-1); counter_state.counter_watch_on=true;
+        std::array<uint8_t, kNstreamsTb+1> seq{};
+        for (long t=0; t<5*counter_second; ++t) {
+            if (t % (10*kMsCycTb)==0) {
+                for (int s=0;s<=kNstreamsTb;++s) {
+                    counter_feed(s,seq[s]++);
+                }
+            }
+            gsi_tick();
+        }
+        // No start/stop, MR or TU update may explain the steady output pushes.
+        for(int s=0;s<=kNstreamsTb;++s) {
+            const auto* diag=dut->rootp;
+            const auto tu=diag->milan_datapath__DOT__talker_diag__DOT__tuiv_r[s];
+            const auto mr=diag->milan_datapath__DOT__talker_diag__DOT__mreset_r[s];
+            const auto starts=diag->milan_datapath__DOT__talker_diag__DOT__start_r[s];
+            const auto stops=diag->milan_datapath__DOT__talker_diag__DOT__stop_r[s];
+            printf("OUTPUT_CONDITION,%d,%s,%u,%u,%u,%u,%u,%u\n",s,
+                   COUNTERS_FRAMES_ONLY_TB ? "frames-only" : "uncertain",
+                   tu,mr,starts,stops,counter_state.wire_tu[s],counter_state.wire_mr[s]);
+            if(COUNTERS_FRAMES_ONLY_TB) {
+                counter_check("OUTPUT_CONDITION","TU counter stays zero",tu,0);
+                counter_check("OUTPUT_CONDITION","MR counter stays zero",mr,0);
+                counter_check("OUTPUT_CONDITION","only initial start",starts,1);
+                counter_check("OUTPUT_CONDITION","no stop during measurement",stops,0);
+                counter_check("OUTPUT_CONDITION","all wire tu bits clear",counter_state.wire_tu[s],0);
+                counter_check("OUTPUT_CONDITION","wire mr remains at reset",counter_state.wire_mr[s],0);
+            }
+        }
+    }
+
+    struct CounterGaps {
+        unsigned count=0;
+        long min_cyc=10000L*kMsCycTb;
+        long max_cyc=0;
+        long tail_cyc=0;
+        bool refresh=false;
+        bool spacing=true;
+    };
+
+    CounterGaps counter_gaps(const std::vector<long>& times,long start_cyc) const {
+        constexpr long second_cyc=1000L*kMsCycTb;
+        constexpr long refresh_limit_cyc=1025L*kMsCycTb;
+        CounterGaps result;
+        long last=-1;
+        for(const long at:times) {
+            if(at<start_cyc || at>=counter_state.measurement_end_cyc) continue;
+            if(last>=0) {
+                result.min_cyc=std::min(result.min_cyc,at-last);
+                result.max_cyc=std::max(result.max_cyc,at-last);
+            }
+            ++result.count;
+            last=at;
+        }
+        result.tail_cyc=counter_state.measurement_end_cyc-(last>=0 ? last : start_cyc);
+        result.spacing=result.min_cyc>=second_cyc;
+        // Two observations prevent silence from satisfying a gap check vacuously.
+        // The tail catches a final missing notification after the last full gap.
+        result.refresh=result.count>=2 && result.max_cyc<=refresh_limit_cyc
+            && result.tail_cyc<=refresh_limit_cyc;
+        return result;
+    }
+
+    void counter_phase_check(const std::vector<long>& times,int ty,int s,int r) {
+        constexpr long second_cyc=1000L*kMsCycTb;
+        const auto reference=counter_gaps(times,0);
+        bool stable=true;
+        // Exhaust every discrete start through one second, including event edges.
+        for(long start_cyc=0;start_cyc<=second_cyc;++start_cyc) {
+            const auto shifted=counter_gaps(times,start_cyc);
+            stable &= shifted.refresh==reference.refresh && shifted.spacing==reference.spacing;
+            if(start_cyc==0 || start_cyc==kMsCycTb/5 || start_cyc==3*kMsCycTb/10 ||
+               start_cyc==4*kMsCycTb/5 || start_cyc==9*kMsCycTb/10 || start_cyc==second_cyc)
+                printf("PHASE,%d,%d,%d,%ld,%d,%d\n",ty,s,r,start_cyc,shifted.refresh,shifted.spacing);
+        }
+        counter_check("PHASE","all measurement starts through one second preserve verdict",stable,1);
+    }
+
+    std::vector<long> counter_notification_times(int ty,int s,int r) {
+        std::vector<long> times;
+        for(size_t j=0;j<uns_log.size();++j) {
+            const auto& f=uns_log[j];
+            const auto& ctl=r ? CTL_B : CTL_A;
+            if(uns_log_when[j]>=counter_state.measurement_end_cyc || f.size()<46 ||
+               !aecp_is_unsolicited(f) || notify_cmd(f)!=0x29 ||
+               gsi_be(f,38,2)!=unsigned(ty) || gsi_be(f,40,2)!=unsigned(s) ||
+               memcmp(f.data()+26,ctl.eid,8)!=0) continue;
+            times.push_back(uns_log_when[j]);
+            printf("NOTE,%d,%d,%d,%ld\n",ty,s,r,uns_log_when[j]);
+        }
+        return times;
+    }
+
+    void counter_notifications() {
+        constexpr long second_cyc=1000L*kMsCycTb;
+        long start_cyc=0;
+        if(const char* shift=std::getenv("COUNTERS_WINDOW_SHIFT")) {
+            char* end=nullptr;
+            start_cyc=std::strtol(shift,&end,10);
+            ck("[726] measurement start is within one second",
+               end!=shift && *end=='\0' && start_cyc>=0 && start_cyc<=second_cyc,1);
+            if(end==shift || *end!='\0' || start_cyc<0 || start_cyc>second_cyc) return;
+        }
+        printf("shape,type,index,recipient,window,notifications,min_gap_ms,max_gap_ms\n");
+        for(int ty:{5,6}) for(int s=0;s<=kNstreamsTb;++s) for(int r=0;r<2;++r) {
+            const auto times=counter_notification_times(ty,s,r);
+            const int slot=(ty==5 ? 0 : kNstreamsTb+1)+s;
+            const long service_cyc=counter_state.service_max[slot];
+            const auto gaps=counter_gaps(times,start_cyc);
+            const char* cadence=ty==6 && COUNTERS_FRAMES_ONLY_TB ? "OUTPUT_CADENCE" : "CADENCE";
+            counter_check("RATE","minimum consecutive spacing from first notification",gaps.spacing,1);
+            counter_check(cadence,"consecutive gaps and final wait at most 1025 ms",gaps.refresh,1);
+            counter_phase_check(times,ty,s,r);
+            printf("GAPS,%d,%d,%d,%d,%ld,%u,%.5f,%.5f,%.5f,%.5f\n",kNstreamsTb,ty,s,r,
+                   start_cyc,gaps.count,gaps.min_cyc/double(kMsCycTb),gaps.max_cyc/double(kMsCycTb),
+                   gaps.tail_cyc/double(kMsCycTb),service_cyc/double(kMsCycTb));
+            // Fixed bins are retained as descriptive measurements, never graded.
+            std::array<int,5> bins{};
+            for(const long at:times) ++bins[at/second_cyc];
+            for(int b=0;b<5;++b) printf("%d,%d,%d,%d,%d,%d,%.5f,%.5f\n",kNstreamsTb,ty,s,r,b,
+                bins[b],gaps.min_cyc/double(kMsCycTb),gaps.max_cyc/double(kMsCycTb));
+        }
+    }
+
+    std::array<uint32_t,kNstreamsTb> counter_receive_resets() {
+        gsi_ms(1010); // commit the final receive batch before its snapshot
+        std::array<uint32_t,kNstreamsTb> batch_base{};
+        for(int s=0;s<=kNstreamsTb;++s) {
+            auto read_rx=[&]() {
+                auto r=gsi_xact(CTL_A,0x29,{0,5,0,static_cast<uint8_t>(s)});
+                counter_check("RX","GET_COUNTERS success",aecp_status(r),0);
+                return ctr_word(r,11);
+            };
+            const auto received=read_rx();
+            counter_check("RX","every received PDU counted",received,500);
+            if(s<kNstreamsTb) {axi_write(A_STRM_SEL,s);axi_write(A_SW_CTRL,0);}
+            else axi_write(A_CRF_CTRL_L,0);
+            gsi_ms(1);
+            counter_check("RX_RESET","unbind preserves total",read_rx(),received);
+            if(s<kNstreamsTb) {
+                axi_write(A_SW_SID_LO,0x100u+s);axi_write(A_SW_SID_HI,0x02112233);
+                axi_write(A_SW_CTRL,1);
+            } else axi_write(A_CRF_CTRL_L,1);
+            gsi_ms(1);
+            const auto rebound=read_rx();
+            counter_check("RX_RESET","bind starts at zero",rebound,0);
+            if(s<kNstreamsTb)batch_base[s]=rebound;
+        }
+        return batch_base;
+    }
+
+    void counter_restart_wrap() {
+        // Quiesce each run before comparing MAC completions with its counter.
+        for(int phase=0;phase<2;++phase) {
+            counter_state.wire_tx.fill(0);
+            axi_write(A_AAF_CTRL,0x00020003);axi_write(A_CRFT_CTRL,1);
+            for(int t=0;t<100;++t)gsi_tick();
+            std::array<uint32_t,kNstreamsTb+1> seeds{};
+            for(int s=0;s<=kNstreamsTb;++s) {
+                const auto start=dut->rootp->milan_datapath__DOT__talker_diag__DOT__ftx_r[s];
+                counter_check("TX_RESET","talker start resets before first PDU",start,0);
+                seeds[s]=phase ? UINT32_MAX-5u : start;
+            }
+            const uint32_t seed=UINT32_MAX-5u;
+            if(phase) for(int s=0;s<=kNstreamsTb;++s)
+                dut->rootp->milan_datapath__DOT__talker_diag__DOT__ftx_r[s]=seed;
+            for(int t=0;t<400000;++t)gsi_tick();
+            axi_write(A_AAF_CTRL,0x00020002);axi_write(A_CRFT_CTRL,0);
+            for(int t=0;t<5000;++t)gsi_tick();
+            for(int s=0;s<=kNstreamsTb;++s) {
+                const auto got=dut->rootp->milan_datapath__DOT__talker_diag__DOT__ftx_r[s];
+                printf("TX_RUN,%d,%d,%u,%u,%u\n",phase,s,seeds[s],got,counter_state.wire_tx[s]);
+                counter_check("TX","restart and wrap follow wire",uint32_t(got-seeds[s]),counter_state.wire_tx[s]);
+                counter_check("TX","restart/wrap emitted enough",counter_state.wire_tx[s]>6,1);
+            }
+        }
+    }
+
+    void counter_batch_boundary(const std::array<uint32_t,kNstreamsTb>& batch_base) {
+        // Boundary seed represents already accepted packets in this interval.
+        // Three real MAC packets must cross the former 16-bit saturation point.
+        for(int s=0;s<kNstreamsTb;++s) {
+            dut->rootp->milan_datapath__DOT__avtp_rx_monitor__DOT__frx_acc_r[s]=65534;
+            for(int k=0;k<3;++k)counter_feed(s,k);
+        }
+        gsi_ms(1100);
+        for(int s=0;s<kNstreamsTb;++s) {
+            auto r=gsi_xact(CTL_A,0x29,{0,5,0,static_cast<uint8_t>(s)});
+            counter_check("RX","batch crosses 65535 without loss",uint32_t(ctr_word(r,11)-batch_base[s]),65537);
+        }
+    }
diff --git a/tb/verilator/milan_dp/stream_counters.py b/tb/verilator/milan_dp/stream_counters.py
new file mode 100644
index 000000000..33e5fed36
--- /dev/null
+++ b/tb/verilator/milan_dp/stream_counters.py
@@ -0,0 +1,256 @@
+#!/usr/bin/env python3
+# SPDX-FileCopyrightText: 2026 Kebag Logic
+# SPDX-License-Identifier: CERN-OHL-W-2.0
+"""Run #726 packet, reset and notification checks through the parent MAC.
+
+Build inputs come from this suite's source and flag exports. All generated
+files, planted RTL copies and logs stay below --work. A mutant must fail its
+named check group and then pass with exactly that group omitted. Neither a
+build failure nor a crash counts as detection. No submodule file is edited.
+"""
+
+import argparse
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import sys
+import tempfile
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+TX = "hdl/ieee1722/avtp/KL_talker_diag_ctx.sv"
+RX = "hdl/ieee1722/crf/KL_crf_rx.sv"
+AAF = "hdl/ieee1722/avtp/KL_avtp_rx_monitor_ctx.sv"
+DP = "hdl/milan/milan_datapath.sv"
+GROUPS = {"tx-interval": "TX", "rx-interval": "RX", "tx-reset": "TX_RESET",
+          "aaf-reset": "RX_RESET", "crf-reset": "RX_RESET",
+          "rx-saturation": "RX", "late": "CADENCE", "rate": "RATE",
+          "tx-nodirty": "OUTPUT_CADENCE", "fixed-grid": "PHASE",
+          "egress-stall": "CADENCE"}
+
+
+def replace_once(text: str, old: str, new: str) -> str:
+    """Apply one plant only when its source anchor is unique."""
+    if text.count(old) != 1:
+        raise ValueError(f"plant anchor occurred {text.count(old)} times: {old!r}")
+    return text.replace(old, new)
+
+
+def stall_egress(text: str) -> str:
+    """Hold parent control frames for 900 ms after a 100 ms quiet period."""
+    text = replace_once(text,
+                        "  adp_tx_arbiter #(.DATA_WIDTH(TDATA_WIDTH), .TO_LOG2_P(15)) ctl_tx_mux (", """
+  logic [31:0] r726_hold_r, r726_quiet_r; logic r726_busy_r; wire r726_ready_w;
+  always_ff @(posedge axis_clk) begin
+    if (!axis_resetn) begin r726_hold_r <= '0; r726_quiet_r <= '0; r726_busy_r <= 1'b0; end
+    else begin
+      if (pp_tx_tvalid_w && pp_tx_tready_w && pp_tx_tlast_w) r726_quiet_r <= '0;
+      else if (r726_quiet_r != 32'hFFFFFFFF) r726_quiet_r <= r726_quiet_r + 1;
+      if (pp_tx_tvalid_w && !r726_busy_r) begin
+        if (!cfg_crft_en || r726_quiet_r < 32'd100000 || r726_hold_r >= 32'd900000) begin
+          r726_busy_r <= 1'b1; r726_hold_r <= '0; end
+        else r726_hold_r <= r726_hold_r + 1;
+      end
+      if (r726_busy_r && pp_tx_tvalid_w && pp_tx_tready_w && pp_tx_tlast_w) r726_busy_r <= 1'b0;
+    end
+  end
+  assign pp_tx_tready_w = r726_ready_w & r726_busy_r;
+  adp_tx_arbiter #(.DATA_WIDTH(TDATA_WIDTH), .TO_LOG2_P(15)) ctl_tx_mux (""")
+    text = replace_once(text, """    .s_data_tvalid(pp_tx_tvalid_w), .s_data_tlast (pp_tx_tlast_w),
+    .s_data_tready(pp_tx_tready_w),""", """
+    .s_data_tvalid(pp_tx_tvalid_w & r726_busy_r), .s_data_tlast (pp_tx_tlast_w),
+    .s_data_tready(r726_ready_w),""")
+    return text
+
+
+def plant(variant: str, work: Path, output_condition: str) -> dict[str, str]:
+    """Stage isolated source variants; expectations remain in the MAC fixture."""
+    files = {rel: (ROOT / rel).read_text() for rel in (TX, RX, AAF, DP)}
+    if variant == "before":
+        for rel in files:
+            files[rel] = subprocess.check_output(
+                ["git", "show", f"c6bd08c6:{rel}"], cwd=ROOT, text=True)
+    elif variant == "tx-interval":
+        files[TX] = replace_once(files[TX], "  always_ff @(posedge clk_i) begin : diag_track", """
+  logic [N_CTX_P-1:0] counted_r;
+  always_ff @(posedge clk_i) begin
+    if (!rst_n) counted_r <= '0;
+    else for (int c=0; c<N_CTX_P; c++) begin
+      if (tick_p_r || (streaming_i[c] && !strm_q_r[c])) counted_r[c] <= ev_f_w[c];
+      else if (ev_f_w[c]) counted_r[c] <= 1'b1;
+    end
+  end
+  always_ff @(posedge clk_i) begin : diag_track""")
+        files[TX] = replace_once(files[TX], "ftx_r[c] <= ftx_r[c] + 32'd1;",
+                                "ftx_r[c] <= ftx_r[c] + 32'(!counted_r[c] || tick_p_r);")
+    elif variant == "rx-interval":
+        files[RX] = replace_once(files[RX], "  always_ff @(posedge clk_i) begin : engine", """
+  logic counted_r;
+  always_ff @(posedge clk_i) begin
+    if (!rst_n || w_bind_rise_w) counted_r <= 1'b0;
+    else if (iv_tick_r) counted_r <= w_acc;
+    else if (w_acc) counted_r <= 1'b1;
+  end
+  always_ff @(posedge clk_i) begin : engine""")
+        files[RX] = replace_once(files[RX], "pdu_count_o <= pdu_count_o + 32'd1;",
+                                "pdu_count_o <= pdu_count_o + 32'(!counted_r || iv_tick_r);")
+    elif variant == "tx-nodirty":
+        files[TX] = replace_once(files[TX],
+                                "ftx_r[c] <= ftx_r[c] + 32'd1;\n          dirty_p_o[c] <= 1'b1;",
+                                "ftx_r[c] <= ftx_r[c] + 32'd1;")
+    elif variant == "tx-reset":
+        files[TX] = replace_once(files[TX], "ftx_r[c]    <= {31'd0, ev_f_w[c]};",
+                                "ftx_r[c]    <= ftx_r[c];")
+    elif variant == "aaf-reset":
+        files[AAF] = replace_once(files[AAF], "else if (bind_zero_r) begin\n          eng_we_w    = 1'b1;",
+                                 "else if (bind_zero_r) begin\n          eng_we_w    = (zero_idx_r != C_FRX_C);")
+    elif variant == "crf-reset":
+        files[RX] = replace_once(files[RX], "        pdu_count_o    <= '0;",
+                                "        pdu_count_o    <= pdu_count_o;")
+    elif variant == "rx-saturation":
+        files[AAF] = replace_once(files[AAF], "if (iv_set_w[s][C_FRX_C])",
+                                 "if (iv_set_w[s][C_FRX_C] && frx_acc_r[s] < 32'd65535)")
+    elif variant == "late":
+        files[DP] = replace_once(files[DP],
+                                "assign pp_ctr_sin_dirty_w = {crf_dirty_p_w, avtprx_dirty_p_w};",
+                                "assign pp_ctr_sin_dirty_w = {crf_dirty_p_w, avtprx_dirty_p_w}"
+                                " & {PP_CTR_SIN_N_C{s_axi_awvalid && s_axi_awaddr == 12'hFFC}};")
+    elif variant == "egress-stall":
+        files[DP] = stall_egress(files[DP])
+    elif variant == "rate":
+        files[DP] = replace_once(files[DP], ".TIM_DIV_MS_P   (PP_TIM_DIV_MS_P),",
+                                ".TIM_DIV_MS_P   (PP_TIM_DIV_MS_P / 2),")
+    if output_condition == "frames-only":
+        # Model the locked-PHC condition at both talker inputs. The real
+        # packetizers stamp tu=0 and their completed-frame bits feed diagnostics.
+        anchor = ".ts_uncertain_i (clkv_tu_w)"
+        if files[DP].count(anchor) != 2:
+            raise ValueError("expected AAF and CRF timestamp-uncertainty inputs")
+        files[DP] = files[DP].replace(anchor, ".ts_uncertain_i (1'b0)")
+    paths = {}
+    for rel, text in files.items():
+        dest = work / Path(rel).name
+        if not dest.exists() or dest.read_text() != text:
+            dest.write_text(text)
+        paths[str(ROOT / rel)] = str(dest)
+    return paths
+
+
+def fixture_source(variant: str, work: Path) -> Path:
+    """Restore the superseded grid grader in an isolated fixture for the phase control."""
+    if variant != "fixed-grid":
+        return HERE / "sim_nxn.cpp"
+    header = replace_once((HERE / "stream_counters.hpp").read_text(),
+                          "result.refresh=result.count>=2 && result.max_cyc<=refresh_limit_cyc\n"
+                          "            && result.tail_cyc<=refresh_limit_cyc;", """
+        (void)refresh_limit_cyc;
+        std::array<int,5> bins{};
+        for(const long at:times) {
+            const long relative=at-start_cyc;
+            if(relative>=0 && relative<5*second_cyc) ++bins[relative/second_cyc];
+        }
+        result.refresh=bins[2]>=1 && bins[3]>=1 && bins[4]>=1;""")
+    (work / "stream_counters.hpp").write_text(header)
+    source = (HERE / "sim_nxn.cpp").read_text().replace(
+        '#include "../../common/verilator_harness.hpp"',
+        '#include "' + str(ROOT / "tb/common/verilator_harness.hpp") + '"')
+    staged = work / "sim_nxn.cpp"
+    staged.write_text(source)
+    return staged
+
+
+def run(shape: int, variant: str, work: Path, verilator: str, output_condition: str) -> None:
+    """Build the requested shape and require clean or attributable detection/escape results."""
+    work.mkdir(parents=True, exist_ok=True)
+    # Preserve the fixture's repository-relative descriptor paths without
+    # writing ROM images or object files into the checkout.
+    for name in ("configs", "sw", "hdl", "scripts", "avdecc", "protocol-processor"):
+        path = work / name
+        if not path.exists():
+            path.symlink_to(ROOT / name, target_is_directory=True)
+    runtime = work / "tb/verilator/milan_dp"
+    runtime.mkdir(parents=True, exist_ok=True)
+    flags = shlex.split(subprocess.check_output(
+        ["make", "--no-print-directory", "-s", "print-dp-vflags"], cwd=HERE, text=True))
+    flags = [f.replace("../../../", str(ROOT) + "/") for f in flags
+             if not f.startswith(("-GDIAG_TICK", "-GLDIAG_IVAL"))]
+    flags[flags.index("-j") + 1] = "2"
+    config = "endstation_ax7101_1x1_tdm8" if shape == 1 else "endstation_ax7101_8x8"
+    flags.insert(0, "+incdir+" + str(ROOT / "configs/generated" / config))
+    flags += ["-GDIAG_TICK_CYC_P=1000000", "-GLDIAG_IVAL_CYC_P=1000000",
+              "-GMILAN_CLK_FREQ_HZ=50000000", "-GPP_TIM_DIV_US_P=1",
+              "-GPP_TIM_DIV_MS_P=1000", f"-GN_STREAMS={shape}",
+              "-GTALKER_WIRE_CHANS_P=8", "-GAUDIO_IF_MASTER_P=1",
+              f"-GAUDIO_IF_SLOTS_P={8 if shape == 1 else 32}",
+              f"-GAUDIO_IF_CLK_HZ_P={24576000 if shape == 1 else 98304000}",
+              "-GI2SPB_P=0", "-GLPF_P=0", "-CFLAGS",
+              f"-DNSTREAMS_TB={shape} -DMS_CYC_TB=1000 -DSTREAM_COUNTERS_TB=1 "
+              f"-DCOUNTERS_FRAMES_ONLY_TB={int(output_condition == 'frames-only')}",
+              "--Mdir", str(work / "obj")]
+    sources = shlex.split(subprocess.check_output(
+        ["make", "--no-print-directory", "-s", "print-srcs"], cwd=HERE, text=True))
+    sources = [str((HERE / s).resolve()) for s in sources]
+    replacements = plant(variant, work, output_condition)
+    sources = [replacements.get(s, s) for s in sources]
+    with (work / "build.log").open("w") as log:
+        subprocess.run([verilator, *flags, *sources, str(fixture_source(variant, work)),
+                        "-o", "stream_counters"], cwd=work, stdout=log,
+                       stderr=subprocess.STDOUT, check=True)
+    for script, output in (("protocol-processor/hdl/acmp/rom/gen_ltn_rom.py", "ltn_rom.hex"),
+                           ("protocol-processor/hdl/aecp/ucode/gen_ucode.py", "ucode.hex")):
+        subprocess.run([sys.executable, str(ROOT / script), "-o", output],
+                       cwd=runtime, check=True)
+    env = dict(os.environ)
+    env.pop("COUNTERS_OMIT_CHECK", None)
+    exe = work / "obj/stream_counters"
+    for omitted in (None, GROUPS[variant]) if variant in GROUPS else (None,):
+        name = "escape.log" if omitted else "run.log"
+        if omitted:
+            env["COUNTERS_OMIT_CHECK"] = omitted
+        with (work / name).open("w") as log:
+            result = subprocess.run([str(exe)], cwd=runtime, env=env,
+                                    stdout=log, stderr=subprocess.STDOUT, check=False)
+        text = (work / name).read_text()
+        failures = [line for line in text.splitlines() if "[FAIL]" in line]
+        if variant in GROUPS and omitted is None:
+            marker = "[726 " + GROUPS[variant] + "]"
+            if result.returncode != 1 or not failures or any(marker not in f for f in failures):
+                raise RuntimeError(f"{variant}: no attributable named detection: {failures}")
+        elif variant == "before":
+            expected = {"TX", "RX", "CADENCE"}
+            found = {group for group in expected
+                     if any("[726 " + group + "]" in f for f in failures)}
+            if (result.returncode != 1 or found != expected or
+                    any(not any("[726 " + group + "]" in f for group in expected)
+                        for f in failures)):
+                raise RuntimeError(f"baseline lacks named TX/RX/CADENCE defects: {failures}")
+        elif result.returncode != 0 or failures or "RESULT: PASS" not in text:
+            raise RuntimeError(f"{variant}/{name}: rc={result.returncode}, {failures}")
+        print(f"{shape}x{shape} {variant} {output_condition} {name}: rc={result.returncode}, failures={len(failures)}")
+        if variant == "clean":
+            print(next(line for line in text.splitlines() if "RESULT: PASS" in line))
+
+
+def main() -> None:
+    """Select the shape, plant and output condition for a scratch-only run."""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--work", type=Path)
+    parser.add_argument("--shape", type=int, choices=(1, 8), default=1)
+    parser.add_argument("--variant", choices=("clean", "before", *GROUPS), default="clean")
+    parser.add_argument("--output-condition", choices=("uncertain", "frames-only"),
+                        help="default: frames-only for tx-nodirty, uncertain otherwise")
+    args = parser.parse_args()
+    condition = args.output_condition or ("frames-only" if args.variant == "tx-nodirty" else "uncertain")
+    if args.variant == "tx-nodirty" and condition != "frames-only":
+        parser.error("tx-nodirty requires the frames-only output condition")
+    verilator = os.environ.get("VERILATOR", "verilator")
+    if args.work:
+        run(args.shape, args.variant, args.work.resolve(), verilator, condition)
+    else:
+        with tempfile.TemporaryDirectory(prefix="stream-counters-") as work:
+            run(args.shape, args.variant, Path(work), verilator, condition)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tb/verilator/tkdiag/sim_main.cpp b/tb/verilator/tkdiag/sim_main.cpp
index c54080b6a..8bcf53601 100644
--- a/tb/verilator/tkdiag/sim_main.cpp
+++ b/tb/verilator/tkdiag/sim_main.cpp
@@ -14,13 +14,9 @@
  *    streaming), or STREAM_START=STREAM_STOP".  NOTE what the clause does
  *    NOT say: these two carry no "Reset to 0" sentence, so they must SURVIVE
  *    a start - see T8.
- *  - MEDIA_RESET / TIMESTAMP_UNCERTAIN / FRAMES_TX are each "Incremented at
- *    the end of every observation interval during which ...", interval
- *    "implementation-specific and shall be less than or equal to 1 second",
- *    each followed by "Reset to 0 each time the Talker starts streaming".
- *    So they are INTERVAL counts (eight PDUs in one interval move FRAMES_TX
- *    by exactly one - a raw frame total would read 8000x off at the real
- *    frame rate) and reset-on-start is MANDATED, not a bug.
