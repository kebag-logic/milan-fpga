+        (NTFY, LC_EXP_RELATCH, LC_EXP_RELATCH.replace("          em_excl_v_r <= 1'b0;\n", "")),),
+        ("LC1:",)),
+    Mutant("lock_take_round_not_relatched", INDEX, (
