diff --git a/tb/verilator/engine/pass_run.py b/tb/verilator/engine/pass_run.py
index cbf387b..9da6b6a 100644
--- a/tb/verilator/engine/pass_run.py
+++ b/tb/verilator/engine/pass_run.py
@@ -101,15 +101,15 @@ def run(n: int, directory: str | None, generate: str | None, argv: list[str], ig
     received: list[int] = []
     child: list[subprocess.Popen] = []
 
-    def chunk(stream: int, data: bytes) -> None:
+    def _chunk(stream: int, data: bytes) -> None:
         log.write(bytes([stream]) + len(data).to_bytes(4, "big") + data)
 
-    def forward(signum: int, _frame: object) -> None:
+    def _forward(signum: int, _frame: object) -> None:
         received.append(signum)
         if child and child[0].returncode is None:
             signal_all(child[0].pid, signum)
 
-    def stop(_signum: int, _frame: object) -> None:
+    def _stop(_signum: int, _frame: object) -> None:
         if failed_before(n):
             record["stopped"] = True
             if child and child[0].returncode is None:
@@ -117,8 +117,8 @@ def run(n: int, directory: str | None, generate: str | None, argv: list[str], ig
 
     for signum in FORWARDED:
         if signal.getsignal(signum) is not signal.SIG_IGN:
-            signal.signal(signum, forward)
-    signal.signal(signal.SIGUSR1, stop)
+            signal.signal(signum, _forward)
+    signal.signal(signal.SIGUSR1, _stop)
     (STATE / f"{n}.pid").write_text(str(os.getpid()))
     if not ignoring and failed_before(n):
         record["stopped"] = True  # an earlier pass failed: the serial recipe never ran this one
@@ -150,7 +150,7 @@ def run(n: int, directory: str | None, generate: str | None, argv: list[str], ig
             if received:
                 signal_all(child[0].pid, received[0])  # a signal that came before the child was known
         except OSError as exc:
-            chunk(2, f"make: {argv[0]}: {exc.strerror}\n".encode())
+            _chunk(2, f"make: {argv[0]}: {exc.strerror}\n".encode())
             record["exit"] = 127
         else:
             proc = child[0]
@@ -161,7 +161,7 @@ def run(n: int, directory: str | None, generate: str | None, argv: list[str], ig
                 for key, _ in selector.select():
                     data = os.read(key.fd, 65536)
                     if data:
-                        chunk(key.data, data)
+                        _chunk(key.data, data)
                     else:
                         selector.unregister(key.fileobj)
             _, status = os.waitpid(proc.pid, 0)
@@ -262,6 +262,7 @@ def reraise(signum: int, core: bool) -> None:
 
 
 def main() -> int:
+    """Run or replay one pass, as the command line names it."""
     parser = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
     parser.add_argument("--ignore-errors", action="store_true", help="make runs with -i")
     sub = parser.add_subparsers(dest="what", required=True)
