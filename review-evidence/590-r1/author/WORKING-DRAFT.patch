+	for (i = 0; i < 14u; ++i)
+		phy_mdio_bit(1, (command >> (13u - i)) & 1u);
+	phy_mdio_bit(0, 0);
+	ack = phy_mdio_bit(0, 0);
+	for (i = 0; i < 16u; ++i)
+		value = (value << 1) | phy_mdio_bit(0, 0);
