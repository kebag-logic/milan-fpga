+    std::vector<Pdu> send(int t, int n, int headroom = 60) {
+        std::vector<Pdu> sent;
+        for (int k = 0; k < n; k++) {
+            sent.push_back(payload());
+            feed(aaf(t, 8, sent.back()), headroom);
+        }
+        return sent;
+    }
