diff --git a/tb/verilator/avtp_rxmon/sim_depkt.cpp b/tb/verilator/avtp_rxmon/sim_depkt.cpp
new file mode 100644
index 0000000000..9596196181
--- /dev/null
+++ b/tb/verilator/avtp_rxmon/sim_depkt.cpp
@@ -0,0 +1,504 @@
+// SPDX-FileCopyrightText: 2026 Kebag Logic
+// SPDX-License-Identifier: CERN-OHL-W-2.0
+//
+// sim_depkt.cpp - KL_aaf_rx_depacketizer on its own (#948), N_STREAMS_P = 4:
+// the frame boundaries of each PDU's output for every payload length, read out
+// once for each input that accepted it.
+//
+// The harness plays the monitor: an enqueue pulse a fixed number of cycles
+// after the frame's eighth beat on the tap (the parser matches on it; in the
+// datapath the pulse comes three cycles on, after the tlast of a frame of ten
+// beats or fewer), then a done pulse naming the accepting inputs, in enqueue
+// order, some cycles later (before or after the frame's end). The consumer
+// stalls at random, or at each PDU's last two beats, or never.
+//
+//   [DT1] a 64-octet payload is eight beats with one tlast, and a 65-octet
+//         one nine beats with one, its last beat lying in the hold
+//   [DT2] every payload length 1..72 and 184..200, and 1000, 1001 and 1983,
+//         untagged and behind a C-VLAN tag, with and without octets after
+//         the payload, to one, two or four inputs or to none, each case
+//         followed by an ordinary 192-octet PDU to another input. Each input
+//         that accepted a PDU receives it as one frame of ceil(length/8)
+//         beats, tlast on the last alone, tuser its own index throughout,
+//         the payload byte for byte and zeros after it; the inputs' passes
+//         come lowest first, and the next PDU keeps its own boundaries and
+//         index. A stalled beat holds its data, tuser and tlast (AXI-Stream).
+//         pdus_o and pdu_out_p_o count each delivered pass under its index,
+//         and nothing is dropped
+//   [DT3] frames that end short of their payload, by words or by octets of
+//         the last beat, untagged and tagged: nothing of the PDU is read out,
+//         drops_o counts the frame, drop_p_o names its accepting inputs, and
+//         the next PDU arrives whole
+//   [DT4] frames of eight, nine and ten beats (the Ethernet minimum up to 80
+//         octets), every payload length that fits, untagged and tagged, the
+//         enqueue pulse three cycles after the eighth beat (the datapath's
+//         latency, after the tlast of each) and one cycle after: two such
+//         PDUs with a frame between them whose PDU was not queued, then an
+//         ordinary PDU, to one, two or no inputs, with and without stalls.
+//         Each queued PDU reaches each of its inputs whole, under its index,
+//         the unqueued frame reaches none, and nothing is dropped. The Milan
+//         v1.2 1-channel 48 kHz Base PDU (24 octets: a 62-octet frame, 66
+//         tagged) is three beats with one tlast
+//   [DT5] the tap with bubbles (AXI-Stream lets a frame pause): before six
+//         beats in ten, one to three cycles of tvalid low or of tready low
+//         holding the beat, the enqueue pulse three cycles after the
+//         accepted eighth beat; every length 1 to 72 and 192, untagged and
+//         tagged, to one, two, four or no inputs, each followed by an
+//         ordinary PDU, under random output stalls: each output frame whole,
+//         in order, under its index
+//
+// Usage: make -C tb/verilator/avtp_rxmon depkt
+
+#include <cstdint>
+#include <cstdio>
+#include <deque>
+#include <memory>
+#include <vector>
+
+#include "Vdepkt_top.h"
+#include "verilated.h"
+
+namespace {
+
+constexpr int kInputs = 4;
+using Bytes = std::vector<uint8_t>;
+
+struct Rng {
+    uint64_t s;
+    uint64_t next() { s ^= s << 13; s ^= s >> 7; s ^= s << 17; return s; }
+    unsigned below(unsigned n) { return static_cast<unsigned>(next() % n); }
+};
+
+//! one frame on the tap: its octets, whether its PDU is queued, and the accepting inputs
+struct Frame {
+    Bytes octets;
+    bool queued;
+    unsigned mask;
+    Bytes payload;      // the stream_data_length octets, as the header names them
+    bool whole;         // the frame holds them all
+};
+
+//! one output frame as the consumer saw it
+struct Out {
+    unsigned tuser;
+    Bytes data;
+    bool tuser_steady;
+};
+
+enum class Stall { kNone, kRandom, kTail };
+
+class Depkt {
+ public:
+    int run() {
+        reset();
+        std::printf("== KL_aaf_rx_depacketizer, N_STREAMS_P=4, PAY_LEAD_CYC_P=%d (#948) ==\n", LEAD_TB);
+        control_and_probe();
+        every_length();
+        frames_short_of_their_payload();
+        short_frames();
+        tap_bubbles();
+        std::printf("\n======================================================================\n");
+        std::printf("DEPKT: %ld checks, %ld failures\nRESULT: %s\n", checks, fails, fails ? "FAIL" : "PASS");
+        return fails ? 1 : 0;
+    }
+
+ private:
+    std::unique_ptr<Vdepkt_top> d = std::make_unique<Vdepkt_top>();
+    long checks = 0;
+    long fails = 0;
+    Rng rng{0x9E3779B97F4A7C15ull};
+    Stall stall = Stall::kNone;
+    unsigned pdu_no = 0;
+
+    // the consumer's view
+    std::vector<Out> outs;                 // completed output frames, in order
+    Out cur{0, {}, true};
+    bool have_cur = false;
+    unsigned beat_in_frame = 0;
+    unsigned tail_beats = 0;               // the current PDU's beat count (for the tail stall)
+    int hold = 0;                          // cycles of stall left
+    bool stalled_seen = false;             // a stalled beat to compare on the next cycle
+    uint64_t st_data = 0; unsigned st_user = 0; bool st_last = false;
+    long axis_breaks = 0;
+    std::vector<unsigned> out_idx;         // pdu_out_p_o's indices
+    std::vector<unsigned> drop_masks;      // drop_p_o's masks
+
+    // the monitor's done pulses still owed, in enqueue order: {cycle due, mask}
+    std::deque<std::pair<long, unsigned>> owed;
+    // its enqueue pulses still owed: {cycle due, mask, the done pulse's lag after it}
+    struct Enq { long due; unsigned mask; int lag; };
+    std::deque<Enq> enq_owed;
+    int enq_lat = 1;                       // cycles from the tap's eighth beat to the enqueue pulse
+    long now = 0;
+
+    void ck(const char* t, long have, long exp) {
+        checks++;
+        if (have != exp) { fails++; std::printf("  [FAIL] %s got=%ld exp=%ld\n", t, have, exp); }
+        else std::printf("  [ ok ] %s = %ld\n", t, have);
+    }
+
+    void reset() {
+        d->rst_n = 0;
+        d->s_tvalid_i = 0; d->s_tready_i = 1; d->s_tlast_i = 0; d->s_tkeep_i = 0; d->s_tdata_i = 0;
+        d->pdu_enq_p_i = 0; d->pdu_done_p_i = 0; d->pdu_done_mask_i = 0;
+        d->m_axis_tready = 1;
+        for (int i = 0; i < 6; i++) cycle();
+        d->rst_n = 1;
+        for (int i = 0; i < 4; i++) cycle();
+    }
+
+    // one clock: drive the consumer's tready and the owed done pulse, sample the output, then the edge
+    void cycle() {
+        d->clk_i = 0;
+        d->pdu_enq_p_i = 0;
+        if (!enq_owed.empty() && enq_owed.front().due <= now) {
+            d->pdu_enq_p_i = 1;
+            owed.emplace_back(now + enq_owed.front().lag, enq_owed.front().mask);
+            enq_owed.pop_front();
+        }
+        d->pdu_done_p_i = 0;
+        if (!owed.empty() && owed.front().first <= now) {
+            d->pdu_done_p_i = 1;
+            d->pdu_done_mask_i = owed.front().second;
+            owed.pop_front();
+        }
+        d->eval();
+        // the consumer decides on this cycle's beat
+        bool ready = true;
+        if (d->m_axis_tvalid) {
+            if (stall == Stall::kRandom) ready = rng.below(10) < 6;
+            else if (stall == Stall::kTail) {
+                if (hold == 0 && tail_beats >= 2 && beat_in_frame + 2 >= tail_beats && !stalled_seen) hold = 5;
+                if (hold > 0) { ready = false; hold--; }
+            }
+        }
+        d->m_axis_tready = ready;
+        d->eval();
+        if (d->m_axis_tvalid) {
+            if (stalled_seen && (d->m_axis_tdata != st_data || d->m_axis_tuser != st_user ||
+                                 static_cast<bool>(d->m_axis_tlast) != st_last))
+                axis_breaks++;
+            stalled_seen = false;
+            if (d->m_axis_tready) {
+                if (!have_cur) { cur = Out{d->m_axis_tuser, {}, true}; have_cur = true; }
+                if (d->m_axis_tuser != cur.tuser) cur.tuser_steady = false;
+                for (int k = 0; k < 8; k++) cur.data.push_back(static_cast<uint8_t>(d->m_axis_tdata >> (8 * k)));
+                beat_in_frame++;
+                if (d->m_axis_tlast) {
+                    outs.push_back(cur);
+                    have_cur = false;
+                    beat_in_frame = 0;
+                    hold = 0;
+                }
+            } else {
+                stalled_seen = true;
+                st_data = d->m_axis_tdata; st_user = d->m_axis_tuser; st_last = d->m_axis_tlast;
+            }
+        } else if (stalled_seen) {
+            axis_breaks++;                 // a stalled beat withdrawn
+            stalled_seen = false;
+        }
+        d->clk_i = 1;
+        d->eval();
+        if (d->pdu_out_p_o) out_idx.push_back(d->pdu_out_idx_o);
+        if (d->drop_p_o) drop_masks.push_back(d->drop_mask_o);
+        now++;
+    }
+
+    Bytes payload(unsigned n) {
+        Bytes p(n);
+        for (unsigned i = 0; i < n; i++) p[i] = static_cast<uint8_t>(pdu_no * 37u + i * 5u + 3u);
+        pdu_no++;
+        return p;
+    }
+
+    // an AAF frame carrying `p`, tagged when `vlan`, `extra` octets after the payload, cut to `cut` octets if set
+    static Frame frame(const Bytes& p, bool vlan, unsigned extra, unsigned mask, size_t cut = 0) {
+        const size_t o = vlan ? 18 : 14;
+        Bytes f(o + 24 + p.size() + extra, 0xEE);
+        for (size_t i = 0; i < o + 24; i++) f[i] = 0;
+        for (int i = 0; i < 6; i++) { f[i] = 0x91; f[6 + i] = 0x02; }
+        if (vlan) { f[12] = 0x81; f[13] = 0x00; f[14] = 0x60; f[15] = 0x02; }
+        f[o - 2] = 0x22; f[o - 1] = 0xF0;
+        f[o + 0] = 0x02; f[o + 1] = 0x81;
+        f[o + 12] = 0x12; f[o + 13] = 0x34; f[o + 14] = 0x56; f[o + 15] = 0x78;
+        f[o + 16] = 0x02; f[o + 17] = 0x50; f[o + 18] = 8; f[o + 19] = 32;
+        f[o + 20] = static_cast<uint8_t>(p.size() >> 8);
+        f[o + 21] = static_cast<uint8_t>(p.size());
+        for (size_t i = 0; i < p.size(); i++) f[o + 24 + i] = p[i];
+        bool whole = true;
+        if (cut) { f.resize(cut); whole = cut >= o + 24 + p.size(); }
+        return Frame{f, true, mask, p, whole};
+    }
+
+    // the tap: one beat a cycle, the enqueue pulse enq_lat cycles after beat 7 (the parser's match), the done
+    // pulse `lag` cycles after that
+    // with `bubbles`, before six beats in ten one to three cycles of tvalid low, or of tready low holding the beat
+    bool bubbles = false;
+    void feed(const Frame& fr, int lag, int gap) {
+        const size_t beats = (fr.octets.size() + 7) / 8;
+        for (size_t b = 0; b < beats; b++) {
+            uint64_t w = 0;
+            unsigned n = 0;
+            for (unsigned k = 0; k < 8 && b * 8 + k < fr.octets.size(); k++, n++)
+                w |= static_cast<uint64_t>(fr.octets[b * 8 + k]) << (8 * k);
+            d->s_tdata_i = w;
+            d->s_tkeep_i = n == 8 ? 0xFF : ((1u << n) - 1);
+            d->s_tvalid_i = 1;
+            d->s_tlast_i = b + 1 == beats;
+            if (bubbles && rng.below(10) < 6) {
+                const unsigned nb = 1 + rng.below(3);
+                for (unsigned i = 0; i < nb; i++) {
+                    if (rng.below(2)) { d->s_tvalid_i = 0; d->s_tready_i = 1; }
+                    else              { d->s_tvalid_i = 1; d->s_tready_i = 0; }
+                    cycle();
+                }
+                d->s_tvalid_i = 1;
+                d->s_tready_i = 1;
+            }
+            if (fr.queued && b == 7) enq_owed.push_back(Enq{now + enq_lat, fr.mask, lag});
+            cycle();
+        }
+        d->s_tvalid_i = 0; d->s_tlast_i = 0;
+        for (int i = 0; i < gap; i++) cycle();
+    }
+
+    // until the output is idle for longer than the store takes to pass over a frame no input accepted (256 words)
+    void drain() {
+        int idle = 0;
+        while (idle < 300) {
+            cycle();
+            idle = (d->m_axis_tvalid || !owed.empty() || !enq_owed.empty()) ? 0 : idle + 1;
+        }
+    }
+
+    // what the frames should have produced, in order: one output per accepting input, lowest first
+    static std::vector<Out> expected(const std::vector<Frame>& fs) {
+        std::vector<Out> e;
+        for (const Frame& f : fs) {
+            if (!f.queued || !f.whole) continue;
+            Bytes q = f.payload;
+            q.resize((q.size() + 7) / 8 * 8, 0);
+            for (unsigned s = 0; s < kInputs; s++)
+                if (f.mask & (1u << s)) e.push_back(Out{s, q, true});
+        }
+        return e;
+    }
+
+    // run frames back to back and grade the outputs; returns true when every output matched
+    bool grade(const char* tag, const std::vector<Frame>& fs, int lag, bool print) {
+        outs.clear(); out_idx.clear(); drop_masks.clear(); axis_breaks = 0;
+        const unsigned pdus0 = d->pdus_o;
+        const unsigned drops0 = d->drops_o;
+        for (const Frame& f : fs) feed(f, lag, static_cast<int>(rng.below(3)));
+        drain();
+        const std::vector<Out> e = expected(fs);
+        long exact = 0;
+        bool order_ok = outs.size() == e.size();
+        for (size_t k = 0; k < e.size() && k < outs.size(); k++) {
+            if (outs[k].tuser == e[k].tuser && outs[k].data == e[k].data && outs[k].tuser_steady) exact++;
+            else order_ok = false;
+        }
+        long idx_ok = out_idx.size() == e.size();
+        for (size_t k = 0; k < e.size() && k < out_idx.size(); k++)
+            if (out_idx[k] != e[k].tuser) idx_ok = 0;
+        long short_q = 0;
+        std::vector<unsigned> want_drops;
+        for (const Frame& f : fs)
+            if (f.queued && !f.whole) { short_q++; if (f.mask) want_drops.push_back(f.mask); }
+        const bool ok = order_ok && idx_ok && axis_breaks == 0 &&
+                        static_cast<uint16_t>(d->pdus_o - pdus0) == e.size() &&
+                        static_cast<uint16_t>(d->drops_o - drops0) == short_q && drop_masks == want_drops;
+        if (print || !ok) {
+            char t[200];
+            std::snprintf(t, sizeof t, "%s output frames, one per accepting input", tag);
+            ck(t, static_cast<long>(outs.size()), static_cast<long>(e.size()));
+            std::snprintf(t, sizeof t, "%s ...each its beats, its tlast, its index and its bytes, in order", tag);
+            ck(t, exact, static_cast<long>(e.size()));
+            std::snprintf(t, sizeof t, "%s pdu_out_p_o names each pass's input", tag);
+            ck(t, idx_ok, 1);
+            std::snprintf(t, sizeof t, "%s pdus_o counts each pass", tag);
+            ck(t, static_cast<uint16_t>(d->pdus_o - pdus0), static_cast<long>(e.size()));
+            std::snprintf(t, sizeof t, "%s drops_o counts each short frame", tag);
+            ck(t, static_cast<uint16_t>(d->drops_o - drops0), short_q);
+            std::snprintf(t, sizeof t, "%s drop_p_o names each short frame's accepting inputs", tag);
+            ck(t, drop_masks == want_drops ? 1 : 0, 1);
+            std::snprintf(t, sizeof t, "%s a stalled beat holds its data, tuser and tlast", tag);
+            ck(t, axis_breaks, 0);
+        }
+        return ok;
+    }
+
+    void control_and_probe() {
+        std::printf("\n[DT1] 64 and 65 octets, untagged, to input 0\n");
+        for (unsigned n : {64u, 65u}) {
+            outs.clear();
+            feed(frame(payload(n), false, 0, 1), 3, 0);
+            drain();
+            char t[120];
+            const unsigned beats = (n + 7) / 8;
+            std::snprintf(t, sizeof t, "[DT1] a %u-octet payload: one output frame", n);
+            ck(t, static_cast<long>(outs.size()), 1);
+            std::snprintf(t, sizeof t, "[DT1] a %u-octet payload: %u beats, tlast on the last", n, beats);
+            ck(t, outs.empty() ? 0 : static_cast<long>(outs[0].data.size() / 8), beats);
+        }
+    }
+
+    void every_length() {
+        std::printf("\n[DT2] every length, tagged and untagged, to none, one, two or four inputs, three consumers\n");
+        std::vector<unsigned> lengths;
+        for (unsigned n = 1; n <= 72; n++) lengths.push_back(n);
+        for (unsigned n = 184; n <= 200; n++) lengths.push_back(n);
+        for (unsigned n : {1000u, 1001u, 1983u}) lengths.push_back(n);
+        const unsigned masks[] = {0x1, 0x5, 0xF, 0x8, 0x0};
+        const Stall stalls[] = {Stall::kNone, Stall::kRandom, Stall::kTail};
+        const char* sname[] = {"no stall", "random stalls", "stalls at the last two beats"};
+        long cases = 0;
+        long good = 0;
+        for (int si = 0; si < 3; si++) {
+            stall = stalls[si];
+            for (bool vlan : {false, true}) {
+                for (unsigned n : lengths) {
+                    for (unsigned mask : masks) {
+                        // a frame of the stream is at least nine beats with its PDU queued; a short payload carries
+                        // octets after it, and every eighth case does
+                        const size_t hdr = vlan ? 42 : 38;
+                        unsigned extra = (hdr + n < 72) ? static_cast<unsigned>(72 - hdr - n) : 0;
+                        if ((cases & 7) == 3) extra += 1 + rng.below(12);
+                        tail_beats = (n + 7) / 8;
+                        std::vector<Frame> fs;
+                        fs.push_back(frame(payload(n), vlan, extra, mask));
+                        // the next PDU, to another input: input 2, or input 0 after one to input 2 alone
+                        const Frame next = frame(payload(192), false, 0, mask == 0x4 ? 0x1 : 0x2);
+                        const bool fits = (fs[0].octets.size() + next.octets.size()) / 8 < 250;
+                        char tag[120];
+                        std::snprintf(tag, sizeof tag, "[DT2] %u octets%s, inputs %X, %s:", n, vlan ? " tagged" : "",
+                                      mask, sname[si]);
+                        const int lag = 2 + static_cast<int>(rng.below(40));
+                        bool ok;
+                        if (fits) {
+                            fs.push_back(next);
+                            ok = grade(tag, fs, lag, false);
+                        } else {
+                            ok = grade(tag, fs, lag, false) && grade(tag, {next}, lag, false);
+                        }
+                        cases++;
+                        if (ok) good++;
+                    }
+                }
+            }
+        }
+        stall = Stall::kNone;
+        ck("[DT2] cases whose every output frame is whole, in order, under its index", good, cases);
+    }
+
+    void frames_short_of_their_payload() {
+        std::printf("\n[DT3] frames that end short of their payload, then a whole PDU\n");
+        for (bool vlan : {false, true}) {
+            const size_t hdr = vlan ? 42 : 38;
+            for (unsigned n : {192u, 65u, 66u}) {
+                for (size_t short_by : {size_t{1}, size_t{7}, size_t{8}, size_t{9}, size_t{40}}) {
+                    for (unsigned mask : {0x3u, 0x0u}) {
+                        const Bytes p = payload(n);
+                        std::vector<Frame> fs;
+                        fs.push_back(frame(p, vlan, 0, mask, hdr + n - short_by));
+                        if (fs[0].octets.size() < 72) continue;    // its PDU is queued on beat 8, in its flight
+                        fs.push_back(frame(payload(192), false, 0, 0x4));
+                        char tag[120];
+                        std::snprintf(tag, sizeof tag, "[DT3] %u octets%s, %zu short, inputs %X:", n,
+                                      vlan ? " tagged" : "", short_by, mask);
+                        grade(tag, fs, 2 + static_cast<int>(rng.below(20)), true);
+                    }
+                }
+            }
+        }
+    }
+
+    void short_frames() {
+        std::printf("\n[DT4] frames of 8 to 10 beats, the pulse 3 cycles after the eighth beat, then 1 after\n");
+        long cases = 0;
+        long good = 0;
+        for (int lat : {3, 1}) {
+            enq_lat = lat;
+            for (bool vlan : {false, true}) {
+                const unsigned hdr = vlan ? 42 : 38;
+                for (unsigned n = 1; hdr + n <= 80; n++) {
+                    for (unsigned mask : {0x1u, 0x5u, 0x0u}) {
+                        for (Stall st : {Stall::kNone, Stall::kRandom}) {
+                            stall = st;
+                            // the Ethernet minimum, 60 octets, padded after the payload
+                            const unsigned extra = hdr + n < 60 ? 60 - hdr - n : 0;
+                            tail_beats = (n + 7) / 8;
+                            std::vector<Frame> fs;
+                            fs.push_back(frame(payload(n), vlan, extra, mask));
+                            fs.push_back(frame(payload(n), vlan, extra, 0x2));
+                            fs.back().queued = false;              // no bound input holds its stream_id
+                            fs.push_back(frame(payload(n), vlan, extra, mask ^ 0x3));
+                            fs.push_back(frame(payload(192), false, 0, 0x8));
+                            char tag[120];
+                            std::snprintf(tag, sizeof tag, "[DT4] %u octets%s, %zu beats, inputs %X, pulse %d on:", n,
+                                          vlan ? " tagged" : "", (fs[0].octets.size() + 7) / 8, mask, lat);
+                            cases++;
+                            if (grade(tag, fs, 2 + static_cast<int>(rng.below(16)), false)) good++;
+                        }
+                    }
+                }
+            }
+        }
+        stall = Stall::kNone;
+        ck("[DT4] cases whose every output frame is whole, in order, under its index", good, cases);
+        enq_lat = 3;
+        for (bool vlan : {false, true}) {
+            outs.clear();
+            feed(frame(payload(24), vlan, 0, 1), 3, 0);
+            drain();
+            char t[140];
+            std::snprintf(t, sizeof t, "[DT4] the 1-channel 48 kHz Base PDU%s (a %u-octet frame): one output frame",
+                          vlan ? " tagged" : "", vlan ? 66u : 62u);
+            ck(t, static_cast<long>(outs.size()), 1);
+            std::snprintf(t, sizeof t, "[DT4] the 1-channel 48 kHz Base PDU%s: 3 beats, tlast on the last",
+                          vlan ? " tagged" : "");
+            ck(t, outs.empty() ? 0 : static_cast<long>(outs[0].data.size() / 8), 3);
+        }
+        enq_lat = 1;
+    }
+    void tap_bubbles() {
+        std::printf("\n[DT5] the tap with bubbles, the enqueue pulse 3 cycles after the accepted eighth beat\n");
+        enq_lat = 3;
+        stall = Stall::kRandom;
+        bubbles = true;
+        long cases = 0;
+        long good = 0;
+        std::vector<unsigned> lengths;
+        for (unsigned n = 1; n <= 72; n++) lengths.push_back(n);
+        lengths.push_back(192);
+        for (bool vlan : {false, true}) {
+            for (unsigned n : lengths) {
+                for (unsigned mask : {0x1u, 0x5u, 0xFu, 0x0u}) {
+                    const unsigned hdr = vlan ? 42 : 38;
+                    const unsigned extra = hdr + n < 60 ? 60 - hdr - n : 0;
+                    tail_beats = (n + 7) / 8;
+                    std::vector<Frame> fs;
+                    fs.push_back(frame(payload(n), vlan, extra, mask));
+                    fs.push_back(frame(payload(192), false, 0, mask == 0x4 ? 0x1 : 0x2));
+                    char tag[120];
+                    std::snprintf(tag, sizeof tag, "[DT5] %u octets%s, inputs %X:", n, vlan ? " tagged" : "", mask);
+                    cases++;
+                    if (grade(tag, fs, 2 + static_cast<int>(rng.below(20)), false)) good++;
+                }
+            }
+        }
+        bubbles = false;
+        stall = Stall::kNone;
+        enq_lat = 1;
+        ck("[DT5] cases whose every output frame is whole, in order, under its index", good, cases);
+    }
+};
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    Verilated::commandArgs(argc, argv);
+    Depkt h;
+    return h.run();
+}
diff --git a/tb/verilator/avtp_rxmon/sim_fanout.cpp b/tb/verilator/avtp_rxmon/sim_fanout.cpp
new file mode 100644
index 0000000000..fe4df0d52a
--- /dev/null
+++ b/tb/verilator/avtp_rxmon/sim_fanout.cpp
@@ -0,0 +1,896 @@
+// SPDX-FileCopyrightText: 2026 Kebag Logic
+// SPDX-License-Identifier: CERN-OHL-W-2.0
+//
+// sim_fanout.cpp - one talker stream bound to several Stream Inputs (#948), at
+// the 8x8 shape's eight contexts: the multi-stream receive stack of
+// avtp_rxmon_nx_wrap (KL_stream_table, avtp_stream_parser,
+// KL_avtp_rx_monitor_ctx, the depacketizer and the route) at N_STREAMS_P = 8.
+//
+// IEEE 1722.1-2021 8.2 lets each sink bind on its own, so one stream_id can be
+// the source of several of an entity's Stream Inputs. Each such input receives
+// every PDU of the stream: it is judged against its own format and counted in
+// its own Table 5.6 counters (Milan v1.2 5.3.8.10), and its payload reaches
+// the depacketizer's output under its own index, the render path's input.
+//
+//   [FO1] two inputs bound to one stream: each accepts every PDU, counts it
+//         in FRAMES_RX and its DEPKT tally, locks, and receives every
+//         payload byte for byte under its own index
+//   [FO2] three inputs bound to one stream: the same for each of the three
+//   [FO3] unbinding one of them leaves the other two receiving, and the
+//         unbound input receives and counts nothing more
+//   [FO4] each input judges the one PDU on its own: an input whose format
+//         differs counts UNSUPPORTED_FORMAT and receives nothing, the others
+//         accept it; once both have settled, a sequence gap counts in each
+//         accepting input's own SEQ_NUM_MISMATCH and STREAM_INTERRUPTED
+//   [FO5] two streams back to back, one bound to two inputs and one to a
+//         third: each input receives exactly its own stream's payloads, in
+//         order, and nothing is dropped
+//   [FO6] all eight inputs bound to one stream: each receives every PDU
+//   [FO7] a PDU no bound input accepts, then one they do, back to back: the
+//         first is delivered to no input, the second to each
+//   [FO8] a frame cut off on its eighth beat, the one the parser matches
+//         on, then a full PDU with no gap: the cut frame's PDU is queued and
+//         counted, and the frame, short of its payload, is delivered to no
+//         input and is one DEPKT drop for each; the full one is delivered to
+//         each, its own payload
+//   [FO9] eight inputs on one stream: a full PDU, six such frames with no
+//         gap, then two full PDUs: the burst fills the engine's ring behind
+//         the committed one's verdicts, and each input receives exactly the
+//         three full PDUs, its FRAMES_RX counting exactly the PDUs it
+//         accepted
+//   [FO10] eight inputs on one stream, thirty full PDUs with no gap: each
+//         frame is read out eight times, so the store overflows; every PDU
+//         an input accepted is delivered to it, in order, or counted as one
+//         of its own DEPKT drops, and each input counts the same drops
+//   [FO11] a PDU whose stream_data_length is not the input's frame size
+//         (channels x samples_per_frame x sample octets, IEEE 1722-2016
+//         7.3.5 and I.2.4.1) is off-format: each input bound to its stream
+//         counts it in UNSUPPORTED_FORMAT and receives none of it, and the
+//         valid PDUs around it arrive whole, in order, under each input's
+//         index (Milan v1.2 4.4.2.2); 65 octets among them. Two
+//         inputs with different frame sizes on one stream each take only
+//         the PDUs of their own size
+//   [FO12] formats whose frame size is not a multiple of eight, every
+//         remainder 1 to 7, untagged and behind a C-VLAN tag, two inputs on
+//         one stream and a third input on another between them: each PDU
+//         reaches each input as one frame of ceil(length/8) beats,
+//         zero-padded, with one tlast, and the other stream's PDUs keep
+//         their own boundaries and index
+//   [FO15] [FO10]'s burst, longer, with idle cycles inside each frame
+//         (AXI-Stream lets tvalid fall between beats): the monitor queues
+//         every PDU while the store overflows and the walker serving eight
+//         inputs is never idle; every PDU an input accepted is delivered to
+//         it or one of its own DEPKT drops, each input counts the same
+//         drops, and its DEPKT tally counts each PDU it was delivered; each
+//         input drops more frames than a pending tally holds before its drain
+//   [FO14] frames of eight, nine and ten beats, the Ethernet minimum up to
+//         80 octets: every payload remainder (INT_16BIT, INT_24BIT and
+//         INT_32BIT formats of one channel), the Milan v1.2 1-channel 48 kHz
+//         Base format among them, untagged and behind a C-VLAN tag, to two
+//         inputs, back to back, with another stream's PDUs to a third input
+//         between them: each reaches each input whole, its own tlast and
+//         index. The parser matches on the eighth beat and the monitor's
+//         enqueue pulse comes three cycles later, after such a frame's tlast.
+//         Short PDUs off the inputs' frame size are still discarded whole and
+//         counted as UNSUPPORTED_FORMAT
+//   [FO13] frames that end short of their stream_data_length, by words and
+//         by one octet: each input counts the PDU (its header is whole) but
+//         receives none of it, the frame is one DEPKT drop for each, and
+//         the PDUs around it arrive whole
+//
+// Usage: make -C tb/verilator/avtp_rxmon fanout   (built at N_STREAMS_P=8)
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <memory>
+#include <vector>
+
+#include "Vavtp_rxmon_nx_wrap.h"
+#include "verilated.h"
+
+namespace {
+
+constexpr int kStreams = 8;
+constexpr int kIval = 2000;                     // the wrap's IVAL_CYC_P
+constexpr int kLctxTimeoutCycles = 64;
+constexpr int W_FMT_LO = 2;                     // LCTX words (KL_avtp_rx_monitor_ctx's record)
+constexpr int W_FMT_HI = 3;
+constexpr int W_DEPKT = 11;
+constexpr int W_ML = 16;
+constexpr int W_SI = 18;
+constexpr int W_SM = 19;
+constexpr int W_UF = 22;
+constexpr int W_FRX = 25;
+constexpr unsigned kPayloadBytes = 192;         // 6 events of 8 channels of 4 bytes (48 kHz, Milan v1.2 6.2)
+//! AAF PCM32 48 kHz with `ch` channels (Milan v1.2 Table 6.2): HI word {subtype, sv/ut/nsr, format, depth}
+constexpr uint32_t kFmtHi = 0x02050220u;
+constexpr uint32_t fmt_lo(unsigned ch) { return (ch << 22) | 0x6000u; }
+constexpr uint64_t fmt(unsigned ch) { return (static_cast<uint64_t>(kFmtHi) << 32) | fmt_lo(ch); }
+constexpr uint64_t kTalkerA = 0x0202DEADBEEF0001ull;  // the talker's stream_ids
+//! an AAF PCM format: the sample format (IEEE 1722-2016 Table 9), bit depth, channels and samples per frame
+struct Fmt {
+    uint8_t format;
+    uint8_t depth;
+    unsigned ch;
+    unsigned spf;
+    unsigned octets() const { return ch * spf * (format == 0x03 ? 3u : format == 0x04 ? 2u : 4u); }
+    uint32_t hi() const { return 0x02050000u | (static_cast<uint32_t>(format) << 8) | depth; }
+    uint32_t lo() const { return (ch << 22) | (spf << 12); }
+};
+constexpr Fmt kPcm32x8{0x02, 32, 8, 6};               // fmt(8): 192 octets
+constexpr uint64_t kTalkerB = 0x0202DEADBEEF0002ull;
+
+using Pdu = std::vector<uint8_t>;
+
+class FanOut {
+ public:
+    int run() {
+        bring_up();
+        two_inputs_on_one_stream();
+        three_inputs_on_one_stream();
+        unbinding_one_leaves_the_others_receiving();
+        each_input_judges_the_pdu_on_its_own();
+        two_streams_back_to_back();
+        all_eight_inputs_on_one_stream();
+        a_pdu_no_input_accepts_then_one_they_do();
+        a_frame_ending_on_its_match_beat_then_a_full_one();
+        a_burst_of_frames_ending_on_their_match_beat_to_eight_inputs();
+        a_dense_burst_to_eight_inputs_overflows_the_store();
+        a_pdu_off_its_inputs_frame_size_is_discarded_whole();
+        payload_tails_that_are_not_whole_beats();
+        frames_short_of_their_payload();
+        frames_of_eight_to_ten_beats();
+        a_dense_burst_with_bubbles_to_eight_inputs();
+        std::printf("\n======================================================================\n");
+        std::printf("FANOUT N=8: %ld checks, %ld failures\nRESULT: %s\n", checks, fails, fails ? "FAIL" : "PASS");
+        return fails ? 1 : 0;
+    }
+
+ private:
+    std::unique_ptr<Vavtp_rxmon_nx_wrap> dut = std::make_unique<Vavtp_rxmon_nx_wrap>();
+    long checks = 0;
+    long fails = 0;
+    std::array<long, kStreams> accepts{};
+    //! the depacketizer's output, one PDU per input that received it
+    std::array<std::vector<Pdu>, kStreams> got{};
+    std::array<Pdu, 16> cur{};
+    std::array<uint8_t, 2> seq{};               // the next sequence_num of talker A and B
+    unsigned pdu_no = 0;                        // tags each payload
+
+    void ck(const char* t, int s, long have, long exp) {
+        checks++;
+        if (have != exp) {
+            fails++;
+            std::printf("  [FAIL] %s: input %d got=%ld exp=%ld\n", t, s, have, exp);
+        } else {
+            std::printf("  [ ok ] %s: input %d = %ld\n", t, s, have);
+        }
+    }
+
+    void lo() { dut->clk = 0; dut->eval(); }
+    void hi() {
+        dut->clk = 1;
+        dut->eval();
+        if (dut->pdu_accept_p_o && dut->pdu_accept_idx_o < kStreams) accepts[dut->pdu_accept_idx_o]++;
+        if (dut->dp_tvalid_o) {
+            const unsigned u = dut->dp_tuser_o & 0xF;
+            for (int k = 0; k < 8; k++) cur[u].push_back(static_cast<uint8_t>(dut->dp_tdata_o >> (8 * k)));
+            if (dut->dp_tlast_o) {
+                if (u < kStreams) got[u].push_back(cur[u]);
+                cur[u].clear();
+            }
+        }
+    }
+    void cyc(int n = 1) { for (int i = 0; i < n; i++) { lo(); hi(); } }
+    void flush_iv() { cyc(kIval + 80); }
+
+    // the payload of the next PDU: every byte names the PDU it belongs to
+    Pdu payload() {
+        Pdu p(kPayloadBytes);
+        for (unsigned i = 0; i < kPayloadBytes; i++) p[i] = static_cast<uint8_t>(pdu_no * 29u + i * 3u + 1u);
+        pdu_no++;
+        return p;
+    }
+
+    // an AAF PDU of talker `t` (0 = A, 1 = B) with `ch` channels and the given payload, its sequence_num
+    // the talker's next unless `skip` numbers are left out first
+    std::vector<uint8_t> aaf(int t, unsigned ch, const Pdu& p, unsigned skip = 0) {
+        return aaf_as(t, Fmt{0x02, 32, ch, 6}, p, false, skip);
+    }
+    // the same in format `fm`, behind a C-VLAN tag when `vlan`; its stream_data_length is the payload's size
+    std::vector<uint8_t> aaf_as(int t, const Fmt& fm, const Pdu& p, bool vlan, unsigned skip = 0) {
+        const int o = vlan ? 18 : 14;
+        std::vector<uint8_t> f(static_cast<size_t>(o) + 24 + p.size(), 0);
+        for (int i = 0; i < 6; i++) { f[i] = 0x91; f[6 + i] = 0x02; }
+        if (vlan) { f[12] = 0x81; f[13] = 0x00; f[14] = 0x60; f[15] = 0x02; }   // PCP 3, VID 2
+        f[o - 2] = 0x22; f[o - 1] = 0xF0;
+        const uint64_t id = t == 0 ? kTalkerA : kTalkerB;
+        seq[t] = static_cast<uint8_t>(seq[t] + skip);
+        f[o + 0] = 0x02;                          // AAF
+        f[o + 1] = 0x81;                          // sv, tv
+        f[o + 2] = seq[t]++;
+        for (int i = 0; i < 8; i++) f[o + 4 + i] = static_cast<uint8_t>(id >> (8 * (7 - i)));
+        f[o + 12] = 0xA5; f[o + 13] = 0x5A; f[o + 14] = 0xC3; f[o + 15] = 0x3C;
+        f[o + 16] = fm.format;
+        f[o + 17] = 0x05 << 4;                    // 48 kHz
+        f[o + 18] = static_cast<uint8_t>(fm.ch);
+        f[o + 19] = fm.depth;
+        f[o + 20] = static_cast<uint8_t>(p.size() >> 8);
+        f[o + 21] = static_cast<uint8_t>(p.size());
+        for (size_t i = 0; i < p.size(); i++) f[o + 24 + i] = p[i];
+        return f;
+    }
+    // a payload of `n` octets, every byte naming the PDU it belongs to
+    Pdu payload(unsigned n) {
+        Pdu p(n);
+        for (unsigned i = 0; i < n; i++) p[i] = static_cast<uint8_t>(pdu_no * 29u + i * 3u + 1u);
+        pdu_no++;
+        return p;
+    }
+    // what the depacketizer emits for payload `p`: whole beats, the last zero-padded
+    static Pdu padded(const Pdu& p) {
+        Pdu q = p;
+        q.resize((p.size() + 7) / 8 * 8, 0);
+        return q;
+    }
+
+    // with `bubbles`, one to three idle cycles before six beats in ten (a fixed-seed generator)
+    bool bubbles = false;
+    uint32_t bub_x = 0x9E3779B9u;
+    uint32_t bub_next() { bub_x = bub_x * 1664525u + 1013904223u; return bub_x >> 8; }
+    void feed(const std::vector<uint8_t>& f, int headroom = 60) {
+        const int beats = static_cast<int>(f.size() + 7) / 8;
+        for (int b = 0; b < beats; b++) {
+            if (bubbles && bub_next() % 10 < 6) {
+                dut->s_tvalid_i = 0;
+                cyc(static_cast<int>(1 + bub_next() % 3));
+            }
+            uint64_t d = 0;
+            int vb = 0;
+            for (int k = 0; k < 8; k++) {
+                const size_t idx = static_cast<size_t>(b) * 8 + static_cast<size_t>(k);
+                if (idx < f.size()) { d |= static_cast<uint64_t>(f[idx]) << (8 * k); vb++; }
+            }
+            dut->s_tdata_i = d;
+            dut->s_tkeep_i = (vb == 8) ? 0xFF : ((1u << vb) - 1);
+            dut->s_tvalid_i = 1;
+            dut->s_tlast_i = (b == beats - 1);
+            cyc();
+        }
+        dut->s_tvalid_i = 0;
+        dut->s_tlast_i = 0;
+        cyc(headroom);
+    }
+
+    // bind input s to stream_id `id`, or unbind it: input 0 through its ACMP alias level, every other
+    // through its table entry
+    void bind(int s, uint64_t id, bool on) {
+        if (s == 0) {
+            dut->sid0_i = id;
+            dut->bound0_i = on;
+            cyc();
+        } else {
+            dut->tbl_wr_en_i = 1;
+            dut->tbl_wr_idx_i = static_cast<uint8_t>(s);
+            dut->tbl_wr_sid_i = on ? id : 0;
+            dut->tbl_wr_valid_i = on;
+            cyc();
+            dut->tbl_wr_en_i = 0;
+        }
+    }
+
+    uint32_t lctx_rd(int s, int w) {
+        dut->lctx_rd_en_i = 1;
+        dut->lctx_rd_addr_i = static_cast<uint8_t>((s << 5) | w);
+        for (int i = 0; i < kLctxTimeoutCycles; i++) {
+            cyc();
+            if (dut->lctx_rd_valid_o) {
+                dut->lctx_rd_en_i = 0;
+                const uint32_t v = dut->lctx_rd_data_o;
+                cyc();
+                return v;
+            }
+        }
+        dut->lctx_rd_en_i = 0;
+        ck("the window read answers", s, 0, 1);
+        return 0xDEADBEEF;
+    }
+
+    void lctx_wr(int s, int w, uint32_t v) {
+        dut->lctx_wr_en_i = 1;
+        dut->lctx_wr_addr_i = static_cast<uint8_t>((s << 5) | w);
+        dut->lctx_wr_data_i = v;
+        for (int i = 0; i < kLctxTimeoutCycles; i++) {
+            lo();
+            const bool rdy = dut->lctx_wr_rdy_o;
+            hi();
+            if (rdy) {
+                dut->lctx_wr_en_i = 0;
+                cyc();
+                return;
+            }
+        }
+        dut->lctx_wr_en_i = 0;
+        ck("the window write is taken", s, 0, 1);
+    }
+
+    // input s's current format: stream 0's is fmt0_i, every other's its LCTX words (written while unbound)
+    void set_format(int s, unsigned ch) {
+        if (s == 0) {
+            dut->fmt0_i = fmt(ch);
+            cyc();
+        } else {
+            lctx_wr(s, W_FMT_LO, fmt_lo(ch));
+            lctx_wr(s, W_FMT_HI, kFmtHi);
+        }
+    }
+    void set_format(int s, const Fmt& fm) {
+        if (s == 0) {
+            dut->fmt0_i = (static_cast<uint64_t>(fm.hi()) << 32) | fm.lo();
+            cyc();
+        } else {
+            lctx_wr(s, W_FMT_LO, fm.lo());
+            lctx_wr(s, W_FMT_HI, fm.hi());
+        }
+    }
+    // rebind inputs `ins` to talker `t` at format `fm` (each unbound while its format is written)
+    void rebind_as(std::initializer_list<int> ins, uint64_t id, const Fmt& fm) {
+        for (int s : ins) bind(s, id, false);
+        cyc(200);
+        for (int s : ins) set_format(s, fm);
+        for (int s : ins) bind(s, id, true);
+        cyc(200);
+    }
+
+    struct Snap {
+        std::array<long, kStreams> acc;
+        std::array<size_t, kStreams> pdus;
+        std::array<uint32_t, kStreams> frx;
+        std::array<uint32_t, kStreams> depkt;
+        std::array<uint32_t, kStreams> ddrop;
+        std::array<uint32_t, kStreams> sm;
+        std::array<uint32_t, kStreams> si;
+        std::array<uint32_t, kStreams> uf;
+    };
+    Snap snap() {
+        Snap n{};
+        n.acc = accepts;
+        for (int s = 0; s < kStreams; s++) {
+            n.pdus[s] = got[s].size();
+            n.frx[s] = lctx_rd(s, W_FRX);
+            n.depkt[s] = lctx_rd(s, W_DEPKT) & 0xFFFF;
+            n.ddrop[s] = (lctx_rd(s, W_DEPKT) >> 16) & 0xFFFF;
+            n.sm[s] = lctx_rd(s, W_SM);
+            n.si[s] = lctx_rd(s, W_SI);
+            n.uf[s] = lctx_rd(s, W_UF);
+        }
+        return n;
+    }
+
+    // the input received `n` new PDUs since `b`, each the sent payload byte for byte, in order
+    void received(const char* tag, int s, const Snap& b, const std::vector<Pdu>& sent) {
+        char t[160];
+        std::snprintf(t, sizeof t, "%s accept verdicts", tag);
+        ck(t, s, accepts[s] - b.acc[s], static_cast<long>(sent.size()));
+        std::snprintf(t, sizeof t, "%s payloads reach the depacketizer's output under the input's index", tag);
+        ck(t, s, static_cast<long>(got[s].size() - b.pdus[s]), static_cast<long>(sent.size()));
+        long exact = 0;
+        for (size_t k = 0; k < sent.size() && b.pdus[s] + k < got[s].size(); k++)
+            if (got[s][b.pdus[s] + k] == sent[k]) exact++;
+        std::snprintf(t, sizeof t, "%s payloads equal the sent ones, byte for byte, in order", tag);
+        ck(t, s, exact, static_cast<long>(sent.size()));
+        std::snprintf(t, sizeof t, "%s FRAMES_RX counts them", tag);
+        ck(t, s, lctx_rd(s, W_FRX) - b.frx[s], static_cast<long>(sent.size()));
+        std::snprintf(t, sizeof t, "%s the DEPKT tally counts them", tag);
+        ck(t, s, (lctx_rd(s, W_DEPKT) & 0xFFFF) - b.depkt[s], static_cast<long>(sent.size()));
+    }
+
+    void nothing(const char* tag, int s, const Snap& b) {
+        char t[160];
+        std::snprintf(t, sizeof t, "%s no accept verdict", tag);
+        ck(t, s, accepts[s] - b.acc[s], 0);
+        std::snprintf(t, sizeof t, "%s no payload", tag);
+        ck(t, s, static_cast<long>(got[s].size() - b.pdus[s]), 0);
+        std::snprintf(t, sizeof t, "%s FRAMES_RX unchanged", tag);
+        ck(t, s, lctx_rd(s, W_FRX) - b.frx[s], 0);
+    }
