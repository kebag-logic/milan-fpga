+    f.round("FAN-UNBIND", 4, {0, 2}, {1});
+    dut->final();
+    std::printf("fanout: %u failed, %u host timeouts, %u ms\n", f.failed(), half.host_timeouts(), half.ms());
+    return f.failed() == 0 && half.host_timeouts() == 0 ? 0 : 1;
+}
