+bool probe_tx_answer(const twin::Frame& sent, twin::Frame* answer) {
+    std::uint16_t t = 0;
+    std::size_t at = 0;
+    if (!twin::ethertype(sent, &t, &at) || t != twin::kEtherAvtp || at != 14 || sent.size() < 70) return false;
