 +    //! ADD (0x002C) or REMOVE (0x002D) of `set` on Stream Port `ty` `port`
 +    long maprec_edit(uint16_t cmd, uint16_t ty, const MapSet& set, uint16_t port = 0) {
 +        std::vector<uint8_t> pl = {
 +            static_cast<uint8_t>(ty >> 8), static_cast<uint8_t>(ty),
 +            static_cast<uint8_t>(port >> 8), static_cast<uint8_t>(port),
 +            0x00, static_cast<uint8_t>(set.size()), 0x00, 0x00};
 +        for (const std::array<uint16_t, 4>& m : set)
