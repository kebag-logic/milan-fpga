 +    //! max(clusters, STREAM_OUTPUT * 8)
 +    size_t maprec_in_entries(uint16_t port = 0) {
 +        return static_cast<size_t>(port_clusters(0x000E, port));
 +    }
 +    size_t maprec_out_entries(uint16_t port = 0) {
 +        long outputs = 0;
 +        while (desc_of(0x0006, static_cast<unsigned>(outputs)) != nullptr) outputs++;
 +        return static_cast<size_t>(std::max(port_clusters(0x000F, port), outputs * 8));
 +    }
 +
 +    //! the window the codec frames for `records`, every other record erased
 +    bool maprec_codec_window(const std::vector<std::string>& records,
 +                             std::vector<uint8_t>* area, RecAt* at) {
 +        std::vector<std::pair<uint32_t, uint32_t> > tables;
 +        uint32_t len = 0;
 +        std::string why;
 +        const bool ok = frame_a_window(AEMI_CFG_C, records, area, &tables, &len, at, &why);
 +        if (!ok) printf("  [i]    %s\n", why.c_str());
 +        return ok && (len == nm_img_len) && (tables == nm_tables);
 +    }
 +
 +    //! re-seal the record at area offset `off` after an edit of its header:
 +    //! its crc16 (CCITT-FALSE, FASTCONNECT 6.1) over the header without the
 +    //! crc field and the payload
 +    static void maprec_reseal(std::vector<uint8_t>* area, uint32_t off) {
 +        std::vector<uint8_t>& a = *area;
 +        const uint32_t plen = (static_cast<uint32_t>(a[off + 4]) << 8) | a[off + 5];
 +        uint16_t crc = 0xFFFF;
 +        for (uint32_t i = 0; i < 8 + plen; i++) {
 +            if (i == 6 || i == 7) continue;
 +            crc ^= static_cast<uint16_t>(a[off + i] << 8);
 +            for (int b = 0; b < 8; b++)
 +                crc = (crc & 0x8000) ? static_cast<uint16_t>((crc << 1) ^ 0x1021)
 +                                     : static_cast<uint16_t>(crc << 1);
 +        }
 +        a[off + 6] = static_cast<uint8_t>(crc >> 8);
 +        a[off + 7] = static_cast<uint8_t>(crc);
 +    }
 +
 +    //! a field of a public vector, held in one machine word or in several
 +    static uint32_t vfield(uint64_t v, unsigned lsb, unsigned n) {
 +        return static_cast<uint32_t>((v >> lsb) & ((1ull << n) - 1));
 +    }
 +    template <std::size_t W>
 +    static uint32_t vfield(const VlWide<W>& v, unsigned lsb, unsigned n) {
 +        return (v[lsb / 32] >> (lsb % 32)) & static_cast<uint32_t>((1ull << n) - 1);
 +    }
 +
 +    //! clock until the window holds `want` and PP_STAT's pend has fallen;
 +    //! the cycles that took, or -1 at `budget`
 +    long maprec_wait_for_the_window(const std::vector<uint8_t>& want, long budget) {
 +        for (long c = 0; c < budget; c += 1000) {
 +            for (int i = 0; i < 1000; i++) step();
 +            if (nmem == want && !(axi_read(A_PP_STAT) & kPpPend)) return c + 1000;
 +        }
 +        for (size_t i = 0; i < nmem.size() && i < want.size(); i++)
 +            if (nmem[i] != want[i]) {
 +                printf("  [i]    the window differs from the codec's first at area "
 +                       "byte %zu: %02x, want %02x\n", i, nmem[i], want[i]);
 +                break;
 +            }
 +        return -1;
 +    }
 +
 +    //! the reset half of a power cycle: the datapath reset, the window
 +    //! memory's bytes KEPT and its bus state dropped (a burst or a write the
 +    //! last boot left owed is gone with the power), then the firmware's load
 +    void maprec_cut_the_power() {
 +        nm_busy = false;
 +        nm_left = 0;
 +        nm_wpend = false;
 +        nm_wwait = 0;
 +        nm_rwait = 0;
 +        bring_the_datapath_out_of_reset();
 +        axi_write(A_ADP_EIDHI, 0x020000FF);
 +        axi_write(A_ADP_EIDLO, 0xFE000001);
 +        load_the_window_in_memory();
 +    }
 +
 +    //! THE PLANTED POWER CYCLE: a reset of the whole datapath with the window
 +    //! memory kept, the firmware's load of that memory, and the walk. The D3
 +    //! walk's roll-back terminal is planted (dynmap_probes.vlt) when
 +    //! `d3_rolled_back`; nothing else is touched. Returns the clocks from the
 +    //! combined restore_done to the end of the map restore, or -1. On the
 +    //! first clock the map restore holds, PP_STAT is read once into
 +    //! maprec_mid_stat (left 0 when the hold ended during that read).
 +    long maprec_go_to_end = -1;   //! the last power cycle's PP_CTRL[1] to map-restore end
 +    uint32_t maprec_mid_stat = 0;
 +    long maprec_power_cycle(const char* tag, bool d3_rolled_back) {
 +        maprec_cut_the_power();
 +        if (d3_rolled_back)
 +            dut->rootp->milan_datapath__DOT__pp_shadow__DOT__u_pp__DOT__u_aecp__DOT__u_d3__DOT__rb_r = 1;
 +        axi_write(kPpCtrl, axi_read(kPpCtrl) | 0x2u);
 +        const long t_go = nm_cycle;
 +        long t_done = -1;
 +        long t_end = -1;
 +        bool mid_read = false;
 +        maprec_mid_stat = 0;
 +        while (nm_cycle - t_go < 6000000 && t_end < 0) {
 +            step();
 +            if (t_done < 0 && dut->rootp->milan_datapath__DOT__pp_restore_done_w) t_done = nm_cycle;
 +            if (t_done >= 0 && !mid_read && dut->rootp->milan_datapath__DOT__amr_rs_hold_r) {
 +                mid_read = true;
 +                const uint32_t s = axi_read(A_PP_STAT);
 +                if (dut->rootp->milan_datapath__DOT__amr_rs_hold_r) maprec_mid_stat = s;
 +            }
 +            if (t_done >= 0 && !dut->rootp->milan_datapath__DOT__amr_rs_hold_r) t_end = nm_cycle;
 +        }
 +        char w[200];
 +        snprintf(w, sizeof w, "[MAPREC] %s: the restore reached its terminal and "
 +                 "the map restore ended", tag);
 +        ck(w, static_cast<unsigned long>(t_end >= 0), 1);
 +        for (int c = 0; c < 64; c++) step();
 +        maprec_go_to_end = (t_end >= 0) ? t_end - t_go : -1;
 +        printf("  [i]    %s: the map restore held the faces %ld clocks after "
 +               "restore_done, %ld after PP_CTRL[1]\n", tag,
 +               (t_end >= 0) ? t_end - t_done : -1, maprec_go_to_end);
 +        return (t_end >= 0) ? t_end - t_done : -1;
 +    }
 +
 +    long maprec_pages = 0;
 +    void maprec_grade_page(const char* tag, uint16_t ty, const MapSet& want,
 +                           uint16_t port = 0) {
 +        const AmapPage p = get_audio_map_page0(ty, port);
 +        printf("  [i]    %s: status %ld, %ld mapping(s)", tag, p.status, p.nmappings);
 +        for (const std::array<uint16_t, 4>& m : p.rec)
 +            printf(" s%u.c%u->o%u.c%u", static_cast<unsigned>(m[0]),
 +                   static_cast<unsigned>(m[1]), static_cast<unsigned>(m[2]),
 +                   static_cast<unsigned>(m[3]));
 +        printf("\n");
 +        char w[200];
 +        snprintf(w, sizeof w, "[MAPREC] %s: GET_AUDIO_MAP SUCCESS", tag);
 +        ck(w, static_cast<unsigned long>(p.status), 0);
 +        snprintf(w, sizeof w, "[MAPREC] %s: number_of_mappings", tag);
 +        ck(w, static_cast<unsigned long>(p.nmappings),
 +           static_cast<unsigned long>(want.size()));
 +        snprintf(w, sizeof w, "[MAPREC] %s: the mappings are the expected list", tag);
 +        ck(w, static_cast<unsigned long>(p.rec == want), 1);
 +        maprec_pages++;
 +    }
 +
 +    //! PP_STAT after a completed restore: done and not busy, and the
 +    //! composed fail and blank (D3 3 rule 7, 8.7)
 +    void maprec_grade_stat(const char* tag, bool fail, bool blank) {
 +        const uint32_t s = axi_read(A_PP_STAT);
 +        printf("  [i]    %s: PP_STAT %08x\n", tag, s);
 +        char w[200];
 +        snprintf(w, sizeof w, "[MAPREC] %s: PP_STAT done 1, busy 0", tag);
 +        ck(w, static_cast<unsigned long>((s & (kPpDone | kPpBusy)) == kPpDone), 1);
 +        snprintf(w, sizeof w, "[MAPREC] %s: PP_STAT fail %u", tag, fail ? 1u : 0u);
 +        ck(w, static_cast<unsigned long>((s & kPpFail) ? 1 : 0), fail ? 1u : 0u);
 +        snprintf(w, sizeof w, "[MAPREC] %s: PP_STAT blank %u", tag, blank ? 1u : 0u);
 +        ck(w, static_cast<unsigned long>((s & kPpBlank) ? 1 : 0), blank ? 1u : 0u);
 +    }
 +
 +    //! a first boot over a window whose every record is erased; false when
 +    //! the window could not be loaded
 +    bool maprec_first_boot() {
 +        bring_the_datapath_out_of_reset();
 +        axi_write(A_ADP_EIDHI, 0x020000FF);
 +        axi_write(A_ADP_EIDLO, 0xFE000001);
 +        std::string why;
 +        const bool loaded = load_the_saved_state_window(AEMI_CFG_C, {}, &why);
 +        ck("[MAPREC] a first boot over an erased window", static_cast<unsigned long>(loaded), 1);
 +        if (!loaded) {
 +            printf("  [i]    %s\n", why.c_str());
 +            return false;
 +        }
 +        start_the_boot_restore_walk();
 +        for (int c = 0; c < 2000; c++) step();
 +        return true;
 +    }
