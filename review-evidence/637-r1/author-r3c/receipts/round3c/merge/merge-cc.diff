 +    static std::string map_record(uint32_t rid, const MapSet& set, size_t entries) {
 +        char b[16];
 +        snprintf(b, sizeof b, "0x%02x=", rid);
 +        std::string h = b;
 +        for (size_t e = 0; e < entries; e++)
 +            for (int f = 0; f < 4; f++) {
