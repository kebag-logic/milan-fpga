+def aligned_cpu_ranges(count: int, width: int) -> tuple[str, ...]:
+    """`count` adjacent ranges of `width` CPUs from CPU 0, each aligned to its width."""
+    return tuple(f"{n * width}-{n * width + width - 1}" for n in range(count))
