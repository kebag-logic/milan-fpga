+    // the Leave of each still names the stream_id it declared
+    for (int k = 0; k < kSinks; ++k) {
+      h.ctl(true, k, sink_record(9, k));
+      SinkRecord r = sink_record(10, k);
+      sid[k] = r.sid;
+      h.ctl(true, k, r);
+      h.advertise(r);
+    }
+    h.clear_logs();
+    h.tick();
+    expect_leaves("WK12", held);
+    txla_walk();
+    expect_listener("WK12", sid);
+  }
 };
 
