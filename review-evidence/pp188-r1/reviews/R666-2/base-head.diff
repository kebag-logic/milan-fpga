+        (NTFY, LC_DEFER, "  assign lk_defer_w   = ((n_st_r == N_IDLE) && rgy_new_w && rgy_state_i);\n"),),
+        ("LC2:",)),
+    Mutant("lock_expiry_at_holder_read", INDEX, (
