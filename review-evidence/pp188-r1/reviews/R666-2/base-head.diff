+  const std::vector<LockWant> straddled = {{MAC_C, 0, 0x00010000u, EID_X}, {MAC_X, 0, UNLOCK, 0},
+                                       {MAC_C, 1, UNLOCK, 0}, {MAC_X, 1, UNLOCK, 0}};
