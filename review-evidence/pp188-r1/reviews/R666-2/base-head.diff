+  //! TAIL's byte @112
+  auto copied = [&](const std::vector<uint8_t>& w, size_t upto) {
+    bool ok = h.w32(12) == 0;
+    for (size_t k = 0; k < upto; k += 4)
+      ok = ok && h.w32(uint32_t(16 + k))
+                     == (uint32_t(w[k]) << 24 | uint32_t(w[k + 1]) << 16
+                         | uint32_t(w[k + 2]) << 8 | w[k + 3]);
+    return ok && ((h.w32(16 + 112) >> 24) & 0xFFu) == w[112];
+  };
