+    d->ev_cmd_class_i = 7;
+    d->ev_cmd_type_i = 0x0005;
+    d->ev_cmd_index_i = 1;
+    d->ev_cmd_arg0_i = 0;
+    d->ev_cmd_arg1_i = 0;
+    d->ev_cmd_excl_eid_i = 0x7777000000000007ull;
+    d->ev_cmd_i = 1;
