index 0000000000..eb8ab5aeeb
--- /dev/null
+++ b/tb/verilator/usbnet/egress_usb.py
@@ -0,0 +1,130 @@
+#!/usr/bin/env python3
+# SPDX-FileCopyrightText: 2026 Kebag Logic
+# SPDX-License-Identifier: CERN-OHL-W-2.0
+"""Add USB interference to the unchanged control service egress queue.
+
+A longest injected frame precedes every wire busy period. This envelope
+ignores the host token bucket, conservatively. The injection occupies no
+store-and-forward slot, but delays its releases and hence mailbox tails.
+The baseline replay must first reproduce every recorded departure exactly.
+"""
+from __future__ import annotations
+
+import dataclasses
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+SERVICE = HERE.parent / "ctrl_service_budget"
+sys.path.insert(0, str(SERVICE))
+import egress_mii as base
+import receipt_regrade
+
+#: Rounded up from 1539 wire octets at 100 Mb/s, including inter-frame gap.
+INJECT_PS = 123_200_000
+#: Filled by the shipping-chain measurement, conservatively rounded upward.
+HANDSHAKE_PS = 260_000
+
+
+class Queue(base.Queue):
+    """The inherited queue with one lower-priority frame per busy period."""
+
+    def __init__(self, p: base.Params, phase_ps: int = 0) -> None:
+        super().__init__(p, phase_ps)
+        self.injections = 0
+
+    def complete(self, t: int, length: int, control: bool) -> None:
+        """A grant just before the first waiting datapath frame delays that busy period."""
+        if t >= self.wire_free:
+            self.wire_free = t + INJECT_PS + HANDSHAKE_PS
+            self.injections += 1
+        super().complete(t, length, control)
+
+
+def replay(recs: list[base.Record], holds: list, p: base.Params, phase_ps: int) -> tuple[list, int]:
+    """Replay unchanged commit times, with byte-level backpressure from injection.
+
+    The baseline's small host-acknowledgement offsets are recovered first.
+    They are then kept, never re-fitted to the delayed USB departures.
+    """
+    q0, q = base.Queue(p, 0), Queue(p, phase_ps)
+    windows, free0, free = base.hold_windows(holds), 0, 0
+    tails = []
+    for r in recs:
+        e0 = max(r.commit + base.MBX_VISIBLE, free0) + base.MBX_LEAD
+        offset = next((d for d in base.ANCHOR if base.stream(q0.clone(), r, e0 + d, windows) == r.wire), None)
+        if offset is None:
+            raise ValueError(f"cannot reproduce baseline mailbox departure at {r.wire}")
+        free0 = base.stream(q0, r, e0 + offset, windows) + base.MBX_AFTER
+        start = max(r.commit + base.MBX_VISIBLE, free) + base.MBX_LEAD + offset
+        tails.append(base.stream(q, r, start, windows))
+        free = tails[-1] + base.MBX_AFTER
+    q.advance((free + 1) * p.sys_ps + 64 * p.wire_ps(1514) + 2 * p.gptp_period_ps // 1000)
+    out = {(d[0], d[1]): d for d in q.departed}
+    return [(tail, out[tail, r.ch][3], out[tail, r.ch][4]) for tail, r in zip(tails, recs)], q.injections
+
+
+def free_space(recs: list, tails: list, p: base.Params) -> list:
+    """Refuse a commit lacking space, before claiming the census carries.
+
+    Each record retires two system cycles after its last byte (KL_mbx_tx DONE).
+    This checks successful commits; exact tail equality is additionally required
+    for other readers and failed free-space tests not printed in a trace.
+    """
+    seen: dict = {}
+    fails = []
+    for i in sorted(range(len(recs)), key=lambda j: recs[j].commit):
+        r = recs[i]
+        previous = seen.setdefault(r.ch, [])
+        used = sum(recs[j].words for j in previous if tails[j][0] + base.MBX_AFTER >= r.commit)
+        if used + r.words > p.ring_words[r.ch]:
+            fails.append(dict(commit=r.commit, ch=r.ch, used=used, need=r.words, capacity=p.ring_words[r.ch]))
+        previous.append(i)
+    return fails
+
+
+def grade(text: str, p: base.Params) -> dict:
+    """All records, the inherited held-egress disposition, and eight SR phases."""
+    baseline = base.grade_case(text, p)
+    if "refused" in baseline or baseline["agree_ps"]:
+        return dict(refused="baseline does not reproduce", baseline=baseline)
+    log = base.parse(text)
+    recs = base.records(log)
+    base.mark_held(recs, base.hold_windows(log["holds"]), [r.egress[4] // p.sys_ps + 1 for r in recs])
+    worst, changed, fails, injected = 0, 0, [], 0
+    for phase in range(base.PHASES):
+        run, count = replay(recs, log["holds"], p, phase * p.sr_period_ps // base.PHASES)
+        injected = max(injected, count)
+        if phase == 0:
+            changed = sum(t != r.wire for r, (t, _, _) in zip(recs, run))
+            fails = free_space(recs, run, p)
+        worst = max([worst] + [end - r.commit * p.sys_ps for r, (_, _, end) in zip(recs, run) if not r.held])
+    return dict(records=len(recs), held=sum(r.held for r in recs), wait_ps=worst, changed_tails=changed,
+                free_space_failures=fails, injections=injected, baseline=baseline)
+
+
+def packet(packet_dir: Path, output: Path) -> int:
+    """Read every manifest-bound case and publish a replay table."""
+    census = json.loads((packet_dir / "census.json").read_text())
+    p, rows = base.params(base.arty_spec()), {}
+    for row in census["cases"]:
+        path = packet_dir / row["manifest"]
+        if hashlib.sha256(path.read_bytes()).hexdigest() != row["sha256"]:
+            raise ValueError("manifest hash mismatch: " + row["case"])
+        manifest = json.loads(path.read_text())
+        raw = receipt_regrade.read_parts(path.parent, manifest["extract"], census.get("part_limit", 14_000_000) + 1)
+        rows[row["case"]] = grade(raw.decode(), p)
+        output.write_text(json.dumps(rows, indent=2) + "\n")
+        print(row["case"], json.dumps(rows[row["case"]]), flush=True)
+    worst = max(r.get("wait_ps", 0) for r in rows.values())
+    bound_us = (worst + base.gptp_wire_ps(p)) * base.MARGIN / 1_000_000 + base.MII_FIXED_NS / 1000
+    carry = all(not r.get("refused") and r["changed_tails"] == 0 and not r["free_space_failures"]
+                for r in rows.values())
+    print(f"EGRESS USB {bound_us:.3f} us; census carries {carry}; cases {len(rows)}", flush=True)
+    return int(bound_us > base.BOUND_US or not carry)
+
+
+if __name__ == "__main__":
+    sys.exit(packet(Path(sys.argv[1]), Path(sys.argv[2])))
diff --git a/tb/verilator/usbnet/sim_egress.cpp b/tb/verilator/usbnet/sim_egress.cpp
new file mode 100644
index 0000000000..84422216c4
--- /dev/null
+++ b/tb/verilator/usbnet/sim_egress.cpp
@@ -0,0 +1,147 @@
+// SPDX-FileCopyrightText: 2026 Kebag Logic
+// SPDX-License-Identifier: CERN-OHL-W-2.0
+// Injection handshake on the production tap and converted MII MAC chain.
+// A fully checked frame waits with injection disabled. Once granted, a
+// datapath frame arrives behind it. Measure grant to datapath acceptance,
+// subtracting only the injected wire frame (not its inter-frame gap).
+#include "Vusbnet_egress_chain.h"
+#include "verilated.h"
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <vector>
+
+namespace {
+constexpr std::uint64_t kSysPs = 12500;
+constexpr std::uint64_t kDpPs = 20000;
+constexpr std::uint64_t kEthPs = 40000;
+constexpr std::uint64_t kOctetPs = 80000;
+constexpr unsigned kPhases = 8;
+
+void require(bool yes, const char* why) {
+    if (!yes) { std::fprintf(stderr, "FAIL: %s\n", why); std::exit(1); }
+}
+
+class Run {
+ public:
+    Run(unsigned dp, unsigned eth) : dut_(std::make_unique<Vusbnet_egress_chain>()),
+        dp_next_(dp * kDpPs / kPhases + kDpPs / 2), eth_next_(eth * kEthPs / kPhases + kEthPs / 2) {}
+    std::uint64_t measure(unsigned len);
+ private:
+    std::unique_ptr<Vusbnet_egress_chain> dut_;
+    std::uint64_t now_ = 0;
+    std::uint64_t sys_next_ = kSysPs / 2;
+    std::uint64_t dp_next_;
+    std::uint64_t eth_next_;
+    std::uint64_t grant_ = 0;
+    std::uint64_t hi_take_ = 0;
+    std::uint64_t low_end_ = 0;
+    std::vector<std::uint16_t> input_;
+    std::size_t word_ = 0;
+    unsigned high_pos_ = 0;
+    unsigned frames_ = 0;
+    unsigned nibbles_ = 0;
+    unsigned low_nibbles_ = 0;
+    bool enabled_ = false;
+    bool previous_en_ = false;
+    bool blocked_ = false;
+    void step();
+    void packet(unsigned kind, const std::vector<std::uint8_t>& bytes);
+};
+
+void Run::packet(unsigned kind, const std::vector<std::uint8_t>& bytes) {
+    input_.push_back(bytes.size()); input_.push_back(kind);
+    for (std::size_t i = 0; i < bytes.size(); i += 2)
+        input_.push_back(bytes[i] | (i + 1 < bytes.size() ? unsigned(bytes[i + 1]) << 8 : 0));
+}
+
+void Run::step() {
+    now_ = std::min({sys_next_, dp_next_, eth_next_});
+    const bool sr = sys_next_ == now_ && !dut_->sys_clk;
+    const bool sf = sys_next_ == now_ && dut_->sys_clk;
+    const bool dr = dp_next_ == now_ && !dut_->dp_clk;
+    const bool df = dp_next_ == now_ && dut_->dp_clk;
+    const bool er = eth_next_ == now_ && !dut_->eth_tx_clk;
+    const bool dn = sr && dut_->dn_valid && dut_->dn_ready;
+    const bool dp = dr && dut_->dp_tvalid && dut_->dp_tready;
+    if (sr && grant_ && dut_->hi_valid && !dut_->hi_ready) blocked_ = true;
+    if (sr && dut_->hi_valid && dut_->hi_ready && !hi_take_) hi_take_ = now_;
+    if (sys_next_ == now_) { dut_->sys_clk = !dut_->sys_clk; sys_next_ += kSysPs / 2; }
+    if (dp_next_ == now_) { dut_->dp_clk = !dut_->dp_clk; dp_next_ += kDpPs / 2; }
+    if (eth_next_ == now_) {
+        dut_->eth_tx_clk = !dut_->eth_tx_clk; dut_->eth_rx_clk = dut_->eth_tx_clk;
+        eth_next_ += kEthPs / 2;
+    }
+    dut_->eval();
+    if (dn) ++word_;
+    if (dp) high_pos_ += 8;
+    if (dut_->active && !grant_) grant_ = now_;
+    if (sf) {
+        dut_->dn_valid = word_ < input_.size();
+        dut_->dn_data = word_ < input_.size() ? input_[word_] : 0;
+        dut_->inject_enable = enabled_;
+    }
+    if (df) {
+        dut_->dp_tvalid = grant_ && high_pos_ < 64;
+        dut_->dp_tlast = high_pos_ == 56;
+        dut_->dp_tkeep = 255;
+        dut_->dp_tdata = 0x5555555555555555ULL;
+    }
+    dut_->eval();
+    if (er) {
+        if (dut_->gmii_tx_en) ++nibbles_;
+        if (!dut_->gmii_tx_en && previous_en_) {
+            ++frames_;
+            if (frames_ == 1) { low_end_ = now_; low_nibbles_ = nibbles_; }
+            else require(nibbles_ == 2 * (8 + 64 + 4), "datapath frame length on MII pads");
+            nibbles_ = 0;
+        }
+        previous_en_ = dut_->gmii_tx_en;
+    }
+}
+
+std::uint64_t Run::measure(unsigned len) {
+    dut_->sys_rst = dut_->dp_rst = dut_->eth_phy_rst = 1;
+    while (now_ < 400000) step();
+    dut_->sys_rst = dut_->dp_rst = dut_->eth_phy_rst = 0;
+    while (now_ < 2000000) step();
+    const std::vector<std::uint8_t> host = {2, 0x78, 0x56, 0x34, 0x12, 0x90};
+    std::vector<std::uint8_t> station = host;
+    station.insert(station.end(), {15, 0, 0, 0, 1, 0, 100, 0, 0, 0});
+    packet(0x4e02, station);
+    std::vector<std::uint8_t> frame(len, 0x55);
+    std::fill_n(frame.begin(), 6, 0xff);
+    std::copy(host.begin(), host.end(), frame.begin() + 6);
+    frame[12] = 8; frame[13] = 0;
+    packet(0x4e01, frame);
+    while (word_ < input_.size() && now_ < 100000000) step();
+    require(word_ == input_.size(), "checked network frame accepted");
+    const auto settle = now_ + 1000000;
+    while (now_ < settle) step();
+    require(!grant_ && !frames_, "disabled injection remains pending");
+    enabled_ = true;
+    const auto limit = now_ + 500000000;
+    while (now_ < limit && frames_ < 2) step();
+    require(frames_ == 2 && grant_ && hi_take_, "both injected and datapath frames depart");
+    require(blocked_, "datapath is held behind injection");
+    require(low_nibbles_ == 2 * (8 + std::max(len, 60u) + 4), "injected length on MII pads");
+    require(hi_take_ >= low_end_ - kEthPs, "datapath waits for injected PHY completion");
+    const auto wire = (8 + std::max(len, 60u) + 4) * kOctetPs;
+    const auto elapsed = hi_take_ - grant_;
+    return elapsed > wire ? elapsed - wire : 0;
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+    Verilated::commandArgs(argc, argv);
+    for (const unsigned len : {14u, 60u, 64u, 90u, 127u, 512u, 1514u, 1515u})
+        for (unsigned d = 0; d < kPhases; ++d)
+            for (unsigned e = 0; e < kPhases; ++e) {
+                Run run(d, e);
+                std::printf("HANDSHAKE %u %u %u %llu\n", len, d, e,
+                            static_cast<unsigned long long>(run.measure(len)));
+            }
