#!/usr/bin/python3
import os,sys,time
log='$MANAGEMENT/2026-09-23/disk-cleanup.log'
with open(log,'a') as f:
 for arg in sys.argv[1:]:
  if not arg.startswith('-'):
   f.write(time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime())+' [A855 r7] BEFORE rm '+os.path.abspath(arg)+'\n')
 f.flush();os.fsync(f.fileno())
os.execv('/usr/bin/rm',['/usr/bin/rm',*sys.argv[1:]])
