+// same(), its last byte compared where it is called (#665): a record's comparisons that fail, a source or a sink
+// each, almost all differ in that byte, so they cost no call; only one whose last byte matches calls same() for the
+// bytes before it.
+static inline bool matches(const uint8_t *a, const uint8_t *b, unsigned n)
+{
+    return a[n - 1u] == b[n - 1u] && same(a, b, n - 1u);
+}
