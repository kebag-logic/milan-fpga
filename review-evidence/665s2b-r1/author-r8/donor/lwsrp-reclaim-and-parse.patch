From a9db3538df9b3b3f98a806c41854da4fdc62bda4 Mon Sep 17 00:00:00 2001
From: hackerman-kl <hackerman-kl@kebag-logic.com>
Date: Thu, 29 Oct 2026 10:53:52 +0100
Subject: [PATCH 1/2] Skip the reclaim walk while no attribute can be
 reclaimed, and clear a decoded value only on the delivering parse pass

---
 src/core/mrp_mad.c | 31 +++++++++++++++++++++++++++++--
 src/core/mrp_pdu.c |  8 +++++++-
 2 files changed, 36 insertions(+), 3 deletions(-)

diff --git a/src/core/mrp_mad.c b/src/core/mrp_mad.c
index b0d4156..f9d9584 100644
--- a/src/core/mrp_mad.c
+++ b/src/core/mrp_mad.c
@@ -106,6 +106,9 @@ struct mrp_port_state {
     struct mrp_map_work *map_head;
     struct mrp_map_work *map_tail;
     struct mrp_attr_inst *attrs;      /* linked list of attribute instances */
+    /* An attribute may be reclaimable: set wherever one is created or its
+     * states change to reclaimable ones, cleared by a reclaim that walked. */
+    bool                 reclaim_due;
     /* LeaveAll timer: fires MRP_EVENT_LEAVEALLTIMER on expiry */
     struct shlan_timer          la_timer;
     /* PeriodicTransmission timer: fires MRP_EVENT_PERIODICTIMER on expiry */
@@ -439,6 +442,22 @@ uint32_t mrp_attr_registered_ports(const struct mrp_app *app,
     return mask;
 }
 
+/* Table 10-3 note 11: neither declared nor registered, and quiescent. */
+static bool attr_reclaimable(const struct mrp_attr_inst *a)
+{
+    return a->reg == MRP_REG_STATE_MT &&
+           (a->appl == MRP_APPL_STATE_VO || a->appl == MRP_APPL_STATE_AO || a->appl == MRP_APPL_STATE_QO);
+}
+
+/* Record that the port may hold a reclaimable attribute: every change of an
+ * attribute's states passes here, so a port without the mark holds none. */
+static void note_states(struct mrp_port_state *ps, const struct mrp_attr_inst *a)
+{
+    if (attr_reclaimable(a)) {
+        ps->reclaim_due = true;
+    }
+}
+
 static struct mrp_attr_inst *find_attr(struct mrp_port_state *ps, const struct mrp_app_ops *ops,
                                    uint8_t type, const void *val)
 {
@@ -493,6 +512,7 @@ static struct mrp_attr_inst *get_or_create_attr(struct mrp_app *app,
     a->pending_tx = TX_MSG_NONE;
     a->next       = ps->attrs;
     ps->attrs     = a;
+    note_states(ps, a);
 
     a->leave_timer_arg.app     = app;
     a->leave_timer_arg.ai      = a;
@@ -734,9 +754,11 @@ static int deliver_event_changed(struct mrp_app *app, struct mrp_port_state *ps,
     if (r < 0) {
         ai->appl = appl_from;
         ai->pending_tx = pending_from;
+        note_states(ps, ai);
         observe(app, ai, ev, port_id, appl_from, reg_from);
         return r;
     }
+    note_states(ps, ai);
     // Table 10-3 note 6: receiving an event can request a transmit too.
     switch (ai->appl) {
     case MRP_APPL_STATE_VN: case MRP_APPL_STATE_AN:
@@ -875,6 +897,7 @@ static void on_leave_timer(void *arg)
     enum mrp_reg_state  reg_from  = a->ai->reg;
 
     (void)reg_event(a->app, a->ai, MRP_EVENT_LEAVETIMER, a->port_id, false);
+    note_states(&priv_of(a->app)->ports[a->port_id], a->ai);
     observe(a->app, a->ai, MRP_EVENT_LEAVETIMER, a->port_id,
             appl_from, reg_from);
 }
@@ -1106,12 +1129,16 @@ unsigned mrp_reclaim(struct mrp_app *app, uint8_t port_id)
     if (ps->in_send || ps->prepared_pdu) {
         return 0;
     }
+    /* No state changed to reclaimable ones since the last walk: none holds them. */
+    if (!ps->reclaim_due) {
+        return 0;
+    }
+    ps->reclaim_due = false;
     unsigned count = 0;
     struct mrp_attr_inst **link = &ps->attrs;
     while (*link) {
         struct mrp_attr_inst *a = *link;
-        if (a->reg == MRP_REG_STATE_MT &&
-            (a->appl == MRP_APPL_STATE_VO || a->appl == MRP_APPL_STATE_AO || a->appl == MRP_APPL_STATE_QO)) {
+        if (attr_reclaimable(a)) {
             *link = a->next;
             shlan_timer_remove(&a->leave_timer);
             shlan_free(a);
diff --git a/src/core/mrp_pdu.c b/src/core/mrp_pdu.c
index c321c9b..e9916df 100644
--- a/src/core/mrp_pdu.c
+++ b/src/core/mrp_pdu.c
@@ -190,7 +190,13 @@ static int parse_pass(const uint8_t *pdu, size_t len,
             }
             for (unsigned k = 0; k < count; ++k) {
                 uint8_t e[3];
-                _Alignas(max_align_t) uint8_t value[64] = {0};
+                _Alignas(max_align_t) uint8_t value[64];
+                /* A delivered value is zero past what decode_attr writes. The
+                 * validation pass delivers nothing, and decode_attr writes its
+                 * output without reading it, so that pass needs no clearing. */
+                if (on_attr) {
+                    memset(value, 0, sizeof(value));
+                }
                 mrp_three_unpack(ev[k / 3u], &e[0], &e[1], &e[2]);
                 int r = ops->decode_attr(type, k, fv, alen, value);
                 if (r < 0) {
-- 
