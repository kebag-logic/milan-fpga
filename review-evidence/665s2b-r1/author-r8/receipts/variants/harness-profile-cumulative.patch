+def code_functions(mapfile: Path) -> tuple[list[str], list[tuple[int, int, int]]]:
+    """Labelled test-only variant (#665 S2b round 6, not committed): each linked text input
+    section as its function (-ffunction-sections), labelled module:function."""
+    text = mapfile.read_text()
+    body = text[text.index('Linker script and memory map'):]
+    rows = re.findall(r'^ (\.text(?:\.\S+)?)\s+0x([0-9a-f]+)\s+0x([0-9a-f]+)\s+(\S+)$', body, re.M)
+    names: list[str] = []
+    spans = []
+    for section, start, size, path in rows:
+        if not int(size, 16):
+            continue
+        stem = Path(path).name
+        match = re.fullmatch(r'\d+-(.+)\.o', stem)
+        member = re.fullmatch(r'lib\w+\.a\((\w+)\.o\)', stem)
+        module = match.group(1) if match else f'rt_{member.group(1)}' if member else Path(stem).stem
+        label = f"{module}:{section.removeprefix('.text').removeprefix('.') or '.text'}"
+        names.append(label)
+        spans.append((int(start, 16), int(start, 16) + int(size, 16), len(names) - 1))
+    spans.sort()
+    return names, spans
+
