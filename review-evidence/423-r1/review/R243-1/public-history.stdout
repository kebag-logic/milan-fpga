        "stdout": "commit 40220227aa942a7811639edfe52d8f24da23363c\nAuthor: hackerman-kl <hackerman-kl@kebag-logic.com>\nDate:   Tue Sep 15 10:52:16 2026 +0200\n\n    Redraw the retained timestamp result in the architecture diagram (#31)\n\ndiff --git a/docs/MANAGER.md b/docs/MANAGER.md\nindex 3701667a353952859b301ab7e03dcbd6418a7aac..de3140fad38467dfcb623f1a1ac828fa6976266c 100644\n--- a/docs/MANAGER.md\n+++ b/docs/MANAGER.md\n@@ -49,7 +49,6 @@ See the [historical resource record](history/v1/RESOURCE_VALIDATION.md).\n \n ## Open risks\n \n-- [Issue #31](https://github.com/Mister-M-alt/FPGA-gPTP/issues/31) covers timestamp overwrite risk.\n - [Issue #35](https://github.com/Mister-M-alt/FPGA-gPTP/issues/35) covers mid-frame receive errors.\n - Parent gitlink updates require separate review.\n - Physical acceptance remains product-specific.\n@@ -58,7 +57,7 @@ See the [historical resource record](history/v1/RESOURCE_VALIDATION.md).\n \n - Keep product integration enabled.\n - Retain disabled builds for comparisons only.\n-- Track both open correctness issues explicitly.\n+- Track every open correctness issue explicitly.\n - Require exact-head verification before parent updates.\n - Preserve dated campaigns within versioned history.\n \ndiff --git a/docs/diagrams/gptp_architecture.drawio b/docs/diagrams/gptp_architecture.drawio\nindex 8179933e23a9602ab592efcd23f9ae0d842383c2..6bfddcb10bbdad5b4262b09997aff066bdc35a6d 100644\n--- a/docs/diagrams/gptp_architecture.drawio\n+++ b/docs/diagrams/gptp_architecture.drawio\n@@ -8,7 +8,7 @@\n           <mxGeometry x=\"320\" y=\"20\" width=\"1280\" height=\"50\" as=\"geometry\"/>\n         </mxCell>\n         <mxCell id=\"engine-boundary\" value=\"KL_gptp_engine \u00b7 one synchronous clock domain\" style=\"rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=16;fontSize=20;fontStyle=1;fontColor=#17324D;fillColor=#F8FBFD;strokeColor=#50758F;strokeWidth=3;dashed=1;dashPattern=8 6;\" vertex=\"1\" parent=\"1\">\n-          <mxGeometry x=\"300\" y=\"100\" width=\"1340\" height=\"730\" as=\"geometry\"/>\n+          <mxGeometry x=\"300\" y=\"100\" width=\"1325\" height=\"730\" as=\"geometry\"/>\n         </mxCell>\n         <mxCell id=\"parent-rx\" value=\"Parent RX service&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;classified 0x88F7 \u00b7 checked frame \u00b7 ingress time&lt;/font&gt;\" style=\"rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#DCEBFA;strokeColor=#24557A;strokeWidth=3;fontColor=#17324D;\" vertex=\"1\" parent=\"1\">\n           <mxGeometry x=\"20\" y=\"190\" width=\"240\" height=\"110\" as=\"geometry\"/>\n@@ -34,14 +34,17 @@\n         <mxCell id=\"timer\" value=\"KL_gptp_timer&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;eight millisecond slots&lt;br&gt;valid-ready expiry&lt;/font&gt;\" style=\"rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#E3F4E8;strokeColor=#287A4B;strokeWidth=3;fontColor=#173D2A;\" vertex=\"1\" parent=\"1\">\n           <mxGeometry x=\"660\" y=\"430\" width=\"230\" height=\"125\" as=\"geometry\"/>\n         </mxCell>\n-        <mxCell id=\"state\" value=\"Engine state regions&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;message \u00b7 timestamps \u00b7 scratch&lt;br&gt;publish \u00b7 PHC \u00b7 timer arm&lt;/font&gt;\" style=\"rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#FFF2CC;strokeColor=#B8860B;strokeWidth=3;fontColor=#513D00;\" vertex=\"1\" parent=\"1\">\n+        <mxCell id=\"state\" value=\"Engine state regions&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;message \u00b7 timestamps \u00b7 credit&lt;br&gt;scratch \u00b7 publish&lt;br&gt;PHC \u00b7 timer arm&lt;/font&gt;\" style=\"rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#FFF2CC;strokeColor=#B8860B;strokeWidth=3;fontColor=#513D00;\" vertex=\"1\" parent=\"1\">\n           <mxGeometry x=\"955\" y=\"430\" width=\"280\" height=\"140\" as=\"geometry\"/>\n         </mxCell>\n-        <mxCell id=\"stamp\" value=\"Priority timestamp return&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;time \u00b7 message type \u00b7 sequence&lt;br&gt;one pending entry&lt;/font&gt;\" style=\"rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=#FDE8E7;strokeColor=#B83A3A;strokeWidth=3;fontColor=#6A2020;\" vertex=\"1\" parent=\"1\">\n-          <mxGeometry x=\"1330\" y=\"430\" width=\"270\" height=\"125\" as=\"geometry\"/>\n+        <mxCell id=\"stamp\" value=\"Priority timestamp return&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;txts_valid_i \u00b7 txts_ready_o&lt;br&gt;time \u00b7 message type \u00b7 sequence&lt;br&gt;txts_ok_i \u00b7 txts_gen_i&lt;br&gt;held until its own dispatch&lt;/font&gt;\" style=\"rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=#D7F0F2;strokeColor=#0F6F7D;strokeWidth=3;fontColor=#0A4751;\" vertex=\"1\" parent=\"1\">\n+          <mxGeometry x=\"1300\" y=\"417\" width=\"300\" height=\"150\" as=\"geometry\"/>\n         </mxCell>\n-        <mxCell id=\"parent-stamp\" value=\"MAC timestamp capture&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;exact transmitted header tag&lt;/font&gt;\" style=\"rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=#DCEBFA;strokeColor=#24557A;strokeWidth=3;fontColor=#17324D;\" vertex=\"1\" parent=\"1\">\n-          <mxGeometry x=\"1680\" y=\"440\" width=\"220\" height=\"105\" as=\"geometry\"/>\n+        <mxCell id=\"parent-stamp\" value=\"MAC timestamp capture&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;exact transmitted header tag&lt;br&gt;offer held until accepted&lt;/font&gt;\" style=\"rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=#DCEBFA;strokeColor=#24557A;strokeWidth=3;fontColor=#17324D;\" vertex=\"1\" parent=\"1\">\n+          <mxGeometry x=\"1650\" y=\"429\" width=\"250\" height=\"126\" as=\"geometry\"/>\n+        </mxCell>\n+        <mxCell id=\"credit\" value=\"Transmit admission credit&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;tx_credit_i level&lt;br&gt;postpones initiating legs&lt;br&gt;Pdelay_Req, Sync, Announce&lt;/font&gt;\" style=\"rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=#DCEBFA;strokeColor=#24557A;strokeWidth=3;fontColor=#17324D;\" vertex=\"1\" parent=\"1\">\n+          <mxGeometry x=\"1650\" y=\"625\" width=\"250\" height=\"140\" as=\"geometry\"/>\n         </mxCell>\n         <mxCell id=\"publish\" value=\"Committed publication&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;identity \u00b7 flags \u00b7 delay \u00b7 offset&lt;br&gt;Announce vector \u00b7 PathTrace&lt;/font&gt;\" style=\"rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=#ECE5F6;strokeColor=#6B4E9B;strokeWidth=3;fontColor=#3E2B59;\" vertex=\"1\" parent=\"1\">\n           <mxGeometry x=\"925\" y=\"660\" width=\"340\" height=\"125\" as=\"geometry\"/>\n@@ -52,8 +55,8 @@\n         <mxCell id=\"phc\" value=\"Parent PHC&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;applies addend and step pulses&lt;/font&gt;\" style=\"rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=#DCEBFA;strokeColor=#24557A;strokeWidth=3;fontColor=#17324D;\" vertex=\"1\" parent=\"1\">\n           <mxGeometry x=\"20\" y=\"530\" width=\"220\" height=\"105\" as=\"geometry\"/>\n         </mxCell>\n-        <mxCell id=\"notes\" value=\"Source evidence: KL_gptp_engine instantiations, state map, queue arbitration, and public ports.&#xa;Red marks bounded risk: issue #31 tracks the one-entry timestamp return.&#xa;Dashed marks the serializer-idle dispatch gate; double heads mark return handshakes.\" style=\"rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#384B5C;fillColor=#F6F8FA;strokeColor=#AAB7C4;strokeWidth=2;spacing=14;\" vertex=\"1\" parent=\"1\">\n-          <mxGeometry x=\"320\" y=\"900\" width=\"1280\" height=\"90\" as=\"geometry\"/>\n+        <mxCell id=\"notes\" value=\"Source evidence: KL_gptp_engine instantiations, state map, queue arbitration, and public ports.&#xa;Teal marks the egress result return: one accepted tuple, held until its own dispatch.&#xa;Transmit admission credit is a level; low credit postpones only the three initiating legs.&#xa;Dashed marks the serializer-idle dispatch gate; double heads mark return handshakes.\" style=\"rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#384B5C;fillColor=#F6F8FA;strokeColor=#AAB7C4;strokeWidth=2;spacing=14;\" vertex=\"1\" parent=\"1\">\n+          <mxGeometry x=\"320\" y=\"895\" width=\"1280\" height=\"115\" as=\"geometry\"/>\n         </mxCell>\n \n         <mxCell id=\"e-rx-parser\" value=\"\" style=\"edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#24557A;strokeWidth=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;\" edge=\"1\" parent=\"1\" source=\"parent-rx\" target=\"parser\">\n@@ -91,14 +94,14 @@\n         <mxCell id=\"e-tx-parent\" value=\"\" style=\"edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#24557A;strokeWidth=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;\" edge=\"1\" parent=\"1\" source=\"txslot\" target=\"parent-tx\">\n           <mxGeometry relative=\"1\" as=\"geometry\"/>\n         </mxCell>\n-        <mxCell id=\"e-parent-stamp\" value=\"\" style=\"edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B83A3A;strokeWidth=3;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;\" edge=\"1\" parent=\"1\" source=\"parent-stamp\" target=\"stamp\">\n+        <mxCell id=\"e-parent-stamp\" value=\"\" style=\"edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#0F6F7D;strokeWidth=3;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;\" edge=\"1\" parent=\"1\" source=\"parent-stamp\" target=\"stamp\">\n           <mxGeometry relative=\"1\" as=\"geometry\"/>\n         </mxCell>\n-        <mxCell id=\"e-stamp-ucpu\" value=\"\" style=\"edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B83A3A;strokeWidth=3;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;\" edge=\"1\" parent=\"1\" source=\"stamp\" target=\"ucpu\">\n+        <mxCell id=\"e-stamp-ucpu\" value=\"\" style=\"edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0F6F7D;strokeWidth=3;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;\" edge=\"1\" parent=\"1\" source=\"stamp\" target=\"ucpu\">\n           <mxGeometry relative=\"1\" as=\"geometry\">\n             <Array as=\"points\">\n-              <mxPoint x=\"1290\" y=\"492\"/>\n-              <mxPoint x=\"1290\" y=\"280\"/>\n+              <mxPoint x=\"1270\" y=\"492\"/>\n+              <mxPoint x=\"1270\" y=\"280\"/>\n             </Array>\n           </mxGeometry>\n         </mxCell>\n@@ -132,9 +135,17 @@\n             </Array>\n           </mxGeometry>\n         </mxCell>\n-        <mxCell id=\"e-stamp-state\" value=\"\" style=\"edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B83A3A;strokeWidth=3;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.625;entryDx=0;entryDy=0;\" edge=\"1\" parent=\"1\" source=\"stamp\" target=\"state\">\n+        <mxCell id=\"e-stamp-state\" value=\"\" style=\"edgeStyle=orthogonalEdgeStyle;rounded=0;htm