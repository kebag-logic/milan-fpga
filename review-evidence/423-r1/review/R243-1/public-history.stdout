        "stdout": "commit ab44ddf8486779eb6e7a20cf3b8beae96cc9d1f8\nAuthor: hackerman-kl <hackerman-kl@kebag-logic.com>\nDate:   Wed Sep 9 13:15:20 2026 +0200\n\n    Rule 11: declare the TX flag rule counters one per line\n\ndiff --git a/tb/verilator/engine/sim_main.cpp b/tb/verilator/engine/sim_main.cpp\nindex 96b383567848c399d7255e1bca62b9ee3de980ed..346eda86420f43708e3c17804035598bcf9f229f 100644\n--- a/tb/verilator/engine/sim_main.cpp\n+++ b/tb/verilator/engine/sim_main.cpp\n@@ -3712,7 +3712,9 @@ class GptpEngineHarness {\n     }};\n     for (const Rule &r : rules) {\n       char n[96];\n-      size_t seen = 0, wrong = 0, reserved = 0;\n+      size_t seen = 0;\n+      size_t wrong = 0;\n+      size_t reserved = 0;\n       uint16_t first_wrong = r.flags;\n       for (const std::vector<uint8_t> &f : txf) {\n         if (f.size() < 22 || (f[14] & 0xF) != r.mtype) continue;"
      },
      {
        "args": [
          "show",
          "--no-ext-diff",
          "--no-textconv",
          "--ignore-submodules=none",
