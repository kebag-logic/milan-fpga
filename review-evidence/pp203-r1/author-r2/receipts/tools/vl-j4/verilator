#!/usr/bin/env bash
# the host's Verilator with its C++ build parallelism capped at 4 (-j 0 -> -j 4), so concurrent campaign arms
# stay inside the unit's memory; nothing else in the command changes
args=()
prev=""
for a in "$@"; do
  if [ "$prev" = "-j" ] && [ "$a" = "0" ]; then a=4; fi
  args+=("$a")
  prev=$a
done
exec /usr/bin/verilator "${args[@]}"
