+    RB_RESP = 3'd1,
+    RB_NTF  = 3'd2,
+    RB_DOWN = 3'd3,
+    RB_DEP  = 3'd4,
+    RB_REQ  = 3'd5
+  } rbt_st_e;
+
+  rbt_st_e rbt_st_r;
+  logic    tx_last_w;    //! the MAC takes a frame's last byte
+  logic    tx_fly_uns_r; //! the granted frame not yet left is an unsolicited AECP one
