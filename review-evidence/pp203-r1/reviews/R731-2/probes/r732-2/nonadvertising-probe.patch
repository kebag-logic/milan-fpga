   // ---- RBT1 to RBT4: every refusal, on one boot -----------------------------
@@ -12767,6 +12768,50 @@
     CHECK(io.reboot_rise_t >= 0 && deps == 0,
           "RBT8 an entity that is not advertising raises reboot_req_o with no "
           "ENTITY_DEPARTING (%d)", deps);
