diff --git a/sw/firmware/ctrl/test/aecp_notice_mutants.py b/sw/firmware/ctrl/test/aecp_notice_mutants.py
new file mode 100644
index 0000000000..d618f50fed
--- /dev/null
+++ b/sw/firmware/ctrl/test/aecp_notice_mutants.py
@@ -0,0 +1,38 @@
+# SPDX-FileCopyrightText: 2026 Kebag Logic
+# SPDX-License-Identifier: CERN-OHL-W-2.0
+"""aecp_notice_mutants.py - the AECP campaign's planted defects in a STREAM_OUTPUT's GET_STREAM_INFO notice from SRP's
+record of a changed Talker declaration (#936; Milan v1.2 5.4.5.2, Table 5.22): the composition's AECP bridge
+(ctrl_app_aecp.c) and the SRP delivery's owed report (ctrl_app_srp.c; ctrl_loop.h, the polls). aecp_mutants.py
+plants each row; every named check must fail on its own words."""
+
+ROWS = (
+    # #936: SRP's record of a changed Talker declaration is its STREAM_OUTPUT's GET_STREAM_INFO notice (Milan v1.2
+    # 5.4.5.2, Table 5.22): dropped, raised for a STREAM_INPUT, raised for the next source, or never cleared
+    ('app-output-notice-dropped', 'app/ctrl_app_aecp.c',
+           '\t\t\t\taecp_changed(&c->aecp->core, 6, n, 1u);\n',
+           '\t\t\t\t(void)n;\n',
+           ('App.SrpDeclarationChangeIsItsStreamOutputsNotice',
+            "a declaration changed notifies its STREAM_OUTPUT's GET_STREAM_INFO to every registered controller")),
+    ('app-output-notice-as-an-input', 'app/ctrl_app_aecp.c',
+           '\t\t\t\taecp_changed(&c->aecp->core, 6, n, 1u);\n',
+           '\t\t\t\taecp_changed(&c->aecp->core, 5, n, 1u);\n',
+           ('App.SrpDeclarationChangeIsItsStreamOutputsNotice',
+            "a declaration changed notifies its STREAM_OUTPUT's GET_STREAM_INFO to every registered controller")),
+    ('app-output-notice-next-source', 'app/ctrl_app_aecp.c',
+           '\t\t\t\taecp_changed(&c->aecp->core, 6, n, 1u);\n',
+           '\t\t\t\taecp_changed(&c->aecp->core, 6, (uint16_t)(n + 1u), 1u);\n',
+           ('App.SrpDeclarationChangeIsItsStreamOutputsNotice',
+            'a source the record does not name is notified nothing')),
+    ('app-output-notice-kept', 'app/ctrl_app_aecp.c',
+           '\t\tc->app->srp_noticed = 0u;\n',
+           '\t\t(void)c;\n',
+           ('App.SrpDeclarationChangeIsItsStreamOutputsNotice',
+            'the bridge raises every STREAM_OUTPUT the delivery took')),
+    # #936 (ctrl_loop.h, the polls): the SRP delivery's pass that takes the record reports nothing owed, so the loop
+    # may sleep with the STREAM_OUTPUT's notice unsent
+    ('app-output-notice-owed-unreported', 'app/ctrl_app_srp.c',
+           '    bool pending = noticed;\n',
+           '    bool pending = false;\n    (void)noticed;\n',
+           ('App.NoPassIsIdleWhileAStreamOutputsNoticeIsOwed',
+            "no pass is idle while a STREAM_OUTPUT's notice is owed")),
+)
diff --git a/sw/firmware/ctrl/test/srp_gate.hpp b/sw/firmware/ctrl/test/srp_gate.hpp
index a747cf9c7e..d49c246fcf 100644
--- a/sw/firmware/ctrl/test/srp_gate.hpp
+++ b/sw/firmware/ctrl/test/srp_gate.hpp
@@ -367,4 +367,38 @@ TEST_F(SrpGate, F936AProbeAndItsExpiryEachNoticeTheSource) {
     EXPECT_EQ(core()->reentries, 0u);
 }
 
+// #936 (ctrl_loop.h, the polls: only a pass that handled nothing and owes nothing sleeps): the pass that takes SRP's
+// record of a probed source's declaration, and the one that takes its expiry's withdrawal, report output owed, since
+// the source's STREAM_OUTPUT notice is still to be raised. Each pass is stepped alone and checked as it ends.
+TEST_F(SrpGate, F936BThePassThatTakesTheRecordOwesItsNotice) {
+    compose();
+    // Each pass up to the one that takes the record; that pass's return value.
+    auto take = [&] {
+        unsigned work = 0;
+        for (unsigned k = 0; k < 256u && app.srp_noticed == 0u; ++k) work = ctrl_loop_service(&app.loop);
+        return work;
+    };
+    Pdu request;
+    request.msg = 0u;
+    request.talker = kOwn;
+    request.talker_uid = static_cast<std::uint16_t>(source);
+    ASSERT_TRUE(offer(request, spec::MULTICAST_MAC, interface));
+    const unsigned declaring = take();
+    ASSERT_EQ(app.srp_noticed, 1u << source) << "a probe's declaration notices its source";
+    EXPECT_NE(declaring, 0u) << "the pass that takes SRP's record of a declaration owes its notice";
+    settle();
+    app.srp_noticed = 0u;
+    run(14500u);
+    ASSERT_TRUE(declared(interface)) << "the probe window holds the declaration";
+    unsigned withdrawing = 0;
+    for (unsigned ms = 0; ms < 1000u && app.srp_noticed == 0u; ++ms) {
+        mbx_model_advance_ms(&model, 1u);
+        withdrawing = take();
+    }
+    ASSERT_EQ(app.srp_noticed, 1u << source) << "the probe's expiry notices its source";
+    EXPECT_FALSE(declared(interface)) << "the probe's 15 s expiry withdraws the Talker";
+    EXPECT_NE(withdrawing, 0u) << "the pass that takes SRP's record of a withdrawal owes its notice";
+    EXPECT_EQ(core()->reentries, 0u);
+}
+
 }  // namespace
