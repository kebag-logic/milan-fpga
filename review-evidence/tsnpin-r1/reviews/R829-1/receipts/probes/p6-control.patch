+TEST_F(AcmpMailbox, ReviewerOneOwedFrameKeepsTheLoopAwake) {
+    waits = waiter{};
+    mbx_model_bind(&model, wait_for_irq, &waits);
+    fill_acmp_tx();
+    ASSERT_TRUE(offer(command(spec::MSG_GET_RX_STATE_COMMAND, 0)));
+    for (unsigned k = 0; k < 8u; ++k) {
+        ctrl_loop_step(&app.loop);
+    }
+    EXPECT_TRUE(core()->owed_count == 1u && waits.waits == 0u)
+        << "REVIEWER one owed frame behind a held egress: the loop does not sleep";
+    bool found = false;
+    bool owes = false;
+    for (unsigned i = 0; i < app.loop.n_polls; ++i) {
+        if (app.loop.polls[i].ctx == static_cast<void*>(&app.acmp)) {
+            found = true;
+            owes = app.loop.polls[i].fn(app.loop.polls[i].ctx);
+        }
+    }
+    EXPECT_TRUE(found && core()->owed_count == 1u && owes)
+        << "REVIEWER one owed frame behind a held egress: the ACMP poll reports it still owes";
+    mbx_model_bind(&model, nullptr, nullptr);
+}
