+		const enum mbx_status st = mbx_rx_take(MBX_CH_ACMP, &l->frame);
+		if (st != MBX_STATUS_OK) {
+			l->stats.rx_bad += st == MBX_STATUS_BAD;
+			return;
+		}
+		l->stats.rx_records++;
+		on_frame(m, &l->frame);
+	}
+}
