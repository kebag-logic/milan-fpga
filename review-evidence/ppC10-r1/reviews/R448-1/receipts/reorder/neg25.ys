rename $logic_and$head_neg2.v:24047$145684_Y r448_bbi_4
rename $logic_and$head_neg2.v:24065$145702_Y r448_bbi_5
rename $logic_or$head_neg2.v:24045$145682_Y r448_bbi_6
cd ..
select -set bbc protocol_processor_top/c:* protocol_processor_top/t:$* protocol_processor_top/t:$paramod* %d %d protocol_processor_top/t:$mem* %u
select -set bbo @bbc %co protocol_processor_top/w:* %i
select -set bbi @bbc %ci protocol_processor_top/w:* %i
tee -q -o gate_neg2_cells.txt select -count @bbc
tee -q -o gate_neg2_exposed_in.txt select -list @bbo
tee -q -o gate_neg2_exposed_out.txt select -list @bbi
expose -input @bbo
expose @bbi
delete @bbc
opt_clean
blackbox protocol_processor_top %n
rename protocol_processor_top gate_neg2
design -stash N
design -copy-from G gold_neg2
design -copy-from N gate_neg2
equiv_make gold_neg2 gate_neg2 eq
hierarchy -top eq
equiv_simple
equiv_induct
tee -o neg25.status equiv_status
equiv_status -assert
