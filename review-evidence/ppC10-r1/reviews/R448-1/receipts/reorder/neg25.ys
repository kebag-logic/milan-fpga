read_verilog -defer base.v
hierarchy -check -top protocol_processor_top
proc
opt_clean
memory -nomap
cd protocol_processor_top
rename $logic_and$base.v:21545$362_Y r448_bbi_0
rename $logic_and$base.v:22330$645_Y r448_bbi_1
rename $logic_and$base.v:22496$648_Y r448_bbi_2
rename $logic_and$base.v:23835$1299_Y r448_bbi_3
rename $logic_and$base.v:24041$1305_Y r448_bbi_4
rename $logic_and$base.v:24059$1323_Y r448_bbi_5
rename $logic_or$base.v:24039$1303_Y r448_bbi_6
cd ..
select -set bbc protocol_processor_top/c:* protocol_processor_top/t:$* protocol_processor_top/t:$paramod* %d %d protocol_processor_top/t:$mem* %u
select -set bbo @bbc %co protocol_processor_top/w:* %i
select -set bbi @bbc %ci protocol_processor_top/w:* %i
tee -q -o gold_neg2_cells.txt select -count @bbc
tee -q -o gold_neg2_exposed_in.txt select -list @bbo
tee -q -o gold_neg2_exposed_out.txt select -list @bbi
expose -input @bbo
expose @bbi
delete @bbc
opt_clean
blackbox protocol_processor_top %n
rename protocol_processor_top gold_neg2
design -stash G
read_verilog -defer head_neg2.v
hierarchy -check -top protocol_processor_top
proc
opt_clean
memory -nomap
cd protocol_processor_top
rename $logic_and$head_neg2.v:21552$144741_Y r448_bbi_0
rename $logic_and$head_neg2.v:22337$145024_Y r448_bbi_1
rename $logic_and$head_neg2.v:22502$145027_Y r448_bbi_2
