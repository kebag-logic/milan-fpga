elta review at the new head by [R304]. R305-3 stays POSITIVE at the ancestor `3face091`.\n","author_association":"OWNER","pin":null,"reactions":{"url":"https://api.github.com/repos/Mister-M-alt/FPGA-gPTP/issues/comments/5821534416/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]]