// The internal signals the harnesses touch, and only those (in place of
// --public-flat-rw, see the Makefile). sim_phc_step.cpp reads them; nothing is driven.
// A signal missing here still compiles (Verilator keeps it in the root
// structure, unoptimised or not), so every internal name the harnesses use
// must be listed.
`verilator_config
public_flat_rd -module "KL_mmcm_drp_servo" -var "integ_r"
public_flat_rd -module "KL_mmcm_drp_servo" -var "u_cmd_r"
public_flat_rd -module "KL_mmcm_drp_servo" -var "ew_r"
public_flat_rd -module "KL_mmcm_drp_servo" -var "pp_seq_r"
public_flat_rd -module "KL_mmcm_drp_servo" -var "pp_run_r"
public_flat_rd -module "KL_mmcm_drp_servo" -var "win_valid_r"
public_flat_rd -module "KL_mmcm_drp_servo" -var "tick_cnt_r"
public_flat_rd -module "KL_mmcm_drp_servo" -var "ptp_jump_r"
public_flat_rd -module "cdc_pulse" -var "sync"
