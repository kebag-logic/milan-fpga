#
# Verilator verification of the saved-state backing-store sizing candidate,
# syn/ooc/sizing/KL_nvm_backend_sizer.sv (design page section 8.3).
#
# WHY A SUITE FOR A SIZING SKETCH. Round 3 of the review measured the
# candidate's area and found that the candidate could not map the two
# channel-map groups it claimed to price, and that its recovery machine
# contradicted the state table it cited. A synthesizable but functionally
# impossible sketch does not discharge an area acceptance, and the lint
# command the PR published did not even reproduce. So the exact sizing source
# is now driven, not just synthesised:
#
#   Vnvm8x8  the shipped max shape. Every 0x60..0x67 and 0x70..0x77 mapping is
#            read against a byte-exact KLJ2 image with DISTINCT input (72 B
#            framed) and output (144 B framed) record lengths.
#   Vnvm1x1  the shipping default, where the single input port has ZERO
#            clusters (an 8-byte framed record with no payload) against a
#            136-byte output payload -- the same asymmetry, the other way up.
#   three NEGATIVE CONTROLS, each compiled from the same source with one
#            defect defined back in, and each of which MUST fail:
#              NVM_MUT_MAP_ALIAS       one table for both directions
#              NVM_MUT_NOMINAL_STRIDE  a nominal channel-map stride
#              NVM_MUT_STALE_MASKONLY  the latch cleared only by reset
#
# The fixtures records_*.txt are GENERATED by
#   scripts/check_nvm_record_space.py --emit-record-table
# and that gate rebuilds and compares them on every run, so they cannot go
# stale against the shape they claim to describe.
#
# `-Wall` with NO `-Wno-fatal`: this build is also the executable form of the
# PR's lint claim about the sizing sources, which the review found did not
# reproduce (both tops in one file tripped DECLFILENAME). The two tops now live
# in one file each and the blankflash top is linted here as well.

VERILATOR ?= verilator
SIZ        = ../../../syn/ooc/sizing
BACKEND    = $(SIZ)/KL_nvm_backend_sizer.sv
BLANK      = $(SIZ)/KL_nvm_blankflash_sizer.sv
TOP        = KL_nvm_backend_sizer

T8X8 = records_endstation_ax7101_8x8.txt
T1X1 = records_endstation_ax7101_1x1_tdm8.txt

# CLK_HZ_P is dropped to 10 kHz so one "millisecond" is ten clocks and the
# section 9.4 deadlines are reachable in simulation; the deadline VALUES are
# what the design page fixes and are exercised as relations, not as durations.
VFLAGS = --cc --exe --build -j 0 --prefix Vnvm \
         -Wall -CFLAGS "-std=c++17 -O2 -Wall -Wextra"

SHAPE_8X8 = -GCLK_HZ_P=10000 -GT_ALIVE_MS_P=4 -GT_COMMIT_MS_P=6 \
            -GN_STREAM_IN_P=9 -GN_STREAM_OUT_P=9 \
            -GN_SPORT_IN_P=8 -GN_SPORT_OUT_P=8 \
            -GN_AUDIO_UNIT_P=1 -GN_CLK_DOM_P=1 -GN_NAME_BANK_P=30

SHAPE_1X1 = -GCLK_HZ_P=10000 -GT_ALIVE_MS_P=4 -GT_COMMIT_MS_P=6 \
            -GN_STREAM_IN_P=2 -GN_STREAM_OUT_P=2 \
            -GN_SPORT_IN_P=1 -GN_SPORT_OUT_P=1 \
            -GN_AUDIO_UNIT_P=1 -GN_CLK_DOM_P=1 -GN_NAME_BANK_P=4

.PHONY: all run lint clean
all: run

obj_8x8/Vnvm: $(BACKEND) sim_main.cpp
	$(VERILATOR) $(VFLAGS) --Mdir obj_8x8 --top-module $(TOP) $(SHAPE_8X8) \
	  $(BACKEND) sim_main.cpp -o Vnvm

obj_1x1/Vnvm: $(BACKEND) sim_main.cpp
	$(VERILATOR) $(VFLAGS) --Mdir obj_1x1 --top-module $(TOP) $(SHAPE_1X1) \
	  $(BACKEND) sim_main.cpp -o Vnvm

obj_mut_alias/Vnvm: $(BACKEND) sim_main.cpp
	$(VERILATOR) $(VFLAGS) --Mdir obj_mut_alias --top-module $(TOP) \
	  $(SHAPE_8X8) +define+NVM_MUT_MAP_ALIAS $(BACKEND) sim_main.cpp -o Vnvm

obj_mut_stride/Vnvm: $(BACKEND) sim_main.cpp
	$(VERILATOR) $(VFLAGS) --Mdir obj_mut_stride --top-module $(TOP) \
	  $(SHAPE_8X8) +define+NVM_MUT_NOMINAL_STRIDE $(BACKEND) sim_main.cpp \
	  -o Vnvm

obj_mut_stale/Vnvm: $(BACKEND) sim_main.cpp
	$(VERILATOR) $(VFLAGS) --Mdir obj_mut_stale --top-module $(TOP) \
	  $(SHAPE_8X8) +define+NVM_MUT_STALE_MASKONLY $(BACKEND) sim_main.cpp \
	  -o Vnvm

# The BEFORE top of the section 8.3 pair is not driven here -- it is the
# responder that already ships and is verified in tb/verilator/pp_shadow --
# but it IS linted, because the PR's lint claim covers both sizing sources.
lint:
	$(VERILATOR) --lint-only -Wall --top-module KL_nvm_blankflash_sizer $(BLANK)
	$(VERILATOR) --lint-only -Wall --top-module $(TOP) $(BACKEND)

run: lint obj_8x8/Vnvm obj_1x1/Vnvm obj_mut_alias/Vnvm obj_mut_stride/Vnvm \
     obj_mut_stale/Vnvm
	@echo "======================================================================"
	./obj_8x8/Vnvm $(T8X8)
	./obj_1x1/Vnvm $(T1X1)
	@echo "---- negative controls: each MUST fail --------------------------------"
	@for m in alias:NVM_MUT_MAP_ALIAS stride:NVM_MUT_NOMINAL_STRIDE \
	          stale:NVM_MUT_STALE_MASKONLY; do \
	  d=obj_mut_$${m%%:*}; n=$${m#*:}; \
	  if ./$$d/Vnvm $(T8X8) > $$d/mut.log 2>&1; then \
	    echo "SELF-TEST FAILED: $$n PASSED. The check it targets is vacuous."; \
	    exit 1; \
	  else \
	    echo "negative control $$n: RED as required -- $$(grep -m1 '^FAIL:' $$d/mut.log)"; \
	  fi; \
	done

clean:
	rm -rf obj_8x8 obj_1x1 obj_mut_alias obj_mut_stride obj_mut_stale
