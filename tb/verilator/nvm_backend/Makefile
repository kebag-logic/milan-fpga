#
# Verilator verification of the saved-state backing store, the shipping module
# hdl/milan/KL_nvm_backend.sv (design page sections 4, 8 and 9), graded on
# bytes against a KLJ2 image the encoder and this harness build independently.
#
#   Vnvm8x8  the shipped max shape. Every allocated record, including every
#            0x60..0x67 and 0x70..0x77 channel map, is read against a
#            byte-exact KLJ2 image with DISTINCT input (72 B framed) and
#            output (144 B framed) record lengths; writes and erases land
#            where reads found the record; the blank-flash behaviour before
#            the firmware configures and validates an image; the bounds
#            refusals; bus errors; the section 9 status machine.
#   Vnvm1x1  the shipping default, where the single input port has ZERO
#            clusters (an 8-byte framed record with no payload) against a
#            136-byte output payload -- the same asymmetry, the other way up.
#   four NEGATIVE CONTROLS, each a copy of the shipping source with one
#            defect planted by mutate.py (exact text match, so a moved line
#            breaks the build rather than passing vacuously), and each of
#            which MUST fail:
#              alias       one channel-map table for both directions
#              stride      a nominal channel-map stride
#              stale_mask  the stale latch cleared only by reset, masked
#              blind_read  a READ served before the image was validated
#
# The fixtures records_*.txt are GENERATED by
#   scripts/check_nvm_record_space.py --emit-record-table
# and that gate rebuilds and compares them on every run, so they cannot go
# stale against the shape they claim to describe.
#
# `-Wall` with NO `-Wno-fatal`: any Verilator warning on the shipping module
# stops this build. The blank-flash BEFORE half of the section 8.3 area pair
# (syn/ooc/sizing/KL_nvm_blankflash_sizer.sv) is linted here as well.

VERILATOR ?= verilator
PYTHON    ?= python3
RTL        = ../../../hdl/milan
SIZ        = ../../../syn/ooc/sizing
BACKEND    = $(RTL)/KL_nvm_backend.sv
BLANK      = $(SIZ)/KL_nvm_blankflash_sizer.sv
TOP        = KL_nvm_backend

T8X8 = records_endstation_ax7101_8x8.txt
T1X1 = records_endstation_ax7101_1x1_tdm8.txt

# CLK_HZ_P is dropped to 10 kHz so one "millisecond" is ten clocks and the
# section 9.4 deadlines are reachable in simulation; the deadline VALUES are
# what the design page fixes and are exercised as relations, not as durations.
VFLAGS = --cc --exe --build -j 0 --prefix Vnvm \
         -Wall -CFLAGS "-std=c++17 -O2 -Wall -Wextra"

SHAPE_8X8 = -GCLK_HZ_P=10000 -GT_ALIVE_MS_P=4 -GT_COMMIT_MS_P=6 \
            -GN_STREAM_IN_P=9 -GN_STREAM_OUT_P=9 \
            -GN_SPORT_IN_P=8 -GN_SPORT_OUT_P=8 \
            -GN_AUDIO_UNIT_P=1 -GN_CLK_DOM_P=1 -GN_NAME_P=107

SHAPE_1X1 = -GCLK_HZ_P=10000 -GT_ALIVE_MS_P=4 -GT_COMMIT_MS_P=6 \
            -GN_STREAM_IN_P=2 -GN_STREAM_OUT_P=2 \
            -GN_SPORT_IN_P=1 -GN_SPORT_OUT_P=1 \
            -GN_AUDIO_UNIT_P=1 -GN_CLK_DOM_P=1 -GN_NAME_P=31

MUTANTS = alias stride stale_mask blind_read

.PHONY: all run lint clean
all: run

obj_8x8/Vnvm: $(BACKEND) sim_main.cpp
	$(VERILATOR) $(VFLAGS) --Mdir obj_8x8 --top-module $(TOP) $(SHAPE_8X8) \
	  $(BACKEND) sim_main.cpp -o Vnvm

obj_1x1/Vnvm: $(BACKEND) sim_main.cpp
	$(VERILATOR) $(VFLAGS) --Mdir obj_1x1 --top-module $(TOP) $(SHAPE_1X1) \
	  $(BACKEND) sim_main.cpp -o Vnvm

# one mutated copy of the shipping source per control, built with the same
# harness and the same flags as the 8x8 leg
obj_mut_%/Vnvm: $(BACKEND) sim_main.cpp mutate.py
	$(PYTHON) mutate.py $* $(BACKEND) obj_mut_$*/KL_nvm_backend.sv
	$(VERILATOR) $(VFLAGS) --Mdir obj_mut_$* --top-module $(TOP) $(SHAPE_8X8) \
	  obj_mut_$*/KL_nvm_backend.sv sim_main.cpp -o Vnvm

lint:
	$(VERILATOR) --lint-only -Wall --top-module KL_nvm_blankflash_sizer $(BLANK)
	$(VERILATOR) --lint-only -Wall --top-module $(TOP) $(SHAPE_8X8) $(BACKEND)
	$(VERILATOR) --lint-only -Wall --top-module $(TOP) $(SHAPE_1X1) $(BACKEND)

run: lint obj_8x8/Vnvm obj_1x1/Vnvm $(foreach m,$(MUTANTS),obj_mut_$(m)/Vnvm)
	@echo "======================================================================"
	./obj_8x8/Vnvm $(T8X8)
	./obj_1x1/Vnvm $(T1X1)
	@echo "---- negative controls: each MUST fail --------------------------------"
	@for m in $(MUTANTS); do \
	  d=obj_mut_$$m; \
	  if ./$$d/Vnvm $(T8X8) > $$d/mut.log 2>&1; then \
	    echo "SELF-TEST FAILED: mutation $$m PASSED. The check it targets is vacuous."; \
	    exit 1; \
	  else \
	    echo "negative control $$m: RED as required -- $$(grep -m1 '^FAIL:' $$d/mut.log)"; \
	  fi; \
	done

clean:
	rm -rf obj_8x8 obj_1x1 $(foreach m,$(MUTANTS),obj_mut_$(m))
