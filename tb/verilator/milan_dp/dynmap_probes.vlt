// #658: stage a STREAM_OUTPUT format row in the processor's dynamic-state
// store while the boot window is open. It is the only stimulus that reaches
// the parent's output clip: the format verdict admits no narrower output
// format, so neither a restore nor a SET_STREAM_FORMAT can place one there.
`verilator_config
public_flat_rw -module "KL_aecp_dyn_state" -var "fmtout_r"
public_flat_rw -module "KL_aecp_dyn_state" -var "fmtout_v_r"
// The boot window's guard arms (R490-1 F1). The input row is staged and
// invalidated as a D3 roll-back leaves it, and the restore is ended CLOSED
// on a chosen clock: no blank or saved window ends it there.
public_flat_rw -module "KL_aecp_dyn_state" -var "fmtin_r"
public_flat_rw -module "KL_aecp_dyn_state" -var "fmtin_v_r"
public_flat_rw -module "KL_aecp_nvm_writer" -var "closed_r"
// CLOSED keeps AECP held, so no GET can read the stores there; the CSR
// writer's one-cycle commit places each write against the terminal.
public_flat_rd -module "milan_datapath" -var "amap_in_store_r"
public_flat_rd -module "milan_datapath" -var "amap_out_owner_v_r"
public_flat_rd -module "milan_datapath" -var "amap_out_cluster_r"
// #637's multi-port legs (maprec8, maprec4) grade every output key's owner.
public_flat_rd -module "milan_datapath" -var "amap_out_owner_r"
public_flat_rd -module "milan_datapath" -var "cfg_chmap_wr_en"
// The post-terminal sweep, held open so that an edit meets it.
public_flat_rw -module "milan_datapath" -var "amap_boot_last_r"
// #637: the map restore's hold and verdict, the combined restore_done, the
// read face's request (the held GET's premise), and the D3 walk's roll-back
// terminal, planted so that the walk ends DEFAULTS over a window it could
// restore.
public_flat_rd -module "milan_datapath" -var "amr_rs_hold_r"
public_flat_rd -module "milan_datapath" -var "amr_rs_fail_r"
public_flat_rd -module "milan_datapath" -var "amr_dirty_r"
public_flat_rd -module "milan_datapath" -var "pp_restore_done_w"
public_flat_rd -module "milan_datapath" -var "pp_amap_req_w"
public_flat_rw -module "KL_aecp_nvm_writer" -var "rb_r"
public_flat_rd -module "milan_datapath" -var "amr_taint_r"
public_flat_rd -module "milan_datapath" -var "amr_req_r"
public_flat_rd -module "KL_pp_shadow" -var "da_map_r"
public_flat_rd -module "KL_pp_shadow" -var "nvm_busy_w"
public_flat_rd -module "KL_pp_shadow" -var "enable_i"
public_flat_rd -module "milan_datapath" -var "pp_gsi_req_w"
public_flat_rd -module "milan_datapath" -var "pp_gsi_kind_w"
public_flat_rd -module "milan_datapath" -var "pp_gsi_sel_w"
public_flat_rd -module "milan_datapath" -var "amr_stage_r"
public_flat_rd -module "milan_datapath" -var "amr_st_r"
public_flat_rd -module "milan_datapath" -var "amr_r_r"
