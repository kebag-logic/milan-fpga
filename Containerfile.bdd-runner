#
# Container image for the behave BDD test runner.
#
# It is GENERIC: it installs behave and runs `tests/features`, whatever those
# features happen to cover. It was written for the AECP tier and outlived it -
# the 1722.1 DUT-simulation half of that pair (Containerfile.dut-sim +
# scripts/run-dut-sim.sh + scripts/aecp_sim_main.cpp) is deleted with the RTL
# it drove, while this image still runs the live conformance suite.

FROM python:3.12-slim
LABEL org.opencontainers.image.title="milan-behave-runner"
LABEL org.opencontainers.image.description="behave BDD runner for tests/features"

RUN pip install --no-cache-dir behave pyyaml

WORKDIR /work
# Tests are mounted at runtime from the host.

ENTRYPOINT ["behave", "tests/features"]
