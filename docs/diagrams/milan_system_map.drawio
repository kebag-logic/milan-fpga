<mxfile host="app.diagrams.net"><diagram name="milan-system-map"><mxGraphModel dx="2000" dy="1400" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5680" pageHeight="2400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="MILAN AVB NIC on VexiiRiscv SoC — FULL SYSTEM MAP&#160;&#160;·&#160;&#160;AX7101 xc7a100t&#160;&#160;·&#160;&#160;data flows LEFT-&gt;RIGHT (RX lane top; TX lane bottom returns to the wire)&#160;&#160;·&#160;&#160;BIG arrows = frame/bus data · thin dashed = configuration/status · big dashed = monitor copy&#160;&#160;·&#160;&#160;every address = its own cell&#160;&#160;·&#160;&#160;2026-07-12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333;fontSize=18;verticalAlign=middle;align=center;spacingLeft=5;spacingRight=5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="5600" height="42" as="geometry"/></mxCell><mxCell id="lg1" value="sys @ 100 MHz (cd_sys)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=middle;align=center;spacingLeft=5;spacingRight=5;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="180" height="26" as="geometry"/></mxCell><mxCell id="lg2" value="milan datapath @ 100 MHz (cd_milan)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle;align=center;spacingLeft=5;spacingRight=5;" vertex="1" parent="1"><mxGeometry x="232" y="70" width="210" height="26" as="geometry"/></mxCell><mxCell id="lg3" value="eth 125 MHz (LiteEth MAC/PHY)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;verticalAlign=middle;align=center;spacingLeft=5;spacingRight=5;" vertex="1" parent="1"><mxGeometry x="454" y="70" width="190" height="26" as="geometry"/></mxCell><mxCell id="lg4" value="off-chip" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;verticalAlign=middle;align=center;spacingLeft=5;spacingRight=5;" vertex="1" parent="1"><mxGeometry x="656" y="70" width="90" height="26" as="geometry"/></mxCell><mxCell id="lg5" value="memory / register cell (w/ address)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle;align=center;spacingLeft=5;spacingRight=5;" vertex="1" parent="1"><mxGeometry x="758" y="70" width="210" height="26" as="geometry"/></mxCell><mxCell id="lg6" value="arbiter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;align=center;spacingLeft=5;spacingRight=5;" vertex="1" parent="1"><mxGeometry x="980" y="70" width="80" height="26" as="geometry"/></mxCell><mxCell id="lg7" value="lanes: LE = little (tdata[7:0] = first wire byte) · the processor eats a 1 byte/clk stream · clocks: sys 100 / milan 100 (Arty 50) / eth 125 / DDR3-800" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9d6;strokeColor=#b3a100;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;" vertex="1" parent="1"><mxGeometry x="1072" y="70" width="720" height="26" as="geometry"/></mxCell><mxCell id="phy" value="RTL8211E PHY&#10;(off-chip)&#10;&#10;GMII-strapped&#10;8-bit SDR&#10;(an RGMII read&#10;corrupts every&#10;byte — hardware-&#10;confirmed)&#10;&#10;1000BASE-T&#10;to the AVB&#10;switch&#10;&#10;RX out @ top&#10;TX in @ bottom&#10;&#10;Arty: DP83848&#10;MII 10/100" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;verticalAlign=top;align=left;spacingLeft=5;spacingRight=5;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="220" height="1980" as="geometry"/></mxCell><mxCell id="c_fab" value="milan_datapath — fabric, cd_milan 100 MHz (Arty 50)&#160;&#160;·&#160;&#160;every AXIS hop: 64b tdata + 8b tkeep + valid/ready/last, LE unless marked BE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f8fd;strokeColor=#6c8ebf;verticalAlign=top;align=left;fontSize=13;fontStyle=1;spacingLeft=8;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="300" y="140" width="3260" height="1980" as="geometry"/></mxCell><mxCell id="c_mac" value="MilanMAC (LiteEth) — eth 125 MHz island" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf6ec;strokeColor=#d79b00;verticalAlign=top;align=left;fontSize=13;fontStyle=1;spacingLeft=8;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="c_fab"><mxGeometry x="20" y="60" width="540" height="1880" as="geometry"/></mxCell><mxCell id="phyif" value="LiteEthPHYGMII&#10;gtx 125 MHz · tx_clk_invert · launch FFs&#10;IOB-packed (silicon placement rule)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;verticalAlign=middle;align=center;spacingLeft=5;spacingRight=5;" vertex="1" parent="c_mac"><mxGeometry x="15" y="40" width="510" height="90" as="geometry"/></mxCell><mxCell id="maccore" value="LiteEthMACCore&#10;preamble/SFD · CRC32 · padding ·&#10;width conversion 8b &lt;-&gt; 64b" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;verticalAlign=middle;align=center;spacingLeft=5;spacingRight=5;" vertex="1" parent="c_mac"><mxGeometry x="15" y="150" width="510" height="90" as="geometry"/></mxCell><mxCell id="macfifo" value="dual-clock stream FIFOs&#10;eth_rx / eth_tx 125 &lt;-&gt; cd_milan 100" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;verticalAlign=middle;align=center;spacingLeft=5;spacingRight=5;" vertex="1" parent="c_mac"><mxGeometry x="15" y="260" width="510" height="70" as="geometry"/></mxCell><mxCell id="lastbe" value="stream &lt;-&gt; AXIS adapter&#10;last_be (one-hot) &lt;-&gt; tkeep (mask)&#10;(the M-A3 no-frame-on-wire root cause)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;verticalAlign=middle;align=center;spacingLeft=5;spacingRight=5;" vertex="1" parent="c_mac"><mxGeometry x="15" y="350" width="510" height="90" as="geometry"/></mxCell><mxCell id="macnote" value="TX side: same core, reverse path&#10;(padding + CRC insert, IOB launch)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;verticalAlign=middle;align=center;spacingLeft=5;spacingRight=5;" vertex="1" parent="c_mac"><mxGeometry x="15" y="1790" width="510" height="70" as="geometry"/></mxCell><mxCell id="ptprx" value="ptp_ts_top — RX stamp&#10;&#10;per-frame RX timestamp -&gt;&#10;descriptor ts window (@ +0x3100)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=top;align=center;spacingLeft=5;spacingRight=5;" vertex="1" parent="c_fab"><mxGeometry x="620" y="100" width="400" height="200" as="geometry"/></mxCell><mxCell id="r_ptp0" value="counter: 64b FF (cd_milan)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_fab"><mxGeometry x="630" y="172" width="380" height="26" as="geometry"/></mxCell><mxCell id="r_ptp1" value="0x500-0x51C CTRL·INCR·ADJ·TW·OF" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_fab"><mxGeometry x="630" y="198" width="380" height="26" as="geometry"/></mxCell><mxCell id="r_ptp2" value="0x520-0x544 CMD·TR·ILAT·ELAT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_fab"><mxGeometry x="630" y="224" width="380" height="26" as="geometry"/></mxCell><mxCell id="tcam" value="rx_mac_filter — TCAM dst-MAC filter&#10;&#10;ternary match · default-pass bit ·&#10;miss + no-default -&gt; drop, never stalls" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=top;align=center;spacingLeft=5;spacingRight=5;" vertex="1" parent="c_fab"><mxGeometry x="1080" y="100" width="420" height="200" as="geometry"/></mxCell><mxCell id="r_tcam0" value="array: 16 x {key48+mask48+act8} FF" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_fab"><mxGeometry x="1090" y="172" width="400" height="26" as="geometry"/></mxCell><mxCell id="r_tcam1" value="0x700-0x714 CTRL·KLO/KHI·MLO/MHI·ACT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_fab"><mxGeometry x="1090" y="198" width="400" height="26" as="geometry"/></mxCell><mxCell id="r_tcam2" value="0x718&#160;&#160;&#160;&#160;&#160;&#160;&#160;CMD (write-entry strobe)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_fab"><mxGeometry x="1090" y="224" width="400" height="26" as="geometry"/></mxCell><mxCell id="tap" value="rx_axis_to_dma&#10;THE TAP POINT (post-filter)&#10;taps are copies — never stall" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle;align=center;spacingLeft=5;spacingRight=5;fontStyle=1;" vertex="1" parent="c_fab"><mxGeometry x="1560" y="150" width="300" height="100" as="geometry"/></mxCell><mxCell id="rmon" value="ethernet_events — RMON" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=top;align=center;spacingLeft=5;spacingRight=5;" vertex="1" parent="c_fab"><mxGeometry x="2160" y="440" width="320" height="106" as="geometry"/></mxCell><mxCell id="r_rmon0" value="counters: 9 x 32b FF" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_fab"><mxGeometry x="2170" y="468" width="300" height="25" as="geometry"/></mxCell><mxCell id="r_rmon1" value="0x210-0x230 STAT0..8 (RO)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_fab"><mxGeometry x="2170" y="493" width="300" height="25" as="geometry"/></mxCell><mxCell id="c_atdecc" value="IEEE 1722.1 / SRP control plane — the protocol processor, and only that (2026-08-13: this repo&#x27;s own ADP/AECP/ACMP/lwSRP RTL is DELETED)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;fontSize=13;fontStyle=1;spacingLeft=8;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="c_fab"><mxGeometry x="620" y="520" width="2060" height="940" as="geometry"/></mxCell><mxCell id="c_pp" value="KL_pp_shadow — wrapper around the pinned protocol-processor submodule (architecture of record v2.0)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f8fd;strokeColor=#6c8ebf;verticalAlign=top;align=left;fontSize=13;fontStyle=1;spacingLeft=8;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="c_atdecc"><mxGeometry x="20" y="40" width="1380" height="860" as="geometry"/></mxCell><mxCell id="pppipe" value="RX tap (registered, qualified on tvalid &amp;&amp; tready) -&gt; CLASSIFY FIRST&#10;&#160;&#160;EtherType 0x22F0 (any DA) · 01:80:C2:00:00:0E + 0x22EA (MSRP)&#10;&#160;&#160;01:80:C2:00:00:21 + 0x88F5 (MVRP)&#10;-&gt; BRAM control-frame FIFO (4 KB) -&gt; 1 byte/clk serializer -&gt; processor&#10;&#10;WHY CLASSIFY FIRST: the processor eats 1 byte/clk = 100 MB/s at 100 MHz,&#10;against gigabit&#x27;s 125 MB/s. A serializer fed from the raw tap would lag&#10;and CORRUPT frames rather than drop them. Control traffic is orders of&#10;magnitude below that rate; a frame lost to a full FIFO is COUNTED." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;" vertex="1" parent="c_pp"><mxGeometry x="15" y="35" width="1350" height="210" as="geometry"/></mxCell><mxCell id="pphdr1" value="what it owns:" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f8fd;strokeColor=#6c8ebf;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;" vertex="1" parent="c_pp"><mxGeometry x="15" y="260" width="1350" height="24" as="geometry"/></mxCell><mxCell id="r_pp0" value="ADP&#160;&#160;&#160;KL_adp_engine — AVAILABLE / DEPARTING / discover answer · available_index" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="284" width="1350" height="26" as="geometry"/></mxCell><mxCell id="r_pp1" value="ACMP&#160;&#160;KL_acmp_talker — CONNECT_TX · PROBE_TX · GET_TX_STATE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="310" width="1350" height="26" as="geometry"/></mxCell><mxCell id="r_pp2" value="ACMP&#160;&#160;KL_pp_acmp_listener — the BIND_RX ladder, publishing a BIND RECORD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="336" width="1350" height="26" as="geometry"/></mxCell><mxCell id="r_pp3" value="SRP&#160;&#160;&#160;Talker Advertise + Listener Ready · Domain adopt · granted idleSlope" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="362" width="1350" height="26" as="geometry"/></mxCell><mxCell id="pphdr2" value="AECP: PRESENT, NARROW. The processor&#x27;s AECP uCPU answers READ_DESCRIPTOR; every other command gets a conformant NOT_IMPLEMENTED echo." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;" vertex="1" parent="c_pp"><mxGeometry x="15" y="400" width="1350" height="24" as="geometry"/></mxCell><mxCell id="r_ppgone0" value="READ_DESCRIPTOR 0x0004 SERVED — SUCCESS {cfg_index, reserved, descriptor} · NO_SUCH_DESCRIPTOR on locate miss" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="424" width="1350" height="26" as="geometry"/></mxCell><mxCell id="r_ppgone1" value="&#160;&#160;&#160;· BAD_ARGUMENTS on bad cfg index; both errors carry the 7.4.5 {desc_type, desc_index} stub." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="450" width="1350" height="26" as="geometry"/></mxCell><mxCell id="r_ppgone2" value="&#160;&#160;&#160;Descriptors are FETCHED FROM DDR3 at a COMPILE-TIME base (no base register). No image = every read BAD_ARGUMENTS." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="476" width="1350" height="26" as="geometry"/></mxCell><mxCell id="r_ppgone3" value="IDENTIFY_NOTIFICATION 0x0026 as a COMMAND = BAD_ARGUMENTS (7.4.39.2 beats 9.3.5.3.3)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="502" width="1350" height="26" as="geometry"/></mxCell><mxCell id="r_ppgone4" value="Every other opcode + AA + MVU = NOT_IMPLEMENTED echo (message_type+1, right length, right cdl). Never silence." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="528" width="1350" height="26" as="geometry"/></mxCell><mxCell id="r_ppgone5" value="Wrong target_entity_id, or an AECP RESPONSE as input: freed, counted, NO reply." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="554" width="1350" height="26" as="geometry"/></mxCell><mxCell id="r_ppgone6" value="AN ECHO IS NOT AN IMPLEMENTATION. Still absent: ACQUIRE/LOCK_ENTITY (Milan d7 NOT_SUPPORTED owner_id=0 is" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="580" width="1350" height="26" as="geometry"/></mxCell><mxCell id="r_ppgone7" value="&#160;&#160;&#160;NOT distinguished from the echo — KNOWN GAP) · SET/GET of configuration · name · sampling rate · stream" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="606" width="1350" height="26" as="geometry"/></mxCell><mxCell id="r_ppgone8" value="&#160;&#160;&#160;format · stream info · max transit time · clock source · GET_AUDIO_MAP / ADD_ / REMOVE_AUDIO_MAPPINGS ·" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="632" width="1350" height="26" as="geometry"/></mxCell><mxCell id="r_ppgone9" value="&#160;&#160;&#160;GET_COUNTERS · Table 5.22 unsolicited push (no producer on the unsolicited TX lane) · GET_AVB_INFO /" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="658" width="1350" height="26" as="geometry"/></mxCell><mxCell id="r_ppgone10" value="&#160;&#160;&#160;GET_AS_PATH / GET_MILAN_INFO · IDENTIFY (o_identify tied 0)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="684" width="1350" height="26" as="geometry"/></mxCell><mxCell id="r_ppgone11" value="no saved-state persistence: the NVM face is a BLANK-FLASH responder, so a restore walk" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="710" width="1350" height="26" as="geometry"/></mxCell><mxCell id="r_ppgone12" value="&#160;&#160;&#160;always finds blank flash and completes with ZERO records (Milan 5.3.8.2 NOT met)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="736" width="1350" height="26" as="geometry"/></mxCell><mxCell id="pphdr3" value="class-D fabric face — published as WIRES, consumed every clock (no read transaction):" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f8fd;strokeColor=#6c8ebf;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;" vertex="1" parent="c_pp"><mxGeometry x="15" y="600" width="1350" height="24" as="geometry"/></mxCell><mxCell id="r_ppcd0" value="acmp_declaring / acmp_bound + bound sid · dmac · vlan&#160;&#160;-&gt;&#160;&#160;AAF admission, stream table, RX classify" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="624" width="1350" height="26" as="geometry"/></mxCell><mxCell id="r_ppcd1" value="srp granted idleSlope (sum over admitted sources) · domain {prio, VID} · over-limit&#160;&#160;-&gt;&#160;&#160;CBS slope mux" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="650" width="1350" height="26" as="geometry"/></mxCell><mxCell id="r_ppcd2" value="adp_next_avail_index&#160;&#160;-&gt;&#160;&#160;0x644 ADP_STATUS (the one live ADP diagnostic left)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="676" width="1350" height="26" as="geometry"/></mxCell><mxCell id="pphdr4" value="CSR window (always decoded — milan_csr&#x27;s PP_PLANE_P parameter is GONE):" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f8fd;strokeColor=#6c8ebf;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;" vertex="1" parent="c_pp"><mxGeometry x="15" y="720" width="1350" height="24" as="geometry"/></mxCell><mxCell id="r_ppcsr0" value="0x920 PP_CTRL {restore_go[1], enable[0]}&#160;&#160;&#160;—&#160;&#160;&#160;enable is ORed with the historic ADP_CTRL[0] at 0x600" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="744" width="1350" height="26" as="geometry"/></mxCell><mxCell id="r_ppcsr1" value="0x924 PP_STAT&#160;&#160;tag 0x5B (constant) · 0x928/0x92C posted side port · 0x930 PP_DIAG {tx, drops, rx}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;fontFamily=Courier New;" vertex="1" parent="c_pp"><mxGeometry x="15" y="770" width="1350" height="26" as="geometry"/></mxCell><mxCell id="c_maap" value="KL_maap + KL_pp_maap_shim — MAAP stays HERE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf6ec;strokeColor=#d79b00;verticalAlign=top;align=left;fontSize=13;fontStyle=1;spacingLeft=8;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="c_atdecc"><mxGeometry x="1420" y="40" width="300" height="400" as="geometry"/></mxCell><mxCell id="maappipe" value="The processor implements no MAAP&#10;by design: its spec puts address&#10;allocation in the integrating&#10;fabric, and it publishes a&#10;per-source ALLOC / RELEASE face&#10;instead.&#10;&#10;KL_pp_maap_shim bridges that face&#10;to KL_maap, which claims ONE block.&#10;&#10;THE DA GATE IS THE TALKER GATE:&#10;acmp_declaring is reachable only&#10;through an ALLOC_DA success, so&#10;with this face unconnected the&#10;processor&#x27;s talker half is dead&#10;by construction." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;verticalAlign=middle;align=left;spacingLeft=5;spacingRight=5;" vertex="1" parent="c_maap"><mxGeometry x="15" y="35" width="270" height="340" as="geometry"/></mxCell>