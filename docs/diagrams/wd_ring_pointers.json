  "head": {"text": "RingDMAWriter RX ring: wr_ptr commits only after the frame's last AXI B response"},
  "foot": {"text": "overload contract: frame C dropped WHOLE + counted, wr_ptr/seq untouched ; rd_ptr is the driver's consumer walk"},
  "config": {"hscale": 2}
