<mxCell id="n2" value="ATDECC control plane in fabric — ADP · AECP/AEM · ACMP · MAAP" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry"/></mxCell>
<mxCell id="n3" value="Every engine follows the monitor-tap + low-rate-TX recipe; identity is shared through the 0x600 CSR group so ADP and AEM can never disagree. Design record: docs/design/AEM_AND_AECP.md" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1700" height="24" as="geometry"/></mxCell>
<mxCell id="n4" value="KL_aecp_top — AECP / AEM listener   (IEEE 1722.1-2021 §9 · Milan v1.2 §5.4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontSize=14;opacity=60;" vertex="1" parent="1"><mxGeometry x="340" y="130" width="1160" height="540" as="geometry"/></mxCell>
<mxCell id="n5" value="ADP   (IEEE 1722.1-2021 §6 · discovery)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontSize=14;opacity=60;" vertex="1" parent="1"><mxGeometry x="340" y="720" width="390" height="310" as="geometry"/></mxCell>
<mxCell id="n6" value="ACMP   (IEEE 1722.1-2021 §8 · Milan v1.2 §5.5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontSize=14;opacity=60;" vertex="1" parent="1"><mxGeometry x="770" y="720" width="450" height="310" as="geometry"/></mxCell>
<mxCell id="n7" value="CSR / driver touchpoints   (milan_csr window; ABI: docs/reference/REGISTER_MAP.md)
softcore/driver: provisions identity at boot, runs the gptp-&gt;CSR daemon, seeds MAAP re-claim, saves/restores ACMP binds (acmp-persist), reads status + forensics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontSize=14;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="1860" height="330" as="geometry"/></mxCell>
<mxCell id="n8" value="MAC RX stream
post rx_mac_filter (TCAM)

MONITOR taps only:
every control engine
reads this stream,
none may backpressure
it (house recipe)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="250" height="840" as="geometry"/></mxCell>
<mxCell id="n9" value="KL_aecp_ingress
AECP-for-us / discover filter
store-and-forward, src MAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="190" width="200" height="95" as="geometry"/></mxCell>
<mxCell id="n10" value="KL_aecp_packet_validator
drop bad message_type /
control_data_length &lt; 12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="595" y="190" width="200" height="95" as="geometry"/></mxCell>
<mxCell id="n11" value="KL_aecp_common_parser
header struct, entity_id
match on the first beat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="190" width="200" height="95" as="geometry"/></mxCell>
<mxCell id="n12" value="KL_aecp_l0_state
LOCK 60 s owner/expiry
ACQUIRE -&gt; NOT_SUPPORTED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1045" y="190" width="200" height="95" as="geometry"/></mxCell>
<mxCell id="n13" value="KL_aecp_timers
1 kHz tick · lock expiry
counter-push 1/s throttle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="190" width="205" height="95" as="geometry"/></mxCell>
<mxCell id="n14" value="KL_aecp_response_builder
capture · classify · SET_* write-back · segment serialiser
4-slot unsolicited push engine (u=1, no-change gate)
GET_DYNAMIC_INFO 0x4B two-pass batch engine
`AEM_DYNMAP dynamic audio-map engine (5.4.2.26-28)
identify_o -&gt; board LED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="340" width="470" height="180" as="geometry"/></mxCell>
<mxCell id="n15" value="KL_aecp_accessor
directory (type,index) -&gt; {base,len}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="340" width="310" height="55" as="geometry"/></mxCell>
<mxCell id="n16" value="KL_aecp_aem_store
generated ROM + write-back RAM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="415" width="310" height="55" as="geometry"/></mxCell>
<mxCell id="n17" value="KL_aecp_aem_dyn_mux
live-field read overlay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="490" width="310" height="55" as="geometry"/></mxCell>
<mxCell id="n18" value="KL_adp_parser
RX: ENTITY_AVAILABLE /
DEPARTING / DISCOVER
decode (82-B rule)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="365" y="785" width="165" height="150" as="geometry"/></mxCell>
<mxCell id="n19" value="adp_advertiser
ENTITY_AVAILABLE every
valid_time; discover resp
(random delay); departing;
available_index++ on
EVERY ADPDU; discover
pulse from AECP ingress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="785" width="165" height="220" as="geometry"/></mxCell>
<mxCell id="n20" value="KL_acmp_lstn_ctx
N sink bind contexts,
one SM + one ctx RAM:
ctx0 probe ladder (5.5.3),
ctx1 CRF record;
CONNECT/DISCONNECT/
GET_RX_STATE responder;
ADP talker watch feeds it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="785" y="785" width="205" height="220" as="geometry"/></mxCell>
<mxCell id="n21" value="KL_acmp_tlkr_ctx
N source contexts:
PROBE_TX SM, 15 s
window, live params" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1005" y="785" width="200" height="130" as="geometry"/></mxCell>
<mxCell id="n22" value="bind-restore port
0x7A0 commit -&gt; ENTRY
record (saved-state)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1005" y="925" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="n23" value="KL_maap
IEEE 1722 Annex B
PROBE x3 -&gt; ANNOUNCE,
DEFEND on conflict;
pool 91:E0:F0 + offset;
claimed DMAC drives the
AAF framer (eff_aaf_dmac
mux); softcore may seed
the offset (re-claim)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="720" width="270" height="310" as="geometry"/></mxCell>
<mxCell id="n24" value="low-rate TX arbiter chain
pairwise adp_tx_arbiter tree:

1  AECP + ACMP talker
2  + ADP advertise
3  + lwSRP MRPDUs (0x680)
4  + ACMP listener
5  + MAAP

one whole frame per grant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1620" y="190" width="280" height="400" as="geometry"/></mxCell>
<mxCell id="n25" value="TX merge with datapath
control stream + shaped/PTP
stream -&gt; one MAC TX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1620" y="660" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="n26" value="MAC TX
MilanMAC -&gt; PHY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1620" y="790" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="n27" value="0x600-0x644  ADP identity + control
entity_id/model_id/caps · gPTP GM 0x624/8 + domain (daemon-fed)
valid_time · ADP_CMD advertise-now · ADP_STATUS available_index" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1165" width="580" height="110" as="geometry"/></mxCell>
<mxCell id="n28" value="0x648 / 0x64C  AECP status (RO)
A_AECP_STAT0/1: locked + command count ·
response count + current_configuration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="1165" width="580" height="110" as="geometry"/></mxCell>
<mxCell id="n29" value="0x6A4 ACMPL_STATE (RO) · 0x6E8 forensics
listener SM state / bound / SRP flags / last ACMP status ·
walker classify counters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="1165" width="580" height="110" as="geometry"/></mxCell>
<mxCell id="n30" value="0x6CC-0x6D4  MAAP
enable / seed re-claim · claimed offset, conflicts, DEFENDs ·
addr_valid + SM state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1290" width="580" height="110" as="geometry"/></mxCell>
<mxCell id="n31" value="0x7A0-0x7B4  ACMP bind-restore
saved talker/controller ids + flags + commit/status;
software-gated: VERSION &gt;= 0x000A + 0x7A0 write/readback probe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="1290" width="580" height="110" as="geometry"/></mxCell>
<mxCell id="n32" value="0x680  lwSRP engine (neighbor)
MSRP Domain/TalkerAdvertise; couples listener_observed into the
talker contexts and gates AAF admission on the reservation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="1290" width="580" height="110" as="geometry"/></mxCell>
<mxCell id="n33" value="entity model (generated)
avdecc/milan-v12-entity*.json
-&gt; avdecc/gen_aem_store.py
   (--overlay: sw/builder
    endstation shapes, NxN)
-&gt; gen/aecp_aem_rom.svh
   + aem_golden.h + aem_rom.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#90A4AE;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1210" y="340" width="270" height="185" as="geometry"/></mxCell>
