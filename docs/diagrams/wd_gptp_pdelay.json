{
  "config": {"hscale": 2},
  "head": {"text": "Parent pdelay timestamp ownership"},
  "signal": [
    ["Egress request",
      {"name": "accepted MAC SOF", "wave": "010.......", "node": ".a........"},
      {"name": "TX PHC capture", "wave": "010.......", "node": ".b........"},
      {"name": "accepted MAC EOF", "wave": "0..10.....", "node": "...c......"},
      {"name": "returned tuple", "wave": "0...10....", "data": ["{t1, seq, type=2}"], "node": "....d....."}
    ],
    {},
    ["Ingress response",
      {"name": "accepted tap SOF", "wave": "0....10...", "node": ".....e...."},
      {"name": "RX PHC capture", "wave": "0....10...", "node": ".....f...."},
      {"name": "frame FIFO commit", "wave": "0......10.", "node": ".......g.."},
      {"name": "engine RX SOF", "wave": "0........10", "node": ".........h"},
      {"name": "paired ingress time", "wave": "x........=", "data": ["t4"]}
    ]
  ],
  "edge": [
    "a~>b capture t1",
    "b~>d preserve t1",
    "c~>d return tags",
    "e~>f capture t4",
    "f~>g push after commit",
    "g~>h pop by position"
  ],
  "foot": {"text": "meanLinkDelay = ((t4-t1) - (t3-t2)) / 2; sequence plus message type selects TX claims"}
}
