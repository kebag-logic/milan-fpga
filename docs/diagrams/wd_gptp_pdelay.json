{
  "config": {"hscale": 1},
  "head": {"text": "Parent pdelay timestamp ownership"},
  "signal": [
    ["Egress request",
      {"name": "accepted MAC SOF", "wave": "010..............", "node": ".a..............."},
      {"name": "TX PHC capture", "wave": "010..............", "node": ".b..............."},
      {"name": "accepted sequence beat 5", "wave": "0.....10.........", "node": "......c.........."},
      {"name": "returned tuple", "wave": "0......10........", "data": ["{t1, seq, type=2}"], "node": ".......d........."},
      {"name": "accepted MAC EOF", "wave": "0........10......", "node": ".........e......."}
    ],
    {},
    ["Ingress response",
      {"name": "accepted tap SOF", "wave": "0..........10....", "node": "...........f....."},
      {"name": "RX PHC capture", "wave": "0..........10....", "node": "...........g....."},
      {"name": "frame FIFO commit", "wave": "0............10..", "node": ".............h..."},
      {"name": "engine RX SOF", "wave": "0..............10", "node": "...............i."},
      {"name": "paired ingress time", "wave": "x..............=.", "data": ["t4"]}
    ]
  ],
  "edge": [
    "a~>b capture t1",
    "b~>d preserve t1",
    "c~>d return tags",
    "d~>e return precedes EOF",
    "f~>g capture t4",
    "g~>h push after commit",
    "h~>i pop by position"
  ],
  "foot": {"text": "meanLinkDelay = ((t4-t1) - (t3-t2)) / 2; sequence plus message type selects TX claims"}
}
