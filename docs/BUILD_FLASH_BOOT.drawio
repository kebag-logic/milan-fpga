<mxfile host="app.diagrams.net"><diagram name="build-flash-boot"><mxGraphModel dx="1400" dy="900" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2002" pageHeight="735" math="0" shadow="0"><root><mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="n2" value="Build → Flash → Boot → Verify — the AX7101 pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=22;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#212121;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="34" as="geometry"/></mxCell>
<mxCell id="n3" value="1 · BUILD   —   dev host · Vivado

$ sw/litex/build.sh ax7101
  --software-profile baremetal
  --fabric-gptp --full
$ --with-spiflash --flashboot baremetal
  generated AEM + gPTP ROM from one YAML
  3×32-thread seed sweep
  GATE: WNS ≥ 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#212121;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="440" height="369" as="geometry"/></mxCell>
<mxCell id="n4" value="OUTPUT
gateware .bit + raw aem_desc.bin
(no second-stage boot images)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2E7D32;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="40" y="541" width="440" height="64" as="geometry"/></mxCell>
<mxCell id="n5" value="2 · FLASH   —   JTAG → QSPI (16 MB)

$ INSTALLED_BUILD=&lt;old&gt; build.sh flash ax7101:&lt;new&gt;
  live-read QSPI@0; match exact old/new .bit
  prepare target; CRC-check the live image set
  software/full→fabric/bare: bit, then AEM
  every write uses --verify
  retry recognizes source or target commit bit
  direct partial writes: recovery escape only
  boundary: torn offset-zero write needs A/B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#212121;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="534" y="150" width="440" height="369" as="geometry"/></mxCell>
<mxCell id="n6" value="OUTPUT
persistent QSPI image:
bitstream@0 · paired raw AEM image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#EF6C00;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="534" y="541" width="440" height="64" as="geometry"/></mxCell>
<mxCell id="n7" value="3 · BOOT   —   on target · self-configures

$ power on / power-cycle
  FPGA config-boots from QSPI
  LiteX BIOS → RV32 firmware in ROM
  AEM length + CRC verified into DRAM
  entity enables only after valid AEM
  fabric gPTP owns PHC + publication
  one firmware image · one time owner · no mirrors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#212121;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1028" y="150" width="440" height="369" as="geometry"/></mxCell>
<mxCell id="n8" value="OUTPUT
cacheless RV32 bare-metal control,
Milan fabric live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1565C0;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="1028" y="541" width="440" height="64" as="geometry"/></mxCell>
<mxCell id="n9" value="4 · VERIFY   —   on the bench

$ baremetal_uart_smoke.py --port &lt;UART&gt;
  UART reports VERSION 0x00020057 + gPTP state
$ focused RTL + processor suites
  traceability + builder gates
  #117: physical / two-board pending
  REGISTER_MAP.md = the ABI
  #117 records topology + raw evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#212121;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1522" y="150" width="440" height="369" as="geometry"/></mxCell>
<mxCell id="n10" value="OUTPUT
digitally validated candidate;
physical acceptance stays on #117" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6A1B9A;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="1522" y="541" width="440" height="64" as="geometry"/></mxCell>
<mxCell id="e11" style="endArrow=block;html=1;strokeColor=#455A64;strokeWidth=3;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e12" style="endArrow=block;html=1;strokeColor=#455A64;strokeWidth=3;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
