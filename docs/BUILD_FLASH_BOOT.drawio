<mxCell id="n14" value="↩ Recovery — retry flash-pair with the same installed reference; source/target commit bits are recognized · JTAG-load to SRAM for nonpersistent tests · a torn offset-zero write needs physical recovery or A/B MultiBoot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#212121;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="639" width="1922" height="72" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>