+// NewFailFastParallelExecutor stops scheduling after the first failed job and joins cleanup.
+func NewFailFastParallelExecutor(parallel int, executors ...Executor) Executor {
+	return func(parent context.Context) error {
+		ctx, cancel := context.WithCancel(parent)
+		defer cancel()
+		if parallel < 1 {
+			parallel = 1
+		}
+		var lock sync.Mutex
+		var workers sync.WaitGroup
+		next := 0
+		var firstErr error
+		for i := 0; i < parallel; i++ {
+			workers.Add(1)
+			go func() {
+				defer workers.Done()
+				for {
+					lock.Lock()
+					if firstErr != nil || ctx.Err() != nil || next == len(executors) {
+						lock.Unlock()
+						return
+					}
+					executor := executors[next]
+					next++
+					lock.Unlock()
+					err := executor(ctx)
+					lock.Lock()
+					if err != nil && firstErr == nil {
+						firstErr = err
+						cancel()
+					}
+					lock.Unlock()
+				}
+			}()
+		}
+		workers.Wait()
+		if firstErr != nil {
+			return firstErr
+		}
+		return parent.Err()
+	}
+}
