  "rules": [
    {
      "class": "absolute-user-path",
      "needles": [
        "/home/",
        "/users/",
        "/data/"
      ],
      "pattern": "(?<![A-Za-z0-9_./-])(?:/home/(?!ubuntu(?:/|[\\x00\\s:]|$))[A-Za-z0-9_.-]+|/Users/[A-Za-z0-9_.-]+|/data/[A-Za-z0-9_.-]+/)"
    },
    {
      "class": "private-address",
      "needles": [
        "192.168.",
        "10.",
        "172."
      ],
      "pattern": "(?<![0-9.])(?:192\\.168\\.[0-9]{1,3}\\.[0-9]{1,3}|10\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}|172\\.(?:1[6-9]|2[0-9]|3[01])\\.[0-9]{1,3}\\.[0-9]{1,3})(?![0-9.])"
    },
    {
      "class": "private-host",
      "needles": [
        "\u0061\u006d\u0078-"
      ],
      "pattern": "\\b\\x61\\x6d\\x78-[A-Za-z0-9.-]+"
    },
    {
      "class": "credential",
      "needles": [
        "ghp_",
        "gho_",
        "ghu_",
        "ghs_",
        "ghr_",
        "github_pat_",
        "AKIA",
        "-----BEGIN",
        "http://",
        "https://"
