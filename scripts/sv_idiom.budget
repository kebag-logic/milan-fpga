# Rule 10 ratchets across the superproject and both project-owned processor
# submodules. See scripts/check_sv_idiom.py. Files that are not lower-case
# .sv/.svh and generic `always` are refused outright and have no entries here.
# EVERY NUMBER MAY ONLY GO DOWN.
#
# All three populations are now ZERO. `reg` was 58 across 15 files and every
# one of them was single-driver sequential state inside an `always_ff`, so the
# repair was a spelling change with no restructuring: each was respelled
# `logic`, the verilator --lint-only warning set was compared before and after
# for every file, and every suite that instantiates one was rebuilt against its
# recorded tally. A `wire` is still NOT counted: a net type is the right model
# for connectivity.
reg declaration    = 0
# The complete measured population (axi_stream_if's four) was typed earlier, so
# the entry admits no new one: a `parameter W;` with no default and every name
# of a `parameter A = 1, B = 2;` list count as well.
untyped parameter  = 0
# Was 2: the `$clog2`-derived TDEST_WIDTH constants in hdl/ieee8021q/ts/, now
# typed. Kept as its own entry so localparam debt is never traded against port
# parameters.
untyped localparam = 0
