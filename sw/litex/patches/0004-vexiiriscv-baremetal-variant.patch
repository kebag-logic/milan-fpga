--- a/litex/soc/cores/cpu/vexiiriscv/core.py
+++ b/litex/soc/cores/cpu/vexiiriscv/core.py
@@ -28,7 +28,7 @@
 
 # Variants -----------------------------------------------------------------------------------------
 
-CPU_VARIANTS = ["standard", "cached", "linux", "debian"]
+CPU_VARIANTS = ["baremetal", "standard", "cached", "linux", "debian"]
 
 # VexiiRiscv -----------------------------------------------------------------------------------------
 
@@ -248,11 +248,17 @@
 
         if with_user_isa:
             isa_map.update(args.isa)
-        isa_map.update(["m", "zihpm", "zicntr"])
