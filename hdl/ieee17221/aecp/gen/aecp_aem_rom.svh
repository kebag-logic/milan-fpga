// Dynamic read-overlay sources
localparam [3:0] OVL_ENTITY_ID_C = 4'd0;
localparam [3:0] OVL_MODEL_ID_C = 4'd1;
localparam [3:0] OVL_ECAPS_C = 4'd2;
localparam [3:0] OVL_TALKER_SRC_C = 4'd3;
localparam [3:0] OVL_TALKER_CAP_C = 4'd4;
localparam [3:0] OVL_LISTEN_SINK_C = 4'd5;
localparam [3:0] OVL_LISTEN_CAP_C = 4'd6;
localparam [3:0] OVL_CTRL_CAP_C = 4'd7;
localparam [3:0] OVL_AVAIL_IDX_C = 4'd8;
localparam [3:0] OVL_ASSOC_ID_C = 4'd9;
localparam [3:0] OVL_CURRENT_CFG_C = 4'd10;
localparam [3:0] OVL_MAC_C = 4'd11;
localparam [3:0] OVL_CLOCK_ID_C = 4'd12;
localparam [3:0] OVL_ENT_NAME8_C = 4'd13;

// overlay lookup: rom addr -> {hit, source[3:0], byte_of_source[2:0]}
// byte_of_source 0 = MOST significant byte of the source value.
function automatic [7:0] aem_ovl_lookup(input [15:0] addr);
  begin
    aem_ovl_lookup = 8'h00;  // hit=0
    if (addr >= 16'd4 && addr < 16'd12)
      aem_ovl_lookup = {1'b1, OVL_ENTITY_ID_C, 3'(addr - 16'd4)};
    if (addr >= 16'd12 && addr < 16'd20)
      aem_ovl_lookup = {1'b1, OVL_MODEL_ID_C, 3'(addr - 16'd12)};
    if (addr >= 16'd20 && addr < 16'd24)
      aem_ovl_lookup = {1'b1, OVL_ECAPS_C, 3'(addr - 16'd20)};
    if (addr >= 16'd24 && addr < 16'd26)
      aem_ovl_lookup = {1'b1, OVL_TALKER_SRC_C, 3'(addr - 16'd24)};
    if (addr >= 16'd26 && addr < 16'd28)
      aem_ovl_lookup = {1'b1, OVL_TALKER_CAP_C, 3'(addr - 16'd26)};
    if (addr >= 16'd28 && addr < 16'd30)
      aem_ovl_lookup = {1'b1, OVL_LISTEN_SINK_C, 3'(addr - 16'd28)};
    if (addr >= 16'd30 && addr < 16'd32)
      aem_ovl_lookup = {1'b1, OVL_LISTEN_CAP_C, 3'(addr - 16'd30)};
    if (addr >= 16'd32 && addr < 16'd36)
      aem_ovl_lookup = {1'b1, OVL_CTRL_CAP_C, 3'(addr - 16'd32)};
    if (addr >= 16'd36 && addr < 16'd40)
      aem_ovl_lookup = {1'b1, OVL_AVAIL_IDX_C, 3'(addr - 16'd36)};
    if (addr >= 16'd40 && addr < 16'd48)
      aem_ovl_lookup = {1'b1, OVL_ASSOC_ID_C, 3'(addr - 16'd40)};
    if (addr >= 16'd48 && addr < 16'd56)
      aem_ovl_lookup = {1'b1, OVL_ENT_NAME8_C, 3'(addr - 16'd48)};
    if (addr >= 16'd310 && addr < 16'd312)
      aem_ovl_lookup = {1'b1, OVL_CURRENT_CFG_C, 3'(addr - 16'd310)};
    if (addr >= 16'd3220 && addr < 16'd3226)
      aem_ovl_lookup = {1'b1, OVL_MAC_C, 3'(addr - 16'd3220)};
    if (addr >= 16'd3228 && addr < 16'd3236)
      aem_ovl_lookup = {1'b1, OVL_CLOCK_ID_C, 3'(addr - 16'd3228)};
  end
endfunction

// SET_* write-back base addresses
localparam [15:0] WB_SAMPLING_RATE_C = 16'd554;
localparam [15:0] WB_STREAM_FORMAT_C = 16'd1964;
localparam [15:0] WB_STREAM_IN0_FMT_C = 16'd640;
localparam [15:0] WB_STREAM_IN1_FMT_C = 16'd788;
localparam [15:0] WB_STREAM_IN2_FMT_C = 16'd936;
localparam [15:0] WB_STREAM_IN3_FMT_C = 16'd1084;
localparam [15:0] WB_STREAM_IN4_FMT_C = 16'd1232;
localparam [15:0] WB_STREAM_IN5_FMT_C = 16'd1380;
localparam [15:0] WB_STREAM_IN6_FMT_C = 16'd1528;
localparam [15:0] WB_STREAM_IN7_FMT_C = 16'd1676;
localparam [15:0] WB_STREAM_IN8_FMT_C = 16'd1824;
localparam [15:0] WB_CLOCK_SRC_IDX_C = 16'd4178;
localparam [15:0] WB_CONTROL_CUR_C = 16'd4312;

// SET/GET_NAME qualifier: (type, index, name_index) + the directory
// oracle's REGISTERED answer -> {valid, rom addr}. Reads no ROM of
// its own (the level-2 directory is block RAM; a second read port
// here would be a second BRAM or a distributed copy): a masked
// type's object_name sits at descriptor base + 4, name_index 0, for
// every index of its run (generator-asserted 1:1 against the NAMED
// table - gen_aem_store.py named_structure/check_named), so the
// accessor's (found, base) for the SAME (type, index) already carry
// the lookup. Exceptions (ENTITY's entity_name/group_name) are
// constant matches. CALLER CONTRACT: acc_found/acc_base must be
// KL_aecp_accessor's answer for this (t, idx) at config 0.
localparam [63:0] AEM_NAMED_MASK_C = 64'h1004100666;
function automatic [16:0] aem_name_qual(input [15:0] t,
                                        input [15:0] idx,
                                        input [15:0] nidx,
                                        input        acc_found,
                                        input [15:0] acc_base);
  begin
    aem_name_qual = 17'd0;
    if (t == 16'h0000 && idx == 16'd0 && nidx == 16'd0)
      aem_name_qual = {1'b1, 16'd48};
    if (t == 16'h0000 && idx == 16'd0 && nidx == 16'd1)
      aem_name_qual = {1'b1, 16'd180};
    if (t < 16'(AEM_L1_N_C) && nidx == 16'd0 &&
        AEM_NAMED_MASK_C[t[5:0]] && acc_found)
      aem_name_qual = {1'b1, acc_base + 16'd4};
  end
endfunction

// Value validation tables
localparam int AEM_RATES_N_C = 1;
localparam [31:0] AEM_RATES_C [0:0] = '{32'h0000BB80};
localparam [63:0] AEM_FMTS_C  [0:1] = '{64'h0205022002006000, 64'h0215022002006000};
localparam [63:0] AEM_CRF_FMTS_C [0:0] = '{64'h041060010000BB80};

// Per-descriptor stream-format tables (multi-stream shapes only:
// the deployed 1-AAF-in/1-out shape keeps the legacy layout above
// byte-identical; KL_aecp_response_builder switches on this define)
`define AEM_PER_STREAM_FMT
localparam int unsigned AEM_N_STRIN_C  = 9;
localparam int unsigned AEM_N_STROUT_C = 9;
localparam bit AEM_STRIN_CRF_C [0:8] = '{1'b0, 1'b0, 1'b0, 1'b0, 1'b0, 1'b0, 1'b0, 1'b0, 1'b1};
localparam [63:0] AEM_STRIN_FMT_C [0:8] = '{64'h0205022002006000, 64'h0205022002006000, 64'h0205022002006000, 64'h0205022002006000, 64'h0205022002006000, 64'h0205022002006000, 64'h0205022002006000, 64'h0205022002006000, 64'h041060010000BB80};
localparam [63:0] AEM_STROUT_FMT_C [0:8] = '{64'h0205022002006000, 64'h0205022002006000, 64'h0205022002006000, 64'h0205022002006000, 64'h0205022002006000, 64'h0205022002006000, 64'h0205022002006000, 64'h0205022002006000, 64'h041060010000BB80};
localparam [15:0] WB_STRIN_FMT_ADDR_C [0:8] = '{16'd640, 16'd788, 16'd936, 16'd1084, 16'd1232, 16'd1380, 16'd1528, 16'd1676, 16'd1824};
localparam [15:0] WB_STROUT_FMT_ADDR_C [0:8] = '{16'd1964, 16'd2104, 16'd2244, 16'd2384, 16'd2524, 16'd2664, 16'd2804, 16'd2944, 16'd3084};

// Static AUDIO_MAP serving tables (GET_AUDIO_MAP, 1722.1-2021 7.4.44).
// Per STREAM_PORT: the ROM address of the AUDIO_MAP that port's OWN
// base_map names, THAT descriptor's own number_of_mappings, and its
// own mappings_offset - because 7.2.19 says the mappings field "shall
// be accessed by using the mappings_offset field". All three used to
// be hardcoded in the RTL (descriptor index 1, 8 mappings, offset 8,
// 64 bytes), which on an 8x8 shape served STREAM_PORT_INPUT[1]'s
// 72-byte map to STREAM_PORT_OUTPUT[0] and read 48 B past its
// 24-byte one. ROWS = 0 marks a port with no static map - 7.2.13:
// "These Entities set the number_of_maps field to zero (0) and the
// base_map field is ignored when read." On a STREAM_PORT_OUTPUT that
// DOES have a map, ROWS != 0 is also the condition under which Milan
// v1.2 5.4.2.26 requires NOT_SUPPORTED rather than a served map.
localparam int unsigned AEM_SMAP_IN_N_C  = 8;
localparam int unsigned AEM_SMAP_OUT_N_C = 8;
localparam [15:0] AEM_SMAP_IN_ADDR_C [0:7] = '{16'd0, 16'd0, 16'd0, 16'd0, 16'd0, 16'd0, 16'd0, 16'd0};
localparam [15:0] AEM_SMAP_IN_ROWS_C [0:7] = '{16'd0, 16'd0, 16'd0, 16'd0, 16'd0, 16'd0, 16'd0, 16'd0};
localparam [15:0] AEM_SMAP_IN_MOFF_C [0:7] = '{16'd0, 16'd0, 16'd0, 16'd0, 16'd0, 16'd0, 16'd0, 16'd0};
localparam [15:0] AEM_SMAP_OUT_ADDR_C [0:7] = '{16'd0, 16'd0, 16'd0, 16'd0, 16'd0, 16'd0, 16'd0, 16'd0};
localparam [15:0] AEM_SMAP_OUT_ROWS_C [0:7] = '{16'd0, 16'd0, 16'd0, 16'd0, 16'd0, 16'd0, 16'd0, 16'd0};
localparam [15:0] AEM_SMAP_OUT_MOFF_C [0:7] = '{16'd0, 16'd0, 16'd0, 16'd0, 16'd0, 16'd0, 16'd0, 16'd0};

// Dynamic audio-map engine (gaps item 8, roadmap 23): every
// map_mode-dynamic STREAM_PORT_INPUT carries no AUDIO_MAP
// descriptor and advertises number_of_maps=0 (1722.1-2021
// 7.2.13); ADD/REMOVE/GET are served by the RTL mappings store
// per Milan 5.4.2.26-28. Fully static shapes never emit this.
// The store key is the GLOBAL cluster index (PBASE + offset) =
// the render crossbar map-RAM address.
`define AEM_DYNMAP
localparam int unsigned AEM_DMAP_KEYS_C  = 64;   // global dynamic cluster keys (mono clusters)
localparam int unsigned AEM_DMAP_PAGE_C  = 8;   // GET_AUDIO_MAP fixed partition size (shared)
if (AEM_DMAP_PAGE_C > 11) $error("AEM_DMAP_PAGE_C %0d exceeds the GET_AUDIO_MAP const-scratch bound of 11 (6 + 8*PAGE <= 96)", AEM_DMAP_PAGE_C);
localparam int unsigned AEM_DMAP_PHYS_C  = 10;   // render crossbar depth (CHMAP_PHYS_C)
localparam int unsigned AEM_DMAP_NPORTS_C = 8;   // STREAM_PORT_INPUT descriptors
localparam bit AEM_DMAP_PDYN_C [0:7] = '{1'b1, 1'b1, 1'b1, 1'b1, 1'b1, 1'b1, 1'b1, 1'b1};
localparam int unsigned AEM_DMAP_PBASE_C [0:7] = '{0, 8, 16, 24, 32, 40, 48, 56};
localparam int unsigned AEM_DMAP_PCLS_C [0:7] = '{8, 8, 8, 8, 8, 8, 8, 8};
localparam int unsigned AEM_DMAP_PNMAPS_C [0:7] = '{1, 1, 1, 1, 1, 1, 1, 1};
// A STATIC port (input or output) is served from the shared
// AEM_SMAP_* tables above - one generated source for "what map
// does this port serve", static and dynamic shapes alike.
// Per-STREAM_INPUT mappability + reset channel count: a mapping
// names any STREAM_INPUT (Table 7-33) and 5.4.2.27 rejects a
// channel absent from THAT stream's current format.
localparam int unsigned AEM_DMAP_NSTRIN_C = 9;
localparam bit AEM_DMAP_SAAF_C [0:8] = '{1'b1, 1'b1, 1'b1, 1'b1, 1'b1, 1'b1, 1'b1, 1'b1, 1'b0};
